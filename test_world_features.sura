assert_eq(time_parts.month, 5)
assert_eq(time_parts.day, 16)
assert_eq(time_parts.hour, 12)
assert_eq(time_parts.minute, 34)
assert_eq(time_parts.second, 56)
assert(not time_parts.utc)

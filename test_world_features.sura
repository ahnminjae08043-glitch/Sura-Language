assert_eq(utc_parts.month, 1)
assert_eq(utc_parts.day, 1)
assert_eq(utc_parts.hour, 0)
assert_eq(utc_parts.weekday, 4)
assert(utc_parts.utc)

callable_dict is {add: func(left, right) do
  return left + right
end}
assert_eq(callable_dict.add(4, 5), 9)

func callable_field_triple(value) do
  return value * 3
end

class CallableFieldBox do
  func init(handler) do
    self.handler is handler
  end
end

callable_box is new CallableFieldBox(callable_field_triple)
assert_eq(callable_box.handler(7), 21)

print "world features: PASS"

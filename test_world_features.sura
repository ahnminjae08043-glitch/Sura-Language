strict_request_policy is {tools: ["http_request"], url_prefixes: ["file://"], http_methods: ["GET"], allowed_headers: ["X-Agent"], required_headers: {"X-Agent": "sura"}, max_timeout: 30, max_body_bytes: 0, allow_shell: false}

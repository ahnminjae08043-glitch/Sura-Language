missing_status is async_status(-999999)
assert(not missing_status.known)
assert(not missing_status.ready)
# 느린 작업은 OS별로 명령이 다르다: Windows는 cmd/ping, 그 외는 sh/sleep.
func slow_echo_cmd(msg) do
    if os_name() == "windows" then
        return "cmd /c ping -n 2 127.0.0.1 > nul && echo " + msg
    end
    return "sleep 1 && echo " + msg
end
slow_task is async_cmd(slow_echo_cmd("slow-timeout"))
slow_status is async_status(slow_task)
assert_eq(slow_status.id, slow_task)
assert(slow_status.known)
assert(slow_status.running)
assert_contains(pluck(async_pending(), "id"), slow_task)
assert_eq(async_await_timeout(slow_task, 1, "not-ready"), "not-ready")
assert(async_status(slow_task).known)
assert(not async_forget(slow_task))
assert(async_status(slow_task).known)
assert_eq(await_timeout(slow_task, 5000, "missing").trim(), "slow-timeout")
assert(not async_status(slow_task).known)
forget_task is async_cmd("echo forget-done")
sleep_ms(500)
assert(async_ready(forget_task))
assert(async_forget(forget_task))
assert(not async_status(forget_task).known)
cleanup_a is async_cmd("echo cleanup-a")
cleanup_b is async_cmd("echo cleanup-b")
sleep_ms(500)
cleanup_count is async_cleanup()
assert(cleanup_count >= 2)
assert(not async_status(cleanup_a).known)
assert(not async_status(cleanup_b).known)
any_slow is async_cmd(slow_echo_cmd("any-slow"))
any_fast is async_cmd("echo any-fast")
first_done is async_any([any_slow, any_fast], 5000, "missing")
assert_eq(first_done.index, 1)
assert_eq(first_done.output.trim(), "any-fast")
assert_eq(await_any([any_slow], 5000, "missing").output.trim(), "any-slow")
all_slow_a is async_cmd(slow_echo_cmd("all-a"))
all_slow_b is async_cmd(slow_echo_cmd("all-b"))
assert_eq(async_all_timeout([all_slow_a, all_slow_b], 1, "waiting"), "waiting")
all_done is await_all_timeout([all_slow_a, all_slow_b], 5000, ["missing"])
assert_eq(all_done[0].trim(), "all-a")
assert_eq(all_done[1].trim(), "all-b")


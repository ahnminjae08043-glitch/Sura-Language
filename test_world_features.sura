print "world features"

use array
use graphics3d

suffix is to_str(round(random(1000000000)))
assert_eq(argc(), 0)
assert_eq(length(argv()), 0)
assert_eq(path_basename(script_name()), "test_world_features.sura")

assert(regex_match("abc123", "[a-z]+[0-9]+"))
assert_eq(regex_replace("a1 b2", "[0-9]", "x"), "ax bx")
assert_eq(regex_find_all("a1 b22 c333", "[0-9]+").join(","), "1,22,333")
literal_pattern is regex_escape("a+b? [x]")
assert(regex_match("a+b? [x]", "^" + literal_pattern + "$"))
assert_eq(regex_find_all("a+b? [x] axb?", literal_pattern).len(), 1)
first_capture is regex_capture("user=kim score=42", "user=([A-Za-z]+) score=([0-9]+)")
assert_eq(first_capture[0], "user=kim score=42")
assert_eq(first_capture[1], "kim")
assert_eq(first_capture[2], "42")
all_captures is regex_captures("a=1 b=22", "([a-z])=([0-9]+)")
assert_eq(all_captures.len(), 2)
assert_eq(all_captures[1][1], "b")
assert_eq(all_captures[1][2], "22")
assert_eq(type(regex_capture("none", "id=([0-9]+)")), "nil")
assert_contains("sura automation", "auto")
assert_contains(["ai", "game"], "ai")
assert_contains({status: "ok"}, "status")
assert_not_contains("sura", "python")
assert_match("agent-2026", "agent-[0-9]+")
assert_type({status: "ok"}, "dict")
assert_len(["ai", "game"], 2)
assert_len("sura", 4)
assert_between(0.75, 0.7, 0.8)
assert_approx(0.1 + 0.2, 0.3, 0.000001)
assert_approx(1.000000001, 1.0, 0.00001, "tiny float drift")
checks is [check("truthy condition", true), check_eq("sum result", 1 + 1, 2), check_match("agent id", "agent-2026", "agent-[0-9]+"), check_eq("expected failure sample", 1, 2)]
summary is test_summary(checks)
assert_eq(summary.total, 4)
assert_eq(summary.passed, 3)
assert_eq(summary.failed, 1)
assert(not summary.ok)
assert_eq(summary.failures[0].name, "expected failure sample")
report is test_report(checks, "world checks")
assert_contains(report, "[PASS] sum result")
assert_contains(report, "[FAIL] expected failure sample")
assert_contains(report, "total: 4, passed: 3, failed: 1")

assert_eq(array_min([4, -2, 7]), -2)
assert_eq(array_max([4, -2, 7]), 7)
assert_eq(array.min([4, -2, 7]), -2)
assert_eq(array.max([4, -2, 7]), 7)

p3 is vec3(1, 2, 3)
q3 is vec3(4, 6, 8)
assert_eq(p3.len(), 3)
assert_eq(vec3_add(p3, q3)[2], 11)
assert_eq(vec3_sub(q3, p3).join(","), "3,4,5")
assert_eq(vec3_dot(p3, q3), 40)
cross3 is vec3_cross([1, 0, 0], [0, 1, 0])
assert_eq(cross3.join(","), "0,0,1")
assert_eq(vec3_scale(p3, 2).join(","), "2,4,6")
assert_eq(vec3_norm([2, 3, 6]), 7)
norm3 is vec3_normalize([0, 3, 4])
assert_approx(norm3[1], 0.6, 0.000001)
assert_approx(norm3[2], 0.8, 0.000001)
assert_eq(vec3_distance([1, 2, 3], [4, 6, 3]), 5)
assert_eq(vec3_neg(p3).join(","), "-1,-2,-3")
lerp3 is vec3_lerp([0, 0, 0], [10, 20, 30], 0.25)
assert_approx(lerp3[0], 2.5, 0.000001)
assert_approx(lerp3[1], 5, 0.000001)
assert_approx(lerp3[2], 7.5, 0.000001)
mid3 is vec3_midpoint([0, 0, 0], [10, 20, 30])
assert_approx(mid3[0], 5, 0.000001)
assert_approx(mid3[1], 10, 0.000001)
assert_approx(mid3[2], 15, 0.000001)
assert_eq(vec3_project([3, 4, 0], [1, 0, 0]).join(","), "3,0,0")
assert_eq(vec3_reject([3, 4, 0], [1, 0, 0]).join(","), "0,4,0")
assert_eq(vec3_reflect([1, -2, 0], [0, 1, 0]).join(","), "1,2,0")
assert_approx(vec3_angle([1, 0, 0], [0, 1, 0]), 1.5707963267948966, 0.000001)
transform3 is vec3_transform4([1, 2, 3], [1, 0, 0, 10, 0, 1, 0, 20, 0, 0, 1, 30, 0, 0, 0, 1])
assert_eq(transform3.join(","), "11,22,33")
nested_transform3 is vec3_transform4([1, 2, 3], [[1, 0, 0, 10], [0, 1, 0, 20], [0, 0, 1, 30], [0, 0, 0, 1]])
assert_eq(nested_transform3.join(","), "11,22,33")
identity3 is graphics3d.identity()
assert_eq(vec3_transform4([1, 2, 3], identity3).join(","), "1,2,3")
cube3 is graphics3d.cube(2)
assert_eq(cube3.vertices.len(), 8)
assert_eq(cube3.faces.len(), 12)
assert_eq(cube3.edges.len(), 12)
bounds3 is graphics3d.bounds(cube3)
assert_eq(bounds3.min.join(","), "-1,-1,-1")
assert_eq(bounds3.max.join(","), "1,1,1")
assert_eq(bounds3.size.join(","), "2,2,2")
assert_eq(bounds3.center.join(","), "0,0,0")
move3 is mat4_translate(10, 0, 0)
moved_cube3 is mesh_transform4(cube3, move3)
moved_bounds3 is mesh_bounds(moved_cube3)
assert_eq(moved_bounds3.min.join(","), "9,-1,-1")
combo3 is graphics3d.mul(graphics3d.translate(1, 2, 3), graphics3d.scale(2, 2, 2))
assert_eq(vec3_transform4([1, 1, 1], combo3).join(","), "3,4,5")
normals3 is mesh_face_normals(cube3)
assert_eq(normals3.len(), 12)
assert_approx(vec3_norm(normals3[0]), 1, 0.000001)
projected3 is camera_project([0, 0, 0], {position: [0, 0, -5], target: [0, 0, 0], fov_deg: 90}, 800, 600)
assert(projected3.visible)
assert_approx(projected3.x, 400, 0.000001)
assert_approx(projected3.y, 300, 0.000001)
assert_approx(projected3.depth, 5, 0.000001)

payload is {"name": "sura", "count": 3}
schema is {"name": "string", "count": "number"}
assert(schema_validate(payload, schema))

agent_payload is {name: "sura", count: 3, mode: "auto", tags: ["ai", "tool"]}
agent_schema is {"type": "dict", "required": ["name", "count", "mode", "tags"], "properties": {"name": {"type": "string", "min_len": 1, "pattern": "^[a-z]+$"}, "count": {"type": "integer", "min": 1, "max": 5}, "mode": {"enum": ["auto", "manual"]}, "tags": {"type": "array", "min_len": 1, "items": {"type": "string"}}}, "additional": false}
assert(schema_validate(agent_payload, agent_schema))
bad_agent_payload is {name: "", count: 9, mode: "other", tags: ["ai", 7], extra: true}
agent_errors is schema_errors(bad_agent_payload, agent_schema).join("|")
assert(not schema_validate(bad_agent_payload, agent_schema))
assert(contains(agent_errors, "$.name"))
assert(contains(agent_errors, "length is below min_len"))
assert(contains(agent_errors, "$.count"))
assert(contains(agent_errors, "number is above max"))
assert(contains(agent_errors, "$.mode"))
assert(contains(agent_errors, "value is not in enum"))
assert(contains(agent_errors, "$.tags[1]"))
assert(contains(agent_errors, "expected string, got number"))
assert(contains(agent_errors, "$.extra"))
assert(contains(agent_errors, "unexpected field"))
missing_agent_errors is schema_errors({count: 1}, agent_schema).join("|")
assert(contains(missing_agent_errors, "$.name"))
assert(contains(missing_agent_errors, "missing required field"))

csv_rows is csv_parse("name,score\nsura,\"9,9\"", true)
assert_eq(csv_rows[0].name, "sura")
assert_eq(csv_rows[0].score, "9,9")
csv_text is csv_stringify([{name: "sura", score: "9,9"}], ["name", "score"])
assert_contains(csv_text, "\"9,9\"")
assert_eq(csv_parse(csv_text, true)[0].score, "9,9")

jsonl_text is jsonl_stringify([{role: "user", content: "hi"}, {role: "assistant", content: "ok"}])
jsonl_events is jsonl_parse("\n" + jsonl_text + "\n\n")
assert_eq(length(jsonl_events), 2)
assert_eq(jsonl_events[0].role, "user")
assert_eq(jsonl_events[1].content, "ok")
jsonl_trailing is jsonl_stringify([{id: 1}], true)
assert(endsWith(jsonl_trailing, "\n"))
assert_eq(jsonl_parse(jsonl_trailing)[0].id, 1)

nested_json is {choices: [{message: {content: "hello"}}], usage: {tokens: 3}, headers: {"content-type": "application/json"}}
assert_eq(json_path(nested_json, "$.choices[0].message.content"), "hello")
assert_eq(json_path(nested_json, "usage.tokens"), 3)
assert_eq(json_path(nested_json, "$.headers[\"content-type\"]"), "application/json")
assert_eq(json_path(nested_json, "$.missing", "fallback"), "fallback")
assert_eq(type(json_path(nested_json, "$.missing")), "nil")
assert_eq(dict_get_path(nested_json, "choices[0].message.content"), "hello")
assert_eq("{}", "{}")
assert_eq("json {} done", "json {} done")
empty_json_obj is json_parse("{}")
assert_eq(json_stringify(empty_json_obj), "{}")
interp_name is "Sura"
interp_count is 3
assert_eq("hello {interp_name}", "hello Sura")
assert_eq("count {interp_count + 2} {}", "count 5 {}")
prompt_text is template_render("Say [[ choices[0].message.content ]] to [[user.name]]. missing=[[missing]]", {choices: [{message: {content: "hello"}}], user: {name: "Sura"}}, "n/a")
assert_eq(prompt_text, "Say hello to Sura. missing=n/a")
assert_eq(template_render("Cost [[price]] ok=[[ok]]", {price: 3, ok: true}), "Cost 3 ok=true")
pipeline_rows is [{name: "sura", kind: "lang", meta: {score: 10}}, {name: "lua", kind: "lang", meta: {score: 7}}, {name: "agent", kind: "bot", meta: {score: 9}}]
assert_eq(pluck(pipeline_rows, "name").join(","), "sura,lua,agent")
assert_eq(pluck(pipeline_rows, "meta.score").join(","), "10,7,9")
assert_eq(pluck([{name: "sura"}, {}], "name", "missing").join(","), "sura,missing")
kind_counts is count_by(pipeline_rows, "kind")
assert_eq(kind_counts.lang, 2)
assert_eq(kind_counts.bot, 1)
kind_groups is group_by(pipeline_rows, "kind")
assert_eq(length(kind_groups.lang), 2)
assert_eq(kind_groups.bot[0].name, "agent")
sorted_pipeline is sort_by(pipeline_rows, "meta.score", true)
assert_eq(sorted_pipeline[0].name, "sura")
assert_eq(sorted_pipeline[2].name, "lua")

assert_eq(base64_encode("hi"), "aGk=")
assert_eq(base64_decode("aGk="), "hi")
assert_eq(sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
assert_eq(hmac_sha256("key", "The quick brown fox jumps over the lazy dog"), "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")
assert_eq(hex_encode("Sura"), "53757261")
assert_eq(hex_decode("53757261"), "Sura")
assert_eq(url_encode("sura api/?q=a+b&ok=true"), "sura%20api%2F%3Fq%3Da%2Bb%26ok%3Dtrue")
assert_eq(url_decode("sura%20api%2F%3Fq%3Da%2Bb%26ok%3Dtrue"), "sura api/?q=a+b&ok=true")
korean_bytes is url_decode("%ED%95%9C%EA%B8%80")
assert_eq(base64_encode(korean_bytes), "7ZWc6riA")
assert_eq(base64_decode("7ZWc6riA"), korean_bytes)
assert_eq(hex_encode(korean_bytes), "ed959ceab880")
assert_eq(hex_decode("ed959ceab880"), korean_bytes)
assert_eq(url_encode(korean_bytes), "%ED%95%9C%EA%B8%80")
assert_eq(query_build({q: "sura api", page: 2, tags: ["ai", "game"], ok: true}), "ok=true&page=2&q=sura%20api&tags=ai&tags=game")
assert_eq(query_build({empty: nil, korean: korean_bytes}), "empty=&korean=%ED%95%9C%EA%B8%80")
parsed_query is query_parse("?q=sura+api&tags=ai&tags=game&empty=&korean=%ED%95%9C%EA%B8%80#frag")
assert_eq(parsed_query.q, "sura api")
assert_eq(parsed_query.tags.join(","), "ai,game")
assert_eq(parsed_query.empty, "")
assert_eq(parsed_query.korean, korean_bytes)
form_body is form_build({q: "sura api", tags: ["ai", "game"], empty: nil, korean: korean_bytes})
assert_eq(form_body, "empty=&korean=%ED%95%9C%EA%B8%80&q=sura+api&tags=ai&tags=game")
parsed_form is form_parse(form_body + "&tags=tools")
assert_eq(parsed_form.q, "sura api")
assert_eq(parsed_form.korean, korean_bytes)
assert_eq(parsed_form.tags[2], "tools")
cookie_header is cookie_build({session: "abc 123", theme: "dark", korean: korean_bytes})
assert_eq(cookie_header, "korean=%ED%95%9C%EA%B8%80; session=abc%20123; theme=dark")
parsed_cookies is cookie_parse("Cookie: " + cookie_header + "; repeated=one; repeated=two")
assert_eq(parsed_cookies.session, "abc 123")
assert_eq(parsed_cookies.korean, korean_bytes)
assert_eq(parsed_cookies.repeated[1], "two")
assert_eq(cookie_get({"Cookie": cookie_header}, "theme"), "dark")
assert_eq(cookie_get(parsed_cookies, "missing", "fallback"), "fallback")
secret_headers is headers_merge({Authorization: "Bearer secret"}, {"X-Api-Key": "key123", "X-Agent": "sura", "Content-Type": "application/json"})
redacted_headers is headers_redact(secret_headers)
assert_eq(redacted_headers.Authorization, "[REDACTED]")
assert_eq(redacted_headers["X-Api-Key"], "[REDACTED]")
assert_eq(redacted_headers["X-Agent"], "sura")
assert_eq(redacted_headers["Content-Type"], "application/json")
custom_redacted_headers is headers_redact(secret_headers, ["X-Agent"], "***")
assert_eq(custom_redacted_headers.Authorization, "***")
assert_eq(custom_redacted_headers["X-Agent"], "***")
sse_chunk_a is json_stringify({choices: [{delta: {content: "Hel"}}]})
sse_chunk_b is json_stringify({choices: [{delta: {content: "lo "}}]})
sse_chunk_c is json_stringify({choices: [{delta: {content: korean_bytes}}]})
sse_text is "event: message\nid: 7\ndata: " + sse_chunk_a + "\n\n: ignored\nretry: 250\ndata: " + sse_chunk_b + "\n\ndata: " + sse_chunk_c + "\n\ndata: [DONE]\n\n"
sse_events is sse_parse(sse_text)
assert_eq(length(sse_events), 4)
assert_eq(sse_events[0].event, "message")
assert_eq(sse_events[0].id, "7")
assert_eq(sse_events[1].retry, 250)
sse_chunks is sse_data(sse_text, true)
assert_eq(length(sse_chunks), 3)
assert_eq(sse_chunks[0].choices[0].delta.content, "Hel")
assert_eq(sse_data(sse_text)[0], sse_chunk_a)
assert_eq(llm_stream_text(sse_text), "Hello " + korean_bytes)
assert_eq(llm_stream_text(sse_chunks), "Hello " + korean_bytes)
request_id is uuid_v4()
assert_len(request_id, 36)
assert_match(request_id, "^[0-9a-f-]+$")
assert_eq(substring(request_id, 8, 9), "-")
assert_eq(substring(request_id, 13, 15), "-4")
assert_eq(substring(request_id, 18, 19), "-")
assert_match(substring(request_id, 19, 20), "^[89ab]$")
assert_eq(substring(request_id, 23, 24), "-")
assert_len(uuid(), 36)

fs_file is "sura_fs_" + suffix + ".txt"
fs_copy is "sura_fs_" + suffix + "_copy.txt"
fs_moved is "sura_fs_" + suffix + "_moved.txt"
assert_eq(path_basename(path_join("tmp", "data.txt")), "data.txt")
assert_eq(path_dirname(path_join("tmp", "data.txt")), "tmp")
assert_eq(path_ext("archive.tar.gz"), ".gz")
assert_eq(path_stem("archive.tar.gz"), "archive.tar")
assert_eq(path_basename(path_normalize(path_join("tmp", "..", "data.txt"))), "data.txt")
assert(file_is_dir("."))
file_write(fs_file, "hello")
assert_eq(file_size(fs_file), 5)
fs_abs is path_abs(fs_file)
assert_eq(path_basename(fs_abs), fs_file)
assert_eq(path_relative(fs_abs, cwd()), fs_file)
assert(file_is_file(fs_file))
fs_info is file_info(fs_file)
assert(fs_info.exists)
assert(fs_info.is_file)
assert(not fs_info.is_dir)
assert_eq(fs_info.size, 5)
assert_eq(fs_info.name, fs_file)
assert_eq(fs_info.ext, ".txt")
assert_eq(fs_info.stem, path_stem(fs_file))
assert(fs_info.modified > 0)
assert(file_copy(fs_file, fs_copy))
assert_eq(file_read(fs_copy), "hello")
assert(file_move(fs_copy, fs_moved))
assert(file_exists(fs_moved))
assert(not file_exists(fs_copy))
assert(file_delete(fs_file))
assert(file_delete(fs_moved))
walk_dir is "sura_walk_" + suffix
mkdir(path_join(walk_dir, "nested"))
walk_a is path_join(walk_dir, "a.sura")
walk_b is path_join(walk_dir, "nested", "b.sura")
walk_note is path_join(walk_dir, "note.txt")
file_write(walk_a, "a")
file_write(walk_b, "b")
file_write(walk_note, "note")
walk_all is file_walk(walk_dir)
assert_eq(length(walk_all), 3)
walk_sura is file_walk(walk_dir, "sura")
assert_eq(length(walk_sura), 2)
assert_eq(path_basename(walk_sura[0]), "a.sura")
assert_eq(path_basename(walk_sura[1]), "b.sura")
assert(file_remove_tree(walk_dir) >= 5)
assert(not file_exists(walk_dir))
assert_eq(file_remove_tree(walk_dir), 0)

utf8_dir is "sura_한글_" + suffix
utf8_file is path_join(utf8_dir, "파일.txt")
utf8_copy is path_join(utf8_dir, "복사.txt")
utf8_moved is path_join(utf8_dir, "이동.txt")
mkdir(utf8_dir)
file_write(utf8_file, "내용")
file_append(utf8_file, "\n추가")
assert_eq(file_read(utf8_file), "내용\n추가")
assert(file_size(utf8_file) > 0)
assert_contains(file_list(utf8_dir), "파일.txt")
assert_eq(path_basename(file_walk(utf8_dir, ".txt")[0]), "파일.txt")
utf8_info is file_info(utf8_file)
assert_eq(utf8_info.name, "파일.txt")
assert_eq(utf8_info.stem, "파일")
assert(utf8_info.is_file)
assert(file_copy(utf8_file, utf8_copy))
assert(file_move(utf8_copy, utf8_moved))
assert(file_exists(utf8_moved))
assert(file_delete(utf8_file))
assert(file_delete(utf8_moved))
assert(file_delete(utf8_dir))

env_prefix is "SURA_WORLD_" + suffix
env_key is env_prefix + "_KEY"
assert_eq(type(env_get(env_key)), "nil")
assert_eq(env_get(env_key, "missing"), "missing")
assert(env_set(env_key, "secret"))
assert_eq(env_require(env_key), "secret")
env_path is "sura_env_" + suffix + ".env"
env_a is env_prefix + "_A"
env_b is env_prefix + "_B"
env_c is env_prefix + "_C"
env_set(env_a, "old")
file_write(env_path, env_a + "=alpha\n" + env_b + "=\"한글 value\"\nexport " + env_c + "=hello # comment\n")
skipped_env is env_load(env_path)
assert_eq(env_get(env_a), "old")
assert_eq(type(skipped_env[env_a]), "nil")
loaded_env is env_load(env_path, true)
assert_eq(loaded_env[env_a], "alpha")
assert_eq(loaded_env[env_b], "한글 value")
assert_eq(loaded_env[env_c], "hello")
assert_eq(env_get(env_b), "한글 value")
file_delete(env_path)

bearer_headers is auth_bearer("token-123")
assert_eq(bearer_headers["Authorization"], "Bearer token-123")
basic_headers is auth_basic("user", "pass")
assert_eq(basic_headers["Authorization"], "Basic dXNlcjpwYXNz")
merged_headers is headers_merge({Accept: "application/json"}, bearer_headers, {"X-Agent": "sura"})
assert_eq(merged_headers.Accept, "application/json")
assert_eq(merged_headers["Authorization"], "Bearer token-123")
assert_eq(merged_headers["X-Agent"], "sura")

log_path is "sura_world_log_" + suffix + ".jsonl"
assert(log_set_file(log_path, false))
log_info("plain", korean_bytes)
plain_log_lines is file_lines(log_path)
assert_contains(plain_log_lines[0], "[INFO")
assert_contains(plain_log_lines[0], korean_bytes)
assert(log_set_json(true))
log_event("info", "agent step", {request_id: "req-1", status: "ok"})
log_warn("structured warning")
json_log_lines is file_lines(log_path)
event_log is json_parse(json_log_lines[1])
assert_eq(event_log.level, "INFO")
assert_eq(event_log.message, "agent step")
assert_eq(event_log.fields.request_id, "req-1")
warn_log is json_parse(json_log_lines[2])
assert_eq(warn_log.level, "WARN")
assert_eq(warn_log.message, "structured warning")
assert_eq(log_set_level("WARN"), "WARN")
assert_eq(log_get_level(), "WARN")
log_info("hidden info")
log_error("visible error")
filtered_log_lines is file_lines(log_path)
assert_eq(filtered_log_lines.len(), 4)
error_log is json_parse(filtered_log_lines[3])
assert_eq(error_log.level, "ERROR")
assert_eq(error_log.message, "visible error")
assert_eq(log_level("DEBUG"), "DEBUG")
assert_eq(log_set_json(false), false)
assert(log_set_file("", true))
assert(file_delete(log_path))

assert_eq(vec_dot([1,2,3], [4,5,6]), 32)
assert_eq(vec_add([1,2], [3,4]).join(","), "4,6")
assert_eq(vec_scale([2,4], 0.5).join(","), "1,2")
assert(vec_norm([3,4]) == 5)
assert_eq(vector_dot([1,0], [0,1]), 0)
assert_eq(vector_add([1,2], [4,5]).join(","), "5,7")
scaled_vec is vector_scale([3,6], 0.5)
assert_eq(scaled_vec[0], 1.5)
assert_eq(scaled_vec[1], 3)
assert_eq(vector_norm([6,8]), 10)
assert_eq(vector_cosine([1,0], [1,0]), 1)
assert_eq(vector_cosine([0,0], [1,0]), 0)
unit_vec is vector_normalize([3,4])
assert(abs(unit_vec[0] - 0.6) < 0.0001)
assert(abs(unit_vec[1] - 0.8) < 0.0001)
utf_chunks is text_chunks(korean_bytes + "abc", 2)
assert_eq(length(utf_chunks), 3)
assert_eq(utf_chunks[0], korean_bytes)
assert_eq(utf_chunks[1], "ab")

# 병렬/벡터화된 CPU 행렬곱이 단일 스레드 참조와 같은 결과를 내는지 검증한다.
# 커널은 행 축을 워커로 나누므로 (1) 경계에서 값이 어긋나지 않아야 하고,
# (2) 워커 안에서 발견한 비정상값도 예외로 올라와야 하며, (3) 스레드 문턱
# 아래/위 크기 모두 정확해야 한다.

use autograd

# 1) 작은 행렬 정확성 (손계산 대조)
A is autograd.tensor([[1, 2], [3, 4]])
B is autograd.tensor([[5, 6], [7, 8]])
C is autograd.data(autograd.matmul(A, B))
assert_eq(C[0][0], 19)
assert_eq(C[0][1], 22)
assert_eq(C[1][0], 43)
assert_eq(C[1][1], 50)

# 2) 비정사각 행렬
D is autograd.tensor([[1, 2, 3], [4, 5, 6]])
E is autograd.tensor([[1, 0], [0, 1], [1, 1]])
F is autograd.data(autograd.matmul(D, E))
assert_eq(F[0][0], 4)
assert_eq(F[0][1], 5)
assert_eq(F[1][0], 10)
assert_eq(F[1][1], 11)

# 3) 배치(rank 3) 브로드캐스트
G is autograd.tensor([[[1, 0], [0, 1]], [[2, 0], [0, 2]]])
H is autograd.tensor([[[1, 2], [3, 4]]])
I is autograd.data(autograd.matmul(G, H))
assert_eq(I[0][0][0], 1)
assert_eq(I[0][1][1], 4)
assert_eq(I[1][0][0], 2)
assert_eq(I[1][1][1], 8)

# 4) 스레드 문턱을 넘는 큰 행렬도 참조 계산과 일치해야 한다
N is 200
rows is []
r is 0
while r < N do
  row is []
  c is 0
  while c < N do
    row.push(((r * N + c) % 9) * 0.25)
    c is c + 1
  end
  rows.push(row)
  r is r + 1
end
BigA is autograd.tensor(rows)
BigB is autograd.tensor(rows)
Big is autograd.data(autograd.matmul(BigA, BigB))
# 참조: 첫 원소를 Sura 코드로 직접 계산
expect is 0
k is 0
while k < N do
  expect is expect + rows[0][k] * rows[k][0]
  k is k + 1
end
assert_eq(Big[0][0], expect)

# 5) 비정상값(무한대)은 여전히 오류여야 한다
# 지수 리터럴 대신 곱해서 오버플로 직전 값을 만든다
huge is 10
p is 0
while p < 165 do
  huge is huge * 10
  p is p + 1
end
Inf1 is autograd.tensor([[huge, huge], [huge, huge]])
Inf2 is autograd.tensor([[huge, huge], [huge, huge]])
caught is false
try
  bad is autograd.matmul(Inf1, Inf2)
catch e
  caught is true
end
assert(caught)

# 6) 역전파가 여전히 동작
P is autograd.parameter([[1, 2], [3, 4]])
Q is autograd.tensor([[1, 0], [0, 1]])
R is autograd.sum(autograd.matmul(P, Q))
autograd.backward(R)
g is autograd.grad(P)
assert_eq(g[0][0], 1)
assert_eq(g[1][1], 1)

print("72_matmul_parallel: PASS")

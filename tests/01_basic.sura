# 기본 연산 테스트
assert_eq(1 + 1, 2)
assert_eq(10 - 3, 7)
assert_eq(3 * 4, 12)
assert_eq(10 / 2, 5)
assert_eq(10 % 3, 1)

# 문자열
assert_eq("hello" + " " + "world", "hello world")
assert_eq("abc".len(), 3)
assert_eq("Hello".lower(), "hello")
assert_eq("hello".upper(), "HELLO")
assert_eq("  hi  ".trim(), "hi")

# 불리언
assert(true)
assert(not false)
assert_eq(1 < 2, true)
assert_eq(2 > 1, true)
assert_eq(1 == 1, true)
assert_eq(1 != 2, true)

print "01_basic: PASS"

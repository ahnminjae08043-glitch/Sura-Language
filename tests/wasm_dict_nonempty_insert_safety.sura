func add_insert_score(left, right) do
  return left + right
end

score is add_insert_score(9, 7)
key is "points"
profile is {count: 11, label: "skip"}
profile[key] is score

label is "NumDict " + profile[key]
calculated is profile[key] + 4
assert_eq(label, "NumDict 16")
assert_eq(calculated, 20)
assert_eq(length(profile), 3)
print "{label} {calculated} {length(profile)}"

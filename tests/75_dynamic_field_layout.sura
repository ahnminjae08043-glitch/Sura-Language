# 클래스에 선언되지 않은 필드를 나중에 붙일 때, 레이아웃이 넓어지기 전에
# 만들어진 인스턴스도 그 필드를 가져야 한다. 예전에는 첫 인스턴스만 값을
# 유지하고 나머지는 쓰기가 범위를 벗어나 조용히 사라졌다.

class Plain do
end

class WithCtor do
  func init(v) do
    self.v is v
  end
end

# 1) 서로 다른 코드 위치에서 같은 이름의 필드를 두 인스턴스에 추가
a is Plain()
b is Plain()
a.tag is 1
b.tag is 2
assert_eq(a.tag, 1)
assert_eq(b.tag, 2)

# 2) 순서를 뒤집어도 양쪽이 유지된다
c is Plain()
d is Plain()
d.mark is 20
c.mark is 10
assert_eq(c.mark, 10)
assert_eq(d.mark, 20)

# 3) 생성자가 있는 클래스도 같다
p is WithCtor(1)
q is WithCtor(2)
p.extra is 100
q.extra is 200
assert_eq(p.v, 1)
assert_eq(q.v, 2)
assert_eq(p.extra, 100)
assert_eq(q.extra, 200)

# 4) 세 개 이상
r1 is Plain()
r2 is Plain()
r3 is Plain()
r1.t is 1
r2.t is 2
r3.t is 3
assert_eq(r1.t, 1)
assert_eq(r2.t, 2)
assert_eq(r3.t, 3)

# 5) 레이아웃이 넓어진 뒤에 만들어진 인스턴스는 기본값 nil을 가진다
r4 is Plain()
assert(r4.t == nil)
r4.t is 4
assert_eq(r4.t, 4)

# 6) 여러 필드를 서로 다른 인스턴스에 번갈아 추가
s1 is Plain()
s2 is Plain()
s1.f1 is 11
s2.f2 is 22
s1.f2 is 12
s2.f1 is 21
assert_eq(s1.f1, 11)
assert_eq(s1.f2, 12)
assert_eq(s2.f1, 21)
assert_eq(s2.f2, 22)

# 7) JIT가 더워진 뒤에도 유지된다 (같은 코드 위치를 반복 실행)
i is 0
while i < 500 do
  t is Plain()
  t.loop_field is i
  assert_eq(t.loop_field, i)
  i is i + 1
end

# 8) 딕트는 영향을 받지 않는다
d1 is {a: 1}
d2 is {a: 2}
d1.extra is 10
d2.extra is 20
assert_eq(d1.extra, 10)
assert_eq(d2.extra, 20)

print("75_dynamic_field_layout: PASS")

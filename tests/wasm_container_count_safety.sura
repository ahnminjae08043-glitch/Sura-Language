positive is array_range(2, 10, 3)
negative is array_range(10, 2, -3)
empty_positive is array_range(5, 2, 1)
empty_negative is array_range(2, 5, -1)
repeated_values is array_repeat(7, 3)
repeated_text is string_repeat("ab", 3)

assert_eq(length(positive), 3)
assert_eq(positive[0], 2)
assert_eq(positive[1], 5)
assert_eq(positive[2], 8)
assert_eq(length(negative), 3)
assert_eq(negative[0], 10)
assert_eq(negative[1], 7)
assert_eq(negative[2], 4)
assert_eq(length(empty_positive), 0)
assert_eq(length(empty_negative), 0)
assert_eq(length(repeated_values), 3)
assert_eq(repeated_values[0], 7)
assert_eq(repeated_values[2], 7)
assert_eq(repeated_text, "ababab")

print repeated_text

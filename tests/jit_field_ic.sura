# 인스턴스 필드 인라인 캐시: 네이티브 코드는 명령의 IC(클래스·필드 번호)를 실행 시점에
# 읽어 필드를 바로 접근한다. 단형 사이트, 다형 사이트(클래스마다 필드 위치가 다름),
# 클래스가 나중에 필드를 얻어 오래된 인스턴스가 짧은 경우, 딕셔너리 수신자,
# 생성자 없는 클래스가 모두 인터프리터와 같은 결과여야 한다.

class Point do
  func init(x, y) do
    self.x is x
    self.y is y
  end
end

class Wide do
  func init(a, b, x) do
    self.a is a
    self.b is b
    self.x is x
  end
end

class Bare do
end

func sum_fields(n) do
  p is Point(1, 2)
  total is 0
  i is 0
  while i < n do
    p.x is p.x + i
    p.y is p.y + 1
    total is total + p.x + p.y
    i is i + 1
  end
  return total
end

func getx(o) do
  return o.x
end

func setx(o, v) do
  o.x is v
end

func poly(n) do
  p is Point(10, 20)
  w is Wide(1, 2, 30)
  acc is 0
  i is 0
  while i < n do
    acc is acc + getx(p) + getx(w)
    i is i + 1
  end
  return acc
end

func widen(n) do
  old is Point(1, 2)
  fresh is Point(3, 4)
  fresh.z is 5
  seen_nil is 0
  i is 0
  while i < n do
    if old.z == nil then
      seen_nil is seen_nil + 1
    end
    i is i + 1
  end
  old.z is 7
  return [seen_nil, old.z, fresh.z]
end

func mixed(n) do
  d is {}
  d["x"] is 3
  p is Point(4, 5)
  acc is 0
  i is 0
  while i < n do
    acc is acc + getx(d) + getx(p)
    setx(p, i)
    setx(d, i + 1)
    i is i + 1
  end
  return [acc, p.x, d["x"]]
end

func bare(n) do
  b is Bare()
  b.x is 0
  i is 0
  while i < n do
    b.x is b.x + 2
    i is i + 1
  end
  return b.x
end

func many(n) do
  arr is []
  i is 0
  while i < n do
    arr.push(Point(i, i * 2))
    i is i + 1
  end
  total is 0
  j is 0
  while j < n do
    q is arr[j]
    total is total + q.x + q.y
    j is j + 1
  end
  return total
end

r is 0
while r < 30 do
  a is sum_fields(50)
  b is poly(50)
  c is widen(50)
  d is mixed(50)
  e is bare(50)
  f is many(50)
  r is r + 1
end

# sum_fields(200): x는 1 + 0+1+...+(i), y는 2 + (i+1)
assert_eq(sum_fields(3), (1 + 3) + (2 + 4) + (4 + 5))
assert_eq(poly(1000), 1000 * 40)
w is widen(200)
assert_eq(w[0], 200)
assert_eq(w[1], 7)
assert_eq(w[2], 5)
m is mixed(100)
assert_eq(m[0], 7 + 9801)
assert_eq(m[1], 99)
assert_eq(m[2], 100)
assert_eq(bare(500), 1000)
assert_eq(many(300), 3 * 300 * 299 / 2)

print "jit_field_ic: PASS"

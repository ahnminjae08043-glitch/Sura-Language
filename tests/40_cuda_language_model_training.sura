use autograd

info is autograd.cuda_info()
if info.available then
  tokens is [[0, 1, 2, 3]]
  targets is [[1, 2, 3, 0]]

  embedding is autograd.parameter([[0.5, 0, 0, 0], [0, 0.5, 0, 0], [0, 0, 0.5, 0], [0, 0, 0, 0.5]], {device: "cuda"})
  norm_weight is autograd.parameter([1, 1, 1, 1], {device: "cuda"})
  norm_bias is autograd.parameter([0, 0, 0, 0], {device: "cuda"})
  hidden_weight is autograd.parameter([[0.2, -0.1, 0.1, 0, 0.05, -0.05, 0.08, -0.02], [-0.1, 0.2, 0, 0.1, -0.05, 0.05, -0.02, 0.08], [0.1, 0, 0.2, -0.1, 0.08, -0.02, 0.05, -0.05], [0, 0.1, -0.1, 0.2, -0.02, 0.08, -0.05, 0.05]], {device: "cuda"})
  hidden_bias is autograd.parameter([0, 0, 0, 0, 0, 0, 0, 0], {device: "cuda"})
  head_weight is autograd.parameter([[0.1, -0.1, 0.05, -0.05], [-0.05, 0.1, -0.1, 0.05], [0.08, -0.02, 0.04, -0.1], [-0.1, 0.04, -0.02, 0.08], [0.05, 0.02, -0.08, 0.01], [-0.02, 0.05, 0.01, -0.08], [0.03, -0.07, 0.09, -0.01], [-0.07, 0.03, -0.01, 0.09]], {device: "cuda"})
  head_bias is autograd.parameter([0, 0, 0, 0], {device: "cuda"})
  parameters is [embedding, norm_weight, norm_bias, hidden_weight, hidden_bias, head_weight, head_bias]

  func model(input_ids) do
    hidden is autograd.embedding(input_ids, embedding)
    hidden is autograd.layer_norm(hidden, norm_weight, norm_bias)
    hidden is autograd.gelu(autograd.linear(hidden, hidden_weight, hidden_bias))
    return autograd.linear(hidden, head_weight, head_bias)
  end

  initial_tensor is autograd.cross_entropy_ids(model(tokens), targets)
  initial_loss is autograd.item(initial_tensor)
  autograd.backward(initial_tensor)
  autograd.zero_grad(parameters)

  # One isolated training step proves the full resident graph and its explicit
  # boundaries: two four-ID uploads and one transactional SGD status read.
  autograd.cuda_reset_stats()
  measured_loss is autograd.cross_entropy_ids(model(tokens), targets)
  autograd.backward(measured_loss)
  autograd.sgd(parameters, 0.1)
  measured is autograd.cuda_stats()
  assert_eq(measured.h2d_bytes, 32)
  assert_eq(measured.d2h_bytes, 4)
  assert_eq(measured.embedding_launches, 2)
  assert_eq(measured.layer_norm_launches, 3)
  assert_eq(measured.gelu_launches, 2)
  assert_eq(measured.cross_entropy_launches, 3)
  assert_eq(measured.matmul_launches, 6)
  assert_eq(measured.cublas_matmul_launches + measured.reference_matmul_launches, 6)

  step is 1
  while step < 200 do
    autograd.zero_grad(parameters)
    loss is autograd.cross_entropy_ids(model(tokens), targets)
    autograd.backward(loss)
    autograd.sgd(parameters, 0.1)
    step is step + 1
  end

  final_loss is autograd.item(autograd.cross_entropy_ids(model(tokens), targets))
  assert(final_loss < initial_loss)
  assert(final_loss < 0.5)
else
  print "40_cuda_language_model_training: SKIP ({info.error})"
end

print "40_cuda_language_model_training: PASS"

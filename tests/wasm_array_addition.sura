func dynamic_array_add(left, right) do
  return left + right
end

func append_dynamic_array(left, right) do
  return left + right
end

func prepend_dynamic_array(left, right) do
  return left + right
end

func choose_array_or_bool(flag, value) do
  if flag then
    return value
  end
  return false
end

numbers is [1, 2] + [3, 4]
labels is ["su"] + ["ra"]

assert_eq(length(numbers), 4)
assert_eq(numbers[0], 1)
assert_eq(numbers[3], 4)
assert_eq(length(labels), 2)
assert_eq(labels[0], "su")
assert_eq(labels[1], "ra")

dynamic_numbers is dynamic_array_add([5, 6], [7])
dynamic_labels is dynamic_array_add(["wasm"], ["value"])
invalid_add is dynamic_array_add(false, 1)
mixed_right_numbers is append_dynamic_array([8, 9], [10])
mixed_right_invalid is append_dynamic_array([8, 9], false)
mixed_left_numbers is prepend_dynamic_array([11], [12, 13])
mixed_left_invalid is prepend_dynamic_array(false, [12, 13])
raw_metadata_numbers is [14, 15]
runtime_selected_numbers is choose_array_or_bool(true, raw_metadata_numbers)
runtime_selected_false is choose_array_or_bool(false, false)
metadata_preserved_numbers is dynamic_array_add(runtime_selected_numbers, [16])
metadata_preserved_invalid is dynamic_array_add(runtime_selected_false, [16])
runtime_selected_slice is choose_array_or_bool(true, [17, 18, 19].slice(0, 2))
slice_metadata_preserved is dynamic_array_add(runtime_selected_slice, [20])
runtime_selected_deep_slice is choose_array_or_bool(true, [21, 22].slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2).slice(0, 2))
deep_slice_metadata_preserved is dynamic_array_add(runtime_selected_deep_slice, [23])

assert_eq(length(dynamic_numbers), 3)
assert_eq(dynamic_numbers[2], 7)
assert_eq(length(dynamic_labels), 2)
assert_eq(dynamic_labels[1], "value")
assert_eq(type(invalid_add), "nil")
assert_eq(to_str(mixed_right_numbers), "[8, 9, 10]")
assert_eq(type(mixed_right_invalid), "nil")
assert_eq(to_str(mixed_left_numbers), "[11, 12, 13]")
assert_eq(type(mixed_left_invalid), "nil")
assert_eq(to_str(metadata_preserved_numbers), "[14, 15, 16]")
assert_eq(type(metadata_preserved_invalid), "nil")
assert_eq(to_str(slice_metadata_preserved), "[17, 18, 20]")
assert_eq(to_str(deep_slice_metadata_preserved), "[21, 22, 23]")

result is to_str(numbers) + "|" + to_str(labels)
result is result + "|" + to_str(dynamic_numbers)
result is result + "|" + to_str(dynamic_labels)
result is result + "|" + type(invalid_add)
result is result + "|" + to_str(mixed_right_numbers)
result is result + "|" + type(mixed_right_invalid)
result is result + "|" + to_str(mixed_left_numbers)
result is result + "|" + type(mixed_left_invalid)
result is result + "|" + to_str(metadata_preserved_numbers)
result is result + "|" + type(metadata_preserved_invalid)
result is result + "|" + to_str(slice_metadata_preserved)
result is result + "|" + to_str(deep_slice_metadata_preserved)
assert_eq(result, "[1, 2, 3, 4]|[\"su\", \"ra\"]|[5, 6, 7]|[\"wasm\", \"value\"]|nil|[8, 9, 10]|nil|[11, 12, 13]|nil|[14, 15, 16]|nil|[17, 18, 20]|[21, 22, 23]")
print_no_nl(result)

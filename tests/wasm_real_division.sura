func ratio(left, right) do
  return left / right
end

func half(value) do
  return value / 2
end

func nested_ratio() do
  return 1 + 3 / 2
end

direct_ratio is 3 / 2
function_ratio is ratio(7, 2)
parameter_ratio is half(5)
nested_value is nested_ratio()
boundary_ratio is (-2147483647 - 1) / -1

assert_eq(direct_ratio, 1.5)
assert_eq(function_ratio, 3.5)
assert_eq(parameter_ratio, 2.5)
assert_eq(nested_value, 2.5)
assert_eq(boundary_ratio, 2147483648)
assert_eq(6 / 3, 2)
assert_eq((9 / 2) * 2, 9)
assert_eq(type(direct_ratio), "number")
assert(3 / 2 > 1)
assert_eq(to_str(direct_ratio), "1.5")
assert_eq("ratio={function_ratio}", "ratio=3.5")

in_place is 9
in_place /= 2
assert_eq(in_place, 4.5)

chained_in_place is 30
chained_in_place -= 4
chained_in_place *= 3
chained_in_place /= 2
chained_in_place %= 10
assert_eq(chained_in_place, 9)

ratios is [3 / 2, ratio(5, 2)]
profile is {half: 1 / 2, third: ratio(1, 3)}
assert_eq(to_str(ratios), "[1.5, 2.5]")
assert_eq(to_str(profile.half), "0.5")
assert_eq(to_str(profile.third), "0.3333333333333333")

print_no_nl("real division ok")

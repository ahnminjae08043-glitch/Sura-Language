# 수학 함수
assert_eq(abs(-5), 5)
assert_eq(floor(3.9), 3)
assert_eq(ceil(3.1), 4)
assert_eq(round(3.5), 4)
assert_eq(pow(2, 8), 256)
assert_eq(max(3, 7), 7)
assert_eq(min(3, 7), 3)
assert_eq(sqrt(9), 3)

# use math 모듈
use math
assert_eq(math.sqrt(16), 4)
assert_eq(math.pow(2, 10), 1024)
assert_eq(math.floor(2.9), 2)
assert(math.pi > 3.14)
assert(math.pi < 3.15)

print "06_math: PASS"

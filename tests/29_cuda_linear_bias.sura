use autograd

info is autograd.cuda_info()
if info.available then
  input is autograd.parameter([[1, 2, 3], [4, 5, 6]], {device: "cuda"})
  weight is autograd.parameter([[1, 2], [3, 4], [5, 6]], {device: "cuda"})
  bias is autograd.parameter([10, 20], {device: "cuda"})

  autograd.cuda_reset_stats()
  output is autograd.linear(input, weight, bias)
  loss is autograd.sum(output)
  autograd.backward(loss)

  before_read is autograd.cuda_stats()
  assert_eq(before_read.h2d_bytes, 0)
  assert_eq(before_read.d2h_bytes, 0)
  assert(before_read.reduction_launches >= 2)

  assert_eq(json_stringify(autograd.grad(bias)), "[2,2]")
  assert_eq(json_stringify(autograd.grad(input)), "[[3,7,11],[3,7,11]]")
  assert_eq(json_stringify(autograd.grad(weight)), "[[5,5],[7,7],[9,9]]")

  after_read is autograd.cuda_stats()
  assert_eq(after_read.d2h_bytes, 56)

  seeded_input is autograd.parameter([[1, 2], [3, 4]], {device: "cuda"})
  seeded_bias is autograd.parameter([10, 20], {device: "cuda"})
  seeded_output is autograd.add(seeded_input, seeded_bias)
  assert_eq(json_stringify(autograd.data(seeded_output)), "[[11,22],[13,24]]")
  autograd.backward(seeded_output, [[1, 2], [3, 4]])
  assert_eq(json_stringify(autograd.grad(seeded_input)), "[[1,2],[3,4]]")
  assert_eq(json_stringify(autograd.grad(seeded_bias)), "[4,6]")
else
  print "29_cuda_linear_bias: SKIP ({info.error})"
end

print "29_cuda_linear_bias: PASS"

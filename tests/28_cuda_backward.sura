use autograd

info is autograd.cuda_info()
if info.available then
  left is autograd.parameter([[1, 2, 3], [4, 5, 6]], {device: "cuda"})
  right is autograd.parameter([[1, 2], [3, 4], [5, 6]], {device: "cuda"})

  loss is autograd.sum(autograd.relu(autograd.matmul(left, right)))
  autograd.cuda_reset_stats()
  autograd.backward(loss)

  after_backward is autograd.cuda_stats()
  assert_eq(after_backward.h2d_bytes, 0)
  assert_eq(after_backward.d2h_bytes, 0)
  assert(after_backward.matmul_launches >= 2)
  assert(after_backward.relu_launches >= 1)

  left_grad is autograd.grad(left)
  right_grad is autograd.grad(right)
  assert_eq(json_stringify(left_grad), "[[3,7,11],[3,7,11]]")
  assert_eq(json_stringify(right_grad), "[[5,5],[7,7],[9,9]]")
  after_grad_read is autograd.cuda_stats()
  assert_eq(after_grad_read.d2h_bytes, 48)

  autograd.cuda_reset_stats()
  autograd.sgd([left, right], 0.1)
  after_step is autograd.cuda_stats()
  assert_eq(after_step.h2d_bytes, 0)
  # Transactional CUDA SGD validates one shared u32 status word before the
  # all-parameter commit, without copying parameter/gradient payloads.
  assert_eq(after_step.d2h_bytes, 4)
  left_data is autograd.data(left)
  assert_approx(left_data[0][0], 0.7, 0.0001)
  assert_approx(left_data[0][1], 1.3, 0.0001)
  assert_approx(left_data[0][2], 1.9, 0.0001)

  overflow_seed_parameter is autograd.parameter([1], {device: "cuda"})
  overflow_seed is autograd.tensor([pow(10, 50)])
  overflow_seed_rejected is false
  try
    autograd.backward(overflow_seed_parameter, overflow_seed)
  catch error
    overflow_seed_rejected is true
  end
  assert(overflow_seed_rejected)
  assert_eq(autograd.grad(overflow_seed_parameter), nil)
else
  print "28_cuda_backward: SKIP ({info.error})"
end

print "28_cuda_backward: PASS"

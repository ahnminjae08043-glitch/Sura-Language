# 크기가 변하지 않는 루프에서 배열의 data 포인터를 GPR에, 끝 포인터를 프레임 슬롯에 두는
# direct hoist: 바깥 루프에서 push로 커지는 배열, 빈 배열, 범위 밖 인덱스, 두 이름이 같은
# 배열을 가리키는 경우 모두 인터프리터와 같아야 한다.

func grow_between(n) do
  a is []
  total is 0
  r is 0
  while r < n do
    a.push(r * 3)
    len is a.len()
    i is 0
    while i < len do
      total is total + a[i]
      a[i] is a[i] + 1
      i is i + 1
    end
    r is r + 1
  end
  return total
end

func alias_write(n) do
  a is [1, 2, 3, 4]
  b is a
  total is 0
  i is 0
  while i < n do
    j is i % 4
    b[j] is a[j] * 2
    total is total + a[j]
    i is i + 1
  end
  return total
end

func out_of_range(a, n) do
  total is 0
  i is 0
  while i < n do
    total is total + a[i]
    i is i + 1
  end
  return total
end

r is 0
while r < 40 do
  x is grow_between(6)
  z is alias_write(20)
  w is out_of_range([1, 2, 3], 3)
  r is r + 1
end

# grow_between: r번째 바깥 반복에서 원소 k(0..r)는 (3k + 앞선 증가 횟수)…: 인터프리터 결과와 비교
assert_eq(grow_between(30), 17980)
assert_eq(alias_write(100), 671088620)
assert_eq(out_of_range([1, 2, 3], 3), 6)
caught is ""
try
  q is out_of_range([1, 2, 3], 5)
catch err
  caught is err
end
print("range: {caught}")
caught2 is ""
try
  q is out_of_range([], 1)
catch err
  caught2 is err
end
print("empty: {caught2}")
print "jit_direct_hoist: PASS"

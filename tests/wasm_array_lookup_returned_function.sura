func lookup_add_pair(left, right) do
  return left + right
end

func lookup_mul_pair(left, right) do
  return left * right
end

func lookup_return_add_pair(value) do
  return lookup_add_pair
end

func lookup_return_mul_pair(value) do
  return lookup_mul_pair
end

func choose_lookup_returned_function(flag, value) do
  handlers is [lookup_return_add_pair, lookup_return_mul_pair]
  index is flag ? 0 : 1
  handler is handlers[index]
  return handler(value)
end

class LookupReturnedFunctionHolder do
  func choose(flag, value) do
    handlers is [lookup_return_add_pair, lookup_return_mul_pair]
    index is flag ? 0 : 1
    handler is handlers[index]
    return handler(value)
  end
end

array_lookup_returned_function is choose_lookup_returned_function(false, 0)
lookup_returned_function_holder is new LookupReturnedFunctionHolder()
method_lookup_returned_function is lookup_returned_function_holder.choose(false, 0)

assert_eq(array_lookup_returned_function(3, 4), 12)
assert_eq(type(array_lookup_returned_function), "function")
assert(to_bool(array_lookup_returned_function))
assert_eq(method_lookup_returned_function(3, 4), 12)
assert_eq(type(method_lookup_returned_function), "function")
assert(to_bool(method_lookup_returned_function))

print_no_nl("array lookup returned function ok")

func add_decimal(left, right) do
  return left + right
end

local_decimal is 1.5
negative_decimal is -2.5
sum_decimal is add_decimal(1.5, 0.25)
decimal_array is [1.25, sum_decimal, -3.5]
decimal_dict is {first: 4.5, second: sum_decimal}

assert_eq(to_str(local_decimal), "1.5")
assert_eq(to_str(negative_decimal), "-2.5")
assert_eq(to_str(sum_decimal), "1.75")
assert_eq(to_str(0.125), "0.125")
assert_eq(to_str(1000.25), "1000.25")
assert_eq(to_str(0.0001), "0.0001")
assert_eq(to_str(0.00001), "1e-05")
assert_eq("decimal={sum_decimal}", "decimal=1.75")
assert_eq(to_str(decimal_array), "[1.25, 1.75, -3.5]")
assert_eq(to_str(decimal_dict.first), "4.5")
assert_eq(to_str(decimal_dict.second), "1.75")

print_no_nl("decimal stringification ok")

# 인덕션 포인터: 배열 접근의 인덱스가 루프 안에서 1씩(또는 정수 step) 늘기만 하면
# 컨테이너 레지스터가 원소 포인터를 들고 반복마다 step*8을 더한다. 시작값이 0이 아니거나
# 음수이거나 정수가 아니거나, 범위를 벗어나거나, 조건부로만 증가하거나, 중간에 배열이
# 바뀌어도 인터프리터와 같아야 한다. Sura는 음수 인덱스를 뒤에서부터 센다.

func sum_from(arr, start, n) do
  total is 0
  i is start
  while i < n do
    total is total + arr[i]
    i is i + 1
  end
  return total
end

func negative_start(arr, n) do
  total is 0
  i is 0 - 2
  count is 0
  while count < n do
    total is total + arr[i]
    i is i + 1
    count is count + 1
  end
  return total
end

func fractional_key(arr, n) do
  total is 0
  i is 0.5
  count is 0
  while count < n do
    total is total + arr[i]
    i is i + 1
    count is count + 1
  end
  return total
end

func step_two(arr, n) do
  total is 0
  i is 0
  while i < n do
    total is total + arr[i]
    i is i + 2
  end
  return total
end

func conditional_bump(arr, n) do
  total is 0
  i is 0
  c is 0
  while c < n do
    total is total + arr[i]
    if c % 2 == 0 then
      i is i + 1
    end
    c is c + 1
  end
  return total
end

func two_arrays(a, b, n) do
  total is 0
  i is 0
  while i < n do
    total is total + a[i] * 10 + b[i]
    i is i + 1
  end
  return total
end

func write_and_read(a, n) do
  i is 0
  while i < n do
    a[i] is a[i] + 1
    i is i + 1
  end
  total is 0
  j is 0
  while j < n do
    total is total + a[j]
    j is j + 1
  end
  return total
end

func break_out(arr, n) do
  total is 0
  i is 0
  while i < n do
    if arr[i] > 2 then
      break
    end
    total is total + arr[i]
    i is i + 1
  end
  return total * 100 + i
end

func nested_keys(a, b, n) do
  total is 0
  i is 0
  while i < n do
    j is 0
    while j < n do
      total is total + a[j] + b[i]
      j is j + 1
    end
    i is i + 1
  end
  return total
end

func zero_trips(arr) do
  total is 0
  i is 0
  while i < 0 do
    total is total + arr[i]
    i is i + 1
  end
  return total + 1
end

func out_of_range(arr, n) do
  total is 0
  i is 0
  while i < n do
    total is total + arr[i]
    i is i + 1
  end
  return total
end

base is [10, 20, 30, 40, 50, 60, 70, 80]
r is 0
while r < 60 do
  x1 is sum_from(base, 0, 8)
  x2 is negative_start(base, 4)
  x3 is fractional_key(base, 4)
  x4 is step_two(base, 8)
  x5 is conditional_bump(base, 6)
  x6 is two_arrays(base, base, 8)
  x7 is write_and_read([1, 2, 3, 4], 4)
  x8 is break_out([1, 2, 3, 4], 4)
  x9 is nested_keys(base, base, 4)
  x10 is zero_trips(base)
  r is r + 1
end

assert_eq(sum_from(base, 0, 8), 360)
assert_eq(sum_from(base, 3, 8), 40 + 50 + 60 + 70 + 80)
assert_eq(negative_start(base, 4), 70 + 80 + 10 + 20)
assert_eq(fractional_key(base, 4), 10 + 20 + 30 + 40)
assert_eq(step_two(base, 8), 10 + 30 + 50 + 70)
assert_eq(conditional_bump(base, 6), 10 + 20 + 20 + 30 + 30 + 40)
assert_eq(two_arrays(base, base, 8), 360 * 11)
assert_eq(write_and_read([1, 2, 3, 4], 4), 1 + 2 + 3 + 4 + 4)
assert_eq(break_out([1, 2, 3, 4], 4), (1 + 2) * 100 + 2)
assert_eq(nested_keys(base, base, 4), 4 * (10 + 20 + 30 + 40) + 4 * (10 + 20 + 30 + 40))
assert_eq(zero_trips(base), 1)

caught is ""
try
  z is out_of_range(base, 12)
catch err
  caught is err
end
print("range={caught}")
print "jit_induction: PASS"

use autograd

func approx_rank1(actual, expected, epsilon) do
  assert_eq(actual.len(), expected.len())
  i is 0
  while i < actual.len() do
    assert_approx(actual[i], expected[i], epsilon)
    i is i + 1
  end
end

func approx_rank2(actual, expected, epsilon) do
  assert_eq(actual.len(), expected.len())
  i is 0
  while i < actual.len() do
    approx_rank1(actual[i], expected[i], epsilon)
    i is i + 1
  end
end

func approx_rank3(actual, expected, epsilon) do
  assert_eq(actual.len(), expected.len())
  i is 0
  while i < actual.len() do
    approx_rank2(actual[i], expected[i], epsilon)
    i is i + 1
  end
end

func approx_rank4(actual, expected, epsilon) do
  assert_eq(actual.len(), expected.len())
  i is 0
  while i < actual.len() do
    approx_rank3(actual[i], expected[i], epsilon)
    i is i + 1
  end
end

func assert_scaled_rank4(actual, base, scale, epsilon) do
  batch is 0
  while batch < actual.len() do
    head is 0
    while head < actual[batch].len() do
      row is 0
      while row < actual[batch][head].len() do
        col is 0
        while col < actual[batch][head][row].len() do
          assert_approx(actual[batch][head][row][col], scale * base[batch][head][row][col], epsilon)
          col is col + 1
        end
        row is row + 1
      end
      head is head + 1
    end
    batch is batch + 1
  end
end

func assert_attention_dispatch(stats, legacy_total, legacy_parallel, fused_total, fused_launches) do
  assert_eq(stats.reference_attention_launches, 0)
  assert_eq(stats.warp_attention_launches, 1)
  if stats.fused_attention_launches > 0 then
    assert_eq(stats.attention_launches, fused_total)
    assert_eq(stats.parallel_attention_launches, 0)
    assert_eq(stats.fused_attention_launches, fused_launches)
  else
    assert_eq(stats.attention_launches, legacy_total)
    assert_eq(stats.parallel_attention_launches, legacy_parallel)
  end
  assert_eq(stats.attention_launches, stats.reference_attention_launches + stats.warp_attention_launches + stats.parallel_attention_launches + stats.fused_attention_launches)
end

func make_q_values() do
  batch is []
  heads is []
  head is 0
  while head < 2 do
    rows is []
    token is 0
    while token < 16 do
      rows.push([(token % 5 - 2) * 0.2, ((token * 2 + head) % 7 - 3) * 0.1, (head + 1) * 0.25, (token % 3) * 0.15 - 0.1])
      token is token + 1
    end
    heads.push(rows)
    head is head + 1
  end
  batch.push(heads)
  return batch
end

func make_k_values() do
  batch is []
  heads is []
  head is 0
  while head < 2 do
    rows is []
    token is 0
    while token < 16 do
      rows.push([((token + 2 * head) % 6 - 2) * 0.17, (token % 4 - 1) * 0.13, (token + 1) * 0.025, (head - 0.5) * 0.2])
      token is token + 1
    end
    heads.push(rows)
    head is head + 1
  end
  batch.push(heads)
  return batch
end

func make_v_values() do
  batch is []
  heads is []
  head is 0
  while head < 2 do
    rows is []
    token is 0
    while token < 16 do
      rows.push([token * 0.05 + head, (15 - token) * 0.03 - head * 0.2, (token + head) % 4 - 1.5])
      token is token + 1
    end
    heads.push(rows)
    head is head + 1
  end
  batch.push(heads)
  return batch
end

func make_seed_values() do
  batch is []
  heads is []
  head is 0
  while head < 2 do
    rows is []
    token is 0
    while token < 16 do
      rows.push([(token + head) % 3 - 1, (token % 5) * 0.2 - 0.4, (head + 1) * 0.1])
      token is token + 1
    end
    heads.push(rows)
    head is head + 1
  end
  batch.push(heads)
  return batch
end

info is autograd.cuda_info()
if info.available then
  assert_eq(autograd.limits().cuda_attention_parallel_min_sequence, 8)
  q_values is make_q_values()
  k_values is make_k_values()
  v_values is make_v_values()
  seed_values is make_seed_values()

  # CPU float32 is the reference for a full rank-4 [B=1,H=2,T=16,D=4]
  # attention problem with value dimension 3 and all roles differentiable.
  cpu_q is autograd.parameter(q_values, {dtype: "float32"})
  cpu_k is autograd.parameter(k_values, {dtype: "float32"})
  cpu_v is autograd.parameter(v_values, {dtype: "float32"})
  cpu_output is autograd.causal_attention(cpu_q, cpu_k, cpu_v)
  assert_eq(autograd.shape(cpu_output).join(","), "1,2,16,3")
  cpu_output_data is autograd.data(cpu_output)
  autograd.backward(cpu_output, seed_values)
  cpu_q_grad is autograd.grad(cpu_q)
  cpu_k_grad is autograd.grad(cpu_k)
  cpu_v_grad is autograd.grad(cpu_v)

  # The default T>=8 contract is one fast warp forward plus two fused
  # recomputation-backward launches. With SURA_CUDA_ATTENTION_FUSED=0, the
  # legacy fallback is one warp forward plus five packed-backward launches.
  # All workspace must be released before backward returns, leaving only the
  # output and three persistent leaf gradients resident.
  gpu_q is autograd.parameter(q_values, {device: "cuda"})
  gpu_k is autograd.parameter(k_values, {device: "cuda"})
  gpu_v is autograd.parameter(v_values, {device: "cuda"})
  gpu_seed is autograd.tensor(seed_values, {device: "cuda"})
  host_baseline is autograd.limits().memory_used_bytes
  autograd.cuda_reset_stats()
  stats_before is autograd.cuda_stats()
  allocated_before is stats_before.allocated_bytes

  gpu_output is autograd.causal_attention(gpu_q, gpu_k, gpu_v)
  assert_eq(autograd.device(gpu_output), "cuda:{info.device_index}")
  assert_eq(autograd.shape(gpu_output).join(","), "1,2,16,3")
  assert_eq(autograd.storage_bytes(gpu_output), 384)
  autograd.backward(gpu_output, gpu_seed)

  stats_after_graph is autograd.cuda_stats()
  expected_resident_delta is autograd.storage_bytes(gpu_output) + autograd.storage_bytes(gpu_q) + autograd.storage_bytes(gpu_k) + autograd.storage_bytes(gpu_v)
  assert_attention_dispatch(stats_after_graph, 6, 5, 3, 2)
  assert_eq(stats_after_graph.h2d_bytes, 0)
  assert_eq(stats_after_graph.d2h_bytes, 0)
  assert_eq(stats_after_graph.allocated_bytes - allocated_before, expected_resident_delta)
  if stats_after_graph.fused_attention_launches > 0 then
    # B=1,H=2,T=16 keeps only max+inv_sum (256 bytes). The other
    # expected_resident_delta is the transactional upstream/contribution set;
    # there is no packed T*T probability workspace.
    assert_eq(stats_after_graph.peak_allocated_bytes - allocated_before, expected_resident_delta * 2 + 256)
  else
    assert(stats_after_graph.peak_allocated_bytes > stats_after_graph.allocated_bytes)
  end
  assert(stats_after_graph.free_calls > 0)
  assert_eq(autograd.limits().memory_used_bytes, host_baseline)

  gpu_output_data is autograd.data(gpu_output)
  gpu_q_grad is autograd.grad(gpu_q)
  gpu_k_grad is autograd.grad(gpu_k)
  gpu_v_grad is autograd.grad(gpu_v)
  approx_rank4(gpu_output_data, cpu_output_data, 0.002)
  approx_rank4(gpu_q_grad, cpu_q_grad, 0.005)
  approx_rank4(gpu_k_grad, cpu_k_grad, 0.005)
  approx_rank4(gpu_v_grad, cpu_v_grad, 0.005)
  assert_eq(autograd.limits().memory_used_bytes, host_baseline + 384)
  stats_after_observation is autograd.cuda_stats()
  assert_eq(stats_after_observation.h2d_bytes, 0)
  assert_eq(stats_after_observation.d2h_bytes, expected_resident_delta)

  # A fresh identical run must produce bit-for-bit identical public f32
  # output and gradients despite parallel reduction scheduling.
  repeat_q is autograd.parameter(q_values, {device: "cuda"})
  repeat_k is autograd.parameter(k_values, {device: "cuda"})
  repeat_v is autograd.parameter(v_values, {device: "cuda"})
  repeat_seed is autograd.tensor(seed_values, {device: "cuda"})
  repeat_output is autograd.causal_attention(repeat_q, repeat_k, repeat_v)
  autograd.backward(repeat_output, repeat_seed)
  repeat_output_data is autograd.data(repeat_output)
  repeat_q_grad is autograd.grad(repeat_q)
  repeat_k_grad is autograd.grad(repeat_k)
  repeat_v_grad is autograd.grad(repeat_v)
  assert_eq(json_stringify(repeat_output_data), json_stringify(gpu_output_data))
  assert_eq(json_stringify(repeat_q_grad), json_stringify(gpu_q_grad))
  assert_eq(json_stringify(repeat_k_grad), json_stringify(gpu_k_grad))
  assert_eq(json_stringify(repeat_v_grad), json_stringify(gpu_v_grad))

  # Use the full CPU graph as the derivative oracle when exactly one CUDA role
  # requires gradients. Frozen roles must remain gradient-free.
  only_seed is autograd.tensor(seed_values, {device: "cuda"})
  frozen_q is autograd.tensor(q_values, {device: "cuda"})
  frozen_k is autograd.tensor(k_values, {device: "cuda"})
  frozen_v is autograd.tensor(v_values, {device: "cuda"})

  only_q is autograd.parameter(q_values, {device: "cuda"})
  autograd.cuda_reset_stats()
  only_q_output is autograd.causal_attention(only_q, frozen_k, frozen_v)
  autograd.backward(only_q_output, only_seed)
  only_q_stats is autograd.cuda_stats()
  assert_attention_dispatch(only_q_stats, 4, 3, 2, 1)
  approx_rank4(autograd.grad(only_q), cpu_q_grad, 0.005)
  assert_eq(autograd.grad(frozen_k), nil)
  assert_eq(autograd.grad(frozen_v), nil)

  only_k is autograd.parameter(k_values, {device: "cuda"})
  autograd.cuda_reset_stats()
  only_k_output is autograd.causal_attention(frozen_q, only_k, frozen_v)
  autograd.backward(only_k_output, only_seed)
  only_k_stats is autograd.cuda_stats()
  assert_attention_dispatch(only_k_stats, 4, 3, 2, 1)
  approx_rank4(autograd.grad(only_k), cpu_k_grad, 0.005)
  assert_eq(autograd.grad(frozen_q), nil)
  assert_eq(autograd.grad(frozen_v), nil)

  only_v is autograd.parameter(v_values, {device: "cuda"})
  autograd.cuda_reset_stats()
  only_v_output is autograd.causal_attention(frozen_q, frozen_k, only_v)
  autograd.backward(only_v_output, only_seed)
  only_v_stats is autograd.cuda_stats()
  assert_attention_dispatch(only_v_stats, 3, 2, 2, 1)
  approx_rank4(autograd.grad(only_v), cpu_v_grad, 0.005)
  assert_eq(autograd.grad(frozen_q), nil)
  assert_eq(autograd.grad(frozen_k), nil)

  # Saved forward statistics remain valid across one retained backward. The
  # second pass frees the graph and leaves exactly twice the reference gradient.
  retained_q is autograd.parameter(q_values, {device: "cuda"})
  retained_k is autograd.parameter(k_values, {device: "cuda"})
  retained_v is autograd.parameter(v_values, {device: "cuda"})
  retained_seed is autograd.tensor(seed_values, {device: "cuda"})
  autograd.cuda_reset_stats()
  retained_output is autograd.causal_attention(retained_q, retained_k, retained_v)
  autograd.backward(retained_output, retained_seed, true)
  autograd.backward(retained_output, retained_seed, false)
  retained_stats is autograd.cuda_stats()
  assert_attention_dispatch(retained_stats, 11, 10, 5, 4)
  assert_eq(retained_stats.h2d_bytes, 0)
  assert_eq(retained_stats.d2h_bytes, 0)
  assert_scaled_rank4(autograd.grad(retained_q), cpu_q_grad, 2, 0.01)
  assert_scaled_rank4(autograd.grad(retained_k), cpu_k_grad, 2, 0.01)
  assert_scaled_rank4(autograd.grad(retained_v), cpu_v_grad, 2, 0.01)

  # Sequences below the parallel threshold use the deterministic low-memory
  # reference fallback: one forward and one backward attention launch.
  small_q_values is [[[[1, 0], [0, 1], [1, 1], [-1, 1]]]]
  small_k_values is [[[[1, 0], [0, 1], [1, -1], [1, 1]]]]
  small_v_values is [[[[1, 2], [3, 4], [5, 6], [7, 8]]]]
  small_seed_values is [[[[1, 0], [0, 1], [1, -1], [2, 0.5]]]]
  small_cpu_q is autograd.parameter(small_q_values, {dtype: "float32"})
  small_cpu_k is autograd.parameter(small_k_values, {dtype: "float32"})
  small_cpu_v is autograd.parameter(small_v_values, {dtype: "float32"})
  small_cpu_output is autograd.causal_attention(small_cpu_q, small_cpu_k, small_cpu_v)
  small_cpu_data is autograd.data(small_cpu_output)
  autograd.backward(small_cpu_output, small_seed_values)
  small_cpu_q_grad is autograd.grad(small_cpu_q)
  small_cpu_k_grad is autograd.grad(small_cpu_k)
  small_cpu_v_grad is autograd.grad(small_cpu_v)

  small_gpu_q is autograd.parameter(small_q_values, {device: "cuda"})
  small_gpu_k is autograd.parameter(small_k_values, {device: "cuda"})
  small_gpu_v is autograd.parameter(small_v_values, {device: "cuda"})
  small_gpu_seed is autograd.tensor(small_seed_values, {device: "cuda"})
  autograd.cuda_reset_stats()
  small_gpu_output is autograd.causal_attention(small_gpu_q, small_gpu_k, small_gpu_v)
  autograd.backward(small_gpu_output, small_gpu_seed)
  small_stats is autograd.cuda_stats()
  assert_eq(small_stats.attention_launches, 2)
  assert_eq(small_stats.reference_attention_launches, 2)
  assert_eq(small_stats.warp_attention_launches, 0)
  assert_eq(small_stats.parallel_attention_launches, 0)
  assert_eq(small_stats.attention_launches, small_stats.reference_attention_launches + small_stats.warp_attention_launches + small_stats.parallel_attention_launches)
  assert_eq(small_stats.h2d_bytes, 0)
  assert_eq(small_stats.d2h_bytes, 0)
  approx_rank4(autograd.data(small_gpu_output), small_cpu_data, 0.0005)
  approx_rank4(autograd.grad(small_gpu_q), small_cpu_q_grad, 0.001)
  approx_rank4(autograd.grad(small_gpu_k), small_cpu_k_grad, 0.001)
  approx_rank4(autograd.grad(small_gpu_v), small_cpu_v_grad, 0.001)
else
  print "44_cuda_attention_parallel: SKIP ({info.error})"
end

print "44_cuda_attention_parallel: PASS"

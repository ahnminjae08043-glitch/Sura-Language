// ==========================================
// 수라 엔진 v2.1: RC & 그래픽 종합 테스트
// ==========================================

print "--- 1. RC(참조 횟수 계산) 테스트 ---"
arr_new a
arr_push a "사과"
arr_push a "포도"

// 참조 복사 (데이터를 복사하지 않고 주소만 공유)
b is a 

arr_push b "수박" // b에 넣었지만 a도 바뀌어야 함

arr_get a 2 result
print "배열 a의 2번 인덱스 (수박 기대): {result}"

print ""
print "--- 2. 딕셔너리 RC 테스트 ---"
dict_new player
dict_set player "hp" 100
dict_set player "name" "수라전사"

hero is player
dict_set hero "hp" 50 // hero를 수정하면 player도 수정됨

dict_get player "hp" current_hp
print "{player.name}의 현재 HP: {current_hp} (50 기대)"

print ""
print "--- 3. 그래픽 & 마우스 테스트 ---"
win_init 800 600 "수라 RC & 그래픽 엔진 테스트"

while 1 do
    win_clear 20 20 30
    
    key_down "q" k_q
    if k_q then break

    mouse_pos mx my
    mouse_down "left" click
    
    if click then
        // 클릭 시 빨간 네모
        win_rect mx my 100 100 255 50 50
    else
        // 평소엔 파란 네모
        win_rect mx my 50 50 50 50 255
    end

    win_update
    sleep 16
end

print "테스트 종료!"

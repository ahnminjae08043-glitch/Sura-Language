# ═══════════════════════════════════════════════════════════════
#  수라 JIT 컴파일러 종합 테스트
# ═══════════════════════════════════════════════════════════════

print "══ JIT 컴파일러 테스트 시작 ══"

# ── 1. 기본 산술 ───────────────────────────────────────────────
print "1. 기본 산술"
x is 10
y is 20
result is x + y
print "  10 + 20 = " + result

z is x * y - 5
print "  10 * 20 - 5 = " + z

# ── 2. 비교 & 논리 ────────────────────────────────────────────
print "2. 비교 & 논리"
if x < y then
    print "  10 < 20: 참"
end

if x > 5 and y < 30 then
    print "  and 연산: 참"
end

if x > 100 or y == 20 then
    print "  or 연산: 참"
end

# ── 3. 삼항 연산자 ─────────────────────────────────────────────
print "3. 삼항 연산자"
msg is x > 5 ? "크다" : "작다"
print "  x > 5 ? = " + msg

# ── 4. if/elif/else ────────────────────────────────────────────
print "4. if/elif/else"
score is 85
if score >= 90 then
    print "  A"
elif score >= 80 then
    print "  B (85점)"
elif score >= 70 then
    print "  C"
else
    print "  F"
end

# ── 5. while 반복 ─────────────────────────────────────────────
print "5. while 반복"
i is 0
sum is 0
while i < 10 do
    sum += i
    i += 1
end
print "  0~9 합: " + sum

# ── 6. repeat 반복 ────────────────────────────────────────────
print "6. repeat 반복"
count is 0
repeat 5 do
    count += 1
end
print "  5회 반복: " + count

# ── 7. for 수치 반복 ──────────────────────────────────────────
print "7. for 반복"
total is 0
for i in 1 to 10 do
    total += i
end
print "  1~10 합: " + total

# ── 8. 배열 ───────────────────────────────────────────────────
print "8. 배열"
nums is [10, 20, 30, 40, 50]
print "  배열: " + nums
print "  길이: " + nums.len

arr_push nums 60
print "  push 60: " + nums

# ── 9. 딕셔너리 ──────────────────────────────────────────────
print "9. 딕셔너리"
person is {"이름": "수라", "나이": 25}
print "  딕셔너리: " + person

# ── 10. foreach 반복 ──────────────────────────────────────────
print "10. foreach"
fruits is ["사과", "바나나", "체리"]
for fruit in fruits do
    print "  과일: " + fruit
end

# ── 11. 함수 ──────────────────────────────────────────────────
print "11. 함수"
func 더하기(a, b) do
    return a + b
end

func 팩토리얼(n) do
    if n <= 1 then
        return 1
    end
    return n * 팩토리얼(n - 1)
end

r is 더하기(3, 7)
print "  더하기(3, 7) = " + r

f is 팩토리얼(6)
print "  6! = " + f

# ── 12. 기본값 매개변수 ──────────────────────────────────────
print "12. 기본값 매개변수"
func 인사(이름 is "세계") do
    print "  안녕, " + 이름 + "!"
end
인사("수라")
인사()

# ── 13. 클래스 ────────────────────────────────────────────────
print "13. 클래스"
class 동물 do
    이름 is "?"
    소리 is "..."

    func init(n, s) do
        self.이름 is n
        self.소리 is s
    end

    func 울기() do
        return self.이름 + ": " + self.소리
    end
end

강아지 is new 동물("멍멍이", "왈왈!")
print "  " + 강아지.울기()

# ── 14. 상속 ──────────────────────────────────────────────────
print "14. 상속"
class 애완동물 extends 동물 do
    주인 is "없음"

    func init(n, s, o) do
        super.init(n, s)
        self.주인 is o
    end

    func 소개() do
        return self.이름 + " (주인: " + self.주인 + ")"
    end
end

고양이 is new 애완동물("야옹이", "냐옹~", "철수")
print "  " + 고양이.소개()
print "  " + 고양이.울기()

# ── 15. try/catch ─────────────────────────────────────────────
print "15. try/catch"
try
    throw "테스트 예외!"
catch 에러
    print "  잡힌 예외: " + 에러
end

# ── 16. break/continue ────────────────────────────────────────
print "16. break/continue"
i is 0
while true do
    if i >= 5 then
        break
    end
    i += 1
end
print "  break 후 i: " + i

evens is 0
for i in 1 to 10 do
    if i % 2 != 0 then
        continue
    end
    evens += 1
end
print "  짝수 개수: " + evens

# ── 17. 복합 대입 ─────────────────────────────────────────────
print "17. 복합 대입"
v is 100
v += 50
v -= 30
v *= 2
print "  (100+50-30)*2 = " + v

# ── 18. 비트 연산 ─────────────────────────────────────────────
print "18. 비트 연산"
a is 255
b is 15
print "  255 & 15 = " + (a & b)
print "  255 | 15 = " + (a | b)
print "  255 ^ 15 = " + (a ^ b)

# ── 19. 문자열 연산 ──────────────────────────────────────────
print "19. 문자열 연산"
str_upper "hello" result
print "  upper: " + result
str_len "수라 언어" len
print "  len: " + len

# ── 20. 수학 함수 ─────────────────────────────────────────────
print "20. 수학 함수"
sqrt 144 r
print "  sqrt(144) = " + r
pow 2 10 r
print "  pow(2,10) = " + r

print ""
print "══ 모든 테스트 완료! ══"

use autograd

path is env_get("SURA_SAFE_FIXTURE", "")
assert(path != "")
weights is autograd.load_safetensors(path)
assert_eq(autograd.dtype(weights.f32), "float32")
assert_eq(autograd.dtype(weights.f16), "float16")
assert_eq(autograd.dtype(weights.bf16), "bfloat16")
assert_eq(autograd.dtype(weights.f64), "float64")
assert_eq(json_stringify(autograd.data(weights.f32)), "[[1,2],[3,4]]")
assert_eq(json_stringify(autograd.data(weights.f16)), "[0.5,-1.5]")
assert_eq(json_stringify(autograd.data(weights.bf16)), "[2.25]")
assert_eq(json_stringify(autograd.data(weights.f64)), "7.5")
print "safetensors_import_fixture: PASS"

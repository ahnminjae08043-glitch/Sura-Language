# ── 1. elif ─────────────────────────────────────────
점수 is 75
if 점수 >= 90 then
    print "A"
elif 점수 >= 80 then
    print "B"
elif 점수 >= 70 then
    print "C"
else
    print "F"
end

# ── 2. 딕셔너리 리터럴 ──────────────────────────────
사람 is {"이름": "철수", "나이": 20, "도시": "서울"}
print 사람.이름
print 사람.나이

# ── 3. in 연산자 ─────────────────────────────────────
과일 is ["사과", "바나나", "포도"]
print "사과" in 과일
print "망고" in 과일

설정 is {"디버그": true, "버전": 2}
print "디버그" in 설정
print "없는키" in 설정

# ── 4. 삼항 연산자 ───────────────────────────────────
x is 10
결과 is x > 5 ? "크다" : "작다"
print 결과

# ── 5. for k, v in dict ─────────────────────────────
재고 is {"사과": 3, "바나나": 5, "포도": 2}
for 품목, 수량 in 재고 do
    print 품목
    print 수량
end

# ── 6. 0 나누기 오류 ─────────────────────────────────
try
    나눗셈 is 10 / 0
catch 오류
    print "0 나누기 오류 잡힘"
end

# ── 7. 음수 인덱스 쓰기 ─────────────────────────────
arr is [1, 2, 3, 4, 5]
arr[-1] is 99
print arr[4]

# ── 8. 기본값 파라미터 ──────────────────────────────
func 인사(이름, 접두사 is "안녕") do
    print 접두사
    print 이름
end
인사("철수")
인사("영희", "반갑습니다")

# ── 9. 비트 연산자 ───────────────────────────────────
print 0b1010 and 0b1010
a is 12
b is 10
print a & b
print a | b
print a ^ b
print 1 << 3
print 16 >> 2
print ~5

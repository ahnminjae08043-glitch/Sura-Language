# AI automation workload: score many candidate tasks for an agent loop.
# This is intentionally numeric and branch-heavy so it measures VM/JIT hot-code throughput.

func score_task(i) do
  base is i * i + i * 31 + 17
  signal is base * 3 - i * 11

  if i > 50000 then
    return signal - i * 7 + 99
  end
  return signal + i * 5 + 13
end

runs is 5
tasks is 100000
total_ms is 0
checksum is 0

repeat runs do
  t0 is clock()
  i is 0
  score is 0
  while i < tasks do
    score is score + score_task(i)
    i is i + 1
  end
  t1 is clock()
  total_ms is total_ms + (t1 - t0) * 1000
  checksum is score
end

avg is total_ms / runs
print "agent scoring tasks: {tasks}"
print "checksum: {checksum}"
print "avg ({runs} runs): {avg} ms"

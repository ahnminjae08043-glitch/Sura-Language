# Doomgeneric desktop application host for Sura OS.
#
# The launcher replaces the marker-backed 8 MiB region with the static
# os/doom/build/doom.elf image.  The kernel loads that ELF into PML4 slot 2,
# creates it on demand in the desktop scheduler's eighth slot, and exposes the
# five syscalls used by doomgeneric_sura.c.

import "../stdlib/freestanding/elf64.sura"

# Keep these declarations adjacent. tools/sura_os_vm.ps1 patches the marker
# and following bytes in both SuraOS.efi and SuraOS.img.
os_doom_elf_image is static.bytes([83, 85, 82, 65, 95, 68, 79, 79, 77, 95, 69, 76, 70, 95, 66, 76, 79, 66, 95, 86, 49, 95, 50, 48, 50, 54, 48, 55, 50, 55, 33, 33], 4096)
os_doom_elf_payload is static.zero(8388576, 1)

os_doom_process_space is static.struct(ProcessAddressSpace)
os_doom_process_buffers is static.struct(ProcessSpaceBuffers)
os_doom_process_owned_pages is static.zero(67584, 16)
os_doom_process_mappings is static.struct(ProcessMapping, 8192)
os_doom_process_stack is static.struct(ProcessStack)
os_doom_process_create is static.struct(UserProcessCreate)
os_doom_kernel_stack is static.zero(32768, 16)

os_doom_elf_info is static.struct(Elf64Info)
os_doom_elf_buffers is static.struct(Elf64Buffers)
os_doom_elf_segment is static.struct(Elf64Segment)
os_doom_elf_previous is static.struct(Elf64Segment)

os_doom_frame_scratch is static.zero(1048576, 64)
os_doom_frame_pages is static.zero(2048, 16)
os_doom_serial_buffer is static.zero(1024, 16)
os_doom_key_queue is static.zero(256, 16)

os_text_doom is static.utf8("DOOM")
os_text_doom_icon is static.utf8("DOOM")
os_text_doom_starting is static.utf8("STARTING E1M1...")
os_text_doom_unavailable is static.utf8("DOOM ELF IS NOT EMBEDDED")
os_text_doom_controls is static.utf8("ARROWS MOVE  CTRL FIRE  SPACE USE  F12 DESKTOP")

os_doom_embedded_marker is static.utf8("SURA_OS_DOOM_EMBEDDED_READY")
os_doom_started_marker is static.utf8("SURA_OS_DOOM_RING3_READY")
os_doom_frame_marker is static.utf8("SURA_OS_DOOM_FRAME_OK")
os_doom_input_marker is static.utf8("SURA_OS_DOOM_INPUT_OK")
os_doom_exit_marker is static.utf8("SURA_OS_DOOM_EXIT_OK")
os_doom_fault_marker is static.utf8("SURA_OS_DOOM_PROCESS_FAULT")
os_doom_unavailable_marker is static.utf8("SURA_OS_DOOM_UNAVAILABLE")

os_doom_available: u64 is 0
os_doom_unavailable_reported: u64 is 0
os_doom_process_id: u64 is 0
os_doom_running: u64 is 0
os_doom_close_requested: u64 is 0
os_doom_frame_ready: u64 is 0
os_doom_frame_count: u64 is 0
os_doom_tsc_per_ms: u64 is 0
os_doom_start_tsc: u64 is 0
os_doom_key_read: u64 is 0
os_doom_key_write: u64 is 0
os_doom_key_count: u64 is 0

os_doom_cached_frame_address: u64 is 0
os_doom_cached_frame_bytes: u64 is 0
os_doom_cached_first_offset: u64 is 0
os_doom_cached_page_count: u64 is 0

func os_doom_elf_capacity() do
  return 8388608
end

func os_doom_expected_width() do
  return 640
end

func os_doom_expected_height() do
  return 400
end

func os_doom_current_process() do
  if os_doom_process_id == 0 then return false
  return user_process_current_id(os_user_scheduler) == os_doom_process_id
end

func os_doom_detect_tsc_per_ms() do
  maximum_leaf: u64 is cpu.cpuid_eax(0, 0)
  if maximum_leaf >= 21 then
    denominator: u64 is cpu.cpuid_eax(21, 0)
    numerator: u64 is cpu.cpuid_ebx(21, 0)
    crystal_hz: u64 is cpu.cpuid_ecx(21, 0)
    if denominator != 0 and numerator != 0 and crystal_hz != 0 and numerator <= u64("0xffffffffffffffff") / crystal_hz then
      frequency: u64 is (crystal_hz * numerator) / denominator
      if frequency >= 1000000 then return frequency / 1000
    end
  end
  if maximum_leaf >= 22 then
    base_mhz: u64 is cpu.cpuid_eax(22, 0) & 65535
    if base_mhz != 0 then return base_mhz * 1000
  end

  pit_count: u64 is 11932
  original_port61: u64 is io.in8(97)
  io.out8(97, original_port61 & 252)
  io.out8(67, 176)
  io.out8(66, pit_count & 255)
  io.out8(66, (pit_count >> 8) & 255)
  start: u64 is cpu.rdtsc()
  io.out8(97, (original_port61 & 252) | 1)
  attempt: u64 is 0
  completed: bool is false
  while attempt < 20000000 do
    if (io.in8(97) & 32) != 0 then
      completed is true
      attempt is 20000000
    else
      cpu.pause()
      attempt += 1
    end
  end
  finish: u64 is cpu.rdtsc()
  io.out8(97, original_port61)
  if completed and finish > start then
    delta: u64 is finish - start
    if delta <= u64("0xffffffffffffffff") / 1193182 then
      ticks: u64 is (delta * 1193182) / pit_count
      if ticks >= 1000000 then return ticks / 1000
    end
  end
  return 1000000
end

func os_doom_ticks_ms() do
  now: u64 is cpu.rdtsc()
  if os_doom_tsc_per_ms == 0 or now < os_doom_start_tsc then return 0
  return (now - os_doom_start_tsc) / os_doom_tsc_per_ms
end

func os_doom_key_clear() do
  global os_doom_key_read, os_doom_key_write, os_doom_key_count
  os_doom_key_read is 0
  os_doom_key_write is 0
  os_doom_key_count is 0
  return true
end

func os_doom_key_push(value: u64) do
  global os_doom_key_read, os_doom_key_write, os_doom_key_count
  if os_doom_key_count >= 256 then
    os_doom_key_read is (os_doom_key_read + 1) & 255
    os_doom_key_count -= 1
  end
  mem.write8(ptr.add(os_doom_key_queue, os_doom_key_write & 255), value & 255)
  os_doom_key_write is (os_doom_key_write + 1) & 255
  os_doom_key_count += 1
  return true
end

func os_doom_queue_key_event(event: ptr[KeyEvent]) do
  global os_doom_close_requested
  if event == 0 then return false
  if event.physical_key == 88 and event.pressed != 0 then
    os_doom_close_requested is 1
    return os_serial_cstr_line(os_doom_input_marker)
  end
  if event.pressed == 0 and event.released == 0 then return true
  physical_key: u64 is event.physical_key
  if physical_key == 0 or physical_key >= 512 then return true
  if physical_key >= 256 then
    if not os_doom_key_push(224) then return false
  end
  value: u64 is physical_key & 127
  if event.released != 0 then value is value | 128
  return os_doom_key_push(value)
end

func os_doom_key_pop() do
  global os_doom_key_read, os_doom_key_count
  if os_doom_key_count == 0 then return u64("0xffffffffffffffff")
  value: u64 is mem.read8(ptr.add(os_doom_key_queue, os_doom_key_read & 255))
  os_doom_key_read is (os_doom_key_read + 1) & 255
  os_doom_key_count -= 1
  return value
end

func os_doom_cache_frame_pages(user_address: u64, byte_count: u64) do
  global os_doom_cached_frame_address, os_doom_cached_frame_bytes
  global os_doom_cached_first_offset, os_doom_cached_page_count
  if user_address == os_doom_cached_frame_address and byte_count == os_doom_cached_frame_bytes and os_doom_cached_page_count != 0 then
    return true
  end
  if not process_user_range_valid(user_address, byte_count) then return false
  if byte_count == 0 or byte_count > 1048576 then return false

  first_offset: u64 is user_address & 4095
  page_count: u64 is (first_offset + byte_count + 4095) / 4096
  if page_count == 0 or page_count > 256 then return false
  first_page: u64 is user_address & ~4095
  index: u64 is 0
  while index < page_count do
    virtual_page: u64 is first_page + index * 4096
    mapping: ptr[ProcessMapping] is process_find_mapping(os_doom_process_space, virtual_page)
    if mapping == 0 or not process_mapping_access_valid(os_doom_process_space, mapping, false) then
      os_doom_cached_page_count is 0
      return false
    end
    mem.write64(ptr.index(os_doom_frame_pages, index, 8), mapping.physical_address)
    index += 1
  end

  os_doom_cached_frame_address is user_address
  os_doom_cached_frame_bytes is byte_count
  os_doom_cached_first_offset is first_offset
  os_doom_cached_page_count is page_count
  return true
end

func os_doom_copy_cached_frame() do
  if os_doom_cached_page_count == 0 or os_doom_cached_frame_bytes == 0 then return false
  copied: u64 is 0
  page_index: u64 is 0
  source_offset: u64 is os_doom_cached_first_offset
  while copied < os_doom_cached_frame_bytes do
    if page_index >= os_doom_cached_page_count then return false
    physical_page: u64 is mem.read64(ptr.index(os_doom_frame_pages, page_index, 8))
    if physical_page == 0 then return false
    chunk: u64 is 4096 - source_offset
    remaining: u64 is os_doom_cached_frame_bytes - copied
    if chunk > remaining then chunk is remaining
    source: ptr is ptr.add(physical_page, source_offset)
    destination: ptr is ptr.add(os_doom_frame_scratch, copied)
    offset: u64 is 0
    while offset + 7 < chunk do
      mem.write64(ptr.add(destination, offset), mem.read64(ptr.add(source, offset)))
      offset += 8
    end
    while offset < chunk do
      mem.write8(ptr.add(destination, offset), mem.read8(ptr.add(source, offset)))
      offset += 1
    end
    copied += chunk
    page_index += 1
    source_offset is 0
  end
  return true
end

func os_doom_draw_pixels(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if surface == 0 or window == 0 then return false
  if window.width <= 4 or window.height <= 41 then return false
  content_x: u64 is window.x + 2
  content_y: u64 is window.y + 39
  content_width: u64 is window.width - 4
  content_height: u64 is window.height - 41
  black: u32 is fb_rgb(surface, 0, 0, 0)
  fb_fill_rect(surface, content_x, content_y, content_width, content_height, black)

  destination_width: u64 is content_width
  destination_height: u64 is (destination_width * os_doom_expected_height()) / os_doom_expected_width()
  if destination_height > content_height then
    destination_height is content_height
    destination_width is (destination_height * os_doom_expected_width()) / os_doom_expected_height()
  end
  if destination_width == 0 or destination_height == 0 then return false
  destination_x: u64 is content_x + (content_width - destination_width) / 2
  destination_y: u64 is content_y + (content_height - destination_height) / 2
  step_x: u64 is (os_doom_expected_width() << 20) / destination_width
  step_y: u64 is (os_doom_expected_height() << 20) / destination_height
  source_y_fixed: u64 is 0
  row: u64 is 0
  while row < destination_height do
    source_y: u64 is source_y_fixed >> 20
    if source_y >= os_doom_expected_height() then source_y is os_doom_expected_height() - 1
    source_x_fixed: u64 is 0
    column: u64 is 0
    while column < destination_width do
      source_x: u64 is source_x_fixed >> 20
      if source_x >= os_doom_expected_width() then source_x is os_doom_expected_width() - 1
      pixel: u64 is mem.read32(ptr.add(os_doom_frame_scratch, (source_y * os_doom_expected_width() + source_x) * 4))
      if surface.pixel_format == 0 then
        red: u64 is (pixel >> 16) & 255
        green: u64 is (pixel >> 8) & 255
        blue: u64 is pixel & 255
        pixel is red | (green << 8) | (blue << 16)
      end
      mem.write32(ptr.add(surface.pixels, ((destination_y + row) * surface.stride + destination_x + column) * 4), pixel)
      source_x_fixed += step_x
      column += 1
    end
    source_y_fixed += step_y
    row += 1
  end
  return true
end

func os_draw_doom_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_doom) then return false
  if window.width <= 4 or window.height <= 41 then return false
  content_x: u64 is window.x + 2
  content_y: u64 is window.y + 39
  content_width: u64 is window.width - 4
  content_height: u64 is window.height - 41
  black: u32 is fb_rgb(surface, 0, 0, 0)
  fb_fill_rect(surface, content_x, content_y, content_width, content_height, black)
  if os_doom_frame_ready != 0 then return os_doom_draw_pixels(surface, window)

  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  message: ptr is os_text_doom_starting
  if os_doom_available == 0 then message is os_text_doom_unavailable
  font_ui_draw_utf8_text(surface, content_x + 20, content_y + 24, message, 48, white_small)
  font_ui_draw_utf8_text(surface, content_x + 20, content_y + 48, os_text_doom_controls, 64, muted_small)
  return true
end

func os_doom_blit(user_address: u64, width: u64, height: u64) do
  global os_doom_frame_ready, os_doom_frame_count
  if width != os_doom_expected_width() or height != os_doom_expected_height() then return false
  byte_count: u64 is width * height * 4
  if byte_count != 1024000 then return false
  if not os_doom_cache_frame_pages(user_address, byte_count) then return false
  if not os_doom_copy_cached_frame() then return false
  os_doom_frame_ready is 1
  os_doom_frame_count += 1
  if os_doom_frame_count == 1 then
    if not os_serial_cstr_line(os_doom_frame_marker) then return false
  end
  window: ptr[DesktopWindow] is window_manager_find(os_window_manager_state, 7)
  if window == 0 or window.visible == 0 then return true
  return os_redraw_desktop()
end

func os_doom_serial_from_user(user_address: u64, byte_count: u64) do
  if byte_count == 0 then return true
  if byte_count > 1024 then byte_count is 1024
  if not process_copy_from_user(os_doom_process_space, os_doom_serial_buffer, user_address, byte_count) then return false
  return serial_write_buffer(1016, os_doom_serial_buffer, byte_count, 1000000)
end

func os_doom_sys_ticks(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) do
  if not os_doom_current_process() then return u64("0xffffffffffffffff")
  return os_doom_ticks_ms()
end

func os_doom_sys_key(a0: u64, a1: u64, a2: u64, a3: u64, a4: u64) do
  if not os_doom_current_process() then return u64("0xffffffffffffffff")
  return os_doom_key_pop()
end

func os_doom_sys_blit(user_address: u64, width: u64, height: u64, a3: u64, a4: u64) do
  if not os_doom_current_process() then return u64("0xffffffffffffffff")
  if not os_doom_blit(user_address, width, height) then return u64("0xffffffffffffffff")
  return 0
end

func os_doom_sys_serial(user_address: u64, byte_count: u64, a2: u64, a3: u64, a4: u64) do
  if not os_doom_current_process() then return u64("0xffffffffffffffff")
  if not os_doom_serial_from_user(user_address, byte_count) then return u64("0xffffffffffffffff")
  return byte_count
end

func os_doom_sys_exit(code: u64, a1: u64, a2: u64, a3: u64, a4: u64) do
  global os_doom_close_requested
  if not os_doom_current_process() then return u64("0xffffffffffffffff")
  os_doom_close_requested is 1
  exited: bool is user_process_exit_current(code)
  return u64("0xffffffffffffffff")
end

func os_doom_install_syscalls(table: ptr[SoftwareSyscallTable]) do
  if table == 0 or table.capacity <= 104 then return false
  if not syscall_table_set(table, 100, addr_of(os_doom_sys_ticks)) then return false
  if not syscall_table_set(table, 101, addr_of(os_doom_sys_key)) then return false
  if not syscall_table_set(table, 102, addr_of(os_doom_sys_blit)) then return false
  if not syscall_table_set(table, 103, addr_of(os_doom_sys_serial)) then return false
  return syscall_table_set(table, 104, addr_of(os_doom_sys_exit))
end

func os_doom_prepare_abort() do
  global os_doom_available
  if os_doom_process_space.initialized != 0 and paging.root() != os_doom_process_space.root then
    process_space_destroy(os_doom_process_space)
  end
  os_doom_available is 0
  return false
end

func os_doom_prepare() do
  global os_doom_available, os_doom_unavailable_reported, os_doom_tsc_per_ms
  if os_doom_available != 0 then return true
  if mem.read32(os_doom_elf_image) != u64("0x464c457f") then
    if os_doom_unavailable_reported == 0 then
      if not os_serial_cstr_line(os_doom_unavailable_marker) then return false
      os_doom_unavailable_reported is 1
    end
    return true
  end
  if os_kernel_page_root == 0 or paging.root() != os_kernel_page_root then return false

  elf_buffers: ptr[Elf64Buffers] is os_doom_elf_buffers
  elf_buffers.segment is os_doom_elf_segment
  elf_buffers.previous is os_doom_elf_previous
  if not elf64_open(os_doom_elf_image, os_doom_elf_capacity(), os_doom_elf_info, elf_buffers) then return false
  if paging.pml4_index(os_doom_elf_info.lowest_address) != 2 then return false
  if paging.pml4_index(os_doom_elf_info.highest_address - 1) != 2 then return false
  if os_doom_elf_info.load_pages + 32 > 8192 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_doom_process_buffers
  buffers.owned_pages is os_doom_process_owned_pages
  buffers.owned_capacity is 8448
  buffers.mappings is os_doom_process_mappings
  buffers.mapping_capacity is 8192
  if not process_space_init(os_doom_process_space, os_allocator_state, os_kernel_page_root, buffers) then return false

  index: u64 is 0
  while index < 256 do
    if index != 2 then
      entry: u64 is paging.read(os_kernel_page_root, index)
      if paging.present(entry) then entry is entry & ~4
      paging.write(os_doom_process_space.root, index, entry)
    end
    index += 1
  end
  if not elf64_load_process(os_doom_elf_image, os_doom_elf_capacity(), os_doom_process_space, os_doom_elf_info, elf_buffers) then
    return os_doom_prepare_abort()
  end
  stack_top: u64 is u64("0x0000010010000000")
  if not process_space_map_stack(os_doom_process_space, stack_top, 16, 1, os_doom_process_stack) then
    return os_doom_prepare_abort()
  end
  if os_doom_tsc_per_ms == 0 then os_doom_tsc_per_ms is os_doom_detect_tsc_per_ms()
  if os_doom_tsc_per_ms == 0 then return os_doom_prepare_abort()
  os_doom_available is 1
  return os_serial_cstr_line(os_doom_embedded_marker)
end

func os_doom_launch() do
  global os_doom_available, os_doom_process_id, os_doom_running
  global os_doom_close_requested, os_doom_frame_ready, os_doom_frame_count
  global os_doom_start_tsc, os_doom_cached_frame_address
  global os_doom_cached_frame_bytes, os_doom_cached_page_count
  global os_graphics_message
  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, 7)
  if window == 0 then return false
  if window.visible == 0 then
    if not window_manager_show(manager, 7) then return false
  elif not window_manager_focus(manager, 7) then
    return false
  end
  if os_doom_running != 0 then return true

  if os_doom_process_id != 0 then
    old_state: u64 is user_process_state(os_user_scheduler, os_doom_process_id)
    if old_state == 1 then
      os_doom_running is 1
      return true
    end
    if old_state != 2 and old_state != 3 then return false
    if not user_process_reap(os_user_scheduler, os_doom_process_id) then return false
    os_doom_process_id is 0
    os_doom_available is 0
  end
  if not os_doom_prepare() then return false
  if os_doom_available == 0 then
    os_graphics_message is os_text_doom_unavailable
    return os_redraw_desktop()
  end
  if os_user_scheduler_ready == 0 or os_user_scheduler.process_count >= os_user_scheduler.capacity then return false

  create: ptr[UserProcessCreate] is os_doom_process_create
  create.address_space is os_doom_process_space
  create.kernel_stack_base is os_doom_kernel_stack
  create.kernel_stack_size is 32768
  create.entry is os_doom_elf_info.entry
  create.user_stack_pointer is os_doom_process_stack.initial_rsp
  create.argument is 0
  create.user_gs_base is 0
  create.event_queue is 0
  os_doom_process_id is user_process_create(os_user_scheduler, create)
  if os_doom_process_id == 0 then return false

  os_doom_close_requested is 0
  os_doom_frame_ready is 0
  os_doom_frame_count is 0
  os_doom_cached_frame_address is 0
  os_doom_cached_frame_bytes is 0
  os_doom_cached_page_count is 0
  if not os_doom_key_clear() then return false
  os_doom_start_tsc is cpu.rdtsc()
  os_doom_running is 1
  if not os_serial_cstr_line(os_doom_started_marker) then return false
  return os_redraw_desktop()
end

func os_doom_request_close() do
  global os_doom_close_requested
  if os_doom_running != 0 then os_doom_close_requested is 1
  return true
end

func os_doom_service() do
  global os_doom_running, os_doom_close_requested, os_graphics_message
  if os_doom_running == 0 or os_doom_process_id == 0 then return true
  state: u64 is user_process_state(os_user_scheduler, os_doom_process_id)
  if os_doom_close_requested != 0 and state == 1 then
    if os_user_scheduler.current != os_user_scheduler.capacity then return false
    if not user_process_terminate(os_user_scheduler, os_doom_process_id, 0) then return false
    state is 2
  end
  if state == 1 then
    scheduled: bool is interrupt.invoke(130)
    if paging.root() != os_kernel_page_root then return false
    state is user_process_state(os_user_scheduler, os_doom_process_id)
  end
  if state == 1 then return true
  if state != 2 and state != 3 then return false

  os_doom_running is 0
  os_doom_close_requested is 0
  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, 7)
  if window != 0 and window.visible != 0 then
    if not window_manager_close(manager, 7) then return false
  end
  os_graphics_message is os_text_user_process_stopped
  if state == 3 then
    if not os_redraw_desktop() then return false
    return os_serial_cstr_line(os_doom_fault_marker)
  end
  if not os_redraw_desktop() then return false
  return os_serial_cstr_line(os_doom_exit_marker)
end

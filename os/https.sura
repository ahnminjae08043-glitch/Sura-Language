  mem.write8(ptr.add(os_https_finished_message, 1), 0)
  mem.write8(ptr.add(os_https_finished_message, 2), 0)
  mem.write8(ptr.add(os_https_finished_message, 3), 32)
  if not tls13_finished_compute(os_https_hmac_workspace, os_https_client_finished_key, os_https_digest, ptr.add(os_https_finished_message, 4)) then return false
  if not os_https_transcript_append(os_https_finished_message, 36) then return false
  if not os_https_record_encrypt_send(context, os_https_client_record_state, os_https_finished_message, 36, 22) then return false
  if not tls13_record_init(os_https_client_record_state, os_https_client_record_buffers, os_https_client_application_key, os_https_client_application_iv) then return false
  if not tls13_record_init(os_https_server_record_state, os_https_server_record_buffers, os_https_server_application_key, os_https_server_application_iv) then return false
  return true

func os_network_https_get(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64, request: ptr, request_bytes: u64) do
  global os_https_last_error, os_https_prehandshaken
  os_https_last_error is 0
  if context == 0 or hostname == 0 or hostname_bytes == 0 then
    os_https_last_error is 1

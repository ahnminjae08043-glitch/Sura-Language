func os_https_validate_certificates(hostname: ptr, hostname_bytes: u64) do
  if hostname == 0 or hostname_bytes == 0 then return false
  list: ptr[Tls13CertificateList] is os_https_certificate_list
  if list.certificate_count < 2 or list.certificate_count > 4 then return false
  index: u64 is 0
  while index < list.certificate_count do
    if not os_browser_cooperative_yield() then return false
    certificate: ptr[X509Certificate] is os_https_certificate_struct(index)
    if certificate == 0 then return false
    if not x509_parse(os_https_certificate_data(index), os_https_certificate_bytes(index), os_https_x509_workspace, certificate) then return false
    mem.write64(ptr.add(os_https_certificate_pointers, index * 8), certificate)
    index += 1
  end
  current_time: u64 is os_https_current_time()
  if current_time == 0 then return false
  chain: ptr[X509ChainVerifyRequest] is os_https_x509_chain_request
  chain.certificates is os_https_certificate_pointers
  chain.certificate_count is list.certificate_count
  chain.trusted_roots is os_https_trusted_root_pointers
  chain.trusted_root_count is os_trust_root_count
  chain.hostname is hostname
  chain.hostname_bytes is hostname_bytes
  chain.current_time is current_time
  chain.rsa_workspace is os_https_rsa_sha_workspace
  chain.rsa_request is os_https_rsa_sha_request
  chain.rsa_sha384_workspace is os_https_rsa_sha384_workspace
  chain.rsa_sha384_request is os_https_rsa_sha384_request
  chain.time_scratch is os_https_x509_time
  if not os_browser_cooperative_yield() then return false
  return x509_verify_chain(chain, os_https_x509_workspace)
end


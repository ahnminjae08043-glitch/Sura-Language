    if not os_https_server_hello_finish() then return os_https_async_fail(context)
    os_https_async_record_count += 1
    os_https_async_state is 2
    return 0
  end
  if os_https_async_state != 2 then return os_https_async_fail(context)
  if not os_https_handshake_record_process(context, hostname, hostname_bytes) then return os_https_async_fail(context)
  os_https_async_record_count += 1
  if os_https_handshake_stage != 4 then return 0
  os_https_async_state is 0
  os_https_async_record_count is 0
  os_https_prehandshaken is 1
  return 1
end

func os_https_receive_http(context: ptr[VirtioNetContext]) do
  global os_browser_length, os_https_receive_error
  os_https_receive_error is 0

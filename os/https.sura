os_https_record_plaintext is static.zero(16640, 16)

os_https_client_hello_request is static.struct(Tls13ClientHelloRequest)
os_https_server_hello_request is static.struct(Tls13ServerHelloRequest)
os_https_client_hello_record is static.zero(512, 16)

os_https_rsa_workspace is static.struct(RsaPublicWorkspace)

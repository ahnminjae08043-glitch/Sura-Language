func os_https_handshake_poll(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64, receive_budget: u64) do
  global os_https_async_state, os_https_async_record_count, os_https_prehandshaken
  if context == 0 or hostname == 0 or hostname_bytes == 0 then return os_https_async_fail(context)
  if receive_budget == 0 or os_https_async_state == 0 then return 2
  if cpu.rdtsc() >= os_https_async_deadline then return os_https_async_fail(context)

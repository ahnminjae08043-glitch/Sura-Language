      if not os_https_consume_outer_record() then
        os_https_receive_error is 9
        return false
      end
      return os_network_http_finish(true)
    end
    if decrypt.content_type != 22 and decrypt.content_type != 23 then
      os_https_receive_error is 10
      return false
    end
    if not os_https_consume_outer_record() then
      os_https_receive_error is 11
      return false
    end
    response_state: u64 is http1_response_inspect(os_browser_buffer, os_browser_length, false, os_http_response_info)
    if response_state == 2 then
      os_https_receive_error is 12
      return false

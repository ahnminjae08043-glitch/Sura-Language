# TLS 1.3 HTTPS client for the Sura OS Text Browser.
#
# The first interoperable profile is intentionally narrow and fail-closed:
# TLS_AES_128_GCM_SHA256, X25519, RSA-PSS-RSAE-SHA256 CertificateVerify,
# RSA/SHA-256 or RSA/SHA-384 certificate chains, HTTP/1.1 over IPv4, and four pinned RSA
# trust anchors.

import "../stdlib/freestanding/sha256.sura"
import "../stdlib/freestanding/hkdf_sha256.sura"
import "../stdlib/freestanding/aes128_gcm.sura"
import "../stdlib/freestanding/x25519.sura"
import "../stdlib/freestanding/entropy_x86.sura"
import "../stdlib/freestanding/tls13_record.sura"
import "../stdlib/freestanding/tls13_handshake.sura"
import "../stdlib/freestanding/tls13_hello.sura"
import "../stdlib/freestanding/tls13_messages.sura"
import "../stdlib/freestanding/tls13_verify.sura"
import "../stdlib/freestanding/x509_chain.sura"
import "trust_store.sura"


func os_https_trusted_root_at(index: u64) do
  if index == 0 then return os_https_trusted_root0
  if index == 1 then return os_https_trusted_root1
  if index == 2 then return os_https_trusted_root2
  if index == 3 then return os_https_trusted_root3
  if index == 4 then return os_https_trusted_root4
  if index == 5 then return os_https_trusted_root5
  if index == 6 then return os_https_trusted_root6
  if index == 7 then return os_https_trusted_root7
  if index == 8 then return os_https_trusted_root8
  if index == 9 then return os_https_trusted_root9
  if index == 10 then return os_https_trusted_root10
  if index == 11 then return os_https_trusted_root11
  if index == 12 then return os_https_trusted_root12
  if index == 13 then return os_https_trusted_root13
  if index == 14 then return os_https_trusted_root14
  if index == 15 then return os_https_trusted_root15
  return 0
end

func os_https_crypto_init() do
  global os_https_initialized
  hmac_buffers: ptr[HmacSha256Buffers] is os_https_hmac_buffers
  hmac_buffers.state is os_https_sha_state
  hmac_buffers.block is os_https_sha_block
  hmac_buffers.schedule is os_https_sha_schedule
  hmac_buffers.key_block is os_https_hmac_key_block
  hmac_buffers.inner_digest is os_https_hmac_inner_digest
  hmac_buffers.message is os_https_hmac_message
  hmac_buffers.message_capacity is 256
  if not hmac_sha256_workspace_init(os_https_hmac_workspace, hmac_buffers) then return false

  handshake_buffers: ptr[Tls13HandshakeBuffers] is os_https_handshake_buffers
  handshake_buffers.hmac_workspace is os_https_hmac_workspace
  handshake_buffers.sha_state is os_https_sha_state
  handshake_buffers.sha_block is os_https_sha_block
  handshake_buffers.sha_schedule is os_https_sha_schedule
  handshake_buffers.label_request is os_https_handshake_label_request
  handshake_buffers.expand_request is os_https_handshake_expand_request
  handshake_buffers.expand_spec is os_https_handshake_expand_spec
  handshake_buffers.label_info is os_https_handshake_label_info
  handshake_buffers.label_info_capacity is 64
  handshake_buffers.zero32 is os_https_handshake_zero
  handshake_buffers.empty_hash is os_https_handshake_empty_hash
  handshake_buffers.transcript_hash is os_https_handshake_transcript_hash
  if not tls13_handshake_workspace_init(os_https_handshake_workspace, handshake_buffers) then return false

  x25519_buffers: ptr[X25519Buffers] is os_https_x25519_buffers
  x25519_buffers.field_a is os_https_x25519_a
  x25519_buffers.field_b is os_https_x25519_b
  x25519_buffers.field_c is os_https_x25519_c
  x25519_buffers.field_d is os_https_x25519_d
  x25519_buffers.field_e is os_https_x25519_e
  x25519_buffers.field_f is os_https_x25519_f
  x25519_buffers.field_x is os_https_x25519_x
  x25519_buffers.scalar is os_https_x25519_scalar
  x25519_buffers.product is os_https_x25519_product
  x25519_buffers.reduce_m is os_https_x25519_reduce
  if not x25519_workspace_init(os_https_x25519_workspace, x25519_buffers) then return false

  aes_buffers: ptr[Aes128GcmBuffers] is os_https_aes_buffers
  aes_buffers.round_keys is os_https_aes_round_keys
  aes_buffers.state is os_https_aes_state
  aes_buffers.hash_subkey is os_https_aes_hash_subkey
  aes_buffers.counter is os_https_aes_counter
  aes_buffers.ghash is os_https_aes_ghash
  aes_buffers.multiply_z is os_https_aes_multiply_z
  aes_buffers.multiply_v is os_https_aes_multiply_v
  aes_buffers.scratch is os_https_aes_scratch
  if not aes128_gcm_workspace_init(os_https_aes_workspace, aes_buffers) then return false

  client_record_buffers: ptr[Tls13RecordBuffers] is os_https_client_record_buffers
  client_record_buffers.key is os_https_client_record_key
  client_record_buffers.iv is os_https_client_record_iv
  client_record_buffers.nonce is os_https_client_record_nonce
  client_record_buffers.aes_workspace is os_https_aes_workspace
  server_record_buffers: ptr[Tls13RecordBuffers] is os_https_server_record_buffers
  server_record_buffers.key is os_https_server_record_key
  server_record_buffers.iv is os_https_server_record_iv
  server_record_buffers.nonce is os_https_server_record_nonce
  server_record_buffers.aes_workspace is os_https_aes_workspace

  rsa_buffers: ptr[RsaPublicBuffers] is os_https_rsa_buffers
  rsa_buffers.modulus is os_https_rsa_modulus
  rsa_buffers.operand is os_https_rsa_operand
  rsa_buffers.base is os_https_rsa_base
  rsa_buffers.result is os_https_rsa_result
  rsa_buffers.r2 is os_https_rsa_r2
  rsa_buffers.temporary is os_https_rsa_temporary
  rsa_buffers.encoded is os_https_rsa_encoded
  rsa_buffers.encoded_capacity is 512
  rsa_buffers.limb_capacity is 128
  if not rsa_public_workspace_init(os_https_rsa_workspace, rsa_buffers) then return false
  rsa_sha_buffers: ptr[RsaSha256Buffers] is os_https_rsa_sha_buffers
  rsa_sha_buffers.rsa_workspace is os_https_rsa_workspace
  rsa_sha_buffers.sha_state is os_https_sha_state
  rsa_sha_buffers.sha_block is os_https_sha_block
  rsa_sha_buffers.sha_schedule is os_https_sha_schedule
  rsa_sha_buffers.message_hash is os_https_rsa_message_hash
  rsa_sha_buffers.mgf_hash is os_https_rsa_mgf_hash
  rsa_sha_buffers.mask is os_https_rsa_mask
  rsa_sha_buffers.mask_capacity is 512
  rsa_sha_buffers.database is os_https_rsa_database
  rsa_sha_buffers.database_capacity is 512
  rsa_sha_buffers.hash_input is os_https_rsa_hash_input
  rsa_sha_buffers.hash_input_capacity is 130
  if not rsa_sha256_workspace_init(os_https_rsa_sha_workspace, rsa_sha_buffers) then return false
  rsa_sha384_buffers: ptr[RsaSha384Buffers] is os_https_rsa_sha384_buffers
  rsa_sha384_buffers.rsa_workspace is os_https_rsa_workspace
  rsa_sha384_buffers.sha_state is os_https_sha384_state
  rsa_sha384_buffers.sha_block is os_https_sha384_block
  rsa_sha384_buffers.sha_schedule is os_https_sha384_schedule
  rsa_sha384_buffers.message_hash is os_https_rsa_sha384_message_hash
  if not rsa_sha384_workspace_init(os_https_rsa_sha384_workspace, rsa_sha384_buffers) then return false

  x509_buffers: ptr[X509Buffers] is os_https_x509_buffers
  x509_buffers.reader0 is os_https_x509_reader0
  x509_buffers.reader1 is os_https_x509_reader1
  x509_buffers.reader2 is os_https_x509_reader2
  x509_buffers.reader3 is os_https_x509_reader3
  x509_buffers.element0 is os_https_x509_element0
  x509_buffers.element1 is os_https_x509_element1
  x509_buffers.element2 is os_https_x509_element2
  x509_buffers.element3 is os_https_x509_element3
  x509_buffers.element4 is os_https_x509_element4
  x509_buffers.element5 is os_https_x509_element5
  if not x509_workspace_init(os_https_x509_workspace, x509_buffers) then return false
  if os_trust_root_count == 0 or os_trust_root_count > 16 then return false
  root_index: u64 is 0
  while root_index < os_trust_root_count do
    root: ptr[X509Certificate] is os_https_trusted_root_at(root_index)
    root_der: ptr is os_trust_root_der(root_index)
    root_der_bytes: u64 is os_trust_root_der_bytes(root_index)
    if root == 0 or root_der == 0 or root_der_bytes == 0 then return false
    if not x509_parse(root_der, root_der_bytes, os_https_x509_workspace, root) then return false
    mem.write64(ptr.add(os_https_trusted_root_pointers, root_index * 8), root)
    root_index += 1
  end
  os_https_initialized is 1
  return true
end

func os_https_reset_state() do
  global os_https_stream_length, os_https_current_record_bytes
  global os_https_transcript_length, os_https_handshake_cursor
  global os_https_decrypt_failure_sequence, os_https_decrypt_failure_record_bytes
  os_https_stream_length is 0
  os_https_current_record_bytes is 0
  os_https_transcript_length is 0
  os_https_handshake_cursor is 0
  os_https_decrypt_failure_sequence is 0
  os_https_decrypt_failure_record_bytes is 0
  return true
end

func os_https_stream_fill(context: ptr[VirtioNetContext], required_bytes: u64) do
  global os_https_stream_length
  if context == 0 or required_bytes > 65536 then return false
  while os_https_stream_length < required_bytes do
    received: u64 is os_network_tcp_receive_some(context, ptr.add(os_https_stream_buffer, os_https_stream_length), 65536 - os_https_stream_length, 80000000)
    if received == 0 then return false
    os_https_stream_length is os_https_stream_length + received
  end
  return true
end

func os_https_receive_outer_record(context: ptr[VirtioNetContext]) do
  global os_https_current_record_bytes
  os_https_current_record_bytes is 0
  if not os_https_stream_fill(context, 5) then return false
  record_bytes: u64 is (mem.read8(ptr.add(os_https_stream_buffer, 3)) << 8) | mem.read8(ptr.add(os_https_stream_buffer, 4))
  if record_bytes == 0 or record_bytes > 16640 then return false
  record_bytes += 5
  if not os_https_stream_fill(context, record_bytes) then return false
  os_https_current_record_bytes is record_bytes
  return true
end

func os_https_stream_fill_poll(context: ptr[VirtioNetContext], required_bytes: u64, receive_budget: u64) do
  global os_https_stream_length
  if context == 0 or required_bytes > 65536 or receive_budget == 0 then return 2
  if os_https_stream_length >= required_bytes then return 1
  if os_https_stream_length >= 65536 then return 2
  received: u64 is os_network_tcp_receive_poll(context, ptr.add(os_https_stream_buffer, os_https_stream_length), 65536 - os_https_stream_length, receive_budget)
  if received != 0 then os_https_stream_length is os_https_stream_length + received
  if os_https_stream_length >= required_bytes then return 1
  if os_network_tcp_closed != 0 then return 2
  return 0
end

func os_https_receive_outer_record_poll(context: ptr[VirtioNetContext], receive_budget: u64) do
  global os_https_current_record_bytes
  os_https_current_record_bytes is 0
  header_status: u64 is os_https_stream_fill_poll(context, 5, receive_budget)
  if header_status != 1 then return header_status
  record_bytes: u64 is (mem.read8(ptr.add(os_https_stream_buffer, 3)) << 8) | mem.read8(ptr.add(os_https_stream_buffer, 4))
  if record_bytes == 0 or record_bytes > 16640 then return 2
  record_bytes += 5
  record_status: u64 is os_https_stream_fill_poll(context, record_bytes, receive_budget)
  if record_status != 1 then return record_status
  os_https_current_record_bytes is record_bytes
  return 1
end

func os_https_consume_outer_record() do
  global os_https_stream_length, os_https_current_record_bytes
  if os_https_current_record_bytes == 0 or os_https_current_record_bytes > os_https_stream_length then return false
  remaining: u64 is os_https_stream_length - os_https_current_record_bytes
  index: u64 is 0
  while index < remaining do
    mem.write8(ptr.add(os_https_stream_buffer, index), mem.read8(ptr.add(os_https_stream_buffer, os_https_current_record_bytes + index)))
    index += 1
  end
  os_https_stream_length is remaining
  os_https_current_record_bytes is 0
  return true
end

func os_https_transcript_append(input: ptr, input_bytes: u64) do
  global os_https_transcript_length
  if input_bytes != 0 and input == 0 then return false
  if input_bytes > 32768 - os_https_transcript_length then return false
  if not tls13_record_copy(ptr.add(os_https_transcript_buffer, os_https_transcript_length), input, input_bytes) then return false
  os_https_transcript_length is os_https_transcript_length + input_bytes
  return true
end

func os_https_transcript_hash(prefix_bytes: u64, output: ptr) do
  if output == 0 or prefix_bytes > os_https_transcript_length then return false
  return sha256_digest(os_https_transcript_buffer, prefix_bytes, output, os_https_sha_state, os_https_sha_block, os_https_sha_schedule)
end

func os_https_current_time() do
  time: ptr[RtcTime] is os_https_rtc_time
  if not rtc_read(time) or time.valid == 0 then return 0
  return x509_datetime_value(time.year, time.month, time.day, time.hour, time.minute, time.second)
end


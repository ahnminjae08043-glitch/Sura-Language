  if not tls13_client_hello_build(client_hello) then return false
  if not os_https_transcript_append(client_hello.handshake, client_hello.handshake_bytes) then return false
  if not os_network_tcp_open(context, 443) then return false
  if not os_network_tcp_send_stream(context, client_hello.record, client_hello.record_bytes) then return false
  return true
end

func os_https_server_hello_finish() do

  if not os_https_record_decrypt(os_https_server_record_state) then return false
  decrypt: ptr[Tls13DecryptRequest] is os_https_decrypt_request
  if decrypt.content_type != 22 then return false
  if not os_https_transcript_append(os_https_record_plaintext, decrypt.content_bytes) then return false
  if not os_https_consume_outer_record() then return false

func os_https_process_handshake_messages(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64) do
  global os_https_handshake_cursor, os_https_handshake_stage
  while os_https_transcript_length - os_https_handshake_cursor >= 4 do
    message: ptr is ptr.add(os_https_transcript_buffer, os_https_handshake_cursor)
    body_bytes: u64 is tls13_message_u24(message, 1)

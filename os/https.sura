func os_https_receive_handshake(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64) do
  if context == 0 then return false
  record_count: u64 is 0
  while record_count < 32 and os_https_handshake_stage != 4 do
    if not os_browser_cooperative_yield() then return false
    if not os_https_receive_outer_record(context) then return false
    outer_type: u64 is mem.read8(os_https_stream_buffer)
    if outer_type == 20 then
      if os_https_current_record_bytes != 6 or mem.read8(ptr.add(os_https_stream_buffer, 5)) != 1 then return false
      if not os_https_consume_outer_record() then return false
    end
    if outer_type == 23 then
      if not os_https_record_decrypt(os_https_server_record_state) then return false
      decrypt: ptr[Tls13DecryptRequest] is os_https_decrypt_request
      if decrypt.content_type == 21 then return false
      if decrypt.content_type != 22 then return false
      if not os_https_transcript_append(os_https_record_plaintext, decrypt.content_bytes) then return false
      if not os_https_consume_outer_record() then return false
      if not os_https_process_handshake_messages(context, hostname, hostname_bytes) then return false
    end
    if outer_type != 20 and outer_type != 23 then return false
    record_count += 1
  end
  return os_https_handshake_stage == 4
end

func os_https_async_fail(context: ptr[VirtioNetContext]) do

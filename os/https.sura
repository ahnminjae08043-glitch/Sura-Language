  secrets.server_key is os_https_server_handshake_key
  secrets.server_iv is os_https_server_handshake_iv
  secrets.client_finished_key is os_https_client_finished_key
  secrets.server_finished_key is os_https_server_finished_key
  handshake_request: ptr[Tls13HandshakeRequest] is os_https_handshake_request
  handshake_request.client_hello is client_hello.handshake
  handshake_request.client_hello_bytes is client_hello.handshake_bytes
  handshake_request.server_hello is server_hello.handshake
  handshake_request.server_hello_bytes is server_hello.handshake_bytes
  handshake_request.shared_secret is os_https_shared_secret
  handshake_request.shared_secret_bytes is 32
  handshake_request.secrets is os_https_handshake_secrets
  if not tls13_handshake_derive(os_https_handshake_workspace, handshake_request) then return false
  if not tls13_record_init(os_https_client_record_state, os_https_client_record_buffers, os_https_client_handshake_key, os_https_client_handshake_iv) then return false
  if not tls13_record_init(os_https_server_record_state, os_https_server_record_buffers, os_https_server_handshake_key, os_https_server_handshake_iv) then return false
  if not os_https_consume_outer_record() then return false
  os_https_handshake_cursor is os_https_transcript_length
  os_https_handshake_stage is 0

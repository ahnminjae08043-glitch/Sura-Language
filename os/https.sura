      if not tls13_certificate_message_parse(message, message_bytes, os_https_certificate_list) then return false
      if not os_https_validate_certificates(hostname, hostname_bytes) then return false
      os_https_handshake_stage is 2
    end
    if stage == 2 then
      if message_type != 15 then return false
      if not os_https_transcript_hash(os_https_handshake_cursor, os_https_digest) then return false
      parsed_verify: ptr[Tls13CertificateVerifyMessage] is os_https_certificate_verify_message
      if not tls13_certificate_verify_message_parse(message, message_bytes, parsed_verify) then return false
      verify: ptr[Tls13CertificateVerifyRequest] is os_https_certificate_verify_request
      verify.certificate is os_https_certificate0
      verify.signature_scheme is parsed_verify.signature_scheme
      verify.signature is parsed_verify.signature
      verify.signature_bytes is parsed_verify.signature_bytes
      verify.transcript_hash is os_https_digest
      verify.rsa_workspace is os_https_rsa_sha_workspace
      verify.rsa_request is os_https_rsa_sha_request
      verify.signed_message is os_https_certificate_verify_input
      verify.signed_message_capacity is 130
      if not tls13_certificate_verify_server(verify) then return false
      os_https_handshake_stage is 3
    end
    if stage == 3 then
      if message_type != 20 or message_bytes != 36 then return false
      finished_data: ptr is tls13_finished_message_parse(message, message_bytes)
      if finished_data == 0 then return false
      if not os_https_complete_handshake(context, finished_data) then return false
      os_https_handshake_stage is 4
    end
    if stage > 3 then return false
    os_https_handshake_cursor is os_https_handshake_cursor + message_bytes
    if os_https_handshake_stage == 4 then return true
  end
  return true

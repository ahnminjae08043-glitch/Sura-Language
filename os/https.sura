  if not os_https_reset_state() then return false
  if not entropy_x86_fill(os_https_client_random, 32) then return false
  if not entropy_x86_fill(os_https_client_private_key, 32) then return false
  if not x25519(os_https_x25519_workspace, os_https_client_private_key, os_https_x25519_basepoint, os_https_client_public_key) then return false

  client_hello: ptr[Tls13ClientHelloRequest] is os_https_client_hello_request

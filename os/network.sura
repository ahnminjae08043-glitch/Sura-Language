    if os_browser_use_https != 0 then request_ok is os_network_https_get(context, os_browser_hostname_buffer, os_browser_hostname_length, os_network_http_request, os_browser_http_request_length)
    if os_browser_use_https == 0 then request_ok is os_network_http_get(context, os_network_http_request, os_browser_http_request_length)
    if not request_ok then
      os_browser_last_error is 5
      if os_browser_use_https != 0 then os_browser_status_text is os_text_browser_status_https
      if os_browser_use_https == 0 then os_browser_status_text is os_text_browser_status_network
      return false
    end
    status_code: u64 is os_browser_http_status_code()
    if status_code >= 300 and status_code <= 399 then

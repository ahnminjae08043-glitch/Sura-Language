func os_browser_navigate_sync(context: ptr[VirtioNetContext]) do
  global os_browser_status_text, os_network_resolved_ip, os_browser_edit_started, os_browser_last_error, os_browser_https_reported
  os_browser_last_error is 0
  if not os_browser_ring3_authorize() then

func os_browser_js_page_fail(stage: u64) do
  global os_browser_last_error
  os_browser_last_error is stage
  if not os_serial_text(os_browser_js_page_failure_prefix) then return false
  if not os_serial_u64(stage) then return false
  if not serial_write_byte(1016, 10, 1000000) then return false
  return false
end

func os_browser_image_at(index: u64) do
  if index >= 2 then return 0
  return ptr.add(os_browser_images, index * 64)
end

func os_browser_image_source_equal(document: ptr[HtmlDomDocument], attribute: ptr[HtmlDomAttribute], resource_index: u64) do
  if document == 0 or attribute == 0 or resource_index >= os_browser_image_count then return false
  source: ptr is ptr.add(os_browser_image_sources, resource_index * 16)
  source_start: u64 is mem.read64(source)
  source_bytes: u64 is mem.read64(ptr.add(source, 8))
  if attribute.source_bytes != source_bytes then return false
  cursor: u64 is 0
  while cursor < source_bytes do
    if mem.read8(ptr.add(document.input, attribute.source_start + cursor)) != mem.read8(ptr.add(document.input, source_start + cursor)) then return false
    cursor += 1
  end
  return true
end

func os_browser_image_find(document: ptr[HtmlDomDocument], attribute: ptr[HtmlDomAttribute]) do
  index: u64 is 0
  while index < os_browser_image_count do
    if os_browser_image_source_equal(document, attribute, index) then return index
    index += 1
  end
  return u64("0xffffffffffffffff")
end

func os_browser_fetch_dom_image(document: ptr[HtmlDomDocument], attribute: ptr[HtmlDomAttribute], resource_index: u64) do
  global os_browser_image_count, os_browser_image_error
  os_browser_image_error is 0
  if document == 0 or attribute == 0 or resource_index >= 2 then
    os_browser_image_error is 1
    return false
  end
  if attribute.has_value == 0 or attribute.source_bytes == 0 or attribute.source_bytes > 900 then
    os_browser_image_error is 2
    return false
  end
  if mem.read8(ptr.add(document.input, attribute.source_start)) != 47 then
    os_browser_image_error is 3
    return false
  end
  if os_browser_image_pixel_memory == 0 or os_browser_image_workspace == 0 then
    os_browser_image_error is 4
    return false
  end
  if not os_browser_build_resource_request(ptr.add(document.input, attribute.source_start), attribute.source_bytes) then
    os_browser_image_error is 5
    return false
  end
  request_ok: bool is false
  if os_browser_use_https != 0 then request_ok is os_network_https_get(os_network_context, os_browser_hostname_buffer, os_browser_hostname_length, os_network_http_request, os_browser_http_request_length)
  if os_browser_use_https == 0 then request_ok is os_network_http_get(os_network_context, os_network_http_request, os_browser_http_request_length)
  if not request_ok then
    os_browser_image_error is 600 + os_https_last_error * 32 + os_https_receive_error
    return false
  end
  status_code: u64 is os_browser_http_status_code()
  if status_code < 200 or status_code >= 300 then
    os_browser_image_error is 7
    return false
  end
  body_start: u64 is os_browser_response_body_start()
  if body_start == 0 or body_start >= os_browser_length then
    os_browser_image_error is 8
    return false
  end
  body_bytes: u64 is os_browser_length - body_start

  image: ptr[BrowserImage] is os_browser_image_at(resource_index)
  image.pixels is ptr.add(os_browser_image_pixel_memory, resource_index * 16777216)
  image.pixel_capacity is 16777216
  if not browser_image_decode(ptr.add(os_browser_buffer, body_start), body_bytes, image, os_browser_image_workspace, 20971520) then
    os_browser_image_error is 9
    return false
  end

  source: ptr is ptr.add(os_browser_image_sources, resource_index * 16)
  mem.write64(source, attribute.source_start)
  mem.write64(ptr.add(source, 8), attribute.source_bytes)
  os_browser_image_count is resource_index + 1
  if image.format == 1 then
    if not os_serial_cstr_line(os_browser_image_png_marker) then return false
  end
  if image.format == 2 then
    if not os_serial_cstr_line(os_browser_image_jpeg_marker) then return false
  end
  return true
end

func os_browser_prepare_dom_images(document: ptr[HtmlDomDocument], viewport_width: u64) do
  global os_browser_image_count, os_browser_image_render_reported
  os_browser_image_count is 0
  os_browser_image_render_reported is 0
  if document == 0 or viewport_width == 0 then return false
  node_index: u64 is 0
  while node_index < 1024 do
    mem.write64(ptr.add(os_browser_image_node_map, node_index * 8), u64("0xffffffffffffffff"))
    node_index += 1
  end

  node_index is 0
  while node_index < document.node_count do
    node: ptr[HtmlDomNode] is html_dom_node(document, node_index)
    if node.kind == 1 and node.tag == 15 then
      if not os_serial_cstr_line(os_browser_image_discovered_marker) then return false
      source_attribute: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, node_index, 4)
      if source_attribute != 0 and source_attribute.has_value != 0 and source_attribute.source_bytes != 0 then
        resource_index: u64 is os_browser_image_find(document, source_attribute)
        if resource_index == u64("0xffffffffffffffff") and os_browser_image_count < 2 then
          candidate: u64 is os_browser_image_count
          if os_browser_fetch_dom_image(document, source_attribute, candidate) then
            resource_index is candidate
          else
            if not os_serial_text(os_browser_image_error_prefix) then return false
            if not os_serial_u64(os_browser_image_error) then return false
            if not serial_write_byte(1016, 10, 1000000) then return false
            if os_https_last_error == 6 and os_https_receive_error == 5 then
              if not os_serial_text(os_browser_tls_sequence_prefix) then return false
              if not os_serial_u64(os_https_decrypt_failure_sequence) then return false
              if not serial_write_byte(1016, 10, 1000000) then return false
              if not os_serial_text(os_browser_tls_record_bytes_prefix) then return false
              if not os_serial_u64(os_https_decrypt_failure_record_bytes) then return false
              if not serial_write_byte(1016, 10, 1000000) then return false
            end
          end
        end
        if resource_index != u64("0xffffffffffffffff") then
          image: ptr[BrowserImage] is os_browser_image_at(resource_index)
          if browser_image_fit(image, viewport_width, 240) then
            style: ptr[CssComputedStyle] is ptr.add(os_browser_dom_computed, node_index * 288)
            if style.width == u64("0xffffffffffffffff") then style.width is image.display_width
            if style.height == u64("0xffffffffffffffff") then style.height is image.display_height
            mem.write64(ptr.add(os_browser_image_node_map, node_index * 8), resource_index)
          end
        end
      end
    end
    node_index += 1
  end
  return true
end

func os_network_build_arp_request(frame: ptr, context: ptr[VirtioNetContext], target_ip: u64) do
  if frame == 0 or context == 0 or target_ip == 0 or target_ip > u64("0xffffffff") then return false
  if not virtio_net_zero(frame, 60) then return false
  index: u64 is 0
  while index < 6 do
    mem.write8(ptr.add(frame, index), 255)
    index += 1
  end
  mem.write8(ptr.add(frame, 6), context.mac0)
  mem.write8(ptr.add(frame, 7), context.mac1)
  mem.write8(ptr.add(frame, 8), context.mac2)
  mem.write8(ptr.add(frame, 9), context.mac3)
  mem.write8(ptr.add(frame, 10), context.mac4)
  mem.write8(ptr.add(frame, 11), context.mac5)
  mem.write8(ptr.add(frame, 12), 8)
  mem.write8(ptr.add(frame, 13), 6)
  mem.write8(ptr.add(frame, 14), 0)
  mem.write8(ptr.add(frame, 15), 1)
  mem.write8(ptr.add(frame, 16), 8)
  mem.write8(ptr.add(frame, 17), 0)
  mem.write8(ptr.add(frame, 18), 6)
  mem.write8(ptr.add(frame, 19), 4)
  mem.write8(ptr.add(frame, 20), 0)
  mem.write8(ptr.add(frame, 21), 1)
  mem.write8(ptr.add(frame, 22), context.mac0)
  mem.write8(ptr.add(frame, 23), context.mac1)
  mem.write8(ptr.add(frame, 24), context.mac2)
  mem.write8(ptr.add(frame, 25), context.mac3)
  mem.write8(ptr.add(frame, 26), context.mac4)
  mem.write8(ptr.add(frame, 27), context.mac5)
  net_write_u32_be(frame, 28, os_network_local_ip)
  net_write_u32_be(frame, 38, target_ip)
  return true
end

func os_network_is_arp_reply(frame: ptr, frame_bytes: u64, target_ip: u64) do
  if frame == 0 or frame_bytes < 42 or target_ip == 0 or target_ip > u64("0xffffffff") then return false
  if mem.read8(ptr.add(frame, 12)) != 8 or mem.read8(ptr.add(frame, 13)) != 6 then return false
  if mem.read8(ptr.add(frame, 20)) != 0 or mem.read8(ptr.add(frame, 21)) != 2 then return false
  if net_read_u32_be(frame, 28) != target_ip then return false
  if net_read_u32_be(frame, 38) != os_network_local_ip then return false
  return true
end

func os_network_copy_context_mac(context: ptr[VirtioNetContext], output: ptr) do
  if context == 0 or output == 0 then return false
  mem.write8(output, context.mac0)
  mem.write8(ptr.add(output, 1), context.mac1)
  mem.write8(ptr.add(output, 2), context.mac2)
  mem.write8(ptr.add(output, 3), context.mac3)
  mem.write8(ptr.add(output, 4), context.mac4)
  mem.write8(ptr.add(output, 5), context.mac5)
  return true
end

func os_network_resolve_arp(context: ptr[VirtioNetContext], target_ip: u64, output_mac: ptr) do
  if context == 0 or output_mac == 0 then return false
  if not os_network_build_arp_request(os_network_tx_frame, context, target_ip) then return false
  if not virtio_net_send(context, os_network_tx_frame, 60, 5000000) then return false
  spins: u64 is 0
  while spins < 20000000 do
    frame_bytes: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if frame_bytes != 0 and os_network_is_arp_reply(os_network_rx_frame, frame_bytes, target_ip) then
      return net_copy(output_mac, ptr.add(os_network_rx_frame, 22), 6)
    end
    io.in8(context.io_base + 19)
    cpu.pause()
    spins += 1
  end
  return false
end

func os_network_is_dhcp_udp(frame: ptr, frame_bytes: u64, expected_type: u64, transaction_id: u64, lease: ptr[NetDhcpLease]) do
  if frame == 0 or lease == 0 or frame_bytes < 14 + 20 + 8 + 241 then return false
  if mem.read8(ptr.add(frame, 12)) != 8 or mem.read8(ptr.add(frame, 13)) != 0 then return false
  ip: ptr is ptr.add(frame, 14)
  if (mem.read8(ip) >> 4) != 4 then return false
  header_bytes: u64 is (mem.read8(ip) & 15) * 4
  if header_bytes < 20 or 14 + header_bytes + 8 > frame_bytes then return false
  total_bytes: u64 is net_read_u16_be(ip, 2)
  if total_bytes < header_bytes + 8 or 14 + total_bytes > frame_bytes then return false
  if mem.read8(ptr.add(ip, 9)) != 17 or net_checksum(ip, header_bytes) != 0 then return false
  udp: ptr is ptr.add(ip, header_bytes)
  if net_read_u16_be(udp, 0) != 67 or net_read_u16_be(udp, 2) != 68 then return false
  udp_bytes: u64 is net_read_u16_be(udp, 4)
  if udp_bytes < 8 + 241 or udp_bytes > total_bytes - header_bytes then return false
  return net_dhcp_parse(ptr.add(udp, 8), udp_bytes - 8, expected_type, transaction_id, os_network_source_mac, lease)
end

func os_network_send_dhcp(context: ptr[VirtioNetContext], message_type: u64, transaction_id: u64, requested_ip: u64, server_ip: u64) do
  request: ptr[NetDhcpRequest] is os_network_dhcp_request
  request.message_type is message_type
  request.transaction_id is transaction_id
  request.mac is os_network_source_mac
  request.requested_ip is requested_ip
  request.server_ip is server_ip
  payload_bytes: u64 is net_dhcp_build(os_network_dhcp_buffer, 576, request)
  if payload_bytes == 0 then return false
  spec: ptr[NetUdpSpec] is os_network_udp_spec
  spec.destination_mac is os_network_broadcast_mac
  spec.source_mac is os_network_source_mac
  spec.source_ip is 0
  spec.destination_ip is u64("0xffffffff")
  spec.source_port is 68
  spec.destination_port is 67
  frame_bytes: u64 is net_build_ipv4_udp(os_network_tx_frame, 2048, spec, os_network_dhcp_buffer, payload_bytes, message_type)
  if frame_bytes == 0 then return false
  return virtio_net_send(context, os_network_tx_frame, frame_bytes, 5000000)
end

func os_network_wait_dhcp(context: ptr[VirtioNetContext], expected_type: u64, transaction_id: u64, lease: ptr[NetDhcpLease]) do
  spins: u64 is 0
  while spins < 40000000 do
    frame_bytes: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if frame_bytes != 0 and os_network_is_dhcp_udp(os_network_rx_frame, frame_bytes, expected_type, transaction_id, lease) then return true
    io.in8(context.io_base + 19)
    cpu.pause()
    spins += 1
  end
  return false
end

func os_network_dhcp(context: ptr[VirtioNetContext]) do
  global os_network_local_ip, os_network_subnet_mask, os_network_gateway_ip, os_network_dns_ip, os_network_dhcp_server_ip, os_network_lease_seconds
  if context == 0 then return false
  transaction_id: u64 is u64("0x53555241")
  offer: ptr[NetDhcpLease] is os_network_dhcp_offer
  lease: ptr[NetDhcpLease] is os_network_dhcp_lease
  if not os_network_send_dhcp(context, 1, transaction_id, 0, 0) then return false
  if not os_network_wait_dhcp(context, 2, transaction_id, offer) then return false
  if not os_network_send_dhcp(context, 3, transaction_id, offer.address, offer.server) then return false
  if not os_network_wait_dhcp(context, 5, transaction_id, lease) then return false
  os_network_local_ip is lease.address
  os_network_subnet_mask is lease.subnet_mask
  os_network_gateway_ip is lease.gateway
  os_network_dns_ip is lease.dns
  os_network_dhcp_server_ip is lease.server
  os_network_lease_seconds is lease.lease_seconds
  if os_network_subnet_mask == 0 then os_network_subnet_mask is offer.subnet_mask
  if os_network_gateway_ip == 0 then os_network_gateway_ip is offer.gateway
  if os_network_dns_ip == 0 then os_network_dns_ip is offer.dns
  if os_network_dhcp_server_ip == 0 then os_network_dhcp_server_ip is offer.server
  if os_network_lease_seconds == 0 then os_network_lease_seconds is offer.lease_seconds
  if os_network_local_ip == 0 or os_network_gateway_ip == 0 or os_network_dns_ip == 0 then return false
  return true
end

func os_browser_reset_address() do
  global os_browser_address_length, os_browser_edit_started, os_browser_status_text
  if not net_zero(os_browser_address_buffer, 256) then return false
  if not net_copy(os_browser_address_buffer, os_browser_default_address, 19) then return false
  os_browser_address_length is 19
  os_browser_edit_started is 0
  os_browser_status_text is os_text_browser_status_ready
  return true
end

func os_browser_begin_edit() do
  global os_browser_address_length, os_browser_edit_started, os_browser_navigation_state, os_network_dns_async_active
  global os_network_tcp_async_active, os_network_tcp_preconnected_port, os_network_tcp_closed
  if os_browser_edit_started != 0 then return true
  if not os_https_handshake_cancel(os_network_context) then return false
  os_browser_navigation_state is 0
  os_network_dns_async_active is 0
  if os_network_tcp_preconnected_port != 0 then os_network_tcp_close(os_network_context)
  os_network_tcp_async_active is 0
  os_network_tcp_preconnected_port is 0
  os_network_tcp_closed is 1
  if not net_zero(os_browser_address_buffer, 256) then return false
  os_browser_address_length is 0
  os_browser_edit_started is 1
  return true
end

func os_browser_backspace_codepoint() do
  global os_browser_address_length, os_browser_edit_started, os_browser_status_text
  os_browser_edit_started is 1
  if os_browser_address_length == 0 then return true
  os_browser_address_length -= 1
  while os_browser_address_length > 0 and (mem.read8(ptr.add(os_browser_address_buffer, os_browser_address_length)) & 192) == 128 do
    os_browser_address_length -= 1
  end
  mem.write8(ptr.add(os_browser_address_buffer, os_browser_address_length), 0)
  os_browser_status_text is os_text_browser_status_ready
  return true
end

func os_browser_accept_packed(value: u64) do
  global os_browser_address_length, os_browser_status_text
  count: u64 is (value >> 56) & 7
  if count == 0 or count > 7 then return false
  if not os_browser_begin_edit() then return false
  if os_browser_address_length + count > 95 then return true
  index: u64 is 0
  while index < count do
    byte: u64 is (value >> (index * 8)) & 255
    if byte == 0 then return false
    index += 1
  end
  index is 0
  while index < count do
    mem.write8(ptr.add(os_browser_address_buffer, os_browser_address_length), (value >> (index * 8)) & 255)
    os_browser_address_length += 1
    index += 1
  end
  mem.write8(ptr.add(os_browser_address_buffer, os_browser_address_length), 0)
  os_browser_status_text is os_text_browser_status_ready
  return true
end

func os_browser_hex_digit(value: u64) do
  if value < 10 then return 48 + value
  return 65 + value - 10
end

func os_browser_path_started() do
  if os_browser_address_length == 0 then return false
  cursor: u64 is 0
  if os_browser_address_length >= 8 then
    has_https: bool is os_network_ascii_lower(mem.read8(os_browser_address_buffer)) == 104
    if has_https then has_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 1))) == 116
    if has_https then has_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 2))) == 116
    if has_https then has_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 3))) == 112
    if has_https then has_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 4))) == 115
    if has_https then has_https is mem.read8(ptr.add(os_browser_address_buffer, 5)) == 58
    if has_https then has_https is mem.read8(ptr.add(os_browser_address_buffer, 6)) == 47
    if has_https then has_https is mem.read8(ptr.add(os_browser_address_buffer, 7)) == 47
    if has_https then cursor is 8
  end
  if os_browser_address_length >= 7 then
    has_http: bool is os_network_ascii_lower(mem.read8(os_browser_address_buffer)) == 104
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 1))) == 116
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 2))) == 116
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 3))) == 112
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 4)) == 58
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 5)) == 47
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 6)) == 47
    if has_http then cursor is 7
  end
  while cursor < os_browser_address_length do
    if mem.read8(ptr.add(os_browser_address_buffer, cursor)) == 47 then return true
    cursor += 1
  end
  return false
end

func os_browser_parse_url() do
  global os_browser_hostname_length, os_browser_path_length, os_browser_status_text, os_browser_use_https
  os_browser_hostname_length is 0
  os_browser_path_length is 0
  # Scheme-less addresses use HTTPS by default. Plain HTTP remains available
  # only when the user explicitly types http://.
  os_browser_use_https is 1
  if not net_zero(os_browser_hostname_buffer, 256) then return false
  if not net_zero(os_browser_path_buffer, 512) then return false
  if os_browser_address_length == 0 then
    os_browser_status_text is os_text_browser_status_invalid
    return false
  end

  is_https: bool is false
  if os_browser_address_length >= 8 then
    is_https is os_network_ascii_lower(mem.read8(os_browser_address_buffer)) == 104
    if is_https then is_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 1))) == 116
    if is_https then is_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 2))) == 116
    if is_https then is_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 3))) == 112
    if is_https then is_https is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 4))) == 115
    if is_https then is_https is mem.read8(ptr.add(os_browser_address_buffer, 5)) == 58
    if is_https then is_https is mem.read8(ptr.add(os_browser_address_buffer, 6)) == 47
    if is_https then is_https is mem.read8(ptr.add(os_browser_address_buffer, 7)) == 47
  end
  cursor: u64 is 0
  has_http: bool is false
  if os_browser_address_length >= 7 then
    has_http is os_network_ascii_lower(mem.read8(os_browser_address_buffer)) == 104
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 1))) == 116
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 2))) == 116
    if has_http then has_http is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, 3))) == 112
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 4)) == 58
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 5)) == 47
    if has_http then has_http is mem.read8(ptr.add(os_browser_address_buffer, 6)) == 47
  end
  if is_https then
    cursor is 8
    os_browser_use_https is 1
  end
  if has_http then
    cursor is 7
    os_browser_use_https is 0
  end
  host_start: u64 is cursor
  while cursor < os_browser_address_length and mem.read8(ptr.add(os_browser_address_buffer, cursor)) != 47 do
    value: u64 is mem.read8(ptr.add(os_browser_address_buffer, cursor))
    if value <= 32 or value >= 127 or value == 58 then
      os_browser_status_text is os_text_browser_status_invalid
      return false
    end
    cursor += 1
  end
  os_browser_hostname_length is cursor - host_start
  if os_browser_hostname_length == 0 or os_browser_hostname_length > 253 then
    os_browser_status_text is os_text_browser_status_invalid
    return false
  end
  index: u64 is 0
  while index < os_browser_hostname_length do
    value: u64 is os_network_ascii_lower(mem.read8(ptr.add(os_browser_address_buffer, host_start + index)))
    mem.write8(ptr.add(os_browser_hostname_buffer, index), value)
    index += 1
  end
  mem.write8(ptr.add(os_browser_hostname_buffer, os_browser_hostname_length), 0)

  if cursor == os_browser_address_length then
    mem.write8(os_browser_path_buffer, 47)
    mem.write8(ptr.add(os_browser_path_buffer, 1), 0)
    os_browser_path_length is 1
    return true
  end
  source_path_length: u64 is os_browser_address_length - cursor
  if source_path_length == 0 or source_path_length > 250 then
    os_browser_status_text is os_text_browser_status_invalid
    return false
  end
  os_browser_path_length is 0
  index is 0
  while index < source_path_length do
    value: u64 is mem.read8(ptr.add(os_browser_address_buffer, cursor + index))
    encode: bool is value <= 32 or value >= 127
    if encode then
      if os_browser_path_length + 3 > 500 then
        os_browser_status_text is os_text_browser_status_invalid
        return false
      end
      mem.write8(ptr.add(os_browser_path_buffer, os_browser_path_length), 37)
      mem.write8(ptr.add(os_browser_path_buffer, os_browser_path_length + 1), os_browser_hex_digit((value >> 4) & 15))
      mem.write8(ptr.add(os_browser_path_buffer, os_browser_path_length + 2), os_browser_hex_digit(value & 15))
      os_browser_path_length += 3
    else
      mem.write8(ptr.add(os_browser_path_buffer, os_browser_path_length), value)
      os_browser_path_length += 1
    end
    index += 1
  end
  mem.write8(ptr.add(os_browser_path_buffer, os_browser_path_length), 0)
  return true
end

func os_browser_build_http_request() do
  global os_browser_http_request_length
  os_browser_http_request_length is 0
  if os_browser_hostname_length == 0 or os_browser_path_length == 0 then return false
  required: u64 is 4 + os_browser_path_length + 17 + os_browser_hostname_length + 56
  if required > 1023 then return false
  if not net_zero(os_network_http_request, 1024) then return false
  cursor: u64 is 0
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_get_prefix, 4) then return false
  cursor += 4
  if not net_copy(ptr.add(os_network_http_request, cursor), os_browser_path_buffer, os_browser_path_length) then return false
  cursor += os_browser_path_length
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_host_prefix, 17) then return false
  cursor += 17
  if not net_copy(ptr.add(os_network_http_request, cursor), os_browser_hostname_buffer, os_browser_hostname_length) then return false
  cursor += os_browser_hostname_length
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_close_suffix, 56) then return false
  cursor += 56
  mem.write8(ptr.add(os_network_http_request, cursor), 0)
  os_browser_http_request_length is cursor
  return true
end

func os_network_is_dns_udp(frame: ptr, frame_bytes: u64) do
  if frame == 0 or frame_bytes < 54 then return false
  if mem.read8(ptr.add(frame, 12)) != 8 or mem.read8(ptr.add(frame, 13)) != 0 then return false
  ip: ptr is ptr.add(frame, 14)
  if (mem.read8(ip) >> 4) != 4 then return false
  header_bytes: u64 is (mem.read8(ip) & 15) * 4
  if header_bytes < 20 or 14 + header_bytes + 8 > frame_bytes then return false
  if mem.read8(ptr.add(ip, 9)) != 17 then return false
  if net_checksum(ip, header_bytes) != 0 then return false
  if net_read_u32_be(ip, 12) != os_network_dns_ip then return false
  if net_read_u32_be(ip, 16) != os_network_local_ip then return false
  udp: ptr is ptr.add(ip, header_bytes)
  if net_read_u16_be(udp, 0) != 53 or net_read_u16_be(udp, 2) != 49152 then return false
  udp_bytes: u64 is net_read_u16_be(udp, 4)
  if udp_bytes < 20 or 14 + header_bytes + udp_bytes > frame_bytes then return false
  return true
end

func os_network_dns_query(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64) do
  if not os_network_dns_begin(context, hostname, hostname_bytes) then return false
  while true do
    status: u64 is os_network_dns_poll(context, 256)
    if status == 1 then return true
    if status == 2 then return false
    if not os_browser_cooperative_yield() then return false
    cpu.pause()
  end
  return false
end

func os_network_dns_begin(context: ptr[VirtioNetContext], hostname: ptr, hostname_bytes: u64) do
  global os_network_resolved_ip, os_network_dns_transaction_id, os_network_dns_async_deadline, os_network_dns_async_active
  if context == 0 or hostname == 0 or hostname_bytes == 0 then return false
  os_network_dns_async_active is 0
  os_network_resolved_ip is 0
  os_network_dns_transaction_id is (os_network_dns_transaction_id + 1) & 65535
  if os_network_dns_transaction_id == 0 then os_network_dns_transaction_id is 1
  query_bytes: u64 is net_dns_build_query(os_network_dns_query_buffer, 512, os_network_dns_transaction_id, hostname, hostname_bytes)
  if query_bytes == 0 then return false
  spec: ptr[NetUdpSpec] is os_network_udp_spec
  spec.destination_mac is os_network_dns_mac
  spec.source_mac is os_network_source_mac
  spec.source_ip is os_network_local_ip
  spec.destination_ip is os_network_dns_ip
  spec.source_port is 49152
  spec.destination_port is 53
  frame_bytes: u64 is net_build_ipv4_udp(os_network_tx_frame, 2048, spec, os_network_dns_query_buffer, query_bytes, 1)
  if frame_bytes == 0 then return false
  if not virtio_net_send(context, os_network_tx_frame, frame_bytes, 5000000) then return false
  base_mhz: u64 is 0
  if cpu.cpuid_eax(0, 0) >= 22 then base_mhz is cpu.cpuid_eax(22, 0) & 65535
  if base_mhz < 100 or base_mhz > 10000 then base_mhz is 2000
  now: u64 is cpu.rdtsc()
  os_network_dns_async_deadline is now + base_mhz * 1000 * 5000
  if os_network_dns_async_deadline < now then os_network_dns_async_deadline is u64("0xffffffffffffffff")
  os_network_dns_async_active is 1
  return true
end

func os_network_dns_poll(context: ptr[VirtioNetContext], receive_budget: u64) do
  global os_network_resolved_ip, os_network_dns_async_active
  if context == 0 or os_network_dns_async_active == 0 or receive_budget == 0 then return 2
  spins: u64 is 0
  while spins < receive_budget do
    received: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if received != 0 and os_network_is_dns_udp(os_network_rx_frame, received) then
      ip: ptr is ptr.add(os_network_rx_frame, 14)
      header_bytes: u64 is (mem.read8(ip) & 15) * 4
      udp: ptr is ptr.add(ip, header_bytes)
      dns: ptr is ptr.add(udp, 8)
      dns_bytes: u64 is net_read_u16_be(udp, 4) - 8
      os_network_resolved_ip is net_dns_first_a(dns, dns_bytes, os_network_dns_transaction_id)
      if os_network_resolved_ip != 0 then
        os_network_dns_async_active is 0
        return 1
      end
    end
    io.in8(context.io_base + 19)
    cpu.pause()
    spins += 1
  end
  if cpu.rdtsc() >= os_network_dns_async_deadline then
    os_network_dns_async_active is 0
    return 2
  end
  return 0
end

func os_network_dns_cache_load(hostname: ptr, hostname_bytes: u64) do
  if hostname == 0 or hostname_bytes == 0 then return 0
  if os_network_dns_cache_ip == 0 or hostname_bytes != os_network_dns_cache_name_length then return 0
  index: u64 is 0
  while index < hostname_bytes do
    current: u64 is os_network_ascii_lower(mem.read8(ptr.add(hostname, index)))
    cached: u64 is os_network_ascii_lower(mem.read8(ptr.add(os_network_dns_cache_name, index)))
    if current != cached then return 0
    index += 1
  end
  return os_network_dns_cache_ip
end

func os_network_dns_cache_store(hostname: ptr, hostname_bytes: u64, address: u64) do
  global os_network_dns_cache_ip, os_network_dns_cache_name_length
  if hostname == 0 or hostname_bytes == 0 or hostname_bytes > 253 then return false
  if address == 0 or address > u64("0xffffffff") then return false
  if not net_zero(os_network_dns_cache_name, 256) then return false
  if not net_copy(os_network_dns_cache_name, hostname, hostname_bytes) then return false
  os_network_dns_cache_name_length is hostname_bytes
  os_network_dns_cache_ip is address
  return true
end

func os_network_ipv4_literal(input: ptr, input_bytes: u64) do
  if input == 0 or input_bytes < 7 or input_bytes > 15 then return 0
  address: u64 is 0
  part_count: u64 is 0
  part_value: u64 is 0
  part_digits: u64 is 0
  cursor: u64 is 0
  while cursor <= input_bytes do
    value: u64 is 46
    if cursor < input_bytes then value is mem.read8(ptr.add(input, cursor))
    if value >= 48 and value <= 57 then
      if part_digits >= 3 then return 0
      part_value is part_value * 10 + value - 48
      if part_value > 255 then return 0
      part_digits += 1
    elif value == 46 then
      if part_digits == 0 or part_count >= 4 then return 0
      address is (address << 8) | part_value
      part_count += 1
      part_value is 0
      part_digits is 0
    else
      return 0
    end
    cursor += 1
  end
  if part_count != 4 or address == 0 then return 0
  return address
end

func os_network_is_http_tcp(frame: ptr, frame_bytes: u64) do
  if frame == 0 or frame_bytes < 54 then return false
  if mem.read8(ptr.add(frame, 12)) != 8 or mem.read8(ptr.add(frame, 13)) != 0 then return false
  ip: ptr is ptr.add(frame, 14)
  if (mem.read8(ip) >> 4) != 4 then return false
  ip_header_bytes: u64 is (mem.read8(ip) & 15) * 4
  if ip_header_bytes < 20 or 14 + ip_header_bytes + 20 > frame_bytes then return false
  total_bytes: u64 is net_read_u16_be(ip, 2)
  if total_bytes < ip_header_bytes + 20 or 14 + total_bytes > frame_bytes then return false
  if mem.read8(ptr.add(ip, 9)) != 6 or net_checksum(ip, ip_header_bytes) != 0 then return false
  if (net_read_u16_be(ip, 6) & 8191) != 0 then return false
  if net_read_u32_be(ip, 12) != os_network_resolved_ip then return false
  if net_read_u32_be(ip, 16) != os_network_local_ip then return false
  tcp: ptr is ptr.add(ip, ip_header_bytes)
  spec: ptr[NetTcpSpec] is os_network_tcp_spec
  if net_read_u16_be(tcp, 0) != spec.destination_port or net_read_u16_be(tcp, 2) != spec.source_port then return false
  tcp_header_bytes: u64 is (mem.read8(ptr.add(tcp, 12)) >> 4) * 4
  if tcp_header_bytes < 20 or tcp_header_bytes > total_bytes - ip_header_bytes then return false
  tcp_bytes: u64 is total_bytes - ip_header_bytes
  return net_tcp_checksum(os_network_resolved_ip, os_network_local_ip, tcp, tcp_bytes) == 0
end

func os_network_send_tcp(context: ptr[VirtioNetContext], payload: ptr, payload_bytes: u64, identification: u64) do
  frame_bytes: u64 is net_build_ipv4_tcp(os_network_tx_frame, 2048, os_network_tcp_spec, payload, payload_bytes, identification)
  if frame_bytes == 0 then return false
  return virtio_net_send(context, os_network_tx_frame, frame_bytes, 5000000)
end

func os_network_tcp_begin(context: ptr[VirtioNetContext], destination_port: u64) do
  global os_network_local_sequence, os_network_request_counter
  global os_network_tcp_packet_id, os_network_tcp_closed
  global os_network_tcp_async_deadline, os_network_tcp_async_initial_sequence
  global os_network_tcp_async_port, os_network_tcp_async_active, os_network_tcp_preconnected_port
  os_network_tcp_async_active is 0
  os_network_tcp_preconnected_port is 0
  if context == 0 or destination_port == 0 or destination_port > 65535 then return false
  if os_network_resolved_ip == 0 or os_network_gateway_mac == 0 then return false
  spec: ptr[NetTcpSpec] is os_network_tcp_spec
  spec.destination_mac is os_network_gateway_mac
  spec.source_mac is os_network_source_mac
  spec.source_ip is os_network_local_ip
  spec.destination_ip is os_network_resolved_ip
  os_network_request_counter is (os_network_request_counter + 1) & 1023
  spec.source_port is 49153 + os_network_request_counter
  spec.destination_port is destination_port
  spec.window is 64240
  os_network_tcp_async_initial_sequence is (u64("0x53555241") + os_network_request_counter * 4096) & u64("0xffffffff")
  spec.sequence is os_network_tcp_async_initial_sequence
  spec.acknowledgement is 0
  spec.flags is 2
  os_network_tcp_packet_id is 2
  os_network_tcp_closed is 0
  if not os_network_send_tcp(context, 0, 0, os_network_tcp_packet_id) then return false
  os_network_tcp_packet_id += 1
  base_mhz: u64 is 0
  if cpu.cpuid_eax(0, 0) >= 22 then base_mhz is cpu.cpuid_eax(22, 0) & 65535
  if base_mhz < 100 or base_mhz > 10000 then base_mhz is 2000
  now: u64 is cpu.rdtsc()
  os_network_tcp_async_deadline is now + base_mhz * 1000 * 5000
  if os_network_tcp_async_deadline < now then os_network_tcp_async_deadline is u64("0xffffffffffffffff")
  os_network_tcp_async_port is destination_port
  os_network_tcp_async_active is 1
  return true
end

func os_network_tcp_poll(context: ptr[VirtioNetContext], receive_budget: u64) do
  global os_network_remote_sequence, os_network_local_sequence
  global os_network_tcp_packet_id, os_network_tcp_closed
  global os_network_tcp_async_deadline, os_network_tcp_async_initial_sequence
  global os_network_tcp_async_port, os_network_tcp_async_active, os_network_tcp_preconnected_port
  if context == 0 or os_network_tcp_async_active == 0 or receive_budget == 0 then return 2
  spins: u64 is 0
  while spins < receive_budget do
    received: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if received != 0 and os_network_is_http_tcp(os_network_rx_frame, received) then
      ip: ptr is ptr.add(os_network_rx_frame, 14)
      ip_header_bytes: u64 is (mem.read8(ip) & 15) * 4
      tcp: ptr is ptr.add(ip, ip_header_bytes)
      flags: u64 is mem.read8(ptr.add(tcp, 13))
      if (flags & 4) != 0 then
        os_network_tcp_async_active is 0
        os_network_tcp_closed is 1
        return 2
      end
      expected_ack: u64 is (os_network_tcp_async_initial_sequence + 1) & u64("0xffffffff")
      if (flags & 18) == 18 and net_read_u32_be(tcp, 8) == expected_ack then
        os_network_remote_sequence is (net_read_u32_be(tcp, 4) + 1) & u64("0xffffffff")
        os_network_local_sequence is expected_ack
        spec: ptr[NetTcpSpec] is os_network_tcp_spec
        spec.sequence is os_network_local_sequence
        spec.acknowledgement is os_network_remote_sequence
        spec.flags is 16
        if not os_network_send_tcp(context, 0, 0, os_network_tcp_packet_id) then
          os_network_tcp_async_active is 0
          return 2
        end
        os_network_tcp_packet_id += 1
        os_network_tcp_preconnected_port is os_network_tcp_async_port
        os_network_tcp_async_active is 0
        return 1
      end
    end
    io.in8(context.io_base + 19)
    cpu.pause()
    spins += 1
  end
  if cpu.rdtsc() >= os_network_tcp_async_deadline then
    os_network_tcp_async_active is 0
    os_network_tcp_closed is 1
    return 2
  end
  return 0
end

func os_network_wait_syn_ack(context: ptr[VirtioNetContext], initial_sequence: u64) do
  global os_network_remote_sequence
  spins: u64 is 0
  while spins < 40000000 do
    received: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if received != 0 and os_network_is_http_tcp(os_network_rx_frame, received) then
      ip: ptr is ptr.add(os_network_rx_frame, 14)
      ip_header_bytes: u64 is (mem.read8(ip) & 15) * 4
      tcp: ptr is ptr.add(ip, ip_header_bytes)
      flags: u64 is mem.read8(ptr.add(tcp, 13))
      if (flags & 4) != 0 then return false
      if (flags & 18) == 18 and net_read_u32_be(tcp, 8) == ((initial_sequence + 1) & u64("0xffffffff")) then
        os_network_remote_sequence is (net_read_u32_be(tcp, 4) + 1) & u64("0xffffffff")
        return true
      end
    end
    io.in8(context.io_base + 19)
    if (spins & 4095) == 0 and not os_browser_cooperative_yield() then return false
    cpu.pause()
    spins += 1
  end
  return false
end

func os_network_tcp_open(context: ptr[VirtioNetContext], destination_port: u64) do
  global os_network_tcp_preconnected_port
  if context == 0 or destination_port == 0 or destination_port > 65535 then return false
  if os_network_tcp_preconnected_port != 0 then
    if os_network_tcp_preconnected_port != destination_port then return false
    os_network_tcp_preconnected_port is 0
    return true
  end
  if not os_network_tcp_begin(context, destination_port) then return false
  while true do
    status: u64 is os_network_tcp_poll(context, 256)
    if status == 1 then
      os_network_tcp_preconnected_port is 0
      return true
    end
    if status == 2 then return false
    if not os_browser_cooperative_yield() then return false
  end
  return false
end

func os_network_tcp_send_stream(context: ptr[VirtioNetContext], payload: ptr, payload_bytes: u64) do
  global os_network_local_sequence, os_network_tcp_packet_id
  if context == 0 or payload == 0 or payload_bytes == 0 then return false
  if os_network_tcp_closed != 0 then return false
  spec: ptr[NetTcpSpec] is os_network_tcp_spec
  cursor: u64 is 0
  while cursor < payload_bytes do
    chunk: u64 is payload_bytes - cursor
    if chunk > 1400 then chunk is 1400
    spec.sequence is os_network_local_sequence
    spec.acknowledgement is os_network_remote_sequence
    spec.flags is 24
    if not os_network_send_tcp(context, ptr.add(payload, cursor), chunk, os_network_tcp_packet_id) then return false
    os_network_tcp_packet_id += 1
    os_network_local_sequence is (os_network_local_sequence + chunk) & u64("0xffffffff")
    cursor is cursor + chunk
  end
  return true
end

func os_network_tcp_ack(context: ptr[VirtioNetContext]) do
  global os_network_tcp_packet_id
  if context == 0 then return false
  spec: ptr[NetTcpSpec] is os_network_tcp_spec
  spec.sequence is os_network_local_sequence
  spec.acknowledgement is os_network_remote_sequence
  spec.flags is 16
  if not os_network_send_tcp(context, 0, 0, os_network_tcp_packet_id) then return false
  os_network_tcp_packet_id += 1
  return true
end

func os_network_tcp_receive_some(context: ptr[VirtioNetContext], output: ptr, output_capacity: u64, spin_limit: u64) do
  global os_network_remote_sequence, os_network_tcp_closed
  if context == 0 or output == 0 or output_capacity == 0 or spin_limit == 0 then return 0
  spins: u64 is 0
  while spins < spin_limit do
    received: u64 is virtio_net_receive(context, os_network_rx_frame, 2048)
    if received != 0 and os_network_is_http_tcp(os_network_rx_frame, received) then
      ip: ptr is ptr.add(os_network_rx_frame, 14)
      ip_header_bytes: u64 is (mem.read8(ip) & 15) * 4
      total_bytes: u64 is net_read_u16_be(ip, 2)
      tcp: ptr is ptr.add(ip, ip_header_bytes)
      tcp_header_bytes: u64 is (mem.read8(ptr.add(tcp, 12)) >> 4) * 4
      tcp_bytes: u64 is total_bytes - ip_header_bytes
      if tcp_header_bytes > tcp_bytes then return 0
      data_bytes: u64 is tcp_bytes - tcp_header_bytes
      flags: u64 is mem.read8(ptr.add(tcp, 13))
      sequence: u64 is net_read_u32_be(tcp, 4)
      if (flags & 4) != 0 then
        os_network_tcp_closed is 1
        return 0
      end
      if sequence == os_network_remote_sequence then
        if data_bytes > output_capacity then return 0
        if data_bytes != 0 then
          if not net_copy(output, ptr.add(tcp, tcp_header_bytes), data_bytes) then return 0
          os_network_remote_sequence is (os_network_remote_sequence + data_bytes) & u64("0xffffffff")
        end
        if (flags & 1) != 0 then
          os_network_remote_sequence is (os_network_remote_sequence + 1) & u64("0xffffffff")
          os_network_tcp_closed is 1
        end
        if data_bytes != 0 or (flags & 1) != 0 then
          if not os_network_tcp_ack(context) then return 0
        end
        if data_bytes != 0 then return data_bytes
        if os_network_tcp_closed != 0 then
          return 0
        end
      else
        if data_bytes != 0 or (flags & 1) != 0 then
          if not os_network_tcp_ack(context) then return 0
        end
      end
    end
    io.in8(context.io_base + 19)
    if (spins & 4095) == 0 and not os_browser_cooperative_yield() then return 0
    cpu.pause()
    spins += 1
  end
  return 0
end

func os_network_tcp_receive_poll(context: ptr[VirtioNetContext], output: ptr, output_capacity: u64, receive_budget: u64) do
  # A deliberately small receive budget lets the desktop loop regain control
  # between packets. Packet validation, ACK handling, and sequence tracking
  # remain centralized in the normal TCP receive path.
  return os_network_tcp_receive_some(context, output, output_capacity, receive_budget)
end

func os_network_tcp_close(context: ptr[VirtioNetContext]) do
  global os_network_local_sequence, os_network_tcp_packet_id, os_network_tcp_closed
  if context == 0 then return false
  if os_network_tcp_closed != 0 then return true
  spec: ptr[NetTcpSpec] is os_network_tcp_spec
  spec.sequence is os_network_local_sequence
  spec.acknowledgement is os_network_remote_sequence
  spec.flags is 17
  if not os_network_send_tcp(context, 0, 0, os_network_tcp_packet_id) then return false
  os_network_tcp_packet_id += 1
  os_network_local_sequence is (os_network_local_sequence + 1) & u64("0xffffffff")
  os_network_tcp_closed is 1
  return true
end

func os_network_http_finish(connection_closed: bool) do
  global os_browser_length
  info: ptr[Http1ResponseInfo] is os_http_response_info
  state: u64 is http1_response_inspect(os_browser_buffer, os_browser_length, connection_closed, info)
  if state != 1 then return false
  mem.write64(os_http_response_length_state, os_browser_length)
  if not http1_response_decode_content(os_browser_buffer, os_http_response_length_state, 2097152, info, os_http_content_workspace, 2101248) then return false
  os_browser_length is mem.read64(os_http_response_length_state)
  if os_browser_length >= 2097152 then return false
  mem.write8(ptr.add(os_browser_buffer, os_browser_length), 0)
  return true
end

func os_network_http_receive(context: ptr[VirtioNetContext]) do
  global os_browser_length
  if context == 0 then return false
  os_browser_length is 0
  mem.write8(os_browser_buffer, 0)
  attempts: u64 is 0
  while attempts < 64 do
    if os_browser_length >= 2097151 then
      os_network_tcp_close(context)
      return false
    end
    received: u64 is os_network_tcp_receive_some(context, ptr.add(os_browser_buffer, os_browser_length), 2097151 - os_browser_length, 2000000)
    if received != 0 then
      os_browser_length += received
      mem.write8(ptr.add(os_browser_buffer, os_browser_length), 0)
      state: u64 is http1_response_inspect(os_browser_buffer, os_browser_length, false, os_http_response_info)
      if state == 2 then
        os_network_tcp_close(context)
        return false
      end
      if state == 1 then
        if not os_network_http_finish(false) then
          os_network_tcp_close(context)
          return false
        end
        os_network_tcp_close(context)
        return true
      end
    else
      if os_network_tcp_closed != 0 then
        return os_network_http_finish(true)
      end
    end
    attempts += 1
  end
  os_network_tcp_close(context)
  return false
end

func os_network_http_get(context: ptr[VirtioNetContext], request: ptr, request_bytes: u64) do
  if context == 0 or request == 0 or request_bytes == 0 or request_bytes > 1460 then return false
  if not os_network_tcp_open(context, 80) then return false
  if not os_network_tcp_send_stream(context, request, request_bytes) then
    os_network_tcp_close(context)
    return false
  end
  return os_network_http_receive(context)
end

func os_network_ascii_lower(value: u64) do
  if value >= 65 and value <= 90 then return value + 32
  return value
end

func os_browser_css_hex_digit(value: u64) do
  if value >= 48 and value <= 57 then return value - 48
  value is os_network_ascii_lower(value)
  if value >= 97 and value <= 102 then return value - 87
  return 16
end

func os_browser_css_color_after(cursor: u64, limit: u64) do
  while cursor < limit and mem.read8(ptr.add(os_browser_buffer, cursor)) != 58 do
    cursor += 1
  end
  if cursor >= limit then return 0
  cursor += 1
  while cursor < limit and mem.read8(ptr.add(os_browser_buffer, cursor)) <= 32 do
    cursor += 1
  end
  if cursor + 3 >= limit or mem.read8(ptr.add(os_browser_buffer, cursor)) != 35 then return 0
  cursor += 1
  first: u64 is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor)))
  second: u64 is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + 1)))
  third: u64 is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + 2)))
  if first > 15 or second > 15 or third > 15 then return 0
  six_digits: bool is cursor + 5 < limit
  if six_digits then six_digits is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + 3))) < 16
  if six_digits then six_digits is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + 4))) < 16
  if six_digits then six_digits is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + 5))) < 16
  if not six_digits then
    color: u64 is (first * 17 << 16) | (second * 17 << 8) | (third * 17)
    return u64("0x1000000") | color
  end
  color: u64 is 0
  index: u64 is 0
  while index < 6 do
    digit: u64 is os_browser_css_hex_digit(mem.read8(ptr.add(os_browser_buffer, cursor + index)))
    if digit > 15 then return 0
    color is (color << 4) | digit
    index += 1
  end
  return u64("0x1000000") | color
end

func os_browser_parse_css() do
  global os_browser_css_page_rgb, os_browser_css_card_rgb, os_browser_css_text_rgb, os_browser_css_heading_rgb, os_browser_css_link_rgb, os_browser_css_rule_count
  os_browser_css_page_rgb is u64("0xf6f9fc")
  os_browser_css_card_rgb is u64("0xffffff")
  os_browser_css_text_rgb is u64("0x0c182c")
  os_browser_css_heading_rgb is u64("0xff6623")
  os_browser_css_link_rgb is u64("0x105b84")
  os_browser_css_rule_count is 0
  limit: u64 is os_browser_body_start()
  if limit == 0 or limit > os_browser_length then limit is os_browser_length
  selector_start: u64 is 0
  cursor: u64 is 0
  while cursor < limit do
    open: u64 is cursor
    while open < limit and mem.read8(ptr.add(os_browser_buffer, open)) != 123 do
      open += 1
    end
    if open >= limit then break
    close: u64 is open + 1
    while close < limit and mem.read8(ptr.add(os_browser_buffer, close)) != 125 do
      close += 1
    end
    if close >= limit then break

    body_selector: bool is false
    div_selector: bool is false
    heading_selector: bool is false
    link_selector: bool is false
    scan: u64 is selector_start
    while scan < open do
      first: u64 is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan)))
      if first == 98 and scan + 3 < open then
        if os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan + 1))) == 111 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan + 2))) == 100 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan + 3))) == 121 then body_selector is true
      end
      if first == 100 and scan + 2 < open then
        if os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan + 1))) == 105 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, scan + 2))) == 118 then div_selector is true
      end
      if first == 104 and scan + 1 < open and mem.read8(ptr.add(os_browser_buffer, scan + 1)) == 49 then heading_selector is true
      if first == 97 then
        previous_ok: bool is scan == selector_start
        if not previous_ok then
          previous: u64 is mem.read8(ptr.add(os_browser_buffer, scan - 1))
          previous_ok is previous <= 32 or previous == 44 or previous == 62
        end
        next_ok: bool is scan + 1 >= open
        if not next_ok then
          next: u64 is mem.read8(ptr.add(os_browser_buffer, scan + 1))
          next_ok is next <= 32 or next == 44 or next == 58 or next == 123
        end
        if previous_ok and next_ok then link_selector is true
      end
      scan += 1
    end

    declaration: u64 is open + 1
    while declaration < close do
      first: u64 is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration)))
      background_property_length: u64 is 0
      background_name: bool is first == 98 and declaration + 9 < close
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 1))) == 97
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 2))) == 99
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 3))) == 107
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 4))) == 103
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 5))) == 114
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 6))) == 111
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 7))) == 117
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 8))) == 110
      if background_name then background_name is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 9))) == 100
      if background_name then background_property_length is 10
      if background_name and declaration + 15 < close and mem.read8(ptr.add(os_browser_buffer, declaration + 10)) == 45 then
        background_color: bool is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 11))) == 99
        if background_color then background_color is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 12))) == 111
        if background_color then background_color is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 13))) == 108
        if background_color then background_color is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 14))) == 111
        if background_color then background_color is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 15))) == 114
        if background_color then background_property_length is 16
      end
      if background_property_length != 0 then
        parsed: u64 is os_browser_css_color_after(declaration + background_property_length, close)
        if parsed != 0 and body_selector then
          os_browser_css_page_rgb is parsed & u64("0xffffff")
          os_browser_css_rule_count += 1
        end
        if parsed != 0 and div_selector then
          os_browser_css_card_rgb is parsed & u64("0xffffff")
          os_browser_css_rule_count += 1
        end
        declaration += background_property_length
      else
        color_property: bool is first == 99 and declaration + 4 < close
        if color_property then color_property is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 1))) == 111
        if color_property then color_property is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 2))) == 108
        if color_property then color_property is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 3))) == 111
        if color_property then color_property is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, declaration + 4))) == 114
        if color_property then
          parsed: u64 is os_browser_css_color_after(declaration + 5, close)
          if parsed != 0 and body_selector then
            os_browser_css_text_rgb is parsed & u64("0xffffff")
            os_browser_css_rule_count += 1
          end
          if parsed != 0 and heading_selector then
            os_browser_css_heading_rgb is parsed & u64("0xffffff")
            os_browser_css_rule_count += 1
          end
          if parsed != 0 and link_selector then
            os_browser_css_link_rgb is parsed & u64("0xffffff")
            os_browser_css_rule_count += 1
          end
          declaration += 5
        else
          declaration += 1
        end
      end
    end
    selector_start is close + 1
    cursor is close + 1
  end
  return true
end

func os_browser_prepare_text() do
  global os_browser_text_length
  os_browser_text_length is 0
  mem.write8(os_browser_text_buffer, 0)
  if os_browser_length < 12 then return false
  input: u64 is 0
  while input + 3 < os_browser_length do
    if mem.read8(ptr.add(os_browser_buffer, input)) == 13 and mem.read8(ptr.add(os_browser_buffer, input + 1)) == 10 and mem.read8(ptr.add(os_browser_buffer, input + 2)) == 13 and mem.read8(ptr.add(os_browser_buffer, input + 3)) == 10 then
      input += 4
      break
    end
    input += 1
  end
  if input >= os_browser_length then return false
  search: u64 is input
  body_start: u64 is 0
  while search + 4 < os_browser_length do
    if mem.read8(ptr.add(os_browser_buffer, search)) == 60 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, search + 1))) == 98 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, search + 2))) == 111 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, search + 3))) == 100 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, search + 4))) == 121 then
      body_start is search + 5
      while body_start < os_browser_length and mem.read8(ptr.add(os_browser_buffer, body_start)) != 62 do
        body_start += 1
      end
      if body_start < os_browser_length then body_start += 1
      break
    end
    search += 1
  end
  if body_start != 0 and body_start < os_browser_length then input is body_start

  in_tag: u64 is 0
  pending_space: u64 is 0
  column: u64 is 0
  while input < os_browser_length and os_browser_text_length + 1 < 4096 do
    value: u64 is mem.read8(ptr.add(os_browser_buffer, input))
    if value == 60 then
      in_tag is 1
      pending_space is 1
    else
      if value == 62 and in_tag != 0 then
        in_tag is 0
      else
        if in_tag == 0 then
          if value == 9 or value == 10 or value == 13 or value == 32 then
            pending_space is 1
          else
            codepoint: u64 is font_utf8_next(os_browser_buffer, os_browser_length, input, addr_of(font_utf8_consumed))
            consumed: u64 is font_utf8_consumed
            if consumed == 0 or consumed > os_browser_length - input then return false
            if codepoint == 160 then pending_space is 1
            if codepoint >= 33 and codepoint != 160 then
              advance: u64 is 1
              if codepoint >= 44032 and codepoint <= 55203 then advance is 2
              if pending_space != 0 and os_browser_text_length != 0 then
                if column >= 96 then
                  mem.write8(ptr.add(os_browser_text_buffer, os_browser_text_length), 10)
                  os_browser_text_length += 1
                  column is 0
                else
                  mem.write8(ptr.add(os_browser_text_buffer, os_browser_text_length), 32)
                  os_browser_text_length += 1
                  column += 1
                end
              end
              pending_space is 0
              if os_browser_text_length + consumed + 1 >= 4096 then return os_browser_text_length != 0
              if not net_copy(ptr.add(os_browser_text_buffer, os_browser_text_length), ptr.add(os_browser_buffer, input), consumed) then return false
              os_browser_text_length += consumed
              column += advance
              if column >= 104 and os_browser_text_length + 1 < 4096 then
                mem.write8(ptr.add(os_browser_text_buffer, os_browser_text_length), 10)
                os_browser_text_length += 1
                column is 0
              end
            end
            input is input + consumed - 1
          end
        end
      end
    end
    input += 1
  end
  mem.write8(ptr.add(os_browser_text_buffer, os_browser_text_length), 0)
  return os_browser_text_length != 0
end

func os_browser_layout_break(next_style: u64) do
  global os_browser_layout_line_count, os_browser_layout_line, os_browser_layout_column, os_browser_layout_bytes
  global os_browser_layout_style, os_browser_layout_pending_space
  if next_style > 2 then return false
  if os_browser_layout_line_count == 0 then
    os_browser_layout_line_count is 1
    os_browser_layout_line is 0
  else
    if os_browser_layout_column != 0 then
      if os_browser_layout_line + 1 >= 32 then return false
      os_browser_layout_line += 1
      if os_browser_layout_line_count < os_browser_layout_line + 1 then
        os_browser_layout_line_count is os_browser_layout_line + 1
      end
    end
  end
  os_browser_layout_column is 0
  os_browser_layout_bytes is 0
  os_browser_layout_style is next_style
  os_browser_layout_pending_space is 0
  mem.write8(ptr.add(os_browser_layout_styles, os_browser_layout_line), next_style)
  mem.write8(ptr.add(os_browser_layout_lines, os_browser_layout_line * 256), 0)
  return true
end

func os_browser_layout_put(input: ptr, input_bytes: u64, codepoint: u64) do
  global os_browser_layout_line_count, os_browser_layout_line, os_browser_layout_column, os_browser_layout_bytes
  global os_browser_layout_style, os_browser_layout_pending_space
  if input == 0 or input_bytes == 0 or input_bytes > 4 then return false
  if codepoint < 33 then return false
  max_columns: u64 is 90
  if os_browser_layout_style == 1 then max_columns is 56
  advance: u64 is 1
  if codepoint >= 44032 and codepoint <= 55203 then advance is 2
  if os_browser_layout_pending_space != 0 and os_browser_layout_column != 0 then
    if os_browser_layout_column < max_columns then
      if os_browser_layout_bytes + 1 >= 256 then return false
      offset: u64 is os_browser_layout_line * 256 + os_browser_layout_bytes
      mem.write8(ptr.add(os_browser_layout_lines, offset), 32)
      os_browser_layout_bytes += 1
      os_browser_layout_column += 1
    end
    if os_browser_layout_column >= max_columns then
      if not os_browser_layout_break(os_browser_layout_style) then return false
    end
  end
  os_browser_layout_pending_space is 0
  if os_browser_layout_column + advance > max_columns then
    if not os_browser_layout_break(os_browser_layout_style) then return false
  end
  if os_browser_layout_bytes + input_bytes >= 256 then
    if not os_browser_layout_break(os_browser_layout_style) then return false
  end
  offset: u64 is os_browser_layout_line * 256 + os_browser_layout_bytes
  if not net_copy(ptr.add(os_browser_layout_lines, offset), input, input_bytes) then return false
  os_browser_layout_bytes += input_bytes
  os_browser_layout_column += advance
  mem.write8(ptr.add(os_browser_layout_lines, os_browser_layout_line * 256 + os_browser_layout_bytes), 0)
  if os_browser_layout_line_count < os_browser_layout_line + 1 then
    os_browser_layout_line_count is os_browser_layout_line + 1
  end
  return true
end

func os_browser_body_start() do
  if os_browser_length < 12 then return 0
  input: u64 is 0
  while input + 3 < os_browser_length do
    if mem.read8(ptr.add(os_browser_buffer, input)) == 13 and mem.read8(ptr.add(os_browser_buffer, input + 1)) == 10 and mem.read8(ptr.add(os_browser_buffer, input + 2)) == 13 and mem.read8(ptr.add(os_browser_buffer, input + 3)) == 10 then
      input += 4
      break
    end
    input += 1
  end
  while input + 4 < os_browser_length do
    if mem.read8(ptr.add(os_browser_buffer, input)) == 60 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, input + 1))) == 98 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, input + 2))) == 111 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, input + 3))) == 100 and os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, input + 4))) == 121 then
      while input < os_browser_length and mem.read8(ptr.add(os_browser_buffer, input)) != 62 do
        input += 1
      end
      if input < os_browser_length then return input + 1
      return 0
    end
    input += 1
  end
  return 0
end

func os_browser_layout_tag(input: u64) do
  if input >= os_browser_length or mem.read8(ptr.add(os_browser_buffer, input)) != 60 then return os_browser_length
  global os_browser_layout_skip_element
  tag: u64 is input + 1
  closing: bool is false
  if tag < os_browser_length and mem.read8(ptr.add(os_browser_buffer, tag)) == 47 then
    closing is true
    tag += 1
  end
  first: u64 is 0
  second: u64 is 0
  if tag < os_browser_length then first is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag)))
  if tag + 1 < os_browser_length then second is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 1)))
  script_tag: bool is tag + 6 <= os_browser_length
  if script_tag then script_tag is first == 115
  if script_tag then script_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 1))) == 99
  if script_tag then script_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 2))) == 114
  if script_tag then script_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 3))) == 105
  if script_tag then script_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 4))) == 112
  if script_tag then script_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 5))) == 116
  style_tag: bool is tag + 5 <= os_browser_length
  if style_tag then style_tag is first == 115
  if style_tag then style_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 1))) == 116
  if style_tag then style_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 2))) == 121
  if style_tag then style_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 3))) == 108
  if style_tag then style_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 4))) == 101
  noscript_tag: bool is tag + 8 <= os_browser_length
  if noscript_tag then noscript_tag is first == 110
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 1))) == 111
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 2))) == 115
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 3))) == 99
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 4))) == 114
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 5))) == 105
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 6))) == 112
  if noscript_tag then noscript_tag is os_network_ascii_lower(mem.read8(ptr.add(os_browser_buffer, tag + 7))) == 116
  if script_tag and not closing then os_browser_layout_skip_element is 1
  if script_tag and closing and os_browser_layout_skip_element == 1 then os_browser_layout_skip_element is 0
  if style_tag and not closing then os_browser_layout_skip_element is 2
  if style_tag and closing and os_browser_layout_skip_element == 2 then os_browser_layout_skip_element is 0
  if noscript_tag and not closing then os_browser_layout_skip_element is 3
  if noscript_tag and closing and os_browser_layout_skip_element == 3 then os_browser_layout_skip_element is 0
  if os_browser_layout_skip_element == 0 then
    if first == 104 and second == 49 and not closing then os_browser_layout_break(1)
    if first == 104 and second == 49 and closing then os_browser_layout_break(0)
    if first == 112 then os_browser_layout_break(0)
    if first == 97 and not closing then os_browser_layout_break(2)
    if first == 97 and closing then os_browser_layout_break(0)
    if first == 98 and second == 114 and not closing then os_browser_layout_break(os_browser_layout_style)
  end
  while input < os_browser_length and mem.read8(ptr.add(os_browser_buffer, input)) != 62 do
    input += 1
  end
  return input
end

func os_browser_prepare_layout() do
  global os_browser_layout_line_count, os_browser_layout_line, os_browser_layout_column, os_browser_layout_bytes
  global os_browser_layout_style, os_browser_layout_pending_space, os_browser_layout_skip_element
  if not net_zero(os_browser_layout_lines, 8192) then return false
  if not net_zero(os_browser_layout_styles, 32) then return false
  os_browser_layout_line_count is 0
  os_browser_layout_line is 0
  os_browser_layout_column is 0
  os_browser_layout_bytes is 0
  os_browser_layout_style is 0
  os_browser_layout_pending_space is 0
  os_browser_layout_skip_element is 0
  input: u64 is os_browser_body_start()
  if input == 0 then return false
  if not os_browser_layout_break(0) then return false
  while input < os_browser_length and os_browser_layout_line < 32 do
    value: u64 is mem.read8(ptr.add(os_browser_buffer, input))
    if value == 60 then
      input is os_browser_layout_tag(input)
    else
      if os_browser_layout_skip_element == 0 then
        if value == 9 or value == 10 or value == 13 or value == 32 then
          os_browser_layout_pending_space is 1
        else
          codepoint: u64 is font_utf8_next(os_browser_buffer, os_browser_length, input, addr_of(font_utf8_consumed))
          consumed: u64 is font_utf8_consumed
          if consumed == 0 or consumed > os_browser_length - input then return false
          if codepoint >= 33 then
            if not os_browser_layout_put(ptr.add(os_browser_buffer, input), consumed, codepoint) then return os_browser_layout_line_count != 0
          end
          input is input + consumed - 1
        end
      end
    end
    input += 1
  end
  return os_browser_layout_line_count != 0
end

func os_browser_response_body_start() do
  if os_browser_length < 4 then return 0
  cursor: u64 is 0
  while cursor + 3 < os_browser_length do
    if mem.read8(ptr.add(os_browser_buffer, cursor)) == 13 and mem.read8(ptr.add(os_browser_buffer, cursor + 1)) == 10 and mem.read8(ptr.add(os_browser_buffer, cursor + 2)) == 13 and mem.read8(ptr.add(os_browser_buffer, cursor + 3)) == 10 then
      return cursor + 4
    end
    cursor += 1
  end
  return 0
end

func os_browser_collect_dom_css(document: ptr[HtmlDomDocument]) do
  global os_browser_dom_css_length
  os_browser_dom_css_length is 0
  if document == 0 or not net_zero(os_browser_dom_css_source, 32768) then return false
  node_index: u64 is 0
  while node_index < document.node_count do
    node: ptr[HtmlDomNode] is html_dom_node(document, node_index)
    if node.kind == 1 and node.tag == 16 then
      child_index: u64 is node.first_child
      while child_index != u64("0xffffffffffffffff") do
        child: ptr[HtmlDomNode] is html_dom_node(document, child_index)
        if child == 0 then return false
        if child.kind == 2 and child.source_bytes != 0 then
          if os_browser_dom_css_length != 0 then
            if os_browser_dom_css_length + 1 >= 32768 then return false
            mem.write8(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), 32)
            os_browser_dom_css_length += 1
          end
          if child.source_bytes > 32767 - os_browser_dom_css_length then return false
          if not net_copy(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), ptr.add(document.input, child.source_start), child.source_bytes) then return false
          os_browser_dom_css_length += child.source_bytes
        end
        child_index is child.next_sibling
      end
    end
    node_index += 1
  end
  mem.write8(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), 0)
  return true
end

func os_browser_build_resource_request(path: ptr, path_bytes: u64) do
  global os_browser_http_request_length
  os_browser_http_request_length is 0
  if path == 0 or path_bytes == 0 or path_bytes > 900 or os_browser_hostname_length == 0 then return false
  required: u64 is 4 + path_bytes + 17 + os_browser_hostname_length + 56
  if required > 1023 then return false
  if not net_zero(os_network_http_request, 1024) then return false
  cursor: u64 is 0
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_get_prefix, 4) then return false
  cursor += 4
  if not net_copy(ptr.add(os_network_http_request, cursor), path, path_bytes) then return false
  cursor += path_bytes
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_host_prefix, 17) then return false
  cursor += 17
  if not net_copy(ptr.add(os_network_http_request, cursor), os_browser_hostname_buffer, os_browser_hostname_length) then return false
  cursor += os_browser_hostname_length
  if not net_copy(ptr.add(os_network_http_request, cursor), os_network_http_close_suffix, 56) then return false
  cursor += 56
  mem.write8(ptr.add(os_network_http_request, cursor), 0)
  os_browser_http_request_length is cursor
  return true
end

func os_browser_fetch_dom_stylesheet(document: ptr[HtmlDomDocument]) do
  global os_browser_dom_css_length, os_browser_dom_external_css_loaded
  os_browser_dom_external_css_loaded is 0
  if document == 0 then return false
  node_index: u64 is 0
  while node_index < document.node_count do
    node: ptr[HtmlDomNode] is html_dom_node(document, node_index)
    if node.kind == 1 and node.tag == 20 then
      relationship: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, node_index, 12)
      href: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, node_index, 3)
      stylesheet_link: bool is relationship != 0 and relationship.has_value != 0
      if stylesheet_link then stylesheet_link is html_dom_token_equal(document.input, relationship.source_start, relationship.source_bytes, os_browser_stylesheet_value, 10)
      if stylesheet_link and href != 0 and href.has_value != 0 and href.source_bytes != 0 then
        if mem.read8(ptr.add(document.input, href.source_start)) != 47 then return true
        if not os_browser_build_resource_request(ptr.add(document.input, href.source_start), href.source_bytes) then return true
        request_ok: bool is false
        if os_browser_use_https != 0 then request_ok is os_network_https_get(os_network_context, os_browser_hostname_buffer, os_browser_hostname_length, os_network_http_request, os_browser_http_request_length)
        if os_browser_use_https == 0 then request_ok is os_network_http_get(os_network_context, os_network_http_request, os_browser_http_request_length)
        if not request_ok then return true
        status_code: u64 is os_browser_http_status_code()
        if status_code < 200 or status_code >= 300 then return true
        css_start: u64 is os_browser_response_body_start()
        if css_start == 0 or css_start >= os_browser_length then return true
        css_bytes: u64 is os_browser_length - css_start
        if css_bytes > 32767 - os_browser_dom_css_length then return true
        if os_browser_dom_css_length != 0 then
          mem.write8(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), 32)
          os_browser_dom_css_length += 1
        end
        if not net_copy(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), ptr.add(os_browser_buffer, css_start), css_bytes) then return true
        os_browser_dom_css_length += css_bytes
        mem.write8(ptr.add(os_browser_dom_css_source, os_browser_dom_css_length), 0)
        os_browser_dom_external_css_loaded is 1
        if not os_serial_cstr_line(os_browser_external_css_marker) then return false
        return true
      end
    end
    node_index += 1
  end
  return true
end

func os_browser_dom_legacy_colors(document: ptr[HtmlDomDocument]) do
  if document == 0 then return false
  index: u64 is 0
  while index < document.node_count do
    node: ptr[HtmlDomNode] is html_dom_node(document, index)
    style: ptr[CssComputedStyle] is ptr.add(os_browser_dom_computed, index * 288)
    if node.kind == 1 then
      if node.tag == 3 then
        style.color is os_browser_css_text_rgb
        style.background is os_browser_css_page_rgb
      end
      if node.tag == 4 then style.background is os_browser_css_card_rgb
      if node.tag >= 6 and node.tag <= 11 then style.color is os_browser_css_heading_rgb
      if node.tag == 12 then style.color is os_browser_css_link_rgb
    end
    index += 1
  end
  return true
end

func os_browser_collect_inline_scripts(document: ptr[HtmlDomDocument]) do
  global os_browser_js_source_length
  os_browser_js_source_length is 0
  if document == 0 or not net_zero(os_browser_js_source, 16384) then return false
  node_index: u64 is 0
  while node_index < document.node_count do
    node: ptr[HtmlDomNode] is html_dom_node(document, node_index)
    if node != 0 and node.kind == 1 and node.tag == 17 and html_dom_find_attribute(document, node_index, 4) == 0 then
      child_index: u64 is node.first_child
      while child_index != u64("0xffffffffffffffff") do
        child: ptr[HtmlDomNode] is html_dom_node(document, child_index)
        if child == 0 then return false
        if child.kind == 2 and child.source_bytes != 0 then
          if child.source_bytes > 16382 - os_browser_js_source_length then return false
          if not net_copy(ptr.add(os_browser_js_source, os_browser_js_source_length), ptr.add(document.input, child.source_start), child.source_bytes) then return false
          os_browser_js_source_length += child.source_bytes
          mem.write8(ptr.add(os_browser_js_source, os_browser_js_source_length), 10)
          os_browser_js_source_length += 1
        end
        child_index is child.next_sibling
      end
    end
    node_index += 1
  end
  mem.write8(ptr.add(os_browser_js_source, os_browser_js_source_length), 0)
  return true
end

func os_browser_execute_script(source: ptr, source_bytes: u64) do
  global os_browser_js_executed, os_browser_js_error
  os_browser_js_error is 0
  if source == 0 or source_bytes == 0 then return true

  compiler: ptr[BrowserJsSourceCompiler] is os_browser_js_compiler
  compiler.code is os_browser_js_code
  compiler.code_capacity is 512
  compiler.constants is os_browser_js_constants
  compiler.constant_capacity is 128
  compiler.bindings is os_browser_js_bindings
  compiler.binding_capacity is 128
  program: ptr[BrowserJsProgram] is os_browser_js_program
  if not browser_js_source_compile(source, source_bytes, program, compiler) then
    os_browser_js_error is 100 + compiler.error
    return true
  end

  vm: ptr[BrowserJsVm] is os_browser_js_vm
  vm.stack is os_browser_js_stack
  vm.stack_capacity is 64
  vm.globals is os_browser_js_globals
  vm.global_capacity is 128
  vm.scratch is os_browser_js_scratch
  vm.instruction_limit is 8192
  vm.host_context is os_browser_js_dom_host
  vm.host_callback is addr_of(browser_js_dom_host_call)
  if not browser_js_vm_init(program, vm) then
    os_browser_js_error is 2
    return true
  end
  if not browser_js_execute(vm) then
    os_browser_js_error is 200 + vm.error
    return true
  end
  os_browser_js_executed is 1
  if not os_serial_cstr_line(os_browser_js_marker) then return false
  return true
end

func os_browser_run_inline_scripts(document: ptr[HtmlDomDocument]) do
  global os_browser_js_executed, os_browser_js_error
  os_browser_js_executed is 0
  os_browser_js_error is 0
  if not os_browser_collect_inline_scripts(document) then
    os_browser_js_error is 1
    return true
  end
  if os_browser_js_source_length == 0 then return true
  return os_browser_execute_script(os_browser_js_source, os_browser_js_source_length)
end

func os_browser_prepare_dom_layout(viewport_width: u64, viewport_height: u64) do
  global os_browser_dom_ready, os_browser_dom_box_count
  global os_browser_dom_viewport_width, os_browser_dom_viewport_height
  global os_browser_dom_render_reported, os_browser_dom_render_error
  global os_browser_dom_css_variable_count, os_browser_form_editing
  global os_browser_js_click_reported
  os_browser_dom_ready is 0
  os_browser_dom_box_count is 0
  os_browser_dom_render_reported is 0
  os_browser_dom_render_error is 0
  os_browser_js_click_reported is 0
  if viewport_width == 0 or viewport_height == 0 then return false
  body_start: u64 is os_browser_response_body_start()
  if body_start == 0 or body_start >= os_browser_length then return false
  body_bytes: u64 is os_browser_length - body_start
  if body_bytes > 65535 then return false
  if not net_zero(os_browser_dom_html, 65536) then return false
  if not net_copy(os_browser_dom_html, ptr.add(os_browser_buffer, body_start), body_bytes) then return false
  mem.write8(ptr.add(os_browser_dom_html, body_bytes), 0)
  document: ptr[HtmlDomDocument] is os_browser_dom_document
  document.nodes is os_browser_dom_nodes
  document.node_capacity is 1024
  document.attributes is os_browser_dom_attributes
  document.attribute_capacity is 1024
  if not html_dom_parse(os_browser_dom_html, body_bytes, document) then return false
  js_host: ptr[BrowserJsDomHost] is os_browser_js_dom_host
  js_host.mutations is os_browser_js_dom_mutations
  js_host.mutation_capacity is 32
  if not browser_js_dom_init(js_host, document) then return false
  if not os_browser_run_inline_scripts(document) then return false
  form_state: ptr[BrowserFormState] is os_browser_form_state
  form_state.controls is os_browser_form_controls
  form_state.values is os_browser_form_values
  form_state.capacity is 32
  form_state.value_stride is 128
  if not browser_form_init(document, form_state) then return false
  os_browser_form_editing is 0
  if not os_browser_collect_dom_css(document) then return false
  if not os_browser_fetch_dom_stylesheet(document) then return false
  os_browser_dom_css_variable_count is css_custom_properties_resolve(os_browser_dom_css_source, os_browser_dom_css_length, os_browser_dom_css_variables, 32)
  if os_browser_dom_css_variable_count != 0 then
    if not os_serial_cstr_line(os_browser_css_variables_marker) then return false
  end

  stylesheet: ptr[CssStylesheet] is os_browser_dom_stylesheet
  stylesheet.rules is os_browser_dom_css_rules
  stylesheet.styles is os_browser_dom_rule_styles
  stylesheet.capacity is 512
  parsed_css: bool is true
  if not css_stylesheet_parse_relaxed_viewport(os_browser_dom_css_source, os_browser_dom_css_length, stylesheet, viewport_width, viewport_height) then
    parsed_css is false
    stylesheet.input is os_browser_dom_css_source
    stylesheet.input_bytes is 0
    stylesheet.count is 0
  end
  if not css_compute_document(document, stylesheet, os_browser_dom_computed, 1024, os_browser_dom_scratch, 640) then return false
  positioned_count: u64 is 0
  positioned_index: u64 is 0
  while positioned_index < document.node_count do
    positioned_style: ptr[CssComputedStyle] is ptr.add(os_browser_dom_computed, positioned_index * 288)
    if positioned_style.position != 0 then positioned_count += 1
    positioned_index += 1
  end
  if positioned_count != 0 then
    if not os_serial_cstr_line(os_browser_css_position_marker) then return false
  end
  if not parsed_css or stylesheet.count == 0 then
    if not os_browser_dom_legacy_colors(document) then return false
  end
  if not os_browser_prepare_dom_images(document, viewport_width) then return false
  os_browser_dom_box_count is css_box_layout(document, os_browser_dom_computed, os_browser_dom_boxes, 1024, viewport_width, viewport_height)
  if os_browser_dom_box_count == 0 then return false
  os_browser_dom_viewport_width is viewport_width
  os_browser_dom_viewport_height is viewport_height
  os_browser_dom_ready is 1
  if not os_serial_cstr_line(os_browser_dom_marker) then return false
  return true
end

func os_browser_http_status_code() do
  if os_browser_length < 12 then return 0
  if mem.read8(os_browser_buffer) != 72 then return 0
  if mem.read8(ptr.add(os_browser_buffer, 1)) != 84 then return 0
  if mem.read8(ptr.add(os_browser_buffer, 2)) != 84 then return 0
  if mem.read8(ptr.add(os_browser_buffer, 3)) != 80 then return 0
  if mem.read8(ptr.add(os_browser_buffer, 4)) != 47 then return 0
  if mem.read8(ptr.add(os_browser_buffer, 8)) != 32 then return 0
  first: u64 is mem.read8(ptr.add(os_browser_buffer, 9))
  second: u64 is mem.read8(ptr.add(os_browser_buffer, 10))
  third: u64 is mem.read8(ptr.add(os_browser_buffer, 11))
  if first < 48 or first > 57 or second < 48 or second > 57 or third < 48 or third > 57 then return 0
  return (first - 48) * 100 + (second - 48) * 10 + third - 48
end

func os_browser_copy_redirect(location: ptr, location_bytes: u64) do
  global os_browser_address_length, os_browser_edit_started
  if location == 0 or location_bytes == 0 or location_bytes > 95 then return false

  absolute: bool is location_bytes >= 7
  if absolute then absolute is os_network_ascii_lower(mem.read8(location)) == 104
  if absolute then absolute is os_network_ascii_lower(mem.read8(ptr.add(location, 1))) == 116
  if absolute then absolute is os_network_ascii_lower(mem.read8(ptr.add(location, 2))) == 116
  if absolute then absolute is os_network_ascii_lower(mem.read8(ptr.add(location, 3))) == 112
  if absolute then absolute is mem.read8(ptr.add(location, 4)) == 58
  if absolute then absolute is mem.read8(ptr.add(location, 5)) == 47
  if absolute then absolute is mem.read8(ptr.add(location, 6)) == 47

  absolute_https: bool is location_bytes >= 8
  if absolute_https then absolute_https is os_network_ascii_lower(mem.read8(location)) == 104
  if absolute_https then absolute_https is os_network_ascii_lower(mem.read8(ptr.add(location, 1))) == 116

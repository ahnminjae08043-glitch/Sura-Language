  r11: u64
  r10: u64
  r9: u64
  r8: u64
  rdi: u64
  rsi: u64
  rbp: u64
  rbx: u64
  rdx: u64
  rcx: u64
  rax: u64
  error: u64
  rip: u64
  cs: u64
  rflags: u64
  rsp: u64
  ss: u64
end


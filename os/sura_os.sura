os_network_lease_seconds: u64 is 0
os_gateway_mac0: u64 is 0
os_gateway_mac1: u64 is 0
os_gateway_mac2: u64 is 0
os_gateway_mac3: u64 is 0
os_gateway_mac4: u64 is 0
os_gateway_mac5: u64 is 0
os_network_resolved_ip: u64 is 0

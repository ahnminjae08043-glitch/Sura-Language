func os_text_input_pack(result: ptr[TextInputResult]) do
  if result == 0 or result.committed_count == 0 or result.committed_count > 2 then return 0
  byte_count: u64 is 0
  index: u64 is 0
  while index < result.committed_count do
    codepoint: u64 is result.committed0
    if index == 1 then codepoint is result.committed1
    written: u64 is text_input_utf8_write(codepoint, ptr.add(os_text_input_utf8, byte_count), 7 - byte_count)
    if written == 0 or byte_count + written > 7 then return 0
    byte_count += written
    index += 1
  end
  packed: u64 is byte_count << 56
  index is 0
  while index < byte_count do
    packed is packed | (mem.read8(ptr.add(os_text_input_utf8, index)) << (index * 8))
    index += 1
  end
  return packed
end

func os_files_name_begin(mode: u64) do
  global os_files_name_mode, os_files_name_length, os_files_rename_select_all
  if os_surafs_mounted == 0 or mode < 1 or mode > 4 then return false
  selected_entry: ptr[VfsDirEntry] is 0
  if mode == 3 or mode == 4 then
    files: ptr[FileExplorerState] is os_file_explorer_state
    if files.selected >= os_storage_entry_count then return false
    selected_entry is ptr.index(os_surafs_entries, files.selected, sizeof(VfsDirEntry))
    if selected_entry.valid == 0 then return false
    is_parent: bool is selected_entry.name_length == 2 and mem.read8(selected_entry.name) == 46 and mem.read8(ptr.add(selected_entry.name, 1)) == 46
    if is_parent then return false
  end
  if not memfs_zero(os_files_name_buffer, 64) then return false
  os_files_name_length is 0
  os_files_rename_select_all is 0
  if mode == 3 then
    if selected_entry == 0 or selected_entry.name_length >= 64 then return false
    if not memfs_copy(os_files_name_buffer, selected_entry.name, selected_entry.name_length) then return false
    os_files_name_length is selected_entry.name_length
    os_files_rename_select_all is 1
  end
  os_files_name_mode is mode
  text_input_reset(os_files_text_input_state)
  if os_input_layout_hangul != 0 then
    if not text_input_set_hangul(os_files_text_input_state, true, os_files_text_input_result) then return false
  end
  return os_redraw_desktop()
end

func os_files_name_append(packed: u64) do
  global os_files_name_length
  byte_count: u64 is (packed >> 56) & 7
  if byte_count == 0 then return true
  if os_files_name_length + byte_count >= 64 then return false
  index: u64 is 0
  while index < byte_count do
    value: u64 is (packed >> (index * 8)) & 255
    if value == 0 or value == 47 then return false
    mem.write8(ptr.add(os_files_name_buffer, os_files_name_length), value)
    os_files_name_length += 1
    index += 1
  end
  mem.write8(ptr.add(os_files_name_buffer, os_files_name_length), 0)
  return true
end

func os_files_name_backspace() do
  global os_files_name_length
  if os_files_name_length == 0 then return true
  os_files_name_length -= 1
  while os_files_name_length > 0 and (mem.read8(ptr.add(os_files_name_buffer, os_files_name_length)) & 192) == 128 do
    os_files_name_length -= 1
  end
  mem.write8(ptr.add(os_files_name_buffer, os_files_name_length), 0)
  return true
end

func os_files_name_cancel() do
  global os_files_name_mode, os_files_name_length, os_files_rename_select_all
  os_files_name_mode is 0
  os_files_name_length is 0
  os_files_rename_select_all is 0
  text_input_reset(os_files_text_input_state)
  return os_redraw_desktop()
end

func os_files_name_commit() do
  global os_files_name_mode, os_files_name_length, os_files_rename_select_all
  mode: u64 is os_files_name_mode
  if mode == 0 then return false
  ok: bool is false
  if mode == 1 and os_files_name_length != 0 then
    ok is os_surafs_create_named(os_files_name_buffer, os_files_name_length, vfs_kind_file)
  elif mode == 2 and os_files_name_length != 0 then
    ok is os_surafs_create_named(os_files_name_buffer, os_files_name_length, vfs_kind_directory)
  elif mode == 3 and os_files_name_length != 0 then
    ok is os_surafs_rename_selected(os_files_name_buffer, os_files_name_length)
  elif mode == 4 then
    ok is os_surafs_delete_selected()
  end
  if not ok then return os_redraw_desktop()
  os_files_name_mode is 0
  os_files_name_length is 0
  os_files_rename_select_all is 0
  text_input_reset(os_files_text_input_state)
  return os_redraw_desktop()
end

func os_input_layout_record(state: ptr[TextInputState]) do
  global os_input_layout_hangul, os_input_layout_reported
  if state == 0 then return false
  os_input_layout_hangul is state.hangul
  editor_state: ptr[TextInputState] is os_text_input_state
  files_state: ptr[TextInputState] is os_files_text_input_state
  editor_save_state: ptr[TextInputState] is os_editor_save_text_input_state
  editor_find_state: ptr[TextInputState] is os_editor_find_text_input_state
  browser_state: ptr[TextInputState] is os_browser_text_input_state
  terminal_state: ptr[TextInputState] is os_terminal_text_input_state
  editor_state.hangul is os_input_layout_hangul
  files_state.hangul is os_input_layout_hangul
  editor_save_state.hangul is os_input_layout_hangul
  editor_find_state.hangul is os_input_layout_hangul
  browser_state.hangul is os_input_layout_hangul
  terminal_state.hangul is os_input_layout_hangul
  if os_storage_mounted != 0 and not os_storage_save_settings() then return false
  if os_input_layout_hangul != 0 and not os_serial_cstr_line(os_input_layout_korean_marker) then return false
  if os_input_layout_hangul == 0 and not os_serial_cstr_line(os_input_layout_english_marker) then return false
  if os_input_layout_reported == 0 then
    if not os_serial_cstr_line(os_input_layout_marker) then return false
    os_input_layout_reported is 1
  end
  return true
end

func os_files_follow_selection(files: ptr[FileExplorerState]) do
  global os_files_view_offset
  if files == 0 or files.entry_count <= 6 then
    os_files_view_offset is 0
    return true
  end
  if files.selected < os_files_view_offset then
    os_files_view_offset is files.selected
  elif files.selected >= os_files_view_offset + 6 then
    os_files_view_offset is files.selected - 5
  end
  maximum: u64 is files.entry_count - 6
  if os_files_view_offset > maximum then os_files_view_offset is maximum
  return true
end

func os_files_key_event(event: ptr[KeyEvent]) do
  global os_files_name_length, os_files_rename_select_all, os_files_scroll_reported
  if event == 0 or event.pressed == 0 then return true
  files_text_state: ptr[TextInputState] is os_files_text_input_state
  ctrl: bool is (event.modifiers & key_event_modifier_ctrl()) != 0
  shift: bool is (event.modifiers & key_event_modifier_shift()) != 0
  layout_key: bool is event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul()

  if os_files_name_mode == 0 then
    if ctrl and event.physical_key == 46 then
      os_surafs_clipboard_copy_selected()
      return true
    end
    if ctrl and event.physical_key == 45 then
      os_surafs_clipboard_cut_selected()
      return true
    end
    if ctrl and event.physical_key == 47 then
      if not os_surafs_paste_clipboard() then return true
      return os_redraw_desktop()
    end
    if ctrl and event.physical_key == 49 then
      if shift then return os_files_name_begin(2)
      return os_files_name_begin(1)
    end
    if event.physical_key == 60 then return os_files_name_begin(3)
    if event.physical_key == 61 then return os_files_name_begin(2)
    if event.physical_key == 62 then return os_files_name_begin(1)
    if event.physical_key == 339 then return os_files_name_begin(4)
    files: ptr[FileExplorerState] is os_file_explorer_state
    if event.physical_key == 328 and files.selected > 0 then
      files.selected -= 1
      if not os_files_follow_selection(files) then return false
      return os_redraw_desktop()
    end
    if event.physical_key == 336 and files.selected + 1 < files.entry_count then
      files.selected += 1
      if not os_files_follow_selection(files) then return false
      return os_redraw_desktop()
    end
    if event.physical_key == 327 and files.entry_count != 0 then
      files.selected is 0
      if not os_files_follow_selection(files) then return false
      return os_redraw_desktop()
    end
    if event.physical_key == 335 and files.entry_count != 0 then
      files.selected is files.entry_count - 1
      if not os_files_follow_selection(files) then return false
      if files.entry_count > 6 and os_files_scroll_reported == 0 then
        if not os_serial_cstr_line(os_files_scroll_marker) then return false
        os_files_scroll_reported is 1
      end
      return os_redraw_desktop()
    end
    if event.physical_key == 28 and files.entry_count != 0 then
      return os_files_ring3_dispatch(files.selected)
    end
    if layout_key then return os_global_layout_key_event(event)
    return true
  end

  if event.physical_key == 1 then return os_files_name_cancel()
  if event.physical_key == 28 then
    if os_files_name_mode != 4 and text_input_composing(os_files_text_input_state) != 0 then
      text_input_result_clear(os_files_text_input_result)
      if not text_input_commit(os_files_text_input_state, os_files_text_input_result) then return false
      packed_commit: u64 is os_text_input_pack(os_files_text_input_result)
      if packed_commit != 0 and not os_files_name_append(packed_commit) then return false
    end
    return os_files_name_commit()
  end
  if os_files_name_mode == 4 then return true
  if layout_key then
    enabled: bool is files_text_state.hangul == 0
    if not text_input_set_hangul(files_text_state, enabled, os_files_text_input_result) then return false
    if not os_input_layout_record(files_text_state) then return false
    packed_layout: u64 is os_text_input_pack(os_files_text_input_result)
    if packed_layout != 0 and not os_files_name_append(packed_layout) then return false
    return os_redraw_desktop()
  end
  composing_before: u64 is text_input_composing(files_text_state)
  if event.physical_key == 14 and composing_before == 0 then
    if os_files_rename_select_all != 0 then
      if not memfs_zero(os_files_name_buffer, 64) then return false
      os_files_name_length is 0
      os_files_rename_select_all is 0
      return os_redraw_desktop()
    end
    if not os_files_name_backspace() then return false
    return os_redraw_desktop()
  end
  if os_files_rename_select_all != 0 and event.unicode != 0 then
    if not memfs_zero(os_files_name_buffer, 64) then return false
    os_files_name_length is 0
    os_files_rename_select_all is 0
  end
  if not text_input_feed_key_event(files_text_state, event, os_files_text_input_result) then return false
  if files_text_state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(files_text_state) then return false
  end
  packed: u64 is os_text_input_pack(os_files_text_input_result)
  if packed != 0 and not os_files_name_append(packed) then return false
  result: ptr[TextInputResult] is os_files_text_input_result
  if packed != 0 or result.changed != 0 or text_input_composing(files_text_state) != composing_before then
    return os_redraw_desktop()
  end
  return true
end

func os_editor_save_begin() do
  global os_editor_save_as_active, os_editor_save_name_exists, os_editor_save_name_length, os_editor_save_select_all
  if os_surafs_mounted == 0 or os_surafs_active_file_length == 0 then return false
  leaf_offset: u64 is memfs_leaf_offset(os_surafs_active_file_path, os_surafs_active_file_length)
  if leaf_offset == u64("0xffffffffffffffff") or leaf_offset >= os_surafs_active_file_length then return false
  name_length: u64 is os_surafs_active_file_length - leaf_offset
  if name_length >= 64 or not memfs_zero(os_editor_save_name_buffer, 64) then return false
  if not memfs_copy(os_editor_save_name_buffer, ptr.add(os_surafs_active_file_path, leaf_offset), name_length) then return false
  os_editor_save_name_length is name_length
  os_editor_save_as_active is 1
  os_editor_save_select_all is 1
  os_editor_save_name_exists is 0
  text_input_reset(os_editor_save_text_input_state)
  if os_input_layout_hangul != 0 then
    if not text_input_set_hangul(os_editor_save_text_input_state, true, os_editor_save_text_input_result) then return false
  end
  return os_redraw_desktop()
end

func os_editor_save_append(packed: u64) do
  global os_editor_save_name_exists, os_editor_save_name_length
  byte_count: u64 is (packed >> 56) & 7
  if byte_count == 0 then return true
  if os_editor_save_name_length + byte_count >= 64 then return false
  index: u64 is 0
  while index < byte_count do
    value: u64 is (packed >> (index * 8)) & 255
    if value == 0 or value == 47 then return false
    mem.write8(ptr.add(os_editor_save_name_buffer, os_editor_save_name_length), value)
    os_editor_save_name_length += 1
    index += 1
  end
  mem.write8(ptr.add(os_editor_save_name_buffer, os_editor_save_name_length), 0)
  os_editor_save_name_exists is 0
  return true
end

func os_editor_save_backspace() do
  global os_editor_save_name_exists, os_editor_save_name_length, os_editor_save_select_all
  os_editor_save_name_exists is 0
  if os_editor_save_select_all != 0 then
    if not memfs_zero(os_editor_save_name_buffer, 64) then return false
    os_editor_save_name_length is 0
    os_editor_save_select_all is 0
    return true
  end
  if os_editor_save_name_length == 0 then return true
  os_editor_save_name_length -= 1
  while os_editor_save_name_length > 0 and (mem.read8(ptr.add(os_editor_save_name_buffer, os_editor_save_name_length)) & 192) == 128 do
    os_editor_save_name_length -= 1
  end
  mem.write8(ptr.add(os_editor_save_name_buffer, os_editor_save_name_length), 0)
  return true
end

func os_editor_save_close() do
  global os_editor_save_as_active, os_editor_save_name_exists, os_editor_save_name_length, os_editor_save_select_all
  os_editor_save_as_active is 0
  os_editor_save_name_exists is 0
  os_editor_save_name_length is 0
  os_editor_save_select_all is 0
  text_input_reset(os_editor_save_text_input_state)
  return os_redraw_desktop()
end

func os_editor_save_commit() do
  global os_editor_save_name_exists
  if os_editor_save_as_active == 0 or os_editor_save_name_length == 0 then return os_redraw_desktop()
  status: u64 is os_surafs_save_as(os_editor_save_name_buffer, os_editor_save_name_length)
  if status == 2 then
    os_editor_save_name_exists is 1
    return os_redraw_desktop()
  end
  if status != 1 then return os_redraw_desktop()
  return os_editor_save_close()
end

func os_editor_save_key_event(event: ptr[KeyEvent]) do
  global os_editor_save_name_exists, os_editor_save_name_length, os_editor_save_select_all
  if event == 0 or event.pressed == 0 then return true
  state: ptr[TextInputState] is os_editor_save_text_input_state
  result: ptr[TextInputResult] is os_editor_save_text_input_result
  if event.physical_key == 1 then return os_editor_save_close()
  if event.physical_key == 28 then
    if text_input_composing(state) != 0 then
      text_input_result_clear(result)
      if not text_input_commit(state, result) then return false
      packed_commit: u64 is os_text_input_pack(result)
      if packed_commit != 0 and not os_editor_save_append(packed_commit) then return false
    end
    return os_editor_save_commit()
  end
  layout_key: bool is event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul()
  if layout_key then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    if not os_input_layout_record(state) then return false
    packed_layout: u64 is os_text_input_pack(result)
    if packed_layout != 0 and not os_editor_save_append(packed_layout) then return false
    return os_redraw_desktop()
  end
  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    if not os_editor_save_backspace() then return false
    return os_redraw_desktop()
  end
  if os_editor_save_select_all != 0 and event.unicode != 0 then
    if not memfs_zero(os_editor_save_name_buffer, 64) then return false
    os_editor_save_name_length is 0
    os_editor_save_select_all is 0
    os_editor_save_name_exists is 0
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 and not os_editor_save_append(packed) then return false
  if packed != 0 or result.changed != 0 or text_input_composing(state) != composing_before then
    return os_redraw_desktop()
  end
  return true
end

func os_editor_find_begin(mode: u64) do
  global os_editor_find_mode, os_editor_find_field, os_editor_find_length, os_editor_replace_length
  if mode != 1 and mode != 2 then return false
  if not memfs_zero(os_editor_find_buffer, 64) or not memfs_zero(os_editor_replace_buffer, 64) then return false
  os_editor_find_mode is mode
  os_editor_find_field is 0
  os_editor_find_length is 0
  os_editor_replace_length is 0
  text_input_reset(os_editor_find_text_input_state)
  if os_input_layout_hangul != 0 then
    if not text_input_set_hangul(os_editor_find_text_input_state, true, os_editor_find_text_input_result) then return false
  end
  return os_redraw_desktop()
end


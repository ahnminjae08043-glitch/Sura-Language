  if not os_user_worker_init(worker, setup) then return false

  files: ptr[FileExplorerState] is os_file_explorer_state
  mailbox: ptr[UserFileExplorerMailbox] is os_files_mailbox_transfer
  mailbox.entry_count is files.entry_count
  mailbox.selected is files.selected
  mailbox.requested_index is files.selected

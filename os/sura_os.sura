func os_vm_exit(code: u64) do
  io.out32(244, code)
  cpu.disable_interrupts()
  while true do
    cpu.halt()
  end
end

func os_serial_line(text: ptr, length: usize) do
  if not serial_write_buffer(1016, text, length, 1000000) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_serial_text(text: ptr) do
  return serial_write_cstr(1016, text, 256, 1000000)
end

func os_serial_cstr_line(text: ptr) do
  if not os_serial_text(text) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_clock_refresh() do
  global os_clock_second
  time: ptr[RtcTime] is os_rtc_time_state
  if not rtc_read(time) then return 0
  changed: u64 is 1
  if time.second != os_clock_second then changed is 2
  os_clock_second is time.second
  mem.write8(ptr.add(os_clock_text, 0), 48 + (time.hour / 10))
  mem.write8(ptr.add(os_clock_text, 1), 48 + (time.hour % 10))
  mem.write8(ptr.add(os_clock_text, 2), 58)
  mem.write8(ptr.add(os_clock_text, 3), 48 + (time.minute / 10))
  mem.write8(ptr.add(os_clock_text, 4), 48 + (time.minute % 10))
  mem.write8(ptr.add(os_clock_text, 5), 0)
  return changed
end

func os_serial_drain() do
  attempt: u64 is 0
  while attempt < 1000000 do
    if (io.in8(1021) & 64) != 0 then return true
    cpu.pause()
    attempt += 1
  end
  return false
end

func os_serial_u64(value: u64) do
  if value == 0 then return serial_write_byte(1016, 48, 1000000)

  index: usize is 32
  remaining: u64 is value
  while remaining > 0 do
    index -= 1
    mem.write8(ptr.add(os_number_buffer, index), 48 + (remaining % 10))
    remaining is remaining / 10
  end
  return serial_write_buffer(1016, ptr.add(os_number_buffer, index), 32 - index, 1000000)
end

func os_command_equals(buffer: ptr, length: usize, expected: ptr) do
  index: usize is 0
  while index < length do
    if mem.read8(ptr.add(buffer, index)) != mem.read8(ptr.add(expected, index)) then
      return false
    end
    index += 1
  end
  return mem.read8(ptr.add(expected, length)) == 0
end

func os_terminal_cstr_line(text: ptr, max_length: usize) do
  terminal: ptr[TextTerminal] is os_terminal_state
  if not text_terminal_write_cstr(terminal, text, max_length) then return false
  return text_terminal_newline(terminal)
end

func os_terminal_prompt() do
  terminal: ptr[TextTerminal] is os_terminal_state
  return text_terminal_write_cstr(terminal, os_shell_prompt, 16)
end

func os_shell_execute_command(command: u64) do
  global os_graphics_message
  terminal: ptr[TextTerminal] is os_terminal_state
  if command == 0 then return true
  if command == 1 then
    os_graphics_message is os_text_help_result
    if not os_terminal_cstr_line(os_shell_help, 64) then return false
    return os_serial_cstr_line(os_shell_help)
  end
  if command == 2 then
    os_graphics_message is os_shell_status
    if not os_terminal_cstr_line(os_shell_status, 32) then return false
    return os_serial_cstr_line(os_shell_status)
  end
  if command == 3 then
    os_graphics_message is os_text_mem_result
    allocator: ptr[PhysicalAllocator] is os_allocator_state
    if not text_terminal_write_cstr(terminal, os_shell_memory_prefix, 32) then return false
    if not text_terminal_write_u64(terminal, pmem_available_pages(allocator)) then return false
    if not text_terminal_newline(terminal) then return false
    if not os_serial_text(os_shell_memory_prefix) then return false
    if not os_serial_u64(pmem_available_pages(allocator)) then return false
    return serial_write_byte(1016, 10, 1000000)
  end
  if command == 4 then
    os_graphics_message is os_text_about_result
    if not os_terminal_cstr_line(os_shell_about, 64) then return false
    return os_serial_cstr_line(os_shell_about)
  end
  if command == 5 then
    os_graphics_message is 0
    if not text_terminal_clear(terminal) then return false
    return os_serial_line(os_clear_marker, 16)
  end
  if command == 6 then
    os_terminal_cstr_line(os_shutdown_marker, 32)
    os_serial_cstr_line(os_shutdown_marker)
    os_serial_drain()
    os_vm_exit(16)
    return true
  end

  os_graphics_message is os_text_unknown_result
  if not os_terminal_cstr_line(os_shell_unknown, 64) then return false
  return os_serial_cstr_line(os_shell_unknown)
end

func os_shell_execute(buffer: ptr, length: usize) do
  if length == 0 then return os_shell_execute_command(0)
  if os_command_equals(buffer, length, os_command_help) then return os_shell_execute_command(1)
  if os_command_equals(buffer, length, os_command_status) then return os_shell_execute_command(2)
  if os_command_equals(buffer, length, os_command_mem) then return os_shell_execute_command(3)
  if os_command_equals(buffer, length, os_command_about) then return os_shell_execute_command(4)
  if os_command_equals(buffer, length, os_command_clear) then return os_shell_execute_command(5)
  if os_command_equals(buffer, length, os_command_shutdown) then return os_shell_execute_command(6)
  return os_shell_execute_command(7)
end

func os_draw_mouse_pointer(surface: ptr[FramebufferSurface]) do
  if surface == 0 or os_mouse_x < 0 or os_mouse_y < 0 then return false
  x: i64 is os_mouse_x
  y: i64 is os_mouse_y
  white: u32 is fb_rgb(surface, 255, 255, 255)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  mouse: ptr[Ps2MouseState] is os_ps2_mouse_state
  pointer_color: u32 is white
  if mouse.buttons != 0 then pointer_color is fb_rgb(surface, 255, 102, 35)
  fb_line(surface, x, y, x, y + 16, black)
  fb_line(surface, x, y, x + 11, y + 11, black)
  fb_line(surface, x, y + 16, x + 4, y + 12, black)
  fb_line(surface, x + 4, y + 12, x + 8, y + 19, black)
  fb_line(surface, x + 8, y + 19, x + 11, y + 17, black)
  fb_line(surface, x + 11, y + 17, x + 7, y + 11, black)
  fb_line(surface, x + 7, y + 11, x + 11, y + 11, black)
  fb_line(surface, x, y, x, y + 14, pointer_color)
  fb_line(surface, x, y, x + 9, y + 10, pointer_color)
  return true
end

func os_present_with_pointer() do
  global os_pointer_drawn_x, os_pointer_drawn_y, os_pointer_drawn
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  if not fb_present(back, front.pixels) then return false
  if not os_draw_mouse_pointer(front) then return false
  os_pointer_drawn_x is os_mouse_x
  os_pointer_drawn_y is os_mouse_y
  os_pointer_drawn is 1
  return true
end

func os_present_pointer_only() do
  global os_pointer_drawn_x, os_pointer_drawn_y, os_pointer_drawn
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  if front == 0 or back == 0 then return false
  if os_pointer_drawn == 0 then return os_present_with_pointer()
  if os_pointer_drawn_x < 0 or os_pointer_drawn_y < 0 then return os_present_with_pointer()

  # Restore only the old cursor damage from the clean desktop backbuffer.
  if not fb_copy_rect(back, front, os_pointer_drawn_x, os_pointer_drawn_y, 14, 22) then
    return false
  end
  if not os_draw_mouse_pointer(front) then return false
  os_pointer_drawn_x is os_mouse_x
  os_pointer_drawn_y is os_mouse_y
  os_pointer_drawn is 1
  return true
end

func os_window_manager_start(surface: ptr[FramebufferSurface]) do
  if surface == 0 or surface.width < 640 or surface.height < 400 then return false
  manager: ptr[WindowManager] is os_window_manager_state
  if not window_manager_init(manager, os_window_storage, 6, surface.width, surface.height, 52) then
    return false
  end

  terminal_width: u64 is 640
  if surface.width < 760 then terminal_width is surface.width - 80
  terminal_height: u64 is 330
  if surface.height < 520 then terminal_height is surface.height - 150
  terminal_x: i64 is (surface.width - terminal_width) / 2
  terminal_y: i64 is (surface.height - terminal_height - 52) / 2

  about_width: u64 is 360
  if surface.width < 720 then about_width is 300
  about_height: u64 is 220
  about_x: i64 is surface.width - about_width - 80
  about_y: i64 is 96
  browser_width: u64 is 720
  if surface.width < 800 then browser_width is surface.width - 80
  browser_height: u64 is 420
  if surface.height < 520 then browser_height is surface.height - 92
  browser_x: i64 is (surface.width - browser_width) / 2
  browser_y: i64 is 88

  if not window_manager_add(manager, 6, browser_x, browser_y, browser_width, browser_height) then return false
  if not window_manager_add(manager, 2, about_x, about_y, about_width, about_height) then
    return false
  end
  if not window_manager_add(manager, 1, terminal_x, terminal_y, terminal_width, terminal_height) then
    return false
  end
  if not window_manager_add(manager, 3, 100, 130, 520, 300) then return false
  if not window_manager_add(manager, 4, 220, 170, 520, 300) then return false
  if not window_manager_add(manager, 5, surface.width - 420, 220, 320, 300) then return false
  if not window_manager_close(manager, 3) then return false
  if not window_manager_close(manager, 4) then return false
  if not window_manager_close(manager, 5) then return false
  if not window_manager_close(manager, 6) then return false
  manager.last_closed_id is 0
  return window_manager_focus(manager, 1)
end

func os_draw_window_frame(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow], title: ptr) do
  if surface == 0 or window == 0 or window.visible == 0 or title == 0 then return false
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  bar_color: u32 is panel_light
  border_color: u32 is muted
  if window.active != 0 then
    bar_color is titlebar
    border_color is orange
  end

  fb_fill_rect(surface, x + 8, y + 10, window.width, window.height, black)
  fb_fill_rect(surface, x, y, window.width, window.height, panel)
  fb_rect_outline(surface, x, y, window.width, window.height, border_color)
  fb_fill_rect(surface, x, y, window.width, 38, bar_color)
  title_icon: ptr is os_icon_terminal
  if window.id == 2 then title_icon is os_icon_about
  if window.id == 3 then title_icon is os_icon_files
  if window.id == 4 then title_icon is os_icon_notes
  if window.id == 5 then title_icon is os_icon_calc
  if window.id == 6 then title_icon is os_icon_web
  os_draw_bitmap_icon(surface, x + 10, y + 11, title_icon, 1)
  font5x7_draw_text(surface, x + 34, y + 11, title, 32, white_large)
  if window.closable != 0 then
    fb_fill_rect(surface, x + window.width - 34, y + 8, 24, 22, orange)
    fb_line(surface, x + window.width - 28, y + 14, x + window.width - 17, y + 24, white)
    fb_line(surface, x + window.width - 17, y + 14, x + window.width - 28, y + 24, white)
  end
  return true
end

func os_draw_terminal_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_terminal) then return false
  x: u64 is window.x
  y: u64 is window.y
  white: u32 is fb_rgb(surface, 242, 247, 252)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  terminal: ptr[TextTerminal] is os_terminal_state
  if terminal.cells != 0 then
    text_terminal_draw(terminal, surface, x + 24, y + 54, white_large)
    cursor_x: u64 is x + 24 + terminal.cursor_x * 12
    cursor_y: u64 is y + 54 + terminal.cursor_y * 16
    if cursor_x + 10 < x + window.width and cursor_y + 15 < y + window.height then
      fb_fill_rect(surface, cursor_x, cursor_y + 14, 10, 2, white)
    end
  else
    font5x7_draw_text(surface, x + 24, y + 72, os_text_terminal_prompt, 32, orange_large)
    font5x7_draw_text(surface, x + 24, y + 108, os_text_terminal_ready, 32, green_large)
    font5x7_draw_text(surface, x + 24, y + 144, os_shell_prompt, 16, white_large)
  end
  return true
end

func os_draw_about_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_system_info) then return false
  x: u64 is window.x
  y: u64 is window.y
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  font5x7_draw_text(surface, x + 22, y + 58, os_text_system_version, 32, orange_large)
  font5x7_draw_text(surface, x + 22, y + 94, os_text_system_target, 32, white_large)
  font5x7_draw_text(surface, x + 22, y + 128, os_text_system_memory, 32, green_large)
  font5x7_draw_text(surface, x + 22, y + 168, os_text_system_machine, 32, white_small)
  return true
end

func os_draw_file_explorer_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_file_explorer) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  files: ptr[FileExplorerState] is os_file_explorer_state
  font5x7_draw_text(surface, x + 20, y + 54, os_storage_path_buffer, 96, white_small)
  row: u64 is 0
  while row < files.entry_count do
    row_y: u64 is y + 78 + row * 34
    row_color: u32 is panel_light
    if files.selected == row then row_color is titlebar
    fb_fill_rect(surface, x + 18, row_y, window.width - 36, 28, row_color)
    if files.selected == row then fb_rect_outline(surface, x + 18, row_y, window.width - 36, 28, orange)
    if os_storage_mounted != 0 and row < os_storage_entry_count then
      name: ptr is ptr.add(os_storage_display_names, row * 13)
      entry: ptr[Fat32DirEntry] is ptr.index(os_storage_root_entries, row, sizeof(Fat32DirEntry))
      entry_icon: ptr is os_icon_notes
      if (entry.attributes & 16) != 0 then entry_icon is os_icon_files
      os_draw_bitmap_icon(surface, x + 26, row_y + 6, entry_icon, 1)
      display_text: ptr is name
      if mem.read8(name) == 46 and mem.read8(ptr.add(name, 1)) == 46 then display_text is os_text_parent_folder
      font5x7_draw_text(surface, x + 50, row_y + 10, display_text, 16, white_small)
    end
    row += 1
  end
  if os_storage_mounted == 0 then
    font5x7_draw_text(surface, x + 30, y + 88, os_text_no_disk, 32, white_small)
    font5x7_draw_text(surface, x + 20, y + window.height - 28, os_text_read_only, 48, muted_small)
  else
    storage_hint: ptr is os_text_storage_ready
    if os_storage_directory_depth != 0 then storage_hint is os_text_storage_directory
    font5x7_draw_text(surface, x + 20, y + window.height - 28, storage_hint, 48, muted_small)
  end
  return true
end

func os_draw_text_editor_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_text_editor) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  editor: ptr[TextEditorState] is os_text_editor_state
  fb_rect_outline(surface, x + 16, y + 50, window.width - 32, window.height - 90, muted)
  font5x7_draw_text(surface, x + 26, y + 62, editor.buffer, editor.capacity, white_small)
  cursor_x: u64 is x + 26 + (editor.length % 72) * 6
  cursor_y: u64 is y + 62 + (editor.length / 72) * 8
  if cursor_x + 5 < x + window.width - 16 and cursor_y + 8 < y + window.height - 40 then
    fb_fill_rect(surface, cursor_x, cursor_y + 7, 5, 1, white)
  end
  editor_hint: ptr is os_text_editor_hint
  if os_storage_mounted != 0 then editor_hint is os_text_editor_autosave
  font5x7_draw_text(surface, x + 20, y + window.height - 26, editor_hint, 48, muted_small)
  return true
end

func os_draw_calculator_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_calculator) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  calculator: ptr[CalculatorState] is os_calculator_state
  if not calculator_format(calculator, os_calculator_text, 16) then return false
  fb_fill_rect(surface, x + 18, y + 54, window.width - 36, 54, panel_light)
  fb_rect_outline(surface, x + 18, y + 54, window.width - 36, 54, orange)
  font5x7_draw_text(surface, x + 34, y + 72, os_calculator_text, 16, white_large)
  font5x7_draw_text(surface, x + 22, y + 132, os_text_calculator_hint, 32, muted_small)
  return true
end

func os_draw_browser_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_browser) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  page: u32 is fb_rgb(surface, (os_browser_css_page_rgb >> 16) & 255, (os_browser_css_page_rgb >> 8) & 255, os_browser_css_page_rgb & 255)
  page_panel: u32 is fb_rgb(surface, (os_browser_css_card_rgb >> 16) & 255, (os_browser_css_card_rgb >> 8) & 255, os_browser_css_card_rgb & 255)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  heading_style: ptr[BitmapFontStyle] is os_font_browser_heading
  body_style: ptr[BitmapFontStyle] is os_font_browser_body
  link_style: ptr[BitmapFontStyle] is os_font_browser_link
  fb_fill_rect(surface, x + 16, y + 50, window.width - 32, 30, panel_light)
  fb_rect_outline(surface, x + 16, y + 50, window.width - 32, 30, orange)
  font5x7_draw_text(surface, x + 28, y + 61, os_browser_address_buffer, 96, white_small)
  if window.active != 0 and os_browser_address_length < 95 then
    cursor_x: u64 is x + 28 + os_browser_address_length * 6
    if cursor_x + 2 < x + window.width - 18 then fb_vline(surface, cursor_x, y + 59, 10, orange)
  end
  fb_fill_rect(surface, x + 16, y + 90, window.width - 32, window.height - 128, page)
  fb_fill_rect(surface, x + 24, y + 98, window.width - 48, window.height - 144, page_panel)
  fb_rect_outline(surface, x + 16, y + 90, window.width - 32, window.height - 128, muted)
  if os_browser_layout_line_count != 0 then
    line: u64 is 0
    draw_y: u64 is y + 108
    content_bottom: u64 is y + window.height - 44
    while line < os_browser_layout_line_count and draw_y + 8 < content_bottom do
      style_id: u64 is mem.read8(ptr.add(os_browser_layout_styles, line))
      style: ptr[BitmapFontStyle] is body_style
      draw_x: u64 is x + 30
      line_height: u64 is 12
      if style_id == 1 then
        style is heading_style
        draw_x is x + 36
        line_height is 22
        fb_fill_rect(surface, x + 26, draw_y, 4, 16, orange)
      end
      if style_id == 2 then
        style is link_style
        fb_fill_rect(surface, x + 26, draw_y + 3, 3, 3, orange)
      end
      font5x7_draw_text(surface, draw_x, draw_y, ptr.add(os_browser_layout_lines, line * 97), 96, style)
      draw_y += line_height
      line += 1
    end
  else
    if os_browser_text_length != 0 then
      font5x7_draw_text(surface, x + 24, y + 104, os_browser_text_buffer, 4096, body_style)
    end
  end
  status: ptr is os_browser_status_text
  if status == 0 then status is os_text_browser_status_network
  font5x7_draw_text(surface, x + 20, y + window.height - 26, status, 48, muted_small)
  return true
end

func os_draw_managed_windows(surface: ptr[FramebufferSurface]) do
  manager: ptr[WindowManager] is os_window_manager_state
  if surface == 0 or manager.windows == 0 then return false
  drawn: u64 is 0
  last_z: u64 is 0
  while drawn < manager.count do
    selected: ptr[DesktopWindow] is 0
    selected_z: u64 is 0
    index: u64 is 0
    while index < manager.capacity do
      candidate: ptr[DesktopWindow] is window_manager_at(manager, index)
      if candidate.visible != 0 and candidate.z_order > last_z and (selected == 0 or candidate.z_order < selected_z) then
        selected is candidate
        selected_z is candidate.z_order
      end
      index += 1
    end
    if selected == 0 then return false
    if selected.id == 1 then
      if not os_draw_terminal_window(surface, selected) then return false
    end
    if selected.id == 2 then
      if not os_draw_about_window(surface, selected) then return false
    end
    if selected.id == 3 then
      if not os_draw_file_explorer_window(surface, selected) then return false
    end
    if selected.id == 4 then
      if not os_draw_text_editor_window(surface, selected) then return false
    end
    if selected.id == 5 then
      if not os_draw_calculator_window(surface, selected) then return false
    end
    if selected.id == 6 then
      if not os_draw_browser_window(surface, selected) then return false
    end
    last_z is selected_z
    drawn += 1
  end
  return true
end

func os_redraw_terminal() do
  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 then return false
  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  if window == 0 or window.visible == 0 then return os_present_with_pointer()
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(back, 20, 27, 40)
  white: u32 is fb_rgb(back, 242, 247, 252)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  terminal: ptr[TextTerminal] is os_terminal_state
  fb_fill_rect(back, x + 1, y + 39, window.width - 2, window.height - 40, panel)
  if terminal.cells != 0 then
    text_terminal_draw(terminal, back, x + 24, y + 54, white_large)
    cursor_x: u64 is x + 24 + terminal.cursor_x * 12
    cursor_y: u64 is y + 54 + terminal.cursor_y * 16
    if cursor_x + 10 < x + window.width and cursor_y + 15 < y + window.height then
      fb_fill_rect(back, cursor_x, cursor_y + 14, 10, 2, white)
    end
  end
  return os_present_with_pointer()
end

func os_redraw_desktop() do
  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 then return false
  if not os_draw_desktop(back) then return false
  return os_present_with_pointer()
end

func os_activate_window(manager: ptr[WindowManager], id: u64) do
  if manager == 0 then return 0
  window: ptr[DesktopWindow] is window_manager_find(manager, id)
  if window == 0 then return 0
  if window.visible == 0 then
    if not window_manager_show(manager, id) then return 0
    return 2
  end
  if not window_manager_focus(manager, id) then return 0
  return 1
end

func os_desktop_pointer_press(manager: ptr[WindowManager], x: i64, y: i64) do
  global os_start_menu_reported, os_window_reopen_reported, os_files_app_reported, os_editor_app_reported, os_calculator_app_reported, os_browser_app_reported, os_directory_reported
  if manager == 0 then return false
  shell: ptr[DesktopShell] is os_desktop_shell_state
  terminal_window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  system_window: ptr[DesktopWindow] is window_manager_find(manager, 2)
  terminal_visible: u64 is 0
  system_visible: u64 is 0
  if terminal_window != 0 then terminal_visible is terminal_window.visible
  if system_window != 0 then system_visible is system_window.visible
  taskbar_y: u64 is desktop_shell_taskbar_y(shell)
  browser_hit: bool is desktop_shell_contains(x, y, 34, 482, 48, 48)
  if shell.width >= 1100 and desktop_shell_contains(x, y, 832, taskbar_y + 8, 100, 36) then browser_hit is true
  if browser_hit then
    shell.start_open is 0
    manager.dragging_id is 0
    if os_activate_window(manager, 6) == 0 then return false
    if not os_serial_cstr_line(os_browser_focus_marker) then return false
    if os_browser_app_reported == 0 then
      if not os_serial_cstr_line(os_browser_app_marker) then return false
      os_browser_app_reported is 1
    end
    return true
  end
  action: u64 is desktop_shell_pointer_press(shell, x, y, terminal_visible, system_visible)

  if action == desktop_action_none then
    top: ptr[DesktopWindow] is window_manager_top_at(manager, x, y)
    if top != 0 and top.id == 3 then
      local_y: i64 is y - top.y
      files: ptr[FileExplorerState] is os_file_explorer_state
      if local_y >= 78 and local_y < 78 + files.entry_count * 34 then
        row: u64 is (local_y - 78) / 34
        if row < files.entry_count then
          if not window_manager_focus(manager, 3) then return false
          return os_files_ring3_dispatch(row)
        end
      end
    end
    window_manager_pointer_press(manager, x, y)
    return true
  end
  manager.dragging_id is 0
  if action == desktop_action_start_toggle then
    if shell.start_open != 0 and os_start_menu_reported == 0 then
      if not os_serial_cstr_line(os_start_menu_marker) then return false
      os_start_menu_reported is 1
    end
    return true
  end
  if action == desktop_action_shutdown then
    os_terminal_cstr_line(os_desktop_shutdown_marker, 48)
    if not os_serial_cstr_line(os_desktop_shutdown_marker) then return false
    if not os_serial_cstr_line(os_shutdown_marker) then return false
    os_serial_drain()
    # QEMU isa-debug-exit value 17 produces host exit code 35. This keeps
    # pointer-driven desktop shutdown distinguishable from shell shutdown.
    os_vm_exit(17)
    return true
  end

  target_id: u64 is 0
  if action == desktop_action_terminal_menu or action == desktop_action_terminal_taskbar then
    target_id is 1
  end
  if action == desktop_action_system_menu or action == desktop_action_system_taskbar or action == desktop_action_about_icon then
    target_id is 2
  end
  if action == desktop_action_files_icon or action == desktop_action_files_taskbar or action == desktop_action_files_menu then target_id is 3
  if action == desktop_action_editor_icon or action == desktop_action_editor_taskbar or action == desktop_action_editor_menu then target_id is 4
  if action == desktop_action_calculator_icon or action == desktop_action_calculator_taskbar or action == desktop_action_calculator_menu then target_id is 5
  if target_id == 0 then return true
  reopened: u64 is os_activate_window(manager, target_id)
  if reopened == 0 then return false
  if reopened == 2 and os_window_reopen_reported == 0 then
    if not os_serial_cstr_line(os_window_reopen_marker) then return false
    os_window_reopen_reported is 1
  end
  if target_id == 3 and os_files_app_reported == 0 then
    if not os_serial_cstr_line(os_files_app_marker) then return false
    os_files_app_reported is 1
  end
  if target_id == 4 and os_editor_app_reported == 0 then
    if not os_serial_cstr_line(os_editor_app_marker) then return false
    os_editor_app_reported is 1
  end
  if target_id == 5 and os_calculator_app_reported == 0 then
    if not os_serial_cstr_line(os_calculator_app_marker) then return false
    os_calculator_app_reported is 1
  end
  return true
end

func os_draw_start_menu(surface: ptr[FramebufferSurface]) do
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if surface == 0 or shell.start_open == 0 then return true
  menu_y: u64 is desktop_shell_menu_y(shell)
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small

  fb_fill_rect(surface, 18, menu_y + 8, 260, 330, black)
  fb_fill_rect(surface, 10, menu_y, 260, 330, panel)
  fb_rect_outline(surface, 10, menu_y, 260, 330, orange)
  fb_fill_rect(surface, 10, menu_y, 260, 42, titlebar)
  font5x7_draw_text(surface, 24, menu_y + 13, os_text_brand, 32, white_large)
  font5x7_draw_text(surface, 176, menu_y + 16, os_text_applications, 32, muted_small)
  fb_fill_rect(surface, 20, menu_y + 54, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 65, os_icon_terminal, 1)
  font5x7_draw_text(surface, 54, menu_y + 68, os_text_terminal, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 96, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 107, os_icon_about, 1)
  font5x7_draw_text(surface, 54, menu_y + 110, os_text_system_short, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 138, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 149, os_icon_files, 1)
  font5x7_draw_text(surface, 54, menu_y + 152, os_text_files, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 180, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 191, os_icon_notes, 1)
  font5x7_draw_text(surface, 54, menu_y + 194, os_text_editor_icon, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 222, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 233, os_icon_calc, 1)
  font5x7_draw_text(surface, 54, menu_y + 236, os_text_calculator_icon, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 280, 240, 36, panel_light)
  fb_rect_outline(surface, 20, menu_y + 280, 240, 36, orange)
  os_draw_bitmap_icon(surface, 30, menu_y + 290, os_icon_logo, 1)
  font5x7_draw_text(surface, 54, menu_y + 293, os_text_shutdown, 32, white_small)
  return true
end

func os_draw_desktop(surface: ptr[FramebufferSurface]) do
  if surface == 0 or surface.width < 640 or surface.height < 400 then return false

  navy: u32 is fb_rgb(surface, 12, 24, 44)
  navy_light: u32 is fb_rgb(surface, 18, 39, 70)
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  orange_light: u32 is fb_rgb(surface, 255, 153, 92)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  green: u32 is fb_rgb(surface, 94, 211, 132)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  browser_heading: ptr[BitmapFontStyle] is os_font_browser_heading
  browser_body: ptr[BitmapFontStyle] is os_font_browser_body
  browser_link: ptr[BitmapFontStyle] is os_font_browser_link
  font5x7_style_init(white_large, white, panel, 2, 0)
  font5x7_style_init(white_small, white, panel, 1, 0)
  font5x7_style_init(orange_large, orange_light, panel, 2, 0)
  font5x7_style_init(green_large, green, panel, 2, 0)
  font5x7_style_init(muted_small, muted, panel_light, 1, 0)
  browser_heading_color: u32 is fb_rgb(surface, (os_browser_css_heading_rgb >> 16) & 255, (os_browser_css_heading_rgb >> 8) & 255, os_browser_css_heading_rgb & 255)
  browser_body_color: u32 is fb_rgb(surface, (os_browser_css_text_rgb >> 16) & 255, (os_browser_css_text_rgb >> 8) & 255, os_browser_css_text_rgb & 255)
  browser_link_color: u32 is fb_rgb(surface, (os_browser_css_link_rgb >> 16) & 255, (os_browser_css_link_rgb >> 8) & 255, os_browser_css_link_rgb & 255)
  font5x7_style_init(browser_heading, browser_heading_color, white, 2, 0)
  font5x7_style_init(browser_body, browser_body_color, white, 1, 0)
  font5x7_style_init(browser_link, browser_link_color, white, 1, 0)

  if not fb_clear(surface, navy) then return false

  band_height: u64 is surface.height / 8
  band: u64 is 0
  while band < 8 do
    if (band & 1) == 0 then
      fb_fill_rect(surface, 0, band * band_height, surface.width, band_height, navy_light)
    end
    band += 1
  end

  # Embedded raster logo and application images.
  os_draw_bitmap_icon(surface, 28, 24, os_icon_logo, 3)
  font5x7_draw_text(surface, 96, 31, os_text_brand, 32, white_large)

  os_draw_bitmap_icon(surface, 34, 114, os_icon_files, 3)
  font5x7_draw_text(surface, 36, 168, os_text_files, 16, white_small)
  os_draw_bitmap_icon(surface, 34, 206, os_icon_about, 3)
  font5x7_draw_text(surface, 36, 260, os_text_about_icon, 16, white_small)
  if surface.height >= 520 then
    os_draw_bitmap_icon(surface, 34, 298, os_icon_notes, 3)
    font5x7_draw_text(surface, 36, 352, os_text_editor_icon, 16, white_small)
    os_draw_bitmap_icon(surface, 34, 390, os_icon_calc, 3)
    font5x7_draw_text(surface, 36, 444, os_text_calculator_icon, 16, white_small)
  end
  if surface.height >= 620 then
    os_draw_bitmap_icon(surface, 34, 482, os_icon_web, 3)
    font5x7_draw_text(surface, 36, 536, os_text_browser_icon, 16, white_small)
  end

  if not os_draw_managed_windows(surface) then return false

  # Taskbar and start button.
  taskbar_y: u64 is surface.height - 52
  fb_fill_rect(surface, 0, taskbar_y, surface.width, 52, panel_light)
  fb_hline(surface, 0, taskbar_y, surface.width, orange)
  start_color: u32 is titlebar
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if shell.start_open != 0 then start_color is orange
  fb_fill_rect(surface, 10, taskbar_y + 8, 104, 36, start_color)
  fb_rect_outline(surface, 10, taskbar_y + 8, 104, 36, orange)
  os_draw_bitmap_icon(surface, 18, taskbar_y + 18, os_icon_logo, 1)
  font5x7_draw_text(surface, 42, taskbar_y + 19, os_text_start, 16, white_large)
  fb_fill_rect(surface, 126, taskbar_y + 8, 158, 36, panel)
  os_draw_bitmap_icon(surface, 138, taskbar_y + 18, os_icon_terminal, 1)
  font5x7_draw_text(surface, 160, taskbar_y + 19, os_text_terminal, 16, white_small)
  manager: ptr[WindowManager] is os_window_manager_state
  terminal_window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  if terminal_window != 0 and terminal_window.active != 0 then
    fb_hline(surface, 126, taskbar_y + 43, 158, orange)
  end
  about: ptr[DesktopWindow] is window_manager_find(manager, 2)
  fb_fill_rect(surface, 296, taskbar_y + 8, 188, 36, panel)
  os_draw_bitmap_icon(surface, 306, taskbar_y + 18, os_icon_about, 1)
  font5x7_draw_text(surface, 328, taskbar_y + 19, os_text_about_icon, 16, white_small)
  if about != 0 and about.active != 0 then
    fb_hline(surface, 296, taskbar_y + 43, 188, orange)
  end
  if surface.width >= 900 then
    fb_fill_rect(surface, 496, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 504, taskbar_y + 18, os_icon_files, 1)
    font5x7_draw_text(surface, 526, taskbar_y + 19, os_text_files, 16, white_small)
    files_window: ptr[DesktopWindow] is window_manager_find(manager, 3)
    if files_window != 0 and files_window.active != 0 then
      fb_hline(surface, 496, taskbar_y + 43, 100, orange)
    end
    fb_fill_rect(surface, 608, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 616, taskbar_y + 18, os_icon_notes, 1)
    font5x7_draw_text(surface, 638, taskbar_y + 19, os_text_editor_icon, 16, white_small)
    editor_window: ptr[DesktopWindow] is window_manager_find(manager, 4)
    if editor_window != 0 and editor_window.active != 0 then
      fb_hline(surface, 608, taskbar_y + 43, 100, orange)
    end
    fb_fill_rect(surface, 720, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 728, taskbar_y + 18, os_icon_calc, 1)
    font5x7_draw_text(surface, 750, taskbar_y + 19, os_text_calculator_icon, 16, white_small)
    calculator_window: ptr[DesktopWindow] is window_manager_find(manager, 5)
    if calculator_window != 0 and calculator_window.active != 0 then
      fb_hline(surface, 720, taskbar_y + 43, 100, orange)
    end
  end
  if surface.width >= 1100 then
    fb_fill_rect(surface, 832, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 840, taskbar_y + 18, os_icon_web, 1)
    font5x7_draw_text(surface, 862, taskbar_y + 19, os_text_browser_icon, 16, white_small)
    browser_window: ptr[DesktopWindow] is window_manager_find(manager, 6)
    if browser_window != 0 and browser_window.active != 0 then
      fb_hline(surface, 832, taskbar_y + 43, 100, orange)
    end
  end
  time: ptr[RtcTime] is os_rtc_time_state
  clock_label: ptr is os_text_clock_unknown
  if time.valid != 0 then clock_label is os_clock_text
  font5x7_draw_text(surface, surface.width - 54, taskbar_y + 19, clock_label, 8, muted_small)
  if not os_draw_start_menu(surface) then return false
  return true
end

func os_graphics_start(framebuffer: ptr, width: u64, height: u64, stride: u64, pixel_format: u64) do
  global os_graphics_status, os_graphics_message, os_mouse_x, os_mouse_y
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  os_graphics_message is os_shell_status
  os_mouse_x is width / 2
  os_mouse_y is height / 2
  os_graphics_status is 1
  if not fb_surface_init(front, framebuffer, width, height, stride, pixel_format) then return false
  os_graphics_status is 2
  if not fb_surface_init(back, os_backbuffer_address, width, height, stride, pixel_format) then return false
  os_graphics_status is 3
  if not os_window_manager_start(back) then return false
  os_graphics_status is 4
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if not desktop_shell_init(shell, width, height, 52) then return false
  files: ptr[FileExplorerState] is os_file_explorer_state
  if not file_explorer_init(files, 1) then return false
  editor: ptr[TextEditorState] is os_text_editor_state
  if not text_editor_init(editor, os_text_editor_buffer, 512) then return false
  calculator: ptr[CalculatorState] is os_calculator_state
  if not calculator_reset(calculator) then return false
  os_clock_refresh()
  if not os_draw_desktop(back) then return false
  os_graphics_status is 5
  background_sample: u32 is fb_get_pixel(back, 2, 2)
  taskbar_sample: u32 is fb_get_pixel(back, 2, height - 20)
  if background_sample == taskbar_sample then return false
  os_graphics_status is 6
  if fb_sample_hash(back) == 0 then return false
  os_graphics_status is 7
  if not os_present_with_pointer() then return false
  os_graphics_status is 0
  return true
end

func os_shell_accept(value: u64) do
  global os_shell_length, os_terminal_scroll_reported
  terminal: ptr[TextTerminal] is os_terminal_state
  if value == 13 then return true
  if value == 10 then
    if not serial_write_byte(1016, 10, 1000000) then return false
    if not text_terminal_newline(terminal) then return false
    if not os_shell_execute(os_shell_input, os_shell_length) then return false
    if terminal.scroll_count > 0 and os_terminal_scroll_reported == 0 then
      if not os_serial_line(os_terminal_scroll_marker, 26) then return false
      os_terminal_scroll_reported is 1
    end
    os_shell_length is 0
    mem.write8(os_shell_input, 0)
    if not os_serial_text(os_shell_prompt) then return false
    if not os_terminal_prompt() then return false
    return os_redraw_terminal()
  end
  if value == 8 or value == 127 then
    if os_shell_length > 0 then
      os_shell_length -= 1
      mem.write8(ptr.add(os_shell_input, os_shell_length), 0)
      text_terminal_put(terminal, 8)
      return os_redraw_terminal()
    end
    return true
  end
  if value >= 32 and value <= 126 and os_shell_length < 63 then
    mem.write8(ptr.add(os_shell_input, os_shell_length), value)
    os_shell_length += 1
    mem.write8(ptr.add(os_shell_input, os_shell_length), 0)
    if not text_terminal_put(terminal, value) then return false
    return os_redraw_terminal()
  end
  return true
end

func os_calculator_ring3_invalid(frame: ptr[OsUserInterruptFrame]) interrupt do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(6)
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(40)
  return
end

func os_calculator_ring3_general_protection(frame: ptr[OsUserInterruptFrame]) interrupt_error do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(13)
  serial_write_byte(1016, 32, 1000000)
  if frame != 0 then
    os_serial_u64(frame.error)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(frame.rip)
  end
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(41)
  return
end

func os_calculator_ring3_page_fault(frame: ptr[OsUserInterruptFrame]) interrupt_error do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(cpu.read_cr2())
  serial_write_byte(1016, 32, 1000000)
  if frame != 0 then
    os_serial_u64(frame.error)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(frame.rip)
  end
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(42)
  return
end

func os_calculator_ring3_interrupt(frame: ptr[OsUserInterruptFrame]) interrupt do
  global os_calculator_cr3_reported, os_editor_cr3_reported, os_files_cr3_reported, os_terminal_cr3_reported, os_user_app_active_id, os_shell_length, os_terminal_user_action, os_terminal_user_command, os_terminal_user_input
  if frame == 0 or frame.cs != 35 or (frame.cs & 3) != 3 then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(43)
    return
  end

  active_id: u64 is os_user_app_active_id
  if active_id != 1 and active_id != 2 and active_id != 3 and active_id != 4 then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(56)
    return
  end
  space: ptr[ProcessAddressSpace] is 0
  if active_id == 1 then space is os_calculator_process_space
  if active_id == 2 then space is os_editor_process_space
  if active_id == 3 then space is os_files_process_space
  if active_id == 4 then space is os_terminal_process_space
  if space == 0 or space.root == 0 or space.root == os_kernel_page_root or paging.root() != space.root then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(50)
    return
  end

  return_target: ptr is 0
  if active_id == 1 then
    mailbox: ptr[UserCalculatorMailbox] is os_user_worker_mailbox_address
    if mailbox.status != 1 or mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then
      os_serial_cstr_line(os_calculator_ring3_fault_marker)
      os_vm_exit(44)
      return
    end
    calculator: ptr[CalculatorState] is os_calculator_state
    calculator.left is mailbox.left
    calculator.right is mailbox.right
    calculator.operation is mailbox.operation
    calculator.entering_right is mailbox.entering_right
    calculator.result is mailbox.result
    calculator.has_result is mailbox.has_result
    calculator.error is mailbox.error
    return_target is addr_of(os_calculator_user_return)
  elif active_id == 2 then
    editor_mailbox: ptr[UserTextEditorMailbox] is os_user_worker_mailbox_address
    editor: ptr[TextEditorState] is os_text_editor_state
    if editor_mailbox.status != 1 or editor_mailbox.error > 2 then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(53)
      return
    end
    if editor_mailbox.request_sequence == 0 or editor_mailbox.response_sequence != editor_mailbox.request_sequence then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(54)
      return
    end
    if editor_mailbox.capacity != editor.capacity or editor_mailbox.length >= editor_mailbox.capacity then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(55)
      return
    end
    editor.length is editor_mailbox.length
    editor.dirty is editor_mailbox.dirty
    copy_index: u64 is 0
    while copy_index < editor.capacity do
      mem.write8(ptr.add(editor.buffer, copy_index), mem.read8(ptr.add(os_user_worker_mailbox_address, 64 + copy_index)))
      copy_index += 1
    end
    return_target is addr_of(os_editor_user_return)
  elif active_id == 3 then
    files_mailbox: ptr[UserFileExplorerMailbox] is os_user_worker_mailbox_address
    files: ptr[FileExplorerState] is os_file_explorer_state
    if files_mailbox.status != 1 or files_mailbox.error != 0 or files_mailbox.action != 1 then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(65)
      return
    end
    if files_mailbox.request_sequence == 0 or files_mailbox.response_sequence != files_mailbox.request_sequence then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(66)
      return
    end
    if files_mailbox.entry_count != files.entry_count or files_mailbox.selected >= files.entry_count then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(67)
      return
    end
    files.selected is files_mailbox.selected
    return_target is addr_of(os_files_user_return)
  elif active_id == 4 then
    terminal_mailbox: ptr[UserTerminalMailbox] is os_user_worker_mailbox_address
    if terminal_mailbox.status != 1 or terminal_mailbox.error > 2 then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(76)
      return
    end
    if terminal_mailbox.request_sequence == 0 or terminal_mailbox.response_sequence != terminal_mailbox.request_sequence then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(77)
      return
    end
    if terminal_mailbox.capacity != 64 or terminal_mailbox.length >= terminal_mailbox.capacity or terminal_mailbox.action > 3 or terminal_mailbox.command > 7 then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(78)
      return
    end
    os_shell_length is terminal_mailbox.length
    os_terminal_user_action is terminal_mailbox.action
    os_terminal_user_command is terminal_mailbox.command
    os_terminal_user_input is terminal_mailbox.input
    terminal_copy_index: u64 is 0
    while terminal_copy_index < 64 do
      mem.write8(ptr.add(os_shell_input, terminal_copy_index), mem.read8(ptr.add(os_user_worker_mailbox_address, 80 + terminal_copy_index)))
      terminal_copy_index += 1
    end
    return_target is addr_of(os_terminal_user_return)
  end

  paging.activate(os_kernel_page_root)
  if paging.root() != os_kernel_page_root then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(51)
    return
  end
  if active_id == 1 and os_calculator_cr3_reported == 0 then
    if not os_serial_cstr_line(os_calculator_cr3_marker) then os_vm_exit(52)
    os_calculator_cr3_reported is 1
  end
  if active_id == 2 and os_editor_cr3_reported == 0 then
    if not os_serial_cstr_line(os_editor_cr3_marker) then os_vm_exit(57)
    os_editor_cr3_reported is 1
  end
  if active_id == 3 and os_files_cr3_reported == 0 then
    if not os_serial_cstr_line(os_files_cr3_marker) then os_vm_exit(68)
    os_files_cr3_reported is 1
  end
  if active_id == 4 and os_terminal_cr3_reported == 0 then
    if not os_serial_cstr_line(os_terminal_cr3_marker) then os_vm_exit(79)
    os_terminal_cr3_reported is 1
  end
  os_user_app_active_id is 0

  # Return to a clean kernel continuation instead of exposing the interrupted
  # kernel call stack to user mode. The interrupt epilogue sees the rewritten
  # ring-0 selector and therefore keeps the kernel GS base active.
  frame.rip is return_target
  frame.cs is 8
  frame.rflags is 2
  frame.rsp is ptr.add(os_calculator_resume_stack, 16376)
  frame.ss is 16
  frame.rax is 0
  return
end

func os_calculator_ring3_start() do
  global os_calculator_ring3_ready, os_kernel_page_root
  if os_calculator_ring3_ready != 0 then return true

  # The copied function has only internal relative branches and no global
  # references, so it can execute from process-owned code pages.
  source: ptr is addr_of(user_calculator_program)
  source_end: ptr is addr_of(user_calculator_program_end)
  if source_end <= source or source_end - source > 8192 then return false
  code_size: u64 is source_end - source

  cpu.disable_interrupts()
  io.out8(33, 255)
  io.out8(161, 255)
  cpu.tss_set_rsp(os_calculator_ring3_tss, 0, ptr.add(os_calculator_kernel_stack, 16384))
  cpu.tss_set_ist(os_calculator_ring3_tss, 1, ptr.add(os_calculator_fault_stack, 16384))
  cpu.tss_set_iomap(os_calculator_ring3_tss, 104)
  cpu.gdt_set_tss(os_calculator_ring3_gdt, 5, os_calculator_ring3_tss, 103)
  cpu.load_gdt(os_calculator_ring3_gdt, 56)
  cpu.reload_segments(8, 16)
  cpu.load_task_register(40)

  cpu.idt_set_gate(os_calculator_ring3_idt, 6, addr_of(os_calculator_ring3_invalid), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 8, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 10, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 11, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 12, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 13, addr_of(os_calculator_ring3_general_protection), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 14, addr_of(os_calculator_ring3_page_fault), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 128, addr_of(os_calculator_ring3_interrupt), 8, 0, 238)
  cpu.load_idt(os_calculator_ring3_idt, 4096)
  percpu.set_base(0)
  percpu.set_kernel_base(0)

  os_kernel_page_root is paging.root()
  if os_kernel_page_root == 0 or not ptr.is_aligned(os_kernel_page_root, 4096) then return false

  buffers: ptr[ProcessSpaceBuffers] is os_calculator_process_buffers
  buffers.owned_pages is os_calculator_process_owned_pages
  buffers.owned_capacity is 32
  buffers.mappings is os_calculator_process_mappings
  buffers.mapping_capacity is 16

  config: ptr[OsUserWorkerConfig] is os_calculator_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is sizeof(UserCalculatorMailbox)
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 8192

  worker: ptr[OsUserWorker] is os_calculator_worker
  space: ptr[ProcessAddressSpace] is os_calculator_process_space
  stack: ptr[ProcessStack] is os_calculator_process_stack
  setup: ptr[OsUserWorkerInit] is os_calculator_worker_init
  setup.space is space
  setup.buffers is buffers
  setup.stack is stack
  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  mailbox: ptr[UserCalculatorMailbox] is os_calculator_mailbox_transfer
  mailbox.left is 0
  mailbox.right is 0
  mailbox.operation is 0
  mailbox.entering_right is 0
  mailbox.result is 0
  mailbox.has_result is 0
  mailbox.error is 0
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.input is 0
  mailbox.status is 0
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserCalculatorMailbox)) then return false

  os_calculator_ring3_ready is 1
  return os_serial_cstr_line(os_calculator_ring3_ready_marker)
end

func os_calculator_ring3_dispatch(value: u64) do
  global os_calculator_ring3_sequence, os_user_app_active_id
  if os_calculator_ring3_ready == 0 or os_user_app_active_id != 0 then return false
  calculator: ptr[CalculatorState] is os_calculator_state
  mailbox: ptr[UserCalculatorMailbox] is os_calculator_mailbox_transfer

  mailbox.left is calculator.left
  mailbox.right is calculator.right
  mailbox.operation is calculator.operation
  mailbox.entering_right is calculator.entering_right
  mailbox.result is calculator.result
  mailbox.has_result is calculator.has_result
  mailbox.error is calculator.error
  os_calculator_ring3_sequence += 1
  if os_calculator_ring3_sequence == 0 then os_calculator_ring3_sequence is 1
  mailbox.request_sequence is os_calculator_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.input is value
  mailbox.status is 0

  worker: ptr[OsUserWorker] is os_calculator_worker
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserCalculatorMailbox)) then return false
  os_user_app_active_id is 1
  if not os_user_worker_activate(worker) then
    os_user_app_active_id is 0
    return false
  end
  stack: ptr[ProcessStack] is worker.stack
  entered: bool is user.enter(worker.code_address, stack.initial_rsp, worker.mailbox_address, 35, 27)
  paging.activate(os_kernel_page_root)
  os_user_app_active_id is 0
  return false
end

func os_editor_ring3_start() do
  global os_editor_ring3_ready
  if os_editor_ring3_ready != 0 then return true
  if os_calculator_ring3_ready == 0 or os_kernel_page_root == 0 then return false

  source: ptr is addr_of(user_text_editor_program)
  source_end: ptr is addr_of(user_text_editor_program_end)
  if source_end <= source or source_end - source > 8192 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_editor_process_buffers
  buffers.owned_pages is os_editor_process_owned_pages
  buffers.owned_capacity is 32
  buffers.mappings is os_editor_process_mappings
  buffers.mapping_capacity is 16

  config: ptr[OsUserWorkerConfig] is os_editor_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is 576
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 8192

  worker: ptr[OsUserWorker] is os_editor_worker
  setup: ptr[OsUserWorkerInit] is os_editor_worker_init
  setup.space is os_editor_process_space
  setup.buffers is buffers
  setup.stack is os_editor_process_stack
  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  editor: ptr[TextEditorState] is os_text_editor_state
  mailbox: ptr[UserTextEditorMailbox] is os_editor_mailbox_transfer
  mailbox.length is editor.length
  mailbox.capacity is editor.capacity
  mailbox.dirty is editor.dirty
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.input is 0
  mailbox.status is 0
  mailbox.error is 0
  index: u64 is 0
  while index < editor.capacity do
    mem.write8(ptr.add(os_editor_mailbox_transfer, 64 + index), mem.read8(ptr.add(editor.buffer, index)))
    index += 1
  end
  if not os_user_worker_copy_to_mailbox(worker, os_editor_mailbox_transfer, 576) then return false

  os_editor_ring3_ready is 1
  return os_serial_cstr_line(os_editor_ring3_ready_marker)
end

func os_editor_ring3_dispatch(value: u64) do
  global os_editor_ring3_sequence, os_user_app_active_id
  if os_editor_ring3_ready == 0 or os_user_app_active_id != 0 then return false
  editor: ptr[TextEditorState] is os_text_editor_state
  mailbox: ptr[UserTextEditorMailbox] is os_editor_mailbox_transfer
  mailbox.length is editor.length
  mailbox.capacity is editor.capacity
  mailbox.dirty is editor.dirty
  os_editor_ring3_sequence += 1
  if os_editor_ring3_sequence == 0 then os_editor_ring3_sequence is 1
  mailbox.request_sequence is os_editor_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.input is value
  mailbox.status is 0
  mailbox.error is 0
  index: u64 is 0
  while index < editor.capacity do
    mem.write8(ptr.add(os_editor_mailbox_transfer, 64 + index), mem.read8(ptr.add(editor.buffer, index)))
    index += 1
  end

  worker: ptr[OsUserWorker] is os_editor_worker
  if not os_user_worker_copy_to_mailbox(worker, os_editor_mailbox_transfer, 576) then return false
  os_user_app_active_id is 2
  if not os_user_worker_activate(worker) then
    os_user_app_active_id is 0
    return false
  end
  stack: ptr[ProcessStack] is worker.stack
  entered: bool is user.enter(worker.code_address, stack.initial_rsp, worker.mailbox_address, 35, 27)
  paging.activate(os_kernel_page_root)
  os_user_app_active_id is 0
  return false
end

func os_files_ring3_start() do
  global os_files_ring3_ready
  if os_files_ring3_ready != 0 then return true
  if os_calculator_ring3_ready == 0 or os_kernel_page_root == 0 then return false

  source: ptr is addr_of(user_file_explorer_program)
  source_end: ptr is addr_of(user_file_explorer_program_end)
  if source_end <= source or source_end - source > 8192 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_files_process_buffers
  buffers.owned_pages is os_files_process_owned_pages

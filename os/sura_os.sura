# Minimal bootable Sura OS image for QEMU/OVMF.
#
# This program is compiled directly to a PE32+ EFI application. After
# ExitBootServices succeeds, it uses only freestanding Sura code: COM1,
# framebuffer memory, the physical-page allocator, port I/O, and CPU halt.

import "../stdlib/freestanding/serial.sura"
import "../stdlib/freestanding/physical_memory.sura"
import "../stdlib/freestanding/font5x7.sura"

os_allocator_state is static.struct(PhysicalAllocator)
os_allocator_bitmap is static.zero(65536, 4096)
os_memory_map is static.zero(131072, 4096)
os_front_surface_state is static.struct(FramebufferSurface)
os_back_surface_state is static.struct(FramebufferSurface)
os_font_white_large is static.struct(BitmapFontStyle)
os_font_white_small is static.struct(BitmapFontStyle)
os_font_orange_large is static.struct(BitmapFontStyle)
os_font_green_large is static.struct(BitmapFontStyle)
os_font_muted_small is static.struct(BitmapFontStyle)

os_boot_marker is static.utf8("SURA_OS_BOOT_OK")
os_memory_marker is static.utf8("SURA_OS_MEMORY_OK")
os_desktop_marker is static.utf8("SURA_OS_DESKTOP_OK")
os_ready_marker is static.utf8("SURA_OS_KERNEL_READY")
os_shutdown_marker is static.utf8("SURA_OS_SHUTDOWN")

os_shell_input is static.zero(128, 16)
os_number_buffer is static.zero(32, 16)

os_command_help is static.utf8("help")
os_command_status is static.utf8("status")
os_command_mem is static.utf8("mem")
os_command_about is static.utf8("about")
os_command_shutdown is static.utf8("shutdown")

os_shell_banner is static.utf8("Sura OS shell ready")
os_shell_prompt is static.utf8("sura> ")
os_shell_help is static.utf8("commands: help status mem about shutdown")
os_shell_status is static.utf8("kernel: ready")
os_shell_memory_prefix is static.utf8("free physical pages: ")
os_graphics_failure_prefix is static.utf8("graphics failure stage: ")
os_graphics_mode_prefix is static.utf8("graphics mode: ")
os_shell_about is static.utf8("Sura OS: freestanding x86-64 kernel running in QEMU")
os_shell_unknown is static.utf8("unknown command; type help")

os_text_brand is static.utf8("SURA OS")
os_text_start is static.utf8("SURA")
os_text_terminal is static.utf8("TERMINAL")
os_text_terminal_prompt is static.utf8("SURA> STATUS")
os_text_terminal_ready is static.utf8("KERNEL READY")
os_text_files is static.utf8("FILES")
os_text_about_icon is static.utf8("ABOUT")
os_text_vm is static.utf8("QEMU VM")

os_map_size: usize is 131072
os_map_key: u64 is 0
os_descriptor_size: usize is 0
os_descriptor_version: u32 is 0
os_backbuffer_address: u64 is 0
os_backbuffer_pages: u64 is 0
os_framebuffer_size: u64 is 0
os_graphics_status: u64 is 0

func os_vm_exit(code: u64) do
  io.out32(244, code)
  cpu.disable_interrupts()
  while true do
    cpu.halt()
  end
end

func os_serial_line(text: ptr, length: usize) do
  if not serial_write_buffer(1016, text, length, 1000000) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_serial_text(text: ptr) do
  return serial_write_cstr(1016, text, 256, 1000000)
end

func os_serial_cstr_line(text: ptr) do
  if not os_serial_text(text) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_serial_drain() do
  attempt: u64 is 0
  while attempt < 1000000 do
    if (io.in8(1021) & 64) != 0 then return true
    cpu.pause()
    attempt += 1
  end
  return false
end

func os_serial_u64(value: u64) do
  if value == 0 then return serial_write_byte(1016, 48, 1000000)

  index: usize is 32
  remaining: u64 is value
  while remaining > 0 do
    index -= 1
    mem.write8(ptr.add(os_number_buffer, index), 48 + (remaining % 10))
    remaining is remaining / 10
  end
  return serial_write_buffer(1016, ptr.add(os_number_buffer, index), 32 - index, 1000000)
end

func os_command_equals(buffer: ptr, length: usize, expected: ptr) do
  index: usize is 0
  while index < length do
    if mem.read8(ptr.add(buffer, index)) != mem.read8(ptr.add(expected, index)) then
      return false
    end
    index += 1
  end
  return mem.read8(ptr.add(expected, length)) == 0
end

func os_shell_execute(buffer: ptr, length: usize) do
  if length == 0 then return true

  if os_command_equals(buffer, length, os_command_help) then
    return os_serial_cstr_line(os_shell_help)
  end
  if os_command_equals(buffer, length, os_command_status) then
    return os_serial_cstr_line(os_shell_status)
  end
  if os_command_equals(buffer, length, os_command_mem) then
    allocator: ptr[PhysicalAllocator] is os_allocator_state
    if not os_serial_text(os_shell_memory_prefix) then return false
    if not os_serial_u64(pmem_available_pages(allocator)) then return false
    return serial_write_byte(1016, 10, 1000000)
  end
  if os_command_equals(buffer, length, os_command_about) then
    return os_serial_cstr_line(os_shell_about)
  end
  if os_command_equals(buffer, length, os_command_shutdown) then
    os_serial_cstr_line(os_shutdown_marker)
    os_serial_drain()
    os_vm_exit(16)
    return true
  end

  return os_serial_cstr_line(os_shell_unknown)
end

func os_shell_run() do
  if not os_serial_cstr_line(os_shell_banner) then return false
  if not os_serial_text(os_shell_prompt) then return false

  length: usize is 0
  while true do
    value: u64 is serial_read_byte(1016, 100000)
    if value == 65535 then
      cpu.pause()
    elif value == 13 then
      cpu.pause()
    elif value == 10 then
      if not serial_write_byte(1016, 10, 1000000) then return false
      if not os_shell_execute(os_shell_input, length) then return false
      length is 0
      if not os_serial_text(os_shell_prompt) then return false
    elif value == 8 or value == 127 then
      if length > 0 then
        length -= 1
      end
    elif value >= 32 and value <= 126 then
      if length < 127 then
        mem.write8(ptr.add(os_shell_input, length), value)
        length += 1
      end
    end
  end
  return true
end

func os_draw_desktop(surface: ptr[FramebufferSurface]) do
  if surface == 0 or surface.width < 640 or surface.height < 400 then return false

  navy: u32 is fb_rgb(surface, 12, 24, 44)
  navy_light: u32 is fb_rgb(surface, 18, 39, 70)
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  orange_light: u32 is fb_rgb(surface, 255, 153, 92)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  green: u32 is fb_rgb(surface, 94, 211, 132)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  font5x7_style_init(white_large, white, panel, 2, 0)
  font5x7_style_init(white_small, white, panel, 1, 0)
  font5x7_style_init(orange_large, orange_light, panel, 2, 0)
  font5x7_style_init(green_large, green, panel, 2, 0)
  font5x7_style_init(muted_small, muted, panel_light, 1, 0)

  if not fb_clear(surface, navy) then return false

  band_height: u64 is surface.height / 8
  band: u64 is 0
  while band < 8 do
    if (band & 1) == 0 then
      fb_fill_rect(surface, 0, band * band_height, surface.width, band_height, navy_light)
    end
    band += 1
  end

  # Brand mark and desktop icons.
  fb_fill_rect(surface, 28, 24, 54, 54, orange)
  fb_rect_outline(surface, 28, 24, 54, 54, white)
  fb_line(surface, 40, 37, 69, 37, white)
  fb_line(surface, 69, 37, 40, 65, white)
  fb_line(surface, 40, 65, 69, 65, white)
  font5x7_draw_text(surface, 96, 31, os_text_brand, 32, white_large)

  fb_draw_app_icon(surface, 34, 114, 48, titlebar, white)
  font5x7_draw_text(surface, 36, 168, os_text_files, 16, white_small)
  fb_draw_app_icon(surface, 34, 206, 48, orange, white)
  font5x7_draw_text(surface, 36, 260, os_text_about_icon, 16, white_small)

  # Centered terminal window.
  window_width: u64 is 640
  if surface.width < 760 then window_width is surface.width - 80
  window_height: u64 is 330
  if surface.height < 520 then window_height is surface.height - 150
  window_x: u64 is (surface.width - window_width) / 2
  window_y: u64 is (surface.height - window_height - 52) / 2
  fb_fill_rect(surface, window_x + 8, window_y + 10, window_width, window_height, black)
  fb_fill_rect(surface, window_x, window_y, window_width, window_height, panel)
  fb_rect_outline(surface, window_x, window_y, window_width, window_height, muted)
  fb_fill_rect(surface, window_x, window_y, window_width, 38, titlebar)
  font5x7_draw_text(surface, window_x + 16, window_y + 11, os_text_terminal, 32, white_large)
  fb_fill_rect(surface, window_x + window_width - 34, window_y + 8, 24, 22, orange)
  fb_line(surface, window_x + window_width - 28, window_y + 14, window_x + window_width - 17, window_y + 24, white)
  fb_line(surface, window_x + window_width - 17, window_y + 14, window_x + window_width - 28, window_y + 24, white)
  font5x7_draw_text(surface, window_x + 24, window_y + 72, os_text_terminal_prompt, 32, orange_large)
  font5x7_draw_text(surface, window_x + 24, window_y + 108, os_text_terminal_ready, 32, green_large)
  font5x7_draw_text(surface, window_x + 24, window_y + 144, os_shell_prompt, 16, white_large)
  fb_fill_rect(surface, window_x + 24 + 72, window_y + 144, 10, 15, white)

  # Taskbar and start button.
  taskbar_y: u64 is surface.height - 52
  fb_fill_rect(surface, 0, taskbar_y, surface.width, 52, panel_light)
  fb_hline(surface, 0, taskbar_y, surface.width, orange)
  fb_fill_rect(surface, 10, taskbar_y + 8, 104, 36, titlebar)
  fb_rect_outline(surface, 10, taskbar_y + 8, 104, 36, orange)
  font5x7_draw_text(surface, 26, taskbar_y + 19, os_text_start, 16, white_large)
  fb_fill_rect(surface, 126, taskbar_y + 8, 158, 36, panel)
  font5x7_draw_text(surface, 140, taskbar_y + 19, os_text_terminal, 16, white_small)
  font5x7_draw_text(surface, surface.width - 66, taskbar_y + 19, os_text_vm, 16, muted_small)
  return true
end

func os_graphics_start(framebuffer: ptr, width: u64, height: u64, stride: u64, pixel_format: u64) do
  global os_graphics_status
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  os_graphics_status is 1
  if not fb_surface_init(front, framebuffer, width, height, stride, pixel_format) then return false
  os_graphics_status is 2
  if not fb_surface_init(back, os_backbuffer_address, width, height, stride, pixel_format) then return false
  os_graphics_status is 3
  if not os_draw_desktop(back) then return false
  os_graphics_status is 4
  background_sample: u32 is fb_get_pixel(back, 2, 2)
  taskbar_sample: u32 is fb_get_pixel(back, 2, height - 20)
  if background_sample == taskbar_sample then return false
  os_graphics_status is 5
  if fb_sample_hash(back) == 0 then return false
  os_graphics_status is 6
  if not fb_present(back, front.pixels) then return false
  os_graphics_status is 0
  return true
end

func os_memory_self_test() do
  allocator: ptr[PhysicalAllocator] is os_allocator_state
  if not pmem_init_from_uefi(allocator, os_allocator_bitmap, 65536, os_memory_map, os_map_size, os_descriptor_size) then
    return false
  end

  page: u64 is pmem_alloc(allocator)
  if page == 0 then return false

  signature: u64 is u64("0x535552414f534f4b")
  mem.write64(page, signature)
  if mem.read64(page) != signature then return false
  return pmem_free(allocator, page)
end

func efi_main(image_handle: u64, system_table: ptr) -> u64 do
  global os_map_size, os_map_key, os_descriptor_size, os_descriptor_version, os_backbuffer_address, os_backbuffer_pages, os_framebuffer_size

  uefi.clear()
  uefi.set_color(15, 0)
  uefi.write("Sura OS virtual machine")
  uefi.newline()
  uefi.write("Preparing the freestanding kernel...")
  uefi.newline()

  framebuffer: ptr is uefi.gop_framebuffer()
  framebuffer_width: u32 is uefi.gop_width()
  framebuffer_height: u32 is uefi.gop_height()
  framebuffer_stride: u32 is uefi.gop_stride()
  framebuffer_format: u32 is uefi.gop_pixel_format()
  os_framebuffer_size is uefi.gop_framebuffer_size()

  if framebuffer == 0 or os_framebuffer_size == 0 or os_framebuffer_size > 67108864 then
    os_vm_exit(9)
    return 9
  end
  os_backbuffer_pages is (os_framebuffer_size + 4095) / 4096
  allocation_status: u64 is uefi.allocate_pages(0, 2, os_backbuffer_pages, addr_of(os_backbuffer_address))
  if allocation_status != 0 or os_backbuffer_address == 0 then
    os_vm_exit(10)
    return 10
  end

  if not serial_init(1016, 1) then
    os_vm_exit(1)
    return 1
  end

  map_status: u64 is 1
  exit_status: u64 is 1
  attempt: u64 is 0
  while attempt < 4 and exit_status != 0 do
    os_map_size is 131072
    map_status is uefi.get_memory_map(addr_of(os_map_size), os_memory_map, addr_of(os_map_key), addr_of(os_descriptor_size), addr_of(os_descriptor_version))
    if map_status == 0 then
      exit_status is uefi.exit_boot_services(os_map_key)
    end
    attempt += 1
  end

  if map_status != 0 or exit_status != 0 then
    os_vm_exit(2)
    return 2
  end

  cpu.disable_interrupts()
  if not os_serial_line(os_boot_marker, 15) then
    os_vm_exit(3)
    return 3
  end

  if not os_graphics_start(framebuffer, framebuffer_width, framebuffer_height, framebuffer_stride, framebuffer_format) then
    os_serial_text(os_graphics_failure_prefix)
    os_serial_u64(os_graphics_status)
    serial_write_byte(1016, 10, 1000000)
    os_serial_text(os_graphics_mode_prefix)
    os_serial_u64(framebuffer_width)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_height)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_stride)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_format)
    serial_write_byte(1016, 10, 1000000)
    os_serial_drain()
    os_vm_exit(7)
    return 7
  end
  if not os_serial_line(os_desktop_marker, 18) then
    os_vm_exit(11)
    return 11
  end

  if not os_memory_self_test() then
    os_vm_exit(4)
    return 4
  end
  if not os_serial_line(os_memory_marker, 17) then
    os_vm_exit(5)
    return 5
  end
  if not os_serial_line(os_ready_marker, 20) then
    os_vm_exit(6)
    return 6
  end

  if not os_shell_run() then
    os_vm_exit(8)
    return 8
  end
  return 0
end

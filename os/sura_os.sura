func os_terminal_ring3_dispatch(value: u64) do
  global os_terminal_ring3_sequence, os_user_app_active_id
  if os_terminal_ring3_ready == 0 then return true
  if os_user_app_active_id != 0 then return false
  packed_count: u64 is (value >> 56) & 7
  if os_shell_length >= 64 then return false
  if packed_count == 0 and value > 255 then return false
  if packed_count != 0 and os_shell_length + packed_count >= 64 then return false
  mailbox: ptr[UserTerminalMailbox] is os_terminal_mailbox_transfer
  mailbox.length is os_shell_length
  mailbox.capacity is 64
  os_terminal_ring3_sequence += 1
  if os_terminal_ring3_sequence == 0 then os_terminal_ring3_sequence is 1
  mailbox.request_sequence is os_terminal_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.input is value
  mailbox.action is 0
  mailbox.command is 0
  mailbox.status is 0
  mailbox.error is 0
  index: u64 is 0
  while index < 64 do
    mem.write8(ptr.add(os_terminal_mailbox_transfer, 80 + index), mem.read8(ptr.add(os_shell_input, index)))
    index += 1
  end

  worker: ptr[OsUserWorker] is os_terminal_worker
  if not os_user_worker_copy_to_mailbox(worker, os_terminal_mailbox_transfer, 144) then return false
  os_user_app_active_id is 4
  dispatch_status: u64 is os_user_scheduler_dispatch(4, mailbox.request_sequence)
  os_user_app_active_id is 0
  if dispatch_status != 1 then return os_user_process_handle_failure(4, dispatch_status)
  if not os_user_worker_copy_from_mailbox(worker, os_terminal_mailbox_transfer, 144) then return false
  if not os_terminal_accept_mailbox() then return false
  if not os_user_process_report_cr3(4) then return false
  return os_terminal_complete()
end

func os_system_mailbox_snapshot(mailbox: ptr[UserSystemInfoMailbox]) do
  if mailbox == 0 then return false
  front: ptr[FramebufferSurface] is os_front_surface_state
  allocator: ptr[PhysicalAllocator] is os_allocator_state
  if front.width < 640 or front.height < 400 then return false
  mailbox.width is front.width
  mailbox.height is front.height
  mailbox.free_pages is pmem_available_pages(allocator)
  mailbox.storage_ready is 0
  if os_storage_mounted != 0 then mailbox.storage_ready is 1
  mailbox.network_ready is 0
  if os_network_status == 0 and os_network_resolved_ip != 0 then mailbox.network_ready is 1
  return mailbox.free_pages != 0
end

func os_system_ring3_start() do
  global os_system_ring3_ready
  if os_system_ring3_ready != 0 then return true
  if os_kernel_page_root == 0 then return false

  source: ptr is addr_of(user_system_info_program)
  source_end: ptr is addr_of(user_system_info_program_end)
  if source_end <= source or source_end - source > 8192 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_system_process_buffers
  buffers.owned_pages is os_system_process_owned_pages
  buffers.owned_capacity is 32
  buffers.mappings is os_system_process_mappings
  buffers.mapping_capacity is 16

  config: ptr[OsUserWorkerConfig] is os_system_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is sizeof(UserSystemInfoMailbox)
  config.event_address is os_user_worker_mailbox_address + 4096
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 8192

  worker: ptr[OsUserWorker] is os_system_worker
  setup: ptr[OsUserWorkerInit] is os_system_worker_init
  setup.space is os_system_process_space
  setup.buffers is buffers
  setup.stack is os_system_process_stack
  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  mailbox: ptr[UserSystemInfoMailbox] is os_system_mailbox_transfer
  if not os_system_mailbox_snapshot(mailbox) then return false
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.action is 0
  mailbox.status is 0
  mailbox.error is 0
  mailbox.memory_mib is 0
  mailbox.pixel_count is 0
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserSystemInfoMailbox)) then return false

  os_system_ring3_ready is 1
  return os_serial_cstr_line(os_system_ring3_ready_marker)
end

func os_system_ring3_dispatch() do
  global os_system_ring3_sequence, os_user_app_active_id
  if os_system_ring3_ready == 0 then return true
  if os_user_app_active_id != 0 then return false
  mailbox: ptr[UserSystemInfoMailbox] is os_system_mailbox_transfer
  if not os_system_mailbox_snapshot(mailbox) then return false
  os_system_ring3_sequence += 1
  if os_system_ring3_sequence == 0 then os_system_ring3_sequence is 1
  mailbox.request_sequence is os_system_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.action is 0
  mailbox.status is 0
  mailbox.error is 0
  mailbox.memory_mib is 0
  mailbox.pixel_count is 0

  worker: ptr[OsUserWorker] is os_system_worker
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserSystemInfoMailbox)) then return false
  os_user_app_active_id is 5
  dispatch_status: u64 is os_user_scheduler_dispatch(5, mailbox.request_sequence)
  os_user_app_active_id is 0
  if dispatch_status != 1 then return os_user_process_handle_failure(5, dispatch_status)
  if not os_user_worker_copy_from_mailbox(worker, mailbox, sizeof(UserSystemInfoMailbox)) then return false
  if not os_system_accept_mailbox() then return false
  if not os_user_process_report_cr3(5) then return false
  return os_system_complete()
end

func os_browser_ring3_start() do
  global os_browser_ring3_ready
  if os_browser_ring3_ready != 0 then return true
  if os_kernel_page_root == 0 then return false

  source: ptr is addr_of(user_browser_program)
  source_end: ptr is addr_of(user_browser_program_end)
  if source_end <= source or source_end - source > 8192 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_browser_process_buffers
  buffers.owned_pages is os_browser_process_owned_pages
  buffers.owned_capacity is 32
  buffers.mappings is os_browser_process_mappings
  buffers.mapping_capacity is 16

  config: ptr[OsUserWorkerConfig] is os_browser_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is 384
  config.event_address is os_user_worker_mailbox_address + 4096
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 8192

  worker: ptr[OsUserWorker] is os_browser_worker
  setup: ptr[OsUserWorkerInit] is os_browser_worker_init
  setup.space is os_browser_process_space
  setup.buffers is buffers

  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  editor: ptr[TextEditorState] is os_text_editor_state
  mailbox: ptr[UserTextEditorMailbox] is os_editor_mailbox_transfer
  mailbox.length is editor.length
  mailbox.capacity is editor.capacity
  mailbox.dirty is editor.dirty
  mailbox.cursor is editor.cursor
  mailbox.selection_anchor is editor.selection_anchor
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.command is 0
  mailbox.input is 0
  mailbox.payload_length is 0
  mailbox.status is 0
  mailbox.error is 0
  index: u64 is 0
  while index < editor.capacity do
    mem.write8(ptr.add(os_editor_mailbox_transfer, 96 + index), mem.read8(ptr.add(editor.buffer, index)))
    index += 1
  end
  if not os_user_worker_copy_to_mailbox(worker, os_editor_mailbox_transfer, 8288) then return false

  os_editor_ring3_ready is 1
  return os_serial_cstr_line(os_editor_ring3_ready_marker)
end

func os_editor_ring3_submit(command: u64, payload: ptr, payload_length: u64, input: u64) do
  global os_editor_ring3_sequence, os_user_app_active_id
  if os_editor_ring3_ready == 0 then return true
  if os_user_app_active_id != 0 then return false
  editor: ptr[TextEditorState] is os_text_editor_state
  if command < 1 or command > 3 or payload_length >= editor.capacity then return false
  if payload_length != 0 and payload == 0 then return false
  mailbox: ptr[UserTextEditorMailbox] is os_editor_mailbox_transfer
  mailbox.length is editor.length
  mailbox.capacity is editor.capacity
  mailbox.dirty is editor.dirty
  mailbox.cursor is editor.cursor
  mailbox.selection_anchor is editor.selection_anchor
  os_editor_ring3_sequence += 1
  if os_editor_ring3_sequence == 0 then os_editor_ring3_sequence is 1
  mailbox.request_sequence is os_editor_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.command is command
  mailbox.input is input
  mailbox.payload_length is payload_length
  mailbox.status is 0
  mailbox.error is 0
  index: u64 is 0
  while index < editor.capacity do
    mem.write8(ptr.add(os_editor_mailbox_transfer, 96 + index), mem.read8(ptr.add(editor.buffer, index)))
    index += 1
  end
  index is 0
  while index < payload_length do
    mem.write8(ptr.add(os_editor_mailbox_transfer, 4192 + index), mem.read8(ptr.add(payload, index)))
    index += 1
  end

  worker: ptr[OsUserWorker] is os_editor_worker
  if not os_user_worker_copy_to_mailbox(worker, os_editor_mailbox_transfer, 8288) then return false
  os_user_app_active_id is 2
  dispatch_status: u64 is os_user_scheduler_dispatch(2, mailbox.request_sequence)
  os_user_app_active_id is 0
  if dispatch_status != 1 then return os_user_process_handle_failure(2, dispatch_status)
  if not os_user_worker_copy_from_mailbox(worker, os_editor_mailbox_transfer, 8288) then return false
  if not os_editor_accept_mailbox() then return false
  if not os_user_process_report_cr3(2) then return false
  return os_editor_complete()
end

func os_editor_ring3_dispatch(value: u64) do
  if value == 8 or value == 127 then return os_editor_ring3_submit(2, 0, 0, value)
  packed_count: u64 is (value >> 56) & 7
  if packed_count != 0 then
    index: u64 is 0
    while index < packed_count do
      byte: u64 is (value >> (index * 8)) & 255
      if byte == 0 then return false
      mem.write8(ptr.add(os_text_input_utf8, index), byte)
      index += 1
    end
    return os_editor_ring3_submit(1, os_text_input_utf8, packed_count, value)
  end
  if value == 13 then value is 10
  if value == 10 or value >= 32 and value <= 126 then
    mem.write8(os_text_input_utf8, value)
    return os_editor_ring3_submit(1, os_text_input_utf8, 1, value)
  end
  return false
end

func os_editor_ring3_delete_forward() do
  return os_editor_ring3_submit(3, 0, 0, 0)
end

func os_editor_ring3_paste() do
  if os_editor_clipboard_length == 0 then return true
  return os_editor_ring3_submit(1, os_editor_clipboard, os_editor_clipboard_length, 0)
end


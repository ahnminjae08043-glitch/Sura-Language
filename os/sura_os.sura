end

func os_editor_find_append(packed: u64) do
  global os_editor_find_length, os_editor_replace_length
  byte_count: u64 is (packed >> 56) & 7
  if byte_count == 0 then return true
  buffer: ptr is os_editor_find_buffer
  length: u64 is os_editor_find_length
  if os_editor_find_field != 0 then
    buffer is os_editor_replace_buffer
    length is os_editor_replace_length
  end
  if length + byte_count >= 64 then return false
  index: u64 is 0
  while index < byte_count do
    value: u64 is (packed >> (index * 8)) & 255
    if value == 0 then return false
    mem.write8(ptr.add(buffer, length), value)
    length += 1
    index += 1
  end
  mem.write8(ptr.add(buffer, length), 0)
  if os_editor_find_field == 0 then os_editor_find_length is length
  if os_editor_find_field != 0 then os_editor_replace_length is length
  return true
end

func os_editor_find_backspace() do
  global os_editor_find_length, os_editor_replace_length
  buffer: ptr is os_editor_find_buffer
  length: u64 is os_editor_find_length
  if os_editor_find_field != 0 then
    buffer is os_editor_replace_buffer
    length is os_editor_replace_length
  end
  if length == 0 then return true
  length -= 1
  while length > 0 and (mem.read8(ptr.add(buffer, length)) & 192) == 128 do
    length -= 1
  end
  mem.write8(ptr.add(buffer, length), 0)
  if os_editor_find_field == 0 then os_editor_find_length is length
  if os_editor_find_field != 0 then os_editor_replace_length is length
  return true
end

func os_editor_find_match(index: u64) do
  editor: ptr[TextEditorState] is os_text_editor_state
  if os_editor_find_length == 0 or index + os_editor_find_length > editor.length then return false
  offset: u64 is 0
  while offset < os_editor_find_length do
    if mem.read8(ptr.add(editor.buffer, index + offset)) != mem.read8(ptr.add(os_editor_find_buffer, offset)) then return false
    offset += 1
  end
  return true
end

func os_editor_find_next() do
  editor: ptr[TextEditorState] is os_text_editor_state
  if os_editor_find_length == 0 or os_editor_find_length > editor.length then return os_redraw_desktop()
  candidate_count: u64 is editor.length - os_editor_find_length + 1
  start: u64 is editor.cursor
  if text_editor_has_selection(editor) then start is text_editor_selection_start(editor) + 1
  if start >= candidate_count then start is 0
  scanned: u64 is 0
  while scanned < candidate_count do
    candidate: u64 is start + scanned
    if candidate >= candidate_count then candidate -= candidate_count
    if os_editor_find_match(candidate) then
      editor.selection_anchor is candidate
      editor.cursor is candidate + os_editor_find_length
      if not os_serial_cstr_line(os_editor_find_marker) then return false
      return os_redraw_desktop()
    end
    scanned += 1
  end
  return os_redraw_desktop()
end

func os_editor_replace_current() do
  editor: ptr[TextEditorState] is os_text_editor_state
  start: u64 is text_editor_selection_start(editor)
  finish: u64 is text_editor_selection_end(editor)
  if finish - start != os_editor_find_length or not os_editor_find_match(start) then return os_editor_find_next()
  if not os_serial_cstr_line(os_editor_replace_marker) then return false
  return os_editor_ring3_submit(1, os_editor_replace_buffer, os_editor_replace_length, 0)
end

func os_editor_find_key_event(event: ptr[KeyEvent]) do
  global os_editor_find_field
  if event == 0 or event.pressed == 0 then return true
  state: ptr[TextInputState] is os_editor_find_text_input_state
  result: ptr[TextInputResult] is os_editor_find_text_input_result
  if event.physical_key == 1 then return os_editor_find_close()
  if event.physical_key == 15 and os_editor_find_mode == 2 then
    os_editor_find_field is 1 - os_editor_find_field
    text_input_reset(state)
    if os_input_layout_hangul != 0 then
      if not text_input_set_hangul(state, true, result) then return false
    end
    return os_redraw_desktop()
  end
  if event.physical_key == 28 then
    if text_input_composing(state) != 0 then
      text_input_result_clear(result)
      if not text_input_commit(state, result) then return false
      packed_commit: u64 is os_text_input_pack(result)
      if packed_commit != 0 and not os_editor_find_append(packed_commit) then return false
    end
    if os_editor_find_mode == 1 then return os_editor_find_next()
    if os_editor_find_field == 0 then
      os_editor_find_field is 1
      return os_redraw_desktop()
    end
    return os_editor_replace_current()
  end
  layout_key: bool is event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul()
  if layout_key then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    if not os_input_layout_record(state) then return false
    packed_layout: u64 is os_text_input_pack(result)
    if packed_layout != 0 and not os_editor_find_append(packed_layout) then return false
    return os_redraw_desktop()
  end
  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    if not os_editor_find_backspace() then return false
    return os_redraw_desktop()
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 and not os_editor_find_append(packed) then return false
  if packed != 0 or result.changed != 0 or text_input_composing(state) != composing_before then return os_redraw_desktop()
  return true
end

func os_editor_capture_selection(marker: ptr) do
  global os_editor_clipboard_length
  editor: ptr[TextEditorState] is os_text_editor_state
  if not text_editor_has_selection(editor) then return false
  if not memfs_zero(os_editor_clipboard, 4096) then return false
  copied: u64 is text_editor_copy_selection(editor, os_editor_clipboard, 4096)
  if copied == 0 then return false
  os_editor_clipboard_length is copied
  return os_serial_cstr_line(marker)
end

func os_editor_select_all() do
  global os_editor_selection_reported
  editor: ptr[TextEditorState] is os_text_editor_state
  if not text_editor_select_all(editor) then return false
  if os_editor_selection_reported == 0 then
    if not os_serial_cstr_line(os_editor_selection_marker) then return false
    os_editor_selection_reported is 1
  end
  return os_redraw_desktop()
end

func os_editor_key_event(event: ptr[KeyEvent]) do
  if event == 0 or event.pressed == 0 then return true
  if os_editor_save_as_active != 0 then return os_editor_save_key_event(event)
  if os_editor_find_mode != 0 then return os_editor_find_key_event(event)
  ctrl: bool is (event.modifiers & key_event_modifier_ctrl()) != 0
  shift: bool is (event.modifiers & key_event_modifier_shift()) != 0
  editor: ptr[TextEditorState] is os_text_editor_state
  if ctrl and event.physical_key == 33 then return os_editor_find_begin(1)
  if ctrl and event.physical_key == 35 then return os_editor_find_begin(2)
  if event.physical_key == 61 and os_editor_find_length != 0 then return os_editor_find_next()
  if ctrl and event.physical_key == 30 then return os_editor_select_all()
  if ctrl and event.physical_key == 46 then
    if not os_editor_capture_selection(os_editor_copy_marker) then return true
    return os_redraw_desktop()
  end
  if ctrl and event.physical_key == 45 then
    if not os_editor_capture_selection(os_editor_cut_marker) then return true
    return os_editor_ring3_dispatch(8)
  end
  if ctrl and event.physical_key == 47 then
    if os_editor_clipboard_length == 0 then return true
    if not os_serial_cstr_line(os_editor_paste_marker) then return false
    return os_editor_ring3_paste()
  end
  if ctrl and shift and event.physical_key == 31 then return os_editor_save_begin()
  if ctrl and not shift and event.physical_key == 31 then
    if os_surafs_mounted != 0 then return os_surafs_save_editor(true)
    return true
  end
  if event.physical_key == 331 then
    if not text_editor_move_left(editor, shift) then return false
    return os_redraw_desktop()
  end
  if event.physical_key == 333 then
    if not text_editor_move_right(editor, shift) then return false
    return os_redraw_desktop()
  end
  if event.physical_key == 327 then
    if not text_editor_set_cursor(editor, 0, shift) then return false
    return os_redraw_desktop()
  end
  if event.physical_key == 335 then
    if not text_editor_set_cursor(editor, editor.length, shift) then return false
    return os_redraw_desktop()
  end
  if event.physical_key == 339 then return os_editor_ring3_delete_forward()
  state: ptr[TextInputState] is os_text_input_state
  result: ptr[TextInputResult] is os_text_input_result

  # Right Alt is a common Korean-layout fallback when no dedicated Hangul key
  # is available. Dedicated key 512 is handled by text_input_feed_key_event.
  if event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul() then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    if not os_input_layout_record(state) then return false
    packed: u64 is os_text_input_pack(result)
    if packed != 0 then return os_editor_ring3_dispatch(packed)
    return os_redraw_desktop()
  end

  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    return os_editor_ring3_dispatch(8)
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 then return os_editor_ring3_dispatch(packed)
  if result.changed != 0 or result.composing != composing_before then return os_redraw_desktop()
  return true
end

func os_browser_report_korean() do
  global os_browser_korean_reported
  if os_browser_korean_reported != 0 or os_browser_address_length < 6 then return true
  index: u64 is 0
  while index + 5 < os_browser_address_length do
    matches: bool is mem.read8(ptr.add(os_browser_address_buffer, index)) == 237
    if matches then matches is mem.read8(ptr.add(os_browser_address_buffer, index + 1)) == 149
    if matches then matches is mem.read8(ptr.add(os_browser_address_buffer, index + 2)) == 156
    if matches then matches is mem.read8(ptr.add(os_browser_address_buffer, index + 3)) == 234
    if matches then matches is mem.read8(ptr.add(os_browser_address_buffer, index + 4)) == 184
    if matches then matches is mem.read8(ptr.add(os_browser_address_buffer, index + 5)) == 128
    if matches then
      if not os_serial_cstr_line(os_browser_korean_marker) then return false
      os_browser_korean_reported is 1
      return true
    end
    index += 1
  end
  return true
end

func os_browser_form_accept_packed(value: u64) do
  global os_browser_form_input_reported
  count: u64 is (value >> 56) & 7
  if count == 0 or count > 7 then return false
  index: u64 is 0
  while index < count do
    byte: u64 is (value >> (index * 8)) & 255
    if byte == 0 then return false
    mem.write8(ptr.add(os_text_input_utf8, index), byte)
    index += 1
  end
  if not browser_form_insert(os_browser_form_state, os_text_input_utf8, count) then return false
  if os_browser_form_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_form_input_marker) then return false
    os_browser_form_input_reported is 1
  end
  return true
end

func os_browser_form_key_event(event: ptr[KeyEvent]) do
  global os_browser_backspace_repeat_reported
  global os_browser_form_editing, os_browser_scroll_y, os_browser_scroll_max, os_browser_scroll_reported
  if event == 0 or event.pressed == 0 then return true
  state: ptr[TextInputState] is os_browser_text_input_state
  result: ptr[TextInputResult] is os_browser_text_input_result
  if event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul() then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    if not os_input_layout_record(state) then return false
    packed: u64 is os_text_input_pack(result)
    if packed != 0 and not os_browser_form_accept_packed(packed) then return false
    return os_redraw_desktop()
  end
  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    if not browser_form_backspace(os_browser_form_state) then return false
    if event.repeated != 0 and os_browser_backspace_repeat_reported == 0 then
      if not os_serial_cstr_line(os_browser_backspace_repeat_marker) then return false
      os_browser_backspace_repeat_reported is 1
    end
    return os_redraw_desktop()
  end
  if event.physical_key == 28 or event.unicode == 10 or event.unicode == 13 then
    if text_input_composing(state) != 0 then
      text_input_result_clear(result)
      if not text_input_commit(state, result) then return false
      packed_commit: u64 is os_text_input_pack(result)
      if packed_commit != 0 and not os_browser_form_accept_packed(packed_commit) then return false
    end
    form_state: ptr[BrowserFormState] is os_browser_form_state
    focused: u64 is form_state.focused
    if focused < form_state.count then
      if not os_browser_submit_form(focused) then return false
      os_browser_form_editing is 0
      os_browser_scroll_y is 0
      os_browser_scroll_max is 0
      os_browser_scroll_reported is 0
      return os_redraw_desktop()
    end
    return true
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 and not os_browser_form_accept_packed(packed) then return false
  if packed != 0 or result.changed != 0 or result.composing != composing_before then return os_redraw_desktop()
  return true
end

func os_browser_key_event(event: ptr[KeyEvent]) do
  global os_browser_dom_render_reported, os_browser_dom_viewport_width, os_browser_dom_viewport_height, os_browser_scroll_y, os_browser_scroll_max, os_browser_scroll_reported
  global os_browser_backspace_repeat_reported, os_browser_edit_started, os_browser_form_editing, os_browser_navigation_async_input_reported, os_browser_navigation_tcp_input_reported, os_browser_navigation_tls_input_reported, os_browser_navigation_fetch_active, os_browser_navigation_fetch_cancel_requested
  if event == 0 or event.pressed == 0 then return true
  # Keep the rest of the desktop responsive during a cooperative network
  # yield without allowing address edits or another browser request to
  # re-enter the shared HTTP/TLS state. F6 is the one safe exception: it
  # requests cancellation, and the outer fetch wrapper restores UI state
  # only after the shared network stack has unwound.
  if os_browser_navigation_fetch_active != 0 then
    if event.physical_key == 64 and os_browser_navigation_fetch_cancel_requested == 0 then
      os_browser_navigation_fetch_cancel_requested is 1
      if not os_serial_cstr_line(os_browser_navigation_fetch_cancel_request_marker) then return false
    end
    return true
  end
  # F6 selects the address field, matching the common desktop-browser
  # shortcut and providing a keyboard-only path that does not depend on
  # pointer coordinates.
  if event.physical_key == 64 then
    if not os_browser_navigation_cancel() then return false
    os_browser_form_editing is 0
    os_browser_form_state.focused is u64("0xffffffffffffffff")
    os_browser_edit_started is 0
    if not text_input_reset(os_browser_text_input_state) then return false
    return os_redraw_browser_address()
  end
  if os_browser_form_editing != 0 then return os_browser_form_key_event(event)
  state: ptr[TextInputState] is os_browser_text_input_state
  result: ptr[TextInputResult] is os_browser_text_input_result

  if os_browser_edit_started == 0 then
    if event.physical_key == 328 then return os_browser_scroll_by(-1, 48)
    if event.physical_key == 336 then return os_browser_scroll_by(1, 48)
    if event.physical_key == 329 then return os_browser_scroll_by(-1, os_browser_dom_viewport_height)
    if event.physical_key == 337 then return os_browser_scroll_by(1, os_browser_dom_viewport_height)
    if event.physical_key == 327 then return os_browser_scroll_by(-1, os_browser_scroll_y)
    if event.physical_key == 335 then return os_browser_scroll_by(1, os_browser_scroll_max - os_browser_scroll_y)
  end

  if event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul() then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    if not os_input_layout_record(state) then return false
    packed: u64 is os_text_input_pack(result)
    if packed != 0 and not os_browser_accept_packed(packed) then return false
    if not os_browser_report_korean() then return false
    return os_redraw_browser_address()
  end

  if event.physical_key == 28 or event.unicode == 10 or event.unicode == 13 then
    if text_input_composing(state) != 0 then
      text_input_result_clear(result)
      if not text_input_commit(state, result) then return false
      packed: u64 is os_text_input_pack(result)
      if packed != 0 and not os_browser_accept_packed(packed) then return false
    end
    if not os_browser_report_korean() then return false
    os_browser_dom_render_reported is 0
    os_browser_dom_viewport_width is 0
    os_browser_dom_viewport_height is 0
    os_browser_scroll_y is 0
    os_browser_scroll_max is 0
    os_browser_scroll_reported is 0
    os_browser_navigation_async_input_reported is 0
    os_browser_navigation_tcp_input_reported is 0
    os_browser_navigation_tls_input_reported is 0
    if not os_browser_navigation_begin(os_network_context) then return false
    if os_browser_navigation_state == 1 then
      if not os_serial_cstr_line(os_browser_navigation_async_begin_marker) then return false
    end
    return os_redraw_desktop()
  end

  # DNS host names remain ASCII until IDNA is implemented. In Korean mode,
  # physical letter keys still enter the host literally; composition starts
  # only after the URL path slash.
  if state.hangul != 0 and event.unicode != 0 and event.physical_key != 14 then
    if os_browser_edit_started == 0 and not os_browser_begin_edit() then return false
    if not os_browser_path_started() then
      if not os_browser_accept(event.unicode) then return false
      return os_redraw_browser_address()
    end
  end

  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    if not os_browser_backspace_codepoint() then return false
    if event.repeated != 0 and os_browser_backspace_repeat_reported == 0 then
      if not os_serial_cstr_line(os_browser_backspace_repeat_marker) then return false
      os_browser_backspace_repeat_reported is 1
    end
    return os_redraw_browser_address()
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 and not os_browser_accept_packed(packed) then return false
  if not os_browser_report_korean() then return false
  if packed != 0 or result.changed != 0 or result.composing != composing_before then return os_redraw_browser_address()
  return true
end

func os_input_event_post(event: ptr[KeyEvent]) do
  if event == 0 then return false
  message: ptr[IpcMessage] is os_input_event_message
  if not ipc_message_clear(message) then return false
  message.kind is 100
  message.value0 is event.physical_key
  message.value1 is event.unicode
  message.value2 is event.modifiers
  message.value3 is event.scan_code & 65535
  if event.pressed != 0 then message.value3 is message.value3 | (1 << 16)
  if event.released != 0 then message.value3 is message.value3 | (1 << 17)
  if event.repeated != 0 then message.value3 is message.value3 | (1 << 18)
  return ipc_queue_push(os_input_event_queue, message)
end

func os_input_event_receive(event: ptr[KeyEvent]) do
  if event == 0 then return false
  message: ptr[IpcMessage] is os_input_event_received
  if not ipc_queue_pop(os_input_event_queue, message) then return false
  if message.kind != 100 then return false
  if not key_event_clear(event) then return false
  event.physical_key is message.value0
  event.unicode is message.value1
  event.modifiers is message.value2
  event.scan_code is message.value3 & 65535
  if (message.value3 & (1 << 16)) != 0 then event.pressed is 1
  if (message.value3 & (1 << 17)) != 0 then event.released is 1
  if (message.value3 & (1 << 18)) != 0 then event.repeated is 1
  event.sequence is message.sequence
  return true
end

func os_input_event_self_test() do
  event: ptr[KeyEvent] is os_key_event_state
  if not key_event_clear(event) then return false
  event.physical_key is 30
  event.scan_code is 30
  event.unicode is 97
  event.pressed is 1
  event.modifiers is key_event_modifier_shift()
  if not os_input_event_post(event) then return false
  if not key_event_clear(event) then return false
  if not os_input_event_receive(event) then return false
  if event.physical_key != 30 or event.scan_code != 30 then return false
  if event.unicode != 97 or event.pressed == 0 or event.released != 0 then return false
  if event.modifiers != key_event_modifier_shift() or event.sequence == 0 then return false
  return ipc_queue_pop(os_input_event_queue, os_input_event_received) == false
end

func os_global_layout_key_event(event: ptr[KeyEvent]) do
  if event == 0 or event.pressed == 0 then return false
  if event.physical_key != 56 and event.physical_key != 312 and event.physical_key != key_event_key_hangul() then return false
  state: ptr[TextInputState] is os_text_input_state
  result: ptr[TextInputResult] is os_text_input_result
  enabled: bool is state.hangul == 0
  if not text_input_set_hangul(state, enabled, result) then return false
  if not os_input_layout_record(state) then return false
  packed: u64 is os_text_input_pack(result)
  if packed != 0 then return os_editor_ring3_dispatch(packed)
  return os_redraw_desktop()
end

func os_terminal_key_event(event: ptr[KeyEvent]) do
  if event == 0 or event.pressed == 0 then return true
  state: ptr[TextInputState] is os_terminal_text_input_state
  result: ptr[TextInputResult] is os_terminal_text_input_result
  layout_key: bool is event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul()
  if layout_key then
    enabled: bool is state.hangul == 0
    if not text_input_set_hangul(state, enabled, result) then return false
    packed_layout: u64 is os_text_input_pack(result)
    if not os_input_layout_record(state) then return false
    if packed_layout != 0 and not os_terminal_ring3_dispatch(packed_layout) then return false
    return os_redraw_desktop()
  end

  composing_before: u64 is text_input_composing(state)
  if event.physical_key == 14 and composing_before == 0 then
    return os_terminal_ring3_dispatch(8)
  end
  if event.physical_key == 28 or event.unicode == 10 or event.unicode == 13 then
    if not text_input_result_clear(result) then return false
    if not text_input_commit(state, result) then return false
    packed_commit: u64 is os_text_input_pack(result)
    if packed_commit != 0 and not os_terminal_ring3_dispatch(packed_commit) then return false
    return os_terminal_ring3_dispatch(10)
  end
  if not text_input_feed_key_event(state, event, result) then return false
  if state.hangul != os_input_layout_hangul then
    if not os_input_layout_record(state) then return false
  end
  packed: u64 is os_text_input_pack(result)
  if packed != 0 then return os_terminal_ring3_dispatch(packed)
  if result.changed != 0 or result.composing != composing_before then return os_redraw_desktop()
  return true
end

func os_key_repeatable(event: ptr[KeyEvent]) do
  if event == 0 or event.pressed == 0 then return false
  key: u64 is event.physical_key
  if key == 14 or key == 15 or key == 328 or key == 329 or key == 331 or key == 333 or key == 335 or key == 336 or key == 337 or key == 339 then return true
  if event.unicode >= 32 and (event.modifiers & (key_event_modifier_ctrl() | key_event_modifier_alt())) == 0 then return true
  return false
end

func os_key_repeat_track(event: ptr[KeyEvent]) do
  global os_key_repeat_active, os_key_repeat_next_tsc, os_key_repeat_ticks_per_ms
  if event == 0 then return false
  repeat_event: ptr[KeyEvent] is os_key_repeat_event
  if event.released != 0 then
    if os_key_repeat_active != 0 and repeat_event.physical_key == event.physical_key then os_key_repeat_active is 0
    return true
  end
  if not os_key_repeatable(event) then
    os_key_repeat_active is 0
    return true
  end
  repeat_event.physical_key is event.physical_key
  repeat_event.scan_code is event.scan_code
  repeat_event.unicode is event.unicode
  repeat_event.pressed is 1
  repeat_event.released is 0
  repeat_event.repeated is 1
  repeat_event.modifiers is event.modifiers
  repeat_event.sequence is event.sequence
  if os_key_repeat_ticks_per_ms == 0 then
    base_mhz: u64 is 0
    if cpu.cpuid_eax(0, 0) >= 22 then base_mhz is cpu.cpuid_eax(22, 0) & 65535
    if base_mhz < 100 or base_mhz > 10000 then base_mhz is 2000
    os_key_repeat_ticks_per_ms is base_mhz * 1000
  end
  delay_ms: u64 is 350
  if event.physical_key == 14 then delay_ms is 200
  if event.repeated != 0 then delay_ms is 40
  now: u64 is cpu.rdtsc()
  os_key_repeat_next_tsc is now + os_key_repeat_ticks_per_ms * delay_ms
  if os_key_repeat_next_tsc < now then os_key_repeat_next_tsc is u64("0xffffffffffffffff")
  os_key_repeat_active is 1
  return true
end

func os_key_repeat_poll() do
  global os_key_repeat_active, os_key_repeat_next_tsc, os_key_repeat_reported
  if os_key_repeat_active == 0 then return true
  now: u64 is cpu.rdtsc()
  if now < os_key_repeat_next_tsc then return true
  repeat_event: ptr[KeyEvent] is os_key_repeat_event
  if repeat_event.sequence != u64("0xffffffffffffffff") then repeat_event.sequence += 1
  repeat_event.pressed is 1
  repeat_event.released is 0
  repeat_event.repeated is 1
  if not os_keyboard_event(repeat_event) then return false
  if os_key_repeat_reported == 0 then
    if not os_serial_cstr_line(os_key_repeat_marker) then return false
    os_key_repeat_reported is 1
  end
  return true
end

func os_browser_navigation_service() do
  global os_browser_dom_render_reported, os_browser_dom_viewport_width, os_browser_dom_viewport_height
  global os_browser_scroll_y, os_browser_scroll_max, os_browser_scroll_reported
  global os_browser_url_reported, os_browser_utf8_url_reported
  navigation_status: u64 is os_browser_navigation_poll(os_network_context)
  if navigation_status == 0 or navigation_status == 1 then return true
  # Status 5 means a cooperative fetch was explicitly cancelled. The
  # cancellation completion path has already restored and redrawn the old
  # document, so it must not be reported as a network failure or clear the
  # preserved viewport state.
  if navigation_status == 5 then return true
  os_browser_dom_render_reported is 0
  os_browser_dom_viewport_width is 0
  os_browser_dom_viewport_height is 0
  os_browser_scroll_y is 0
  os_browser_scroll_max is 0
  os_browser_scroll_reported is 0
  if navigation_status == 2 or navigation_status == 4 then
    if navigation_status == 4 then
      if not os_serial_cstr_line(os_browser_navigation_async_done_marker) then return false
    end
    if os_browser_status_text == os_text_browser_status_ready and os_browser_url_reported == 0 then
      if not os_serial_cstr_line(os_browser_url_marker) then return false
      os_browser_url_reported is 1
    end
    if os_browser_status_text == os_text_browser_status_ready and os_browser_korean_reported != 0 and os_browser_utf8_url_reported == 0 then
      if not os_serial_cstr_line(os_browser_utf8_url_marker) then return false
      os_browser_utf8_url_reported is 1
    end
  else
    if not os_serial_text(os_browser_url_failure_prefix) then return false
    if not os_serial_u64(os_browser_last_error) then return false
    if not serial_write_byte(1016, 10, 1000000) then return false
  end
  return os_redraw_desktop()
end

func os_keyboard_event(event: ptr[KeyEvent]) do
  global os_keyboard_reported, os_shift_reported, os_editor_input_reported, os_calculator_result_reported, os_browser_url_reported, os_browser_utf8_url_reported, os_browser_navigation_async_input_reported, os_browser_navigation_tcp_input_reported, os_browser_navigation_tls_input_reported, os_input_event_reported, os_calculator_last_input_source, os_window_resize_reported, os_window_minimize_reported, os_window_maximize_reported, os_window_fullscreen_reported
  if event == 0 then return false
  if os_doom_running != 0 then return os_doom_queue_key_event(event)
  if not os_input_event_post(event) then return false
  if not os_input_event_receive(event) then return false
  if not os_key_repeat_track(event) then return false
  if os_input_event_reported == 0 then
    if not os_serial_cstr_line(os_input_event_marker) then return false
    os_input_event_reported is 1
  end
  manager: ptr[WindowManager] is os_window_manager_state
  if event.pressed == 0 then
    # Redraw once more on release so the final value remains authoritative
    # even if a transient presentation failure occurred during a repeat.
    if event.released != 0 and event.physical_key == 14 and manager.active_id == 6 then
      # The value update is authoritative; a transient presentation failure
      # must not terminate the input loop. Pointer or clock damage will retry.
      os_redraw_browser_address()
      return true
    end
    return true
  end
  if os_keyboard_reported == 0 then
    if not os_serial_line(os_keyboard_marker, 19) then return false
    os_keyboard_reported is 1
  end
  if (event.physical_key == 42 or event.physical_key == 54) and os_shift_reported == 0 then
    if not os_serial_line(os_shift_marker, 16) then return false
    os_shift_reported is 1
  end
  if (os_browser_navigation_state == 1 or os_browser_navigation_state == 3 or os_browser_navigation_state == 5 or os_browser_navigation_fetch_active != 0) and os_browser_navigation_async_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_async_input_marker) then return false
    os_browser_navigation_async_input_reported is 1
  end
  if os_browser_navigation_state == 3 and os_browser_navigation_tcp_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_tcp_input_marker) then return false
    os_browser_navigation_tcp_input_reported is 1
  end
  if os_browser_navigation_state == 5 and os_browser_navigation_tls_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_tls_input_marker) then return false
    os_browser_navigation_tls_input_reported is 1
  end
  if event.physical_key == 66 and manager.active_id != 0 then
    resize_window: ptr[DesktopWindow] is window_manager_find(manager, manager.active_id)
    if resize_window == 0 or resize_window.state != window_state_normal() then return false
    if not window_manager_resize(manager, manager.active_id, resize_window.width + 16, resize_window.height + 16) then return false
    if os_window_resize_reported == 0 then
      if not os_serial_cstr_line(os_window_resize_marker) then return false
      os_window_resize_reported is 1
    end
    return os_redraw_desktop()
  end
  if event.physical_key == 67 and manager.active_id != 0 then
    if not window_manager_minimize(manager, manager.active_id) then return false
    if os_window_minimize_reported == 0 then
      if not os_serial_cstr_line(os_window_minimize_marker) then return false
      os_window_minimize_reported is 1
    end
    return os_redraw_desktop()
  end
  if event.physical_key == 68 and manager.active_id != 0 then
    if not window_manager_toggle_maximize(manager, manager.active_id) then return false
    if os_window_maximize_reported == 0 then
      if not os_serial_cstr_line(os_window_maximize_marker) then return false
      os_window_maximize_reported is 1
    end
    return os_redraw_desktop()
  end
  if event.physical_key == 87 and manager.active_id != 0 then
    if not window_manager_toggle_fullscreen(manager, manager.active_id) then return false
    if os_window_fullscreen_reported == 0 then
      if not os_serial_cstr_line(os_window_fullscreen_marker) then return false
      os_window_fullscreen_reported is 1
    end
    return os_redraw_desktop()
  end
  layout_key: bool is event.physical_key == 56 or event.physical_key == 312 or event.physical_key == key_event_key_hangul()
  if manager.active_id == 1 then
    return os_terminal_key_event(event)
  end
  if manager.active_id == 3 then
    return os_files_key_event(event)
  end
  if layout_key and manager.active_id != 4 and manager.active_id != 6 then
    return os_global_layout_key_event(event)
  end
  if manager.active_id == 4 then
    return os_editor_key_event(event)
  end
  if event.unicode != 0 and manager.active_id == 5 then
    os_calculator_last_input_source is 0
    return os_calculator_ring3_dispatch(event.unicode)
  end
  if manager.active_id == 6 then
    navigation_requested: bool is event.physical_key == 28 or event.unicode == 10 or event.unicode == 13
    if not os_browser_key_event(event) then return false
    if navigation_requested and os_browser_navigation_state == 0 and os_browser_status_text == os_text_browser_status_ready and os_browser_url_reported == 0 then
      if not os_serial_cstr_line(os_browser_url_marker) then return false
      os_browser_url_reported is 1
    end
    if navigation_requested and os_browser_navigation_state == 0 and os_browser_status_text == os_text_browser_status_ready and os_browser_korean_reported != 0 and os_browser_utf8_url_reported == 0 then
      if not os_serial_cstr_line(os_browser_utf8_url_marker) then return false
      os_browser_utf8_url_reported is 1
    end
    if navigation_requested and os_browser_navigation_state == 0 and os_browser_status_text != os_text_browser_status_ready then
      if not os_serial_text(os_browser_url_failure_prefix) then return false
      if not os_serial_u64(os_browser_last_error) then return false
      if not serial_write_byte(1016, 10, 1000000) then return false
    end
    return true
  end
  return true
end

func os_ps2_keyboard(keyboard: ptr[Ps2KeyboardState]) do
  if keyboard == 0 then return false
  event: ptr[KeyEvent] is os_key_event_state
  if not ps2_keyboard_to_event(keyboard, event) then return false
  return os_keyboard_event(event)
end

func os_pointer_event(event: ptr[PointerEvent]) do
  global os_mouse_x, os_mouse_y, os_mouse_reported, os_mouse_click_reported, os_window_focus_reported, os_window_drag_reported, os_window_resize_reported, os_window_close_reported, os_key_repeat_active, os_browser_wheel_reported, os_browser_navigation_tcp_input_reported, os_browser_navigation_tls_input_reported
  if event == 0 then return false
  os_mouse_x is event.x
  os_mouse_y is event.y
  if event.moved != 0 and os_browser_navigation_state == 3 and os_browser_navigation_tcp_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_tcp_input_marker) then return false
    os_browser_navigation_tcp_input_reported is 1
  end
  if event.moved != 0 and os_browser_navigation_state == 5 and os_browser_navigation_tls_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_tls_input_marker) then return false
    os_browser_navigation_tls_input_reported is 1
  end
  if event.pressed != 0 then os_key_repeat_active is 0
  manager: ptr[WindowManager] is os_window_manager_state
  wheel_window: ptr[DesktopWindow] is window_manager_top_at(manager, event.x, event.y)
  browser_wheel: bool is wheel_window != 0 and wheel_window.id == 6
  if not browser_wheel and manager.active_id == 6 then browser_wheel is true
  if event.wheel != 0 and browser_wheel then
    if os_browser_wheel_reported == 0 then
      if not os_serial_cstr_line(os_browser_wheel_marker) then return false
      os_browser_wheel_reported is 1
    end
    if event.wheel > 0 then return os_browser_scroll_by(-1, 96)
    return os_browser_scroll_by(1, 96)
  end
  first_mouse: u64 is 0
  first_click: u64 is 0
  if os_mouse_reported == 0 then
    first_mouse is 1
    os_mouse_reported is 1
  end
  if event.pressed != 0 and os_mouse_click_reported == 0 then
    first_click is 1
    os_mouse_click_reported is 1
  end
  if (event.pressed & 1) != 0 then
    previous_active: u64 is manager.active_id
    if not os_desktop_pointer_press(manager, event.x, event.y) then return false
    doom_window: ptr[DesktopWindow] is window_manager_find(manager, 7)
    if os_doom_running != 0 and (doom_window == 0 or doom_window.visible == 0) then
      if not os_doom_request_close() then return false
    end
    if manager.active_id == 2 and manager.active_id != previous_active and os_window_focus_reported == 0 then
      if not os_serial_cstr_line(os_window_focus_marker) then return false
      os_window_focus_reported is 1
    end
    if manager.last_closed_id == 2 and os_window_close_reported == 0 then
      if not os_serial_cstr_line(os_window_close_marker) then return false
      os_window_close_reported is 1
    end
  end
  if event.moved != 0 and manager.dragging_id != 0 then
    dragged: ptr[DesktopWindow] is window_manager_find(manager, manager.dragging_id)
    previous_x: i64 is 0
    previous_y: i64 is 0
    if dragged != 0 then
      previous_x is dragged.x
      previous_y is dragged.y
    end
    if not window_manager_pointer_move(manager, event.x, event.y, event.buttons & 1) then return false
    if dragged != 0 and dragged.id == 2 and (dragged.x != previous_x or dragged.y != previous_y) and os_window_drag_reported == 0 then
      if not os_serial_cstr_line(os_window_drag_marker) then return false
      os_window_drag_reported is 1
    end
  end
  if event.moved != 0 and manager.resizing_id != 0 then
    resized: ptr[DesktopWindow] is window_manager_find(manager, manager.resizing_id)
    previous_width: u64 is 0
    previous_height: u64 is 0
    if resized != 0 then
      previous_width is resized.width
      previous_height is resized.height
    end
    if not window_manager_pointer_move(manager, event.x, event.y, event.buttons & 1) then return false
    if resized != 0 and (resized.width != previous_width or resized.height != previous_height) and os_window_resize_reported == 0 then
      if not os_serial_cstr_line(os_window_resize_marker) then return false
      os_window_resize_reported is 1
    end
  end
  if (event.released & 1) != 0 then
    if not window_manager_pointer_release(manager) then return false
    if os_storage_mounted != 0 then
      if not os_storage_save_desktop() then return false
    end
  end
  if first_mouse != 0 then
    if not os_serial_line(os_mouse_marker, 16) then return false
  end
  if first_click != 0 then
    if not os_serial_line(os_mouse_click_marker, 22) then return false
  end
  if manager.dragging_id != 0 or manager.resizing_id != 0 then return os_redraw_desktop()
  if event.pressed != 0 then return os_redraw_desktop()
  if event.released != 0 then return os_redraw_desktop()
  if event.moved != 0 then return os_present_pointer_only()
  return true
end

func os_ps2_mouse(mouse: ptr[Ps2MouseState]) do
  if mouse == 0 then return false
  event: ptr[PointerEvent] is os_pointer_event_state
  if not ps2_mouse_to_event(mouse, event) then return false
  return os_pointer_event(event)
end

func os_input_recover(stage: u64) do
  global os_input_recovery_reported
  if os_input_recovery_reported == 0 then
    if not os_serial_cstr_line(os_input_recovered_marker) then return true
    os_input_recovery_reported is 1
  end
  if not os_serial_text(os_input_recovered_prefix) then return true
  if not os_serial_u64(stage) then return true
  serial_write_byte(1016, 10, 1000000)
  return true
end

func os_input_poll_once() do
  global os_xhci_input_ready, os_xhci_input_status
  if os_xhci_input_ready != 0 then
    if os_xhci_input_poll() then return true
    os_xhci_input_ready is 0
    os_xhci_input_status is 6
    return os_input_recover(1)
  end
  input_kind: u64 is ps2_poll(os_ps2_keyboard_state, os_ps2_mouse_state)
  if input_kind == 1 then
    if not os_ps2_keyboard(os_ps2_keyboard_state) then return os_input_recover(2)
  end
  if input_kind == 2 then
    if not os_ps2_mouse(os_ps2_mouse_state) then return os_input_recover(3)
  end
  return true
end

func os_browser_cooperative_fetch_begin() do
  global os_browser_navigation_cooperative_ready, os_browser_navigation_fetch_input_reported, os_browser_navigation_fetch_cancel_requested, os_browser_navigation_fetch_cancelled
  os_browser_navigation_fetch_input_reported is 0
  os_browser_navigation_fetch_cancel_requested is 0
  os_browser_navigation_fetch_cancelled is 0
  if os_browser_navigation_cooperative_ready == 0 then return true
  return os_serial_cstr_line(os_browser_navigation_fetch_begin_marker)
end

func os_browser_cooperative_yield() do
  global os_browser_navigation_cooperative_ready, os_browser_navigation_fetch_active, os_browser_navigation_fetch_input_reported, os_browser_navigation_fetch_cancel_requested
  if os_browser_navigation_cooperative_ready == 0 or os_browser_navigation_fetch_active == 0 then return true
  key_sequence_before: u64 is os_key_event_state.sequence
  mouse_x_before: i64 is os_mouse_x
  mouse_y_before: i64 is os_mouse_y
  if not os_input_poll_once() then return false
  if not os_key_repeat_poll() then return false
  input_changed: bool is os_key_event_state.sequence != key_sequence_before
  if os_mouse_x != mouse_x_before or os_mouse_y != mouse_y_before then input_changed is true
  if input_changed and os_browser_navigation_fetch_input_reported == 0 then
    if not os_serial_cstr_line(os_browser_navigation_fetch_input_marker) then return false
    os_browser_navigation_fetch_input_reported is 1
  end
  if os_browser_navigation_fetch_cancel_requested != 0 then return false
  return true
end

func os_browser_cooperative_fetch_cancel_complete() do
  global os_browser_navigation_fetch_active, os_browser_navigation_fetch_cancel_requested, os_browser_navigation_fetch_cancelled
  global os_browser_status_text, os_browser_last_error, os_browser_edit_started, os_browser_form_editing
  if os_browser_navigation_fetch_active == 0 or os_browser_navigation_fetch_cancel_requested == 0 then return false
  os_browser_navigation_fetch_active is 0
  os_browser_navigation_fetch_cancel_requested is 0
  os_browser_navigation_fetch_cancelled is 1
  os_browser_status_text is os_text_browser_status_ready
  os_browser_last_error is 0
  os_browser_edit_started is 0
  os_browser_form_editing is 0
  os_browser_form_state.focused is u64("0xffffffffffffffff")
  if not os_browser_navigation_cancel() then return false
  if not text_input_reset(os_browser_text_input_state) then return false
  if not os_serial_cstr_line(os_browser_navigation_fetch_cancelled_marker) then return false
  return os_redraw_desktop()
end

func os_shell_run() do
  global os_graphics_message, os_rtc_reported, os_input_event_reported, os_browser_navigation_cooperative_ready
  front: ptr[FramebufferSurface] is os_front_surface_state
  keyboard: ptr[Ps2KeyboardState] is os_ps2_keyboard_state
  mouse: ptr[Ps2MouseState] is os_ps2_mouse_state
  terminal: ptr[TextTerminal] is os_terminal_state
  if not text_terminal_init(terminal, os_terminal_cells, 46, 14) then return false
  if not os_terminal_cstr_line(os_shell_banner, 32) then return false
  ps2_keyboard_reset(keyboard)
  text_input_reset(os_text_input_state)
  text_input_reset(os_files_text_input_state)
  text_input_reset(os_editor_save_text_input_state)
  text_input_reset(os_editor_find_text_input_state)
  text_input_reset(os_browser_text_input_state)
  text_input_reset(os_terminal_text_input_state)
  if os_input_layout_hangul != 0 then
    if not text_input_set_hangul(os_text_input_state, true, os_text_input_result) then return false
    if not text_input_set_hangul(os_files_text_input_state, true, os_files_text_input_result) then return false
    if not text_input_set_hangul(os_editor_save_text_input_state, true, os_editor_save_text_input_result) then return false
    if not text_input_set_hangul(os_editor_find_text_input_state, true, os_editor_find_text_input_result) then return false
    if not text_input_set_hangul(os_browser_text_input_state, true, os_browser_text_input_result) then return false
    if not text_input_set_hangul(os_terminal_text_input_state, true, os_terminal_text_input_result) then return false
    if not os_serial_cstr_line(os_input_layout_restored_marker) then return false
  end
  if not ipc_queue_init(os_input_event_queue, os_input_event_messages, 64) then return false
  if not os_input_event_self_test() then return false
  if not os_serial_cstr_line(os_input_event_marker) then return false
  os_input_event_reported is 1
  ps2_mouse_reset(mouse, front.width - 20, front.height - 22)
  input_ports: u64 is ps2_controller_init()
  if (input_ports & 2) != 0 then ps2_mouse_enable_wheel(mouse)
  if not os_serial_text(os_ps2_ports_prefix) then return false
  if not os_serial_u64(input_ports) then return false
  if not serial_write_byte(1016, 10, 1000000) then return false
  if (input_ports & 3) == 3 then
    if not os_serial_line(os_ps2_marker, 17) then return false
  end
  xhci_ready: bool is os_xhci_input_start(front.width - 20, front.height - 22)
  if xhci_ready then
    if not os_serial_cstr_line(os_xhci_input_marker) then return false
  end
  if not xhci_ready then
    if not os_serial_cstr_line(os_xhci_input_unavailable_marker) then return false
    if not os_serial_text(os_xhci_input_status_prefix) then return false
    if not os_serial_u64(os_xhci_input_status) then return false
    if not serial_write_byte(1016, 10, 1000000) then return false
  end
  if (input_ports & 3) != 3 and os_xhci_input_ready == 0 then
    os_graphics_message is os_text_input_unavailable
    if not os_terminal_cstr_line(os_text_input_unavailable, 32) then return false
  end
  os_browser_navigation_cooperative_ready is 1

  if not os_serial_cstr_line(os_shell_banner) then return false
  if not os_serial_text(os_shell_prompt) then return false
  if not os_terminal_prompt() then return false
  if not os_redraw_terminal() then return false

  return os_shell_loop()
end

func os_memory_self_test() do
  allocator: ptr[PhysicalAllocator] is os_allocator_state
  if not pmem_init_from_uefi(allocator, os_allocator_bitmap, 65536, os_memory_map, os_map_size, os_descriptor_size) then
    return false
  end

  page: u64 is pmem_alloc(allocator)
  if page == 0 then return false

  signature: u64 is u64("0x535552414f534f4b")
  mem.write64(page, signature)
  if mem.read64(page) != signature then return false
  return pmem_free(allocator, page)
end

func efi_main(image_handle: u64, system_table: ptr) -> u64 do
  global os_map_size, os_map_key, os_descriptor_size, os_descriptor_version, os_backbuffer_address, os_backbuffer_pages, os_framebuffer_size, os_virtio_gpu_dma_address, os_virtio_gpu_framebuffer_address, os_virtio_gpu_framebuffer_pages, os_hda_dma_address, os_rtc_reported, os_storage_dma_address, os_network_dma_address, os_xhci_dma_address, os_power_discovered, os_browser_buffer, os_http_content_workspace, os_browser_image_pixel_memory, os_browser_image_workspace

  uefi.clear()
  uefi.set_color(15, 0)
  uefi.write("Sura OS virtual machine")
  uefi.newline()
  uefi.write("Preparing the freestanding kernel...")
  uefi.newline()

  framebuffer: ptr is uefi.gop_framebuffer()
  framebuffer_width: u32 is uefi.gop_width()
  framebuffer_height: u32 is uefi.gop_height()
  framebuffer_stride: u32 is uefi.gop_stride()
  framebuffer_format: u32 is uefi.gop_pixel_format()
  os_framebuffer_size is uefi.gop_framebuffer_size()

  if framebuffer == 0 or os_framebuffer_size == 0 or os_framebuffer_size > 67108864 then
    os_vm_exit(9)
    return 9
  end
  gpu_framebuffer_bytes: u64 is framebuffer_width * framebuffer_height * 4
  backbuffer_bytes: u64 is os_framebuffer_size
  if gpu_framebuffer_bytes > backbuffer_bytes then backbuffer_bytes is gpu_framebuffer_bytes
  os_backbuffer_pages is (backbuffer_bytes + 4095) / 4096
  allocation_status: u64 is uefi.allocate_pages(0, 2, os_backbuffer_pages, addr_of(os_backbuffer_address))
  if allocation_status != 0 or os_backbuffer_address == 0 then
    os_vm_exit(10)
    return 10
  end
  storage_allocation_status: u64 is uefi.allocate_pages(0, 2, os_storage_dma_pages, addr_of(os_storage_dma_address))
  if storage_allocation_status != 0 then os_storage_dma_address is 0
  network_allocation_status: u64 is uefi.allocate_pages(0, 2, os_network_dma_pages, addr_of(os_network_dma_address))
  if network_allocation_status != 0 then os_network_dma_address is 0
  xhci_allocation_status: u64 is uefi.allocate_pages(0, 2, os_xhci_dma_pages, addr_of(os_xhci_dma_address))
  if xhci_allocation_status != 0 then os_xhci_dma_address is 0
  gpu_dma_allocation_status: u64 is uefi.allocate_pages(0, 2, os_virtio_gpu_dma_pages, addr_of(os_virtio_gpu_dma_address))
  if gpu_dma_allocation_status != 0 then os_virtio_gpu_dma_address is 0
  hda_allocation_status: u64 is uefi.allocate_pages(0, 2, os_hda_dma_pages, addr_of(os_hda_dma_address))
  if hda_allocation_status != 0 then os_hda_dma_address is 0
  os_virtio_gpu_framebuffer_pages is (gpu_framebuffer_bytes + 4095) / 4096
  gpu_framebuffer_allocation_status: u64 is uefi.allocate_pages(0, 2, os_virtio_gpu_framebuffer_pages, addr_of(os_virtio_gpu_framebuffer_address))
  if gpu_framebuffer_allocation_status != 0 then os_virtio_gpu_framebuffer_address is 0
  browser_buffer_allocation_status: u64 is uefi.allocate_pages(0, 2, 512, addr_of(os_browser_buffer))
  if browser_buffer_allocation_status != 0 or os_browser_buffer == 0 then
    os_vm_exit(115)
    return 115
  end
  http_workspace_allocation_status: u64 is uefi.allocate_pages(0, 2, 513, addr_of(os_http_content_workspace))
  if http_workspace_allocation_status != 0 or os_http_content_workspace == 0 then
    os_vm_exit(116)
    return 116
  end
  browser_image_pixels_status: u64 is uefi.allocate_pages(0, 2, 8192, addr_of(os_browser_image_pixel_memory))
  if browser_image_pixels_status != 0 or os_browser_image_pixel_memory == 0 then
    os_vm_exit(117)
    return 117
  end
  browser_image_workspace_status: u64 is uefi.allocate_pages(0, 2, 5120, addr_of(os_browser_image_workspace))
  if browser_image_workspace_status != 0 or os_browser_image_workspace == 0 then
    os_vm_exit(118)
    return 118
  end

  if not serial_init(1016, 1) then
    os_vm_exit(1)
    return 1
  end
  power_control: ptr[AcpiPowerControl] is os_power_control_state
  if power_discover(system_table, power_control) then os_power_discovered is 1

  map_status: u64 is 1
  exit_status: u64 is 1
  attempt: u64 is 0
  while attempt < 4 and exit_status != 0 do
    os_map_size is 131072
    map_status is uefi.get_memory_map(addr_of(os_map_size), os_memory_map, addr_of(os_map_key), addr_of(os_descriptor_size), addr_of(os_descriptor_version))
    if map_status == 0 then
      exit_status is uefi.exit_boot_services(os_map_key)
    end
    attempt += 1
  end

  if map_status != 0 or exit_status != 0 then
    os_vm_exit(2)
    return 2
  end

  cpu.disable_interrupts()
  if not os_serial_line(os_boot_marker, 15) then
    os_vm_exit(3)
    return 3
  end
  if os_power_discovered != 0 and power_control.shutdown_ready != 0 and power_control.reset_ready != 0 then
    if not os_serial_cstr_line(os_power_ready_marker) then
      os_vm_exit(37)
      return 37
    end
  else
    if not os_serial_cstr_line(os_power_fallback_marker) then
      os_vm_exit(38)
      return 38
    end
  end

  if os_virtio_gpu_start(framebuffer_width, framebuffer_height, framebuffer_format) then
    if not os_serial_cstr_line(os_virtio_gpu_ready_marker) then
      os_vm_exit(26)
      return 26
    end
  else
    if not os_serial_cstr_line(os_virtio_gpu_fallback_marker) then
      os_vm_exit(27)
      return 27
    end
  end
  if os_hda_start() then
    if not os_serial_cstr_line(os_hda_ready_marker) then
      os_vm_exit(32)
      return 32
    end
  else
    if not os_serial_cstr_line(os_hda_unavailable_marker) then
      os_vm_exit(33)
      return 33
    end
    if not os_serial_text(os_hda_status_prefix) then
      os_vm_exit(34)
      return 34
    end
    if not os_serial_u64(os_hda_status) then
      os_vm_exit(35)
      return 35
    end
    if not serial_write_byte(1016, 10, 1000000) then
      os_vm_exit(36)
      return 36
    end
  end

  if not os_graphics_start(framebuffer, framebuffer_width, framebuffer_height, framebuffer_stride, framebuffer_format) then
    os_serial_text(os_graphics_failure_prefix)
    os_serial_u64(os_graphics_status)
    serial_write_byte(1016, 10, 1000000)
    os_serial_text(os_graphics_mode_prefix)
    os_serial_u64(framebuffer_width)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_height)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_stride)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(framebuffer_format)
    serial_write_byte(1016, 10, 1000000)
    os_serial_drain()
    os_vm_exit(7)
    return 7
  end
  if os_storage_start() then
    if not os_serial_cstr_line(os_storage_ready_marker) then
      os_vm_exit(14)
      return 14
    end
    if os_storage_backend == 2 then
      if not os_serial_cstr_line(os_storage_nvme_marker) then
        os_vm_exit(113)
        return 113
      end
    else
      if not os_serial_cstr_line(os_storage_ahci_marker) then
        os_vm_exit(114)
        return 114
      end
    end
    if not os_serial_cstr_line(os_storage_read_marker) then
      os_vm_exit(15)
      return 15
    end
    if not os_serial_cstr_line(os_storage_settings_marker) then
      os_vm_exit(17)
      return 17
    end
    if not os_serial_cstr_line(os_storage_desktop_state_marker) then
      os_vm_exit(18)
      return 18
    end
    if os_surafs_mounted != 0 then
      if not os_serial_cstr_line(os_surafs_ready_marker) then
        os_vm_exit(19)
        return 19
      end
      if os_surafs_restored_length != 0 then
        if not os_serial_text(os_surafs_editor_restored_marker) then
          os_vm_exit(20)
          return 20
        end
        if not os_serial_text(os_surafs_editor_restored_bytes) then
          os_vm_exit(20)
          return 20
        end
        if not os_serial_u64(os_surafs_restored_length) then
          os_vm_exit(20)
          return 20
        end
        if not os_serial_text(os_surafs_editor_restored_checksum) then
          os_vm_exit(20)
          return 20
        end
        if not os_serial_u64(os_surafs_restored_checksum) then
          os_vm_exit(20)
          return 20
        end
        if not serial_write_byte(1016, 10, 1000000) then
          os_vm_exit(20)
          return 20
        end
      end
    end
    if not os_redraw_desktop() then
      os_vm_exit(16)
      return 16
    end
  else
    os_serial_cstr_line(os_storage_unavailable_marker)
    os_serial_text(os_storage_status_prefix)
    os_serial_u64(os_storage_status)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_dma_address)
    serial_write_byte(1016, 32, 1000000)
    storage_controller: ptr[AhciController] is os_storage_controller
    os_serial_u64(storage_controller.ports_implemented)
    serial_write_byte(1016, 32, 1000000)
    storage_context: ptr[AhciContext] is os_storage_context
    os_serial_u64(storage_context.last_error)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_mbr_signature)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_mbr_type)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_mbr_start)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_sector_count)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_direct_read_status)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_storage_read_callback)
    serial_write_byte(1016, 10, 1000000)
  end
  if os_network_start() then
    if not os_serial_cstr_line(os_network_ready_marker) then
      os_vm_exit(19)
      return 19
    end
    if not os_serial_cstr_line(os_network_dhcp_marker) then
      os_vm_exit(30)
      return 30
    end
    if not os_serial_cstr_line(os_network_arp_marker) then
      os_vm_exit(20)
      return 20
    end
    if not os_serial_cstr_line(os_network_udp_marker) then
      os_vm_exit(21)
      return 21
    end
    if not os_serial_cstr_line(os_network_dns_marker) then
      os_vm_exit(22)
      return 22
    end
    if not os_serial_cstr_line(os_network_tcp_marker) then
      os_vm_exit(26)
      return 26
    end
    if not os_serial_cstr_line(os_network_http_marker) then
      os_vm_exit(27)
      return 27
    end
    if not os_serial_cstr_line(os_browser_app_marker) then
      os_vm_exit(28)
      return 28
    end
    if os_browser_css_rule_count != 0 then
      if not os_serial_cstr_line(os_browser_css_marker) then
        os_vm_exit(31)
        return 31
      end
    end
    if os_browser_dom_ready != 0 then
      if not os_serial_cstr_line(os_browser_dom_marker) then
        os_vm_exit(31)
        return 31
      end
    end
    if not os_serial_text(os_network_dns_prefix) then
      os_vm_exit(23)
      return 23
    end
    if not os_serial_u64(os_network_resolved_ip) then
      os_vm_exit(24)
      return 24
    end
    if not serial_write_byte(1016, 10, 1000000) then
      os_vm_exit(25)
      return 25
    end
    if not os_redraw_desktop() then
      os_vm_exit(29)
      return 29
    end
  else
    os_serial_cstr_line(os_network_unavailable_marker)
    os_serial_text(os_network_status_prefix)
    os_serial_u64(os_network_status)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(os_network_dma_address)
    serial_write_byte(1016, 32, 1000000)
    network_device: ptr[PciDevice] is os_network_pci_device
    os_serial_u64(network_device.vendor_id)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(network_device.device_id)
    serial_write_byte(1016, 32, 1000000)
    network_context: ptr[VirtioNetContext] is os_network_context
    os_serial_u64(network_context.io_base)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(network_context.device_features)
    serial_write_byte(1016, 10, 1000000)
  end
  if not os_serial_line(os_desktop_marker, 18) then
    os_vm_exit(11)
    return 11
  end
  if not os_serial_cstr_line(os_window_ready_marker) then
    os_vm_exit(12)
    return 12
  end
  time: ptr[RtcTime] is os_rtc_time_state
  if time.valid != 0 then
    if not os_serial_cstr_line(os_rtc_marker) then
      os_vm_exit(13)
      return 13
    end
    os_rtc_reported is 1
  end

  if not os_memory_self_test() then
    os_vm_exit(4)
    return 4
  end
  if not os_serial_line(os_memory_marker, 17) then
    os_vm_exit(5)
    return 5
  end
  if not os_calculator_ring3_start() then
    os_vm_exit(39)
    return 39
  end
  if not os_editor_ring3_start() then
    os_vm_exit(64)
    return 64
  end
  if not os_files_ring3_start() then
    os_vm_exit(76)
    return 76
  end
  if not os_terminal_ring3_start() then
    os_vm_exit(94)
    return 94
  end
  if not os_system_ring3_start() then
    os_vm_exit(107)
    return 107
  end
  if not os_window_server_ring3_start() then
    os_vm_exit(113)
    return 113
  end
  if not os_browser_ring3_start() then
    os_vm_exit(119)
    return 119
  end
  if not os_doom_prepare() then
    os_vm_exit(120)
    return 120
  end
  if not os_user_scheduler_start() then
    os_vm_exit(112)
    return 112
  end
  if not os_window_server_ring3_dispatch() then
    os_vm_exit(114)
    return 114
  end
  if not os_serial_line(os_ready_marker, 20) then
    os_vm_exit(6)
    return 6
  end

  if not os_shell_run() then
    os_vm_exit(8)
    return 8
  end
  return 0
end

func os_vm_exit(code: u64) do
  io.out32(244, code)
  cpu.disable_interrupts()
  while true do
    cpu.halt()
  end
end

func os_power_shutdown(fallback_code: u64) do
  control: ptr[AcpiPowerControl] is os_power_control_state
  if os_power_discovered != 0 and control.shutdown_ready != 0 then
    if power_enable_acpi(control, 100000000) then
      os_serial_cstr_line(os_power_off_armed_marker)
      os_serial_drain()
      if power_shutdown_s5(control) then
        cpu.disable_interrupts()
        while true do
          cpu.halt()
        end
      end
    end
  end
  os_serial_cstr_line(os_power_fallback_marker)
  os_serial_drain()
  os_vm_exit(fallback_code)
end

func os_power_restart(fallback_code: u64) do
  control: ptr[AcpiPowerControl] is os_power_control_state
  if os_power_discovered != 0 and control.reset_ready != 0 then
    os_serial_cstr_line(os_reset_armed_marker)
    os_serial_drain()
    if power_reset(control) then
      cpu.disable_interrupts()
      while true do
        cpu.halt()
      end
    end
  end
  os_serial_cstr_line(os_power_fallback_marker)
  os_serial_drain()
  os_vm_exit(fallback_code)
end

func os_serial_line(text: ptr, length: usize) do
  if not serial_write_buffer(1016, text, length, 1000000) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_serial_text(text: ptr) do
  return serial_write_cstr(1016, text, 256, 1000000)
end

func os_serial_cstr_line(text: ptr) do
  if not os_serial_text(text) then return false
  return serial_write_byte(1016, 10, 1000000)
end

func os_clock_refresh() do
  global os_clock_second
  time: ptr[RtcTime] is os_rtc_time_state
  if not rtc_read(time) then return 0
  changed: u64 is 1
  if time.second != os_clock_second then changed is 2
  os_clock_second is time.second
  mem.write8(ptr.add(os_clock_text, 0), 48 + (time.hour / 10))
  mem.write8(ptr.add(os_clock_text, 1), 48 + (time.hour % 10))
  mem.write8(ptr.add(os_clock_text, 2), 58)
  mem.write8(ptr.add(os_clock_text, 3), 48 + (time.minute / 10))
  mem.write8(ptr.add(os_clock_text, 4), 48 + (time.minute % 10))
  mem.write8(ptr.add(os_clock_text, 5), 0)
  return changed
end

func os_serial_drain() do
  attempt: u64 is 0
  while attempt < 1000000 do
    if (io.in8(1021) & 64) != 0 then return true
    cpu.pause()
    attempt += 1
  end
  return false
end

func os_serial_u64(value: u64) do
  if value == 0 then return serial_write_byte(1016, 48, 1000000)

  index: usize is 32
  remaining: u64 is value
  while remaining > 0 do
    index -= 1
    mem.write8(ptr.add(os_number_buffer, index), 48 + (remaining % 10))
    remaining is remaining / 10
  end
  return serial_write_buffer(1016, ptr.add(os_number_buffer, index), 32 - index, 1000000)
end

func os_command_equals(buffer: ptr, length: usize, expected: ptr) do
  index: usize is 0
  while index < length do
    if mem.read8(ptr.add(buffer, index)) != mem.read8(ptr.add(expected, index)) then
      return false
    end
    index += 1
  end
  return mem.read8(ptr.add(expected, length)) == 0
end

func os_terminal_cstr_line(text: ptr, max_length: usize) do
  terminal: ptr[TextTerminal] is os_terminal_state
  if not text_terminal_write_cstr(terminal, text, max_length) then return false
  return text_terminal_newline(terminal)
end

func os_terminal_prompt() do
  terminal: ptr[TextTerminal] is os_terminal_state
  return text_terminal_write_cstr(terminal, os_shell_prompt, 16)
end

func os_shell_execute_command(command: u64) do
  global os_graphics_message
  terminal: ptr[TextTerminal] is os_terminal_state
  if command == 0 then return true
  if command == 1 then
    os_graphics_message is os_text_help_result
    if not os_terminal_cstr_line(os_shell_help, 64) then return false
    return os_serial_cstr_line(os_shell_help)
  end
  if command == 2 then
    os_graphics_message is os_shell_status
    if not os_terminal_cstr_line(os_shell_status, 32) then return false
    return os_serial_cstr_line(os_shell_status)
  end
  if command == 3 then
    os_graphics_message is os_text_mem_result
    allocator: ptr[PhysicalAllocator] is os_allocator_state
    if not text_terminal_write_cstr(terminal, os_shell_memory_prefix, 32) then return false
    if not text_terminal_write_u64(terminal, pmem_available_pages(allocator)) then return false
    if not text_terminal_newline(terminal) then return false
    if not os_serial_text(os_shell_memory_prefix) then return false
    if not os_serial_u64(pmem_available_pages(allocator)) then return false
    return serial_write_byte(1016, 10, 1000000)
  end
  if command == 4 then
    os_graphics_message is os_text_about_result
    if not os_terminal_cstr_line(os_shell_about, 64) then return false
    return os_serial_cstr_line(os_shell_about)
  end
  if command == 5 then
    os_graphics_message is 0
    if not text_terminal_clear(terminal) then return false
    return os_serial_line(os_clear_marker, 16)
  end
  if command == 6 then
    os_terminal_cstr_line(os_shutdown_marker, 32)
    os_serial_cstr_line(os_shutdown_marker)
    os_serial_drain()
    os_power_shutdown(16)
    return true
  end
  if command == 8 then
    return os_user_process_fault_probe()
  end
  if command == 9 then
    return os_user_process_hang_probe()
  end
  if command == 10 then
    os_terminal_cstr_line(os_restart_marker, 32)
    os_serial_cstr_line(os_restart_marker)
    os_serial_drain()
    os_power_restart(18)
    return true
  end
  if command == 11 then
    return os_browser_process_fault_probe()
  end

  os_graphics_message is os_text_unknown_result
  if not os_terminal_cstr_line(os_shell_unknown, 64) then return false
  return os_serial_cstr_line(os_shell_unknown)
end

func os_shell_execute(buffer: ptr, length: usize) do
  if length == 0 then return os_shell_execute_command(0)
  if os_command_equals(buffer, length, os_command_help) then return os_shell_execute_command(1)
  if os_command_equals(buffer, length, os_command_status) then return os_shell_execute_command(2)
  if os_command_equals(buffer, length, os_command_mem) then return os_shell_execute_command(3)
  if os_command_equals(buffer, length, os_command_about) then return os_shell_execute_command(4)
  if os_command_equals(buffer, length, os_command_clear) then return os_shell_execute_command(5)
  if os_command_equals(buffer, length, os_command_faultapp) then return os_shell_execute_command(8)
  if os_command_equals(buffer, length, os_command_hangapp) then return os_shell_execute_command(9)
  if os_command_equals(buffer, length, os_command_faultbrowser) then return os_shell_execute_command(11)
  if os_command_equals(buffer, length, os_command_shutdown) then return os_shell_execute_command(6)
  if os_command_equals(buffer, length, os_command_reboot) then return os_shell_execute_command(10)
  return os_shell_execute_command(7)
end

func os_draw_mouse_pointer(surface: ptr[FramebufferSurface]) do
  if surface == 0 or os_mouse_x < 0 or os_mouse_y < 0 then return false
  x: i64 is os_mouse_x
  y: i64 is os_mouse_y
  white: u32 is fb_rgb(surface, 255, 255, 255)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  mouse: ptr[Ps2MouseState] is os_ps2_mouse_state
  pointer_color: u32 is white
  if mouse.buttons != 0 then pointer_color is fb_rgb(surface, 255, 102, 35)
  fb_line(surface, x, y, x, y + 16, black)
  fb_line(surface, x, y, x + 11, y + 11, black)
  fb_line(surface, x, y + 16, x + 4, y + 12, black)
  fb_line(surface, x + 4, y + 12, x + 8, y + 19, black)
  fb_line(surface, x + 8, y + 19, x + 11, y + 17, black)
  fb_line(surface, x + 11, y + 17, x + 7, y + 11, black)
  fb_line(surface, x + 7, y + 11, x + 11, y + 11, black)
  fb_line(surface, x, y, x, y + 14, pointer_color)
  fb_line(surface, x, y, x + 9, y + 10, pointer_color)
  return true
end

func os_virtio_gpu_start(width: u64, height: u64, pixel_format: u64) do
  global os_virtio_gpu_active
  os_virtio_gpu_active is 0
  if width == 0 or height == 0 or width > 8192 or height > 8192 then return false
  # The first resource format mirrors a B8G8R8X8 GOP surface byte-for-byte.
  if pixel_format != 1 then return false
  if os_virtio_gpu_dma_address == 0 or os_virtio_gpu_framebuffer_address == 0 then return false
  if width > u64("0x3fffffff") / height then return false
  required_bytes: u64 is width * height * 4
  if required_bytes > os_virtio_gpu_framebuffer_pages * 4096 then return false

  device: ptr[PciDevice] is os_virtio_gpu_device_state
  transport: ptr[VirtioPciTransport] is os_virtio_gpu_transport_state
  context: ptr[VirtioGpuContext] is os_virtio_gpu_context_state
  if not virtio_gpu_find_pci(device) then return false
  if not virtio_gpu_init(context, transport, device, os_virtio_gpu_dma_address, os_virtio_gpu_dma_address, 24576) then
    return false
  end
  if not virtio_gpu_get_display_info(context, 100000000) then
    virtio_gpu_stop(context)
    return false
  end
  if context.width != width or context.height != height or context.scanout_id != 0 then
    virtio_gpu_stop(context)
    return false
  end
  if not virtio_gpu_resource_create_2d(context, 1, 100000000) then
    virtio_gpu_stop(context)
    return false
  end
  if not virtio_gpu_attach_backing(context, os_virtio_gpu_framebuffer_address, os_virtio_gpu_framebuffer_address, required_bytes, 100000000) then
    virtio_gpu_stop(context)
    return false
  end
  if not virtio_gpu_set_scanout(context, 100000000) then
    virtio_gpu_stop(context)
    return false
  end
  gpu_surface: ptr[FramebufferSurface] is os_virtio_gpu_surface_state
  if not fb_surface_init(gpu_surface, os_virtio_gpu_framebuffer_address, width, height, width, 1) then
    virtio_gpu_stop(context)
    return false
  end
  os_virtio_gpu_active is 1
  return true
end

func os_hda_start() do
  global os_hda_active, os_hda_status
  os_hda_active is 0
  os_hda_status is 1
  if os_hda_dma_address == 0 then return false

  device: ptr[PciDevice] is os_hda_device_state
  controller: ptr[HdaController] is os_hda_controller_state
  stream: ptr[HdaOutputStream] is os_hda_stream_state
  os_hda_status is 2
  if not hda_controller_init(controller, device, 100000000) then return false
  codec: u64 is hda_codec_first(controller)
  os_hda_status is 3
  if codec > 14 then return false
  response: ptr is ptr.add(os_hda_dma_address, 64)
  afg: u64 is hda_find_audio_function_group(controller, codec, response, 100000000)
  os_hda_status is 4
  if afg == 0 then return false
  os_hda_status is 5
  if not hda_output_prepare_48k_s16_stereo(stream, controller, codec, afg, os_hda_dma_address, os_hda_dma_address) then
    return false
  end
  os_hda_status is 6
  if not hda_output_start(stream, 100000000) then return false
  # Move a bounded 125-ms startup slice through the real BDL path. The normal
  # automated VM uses a silent backend; later applications may reuse the
  # initialized controller without replaying a continuous test tone.
  os_hda_status is 7
  if not hda_output_wait_position(stream, 24000, 1000000000) then
    hda_output_stop(stream, 100000000)
    return false
  end
  os_hda_status is 8
  if not hda_output_stop(stream, 100000000) then return false
  os_hda_active is 1
  os_hda_status is 0
  return true
end

func os_virtio_gpu_present_full() do
  if os_virtio_gpu_active == 0 then return true
  context: ptr[VirtioGpuContext] is os_virtio_gpu_context_state
  front: ptr[FramebufferSurface] is os_front_surface_state
  gpu_surface: ptr[FramebufferSurface] is os_virtio_gpu_surface_state
  if front.stride != gpu_surface.stride then return false
  if not fb_present(front, gpu_surface.pixels) then return false
  return virtio_gpu_present(context, 0, 0, context.width, context.height, 100000000)
end

func os_virtio_gpu_present_pointer_damage(old_x: i64, old_y: i64, new_x: i64, new_y: i64) do
  if os_virtio_gpu_active == 0 then return true
  context: ptr[VirtioGpuContext] is os_virtio_gpu_context_state
  left: i64 is old_x
  if new_x < left then left is new_x
  top: i64 is old_y
  if new_y < top then top is new_y
  right: i64 is old_x + 14
  if new_x + 14 > right then right is new_x + 14
  bottom: i64 is old_y + 22
  if new_y + 22 > bottom then bottom is new_y + 22
  if left < 0 then left is 0
  if top < 0 then top is 0
  if right > context.width then right is context.width
  if bottom > context.height then bottom is context.height
  if right <= left or bottom <= top then return true
  front: ptr[FramebufferSurface] is os_front_surface_state
  gpu_surface: ptr[FramebufferSurface] is os_virtio_gpu_surface_state
  if not fb_copy_rect(front, gpu_surface, left, top, right - left, bottom - top) then return false
  return virtio_gpu_present(context, left, top, right - left, bottom - top, 100000000)
end

func os_present_with_pointer() do
  global os_pointer_drawn_x, os_pointer_drawn_y, os_pointer_drawn
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  if not fb_present(back, front.pixels) then return false
  if not os_draw_mouse_pointer(front) then return false
  os_pointer_drawn_x is os_mouse_x
  os_pointer_drawn_y is os_mouse_y
  os_pointer_drawn is 1
  return os_virtio_gpu_present_full()
end

func os_present_pointer_only() do
  global os_pointer_drawn_x, os_pointer_drawn_y, os_pointer_drawn
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  if front == 0 or back == 0 then return false
  if os_pointer_drawn == 0 then return os_present_with_pointer()
  if os_pointer_drawn_x < 0 or os_pointer_drawn_y < 0 then return os_present_with_pointer()
  old_x: i64 is os_pointer_drawn_x
  old_y: i64 is os_pointer_drawn_y

  # Restore only the old cursor damage from the clean desktop backbuffer.
  if not fb_copy_rect(back, front, os_pointer_drawn_x, os_pointer_drawn_y, 14, 22) then
    return false
  end
  if not os_draw_mouse_pointer(front) then return false
  os_pointer_drawn_x is os_mouse_x
  os_pointer_drawn_y is os_mouse_y
  os_pointer_drawn is 1
  return os_virtio_gpu_present_pointer_damage(old_x, old_y, os_mouse_x, os_mouse_y)
end

func os_window_manager_start(surface: ptr[FramebufferSurface]) do
  if surface == 0 or surface.width < 640 or surface.height < 400 then return false
  manager: ptr[WindowManager] is os_window_manager_state
  if not window_manager_init(manager, os_window_storage, 7, surface.width, surface.height, 52) then
    return false
  end

  terminal_width: u64 is 640
  if surface.width < 760 then terminal_width is surface.width - 80
  terminal_height: u64 is 330
  if surface.height < 520 then terminal_height is surface.height - 150
  terminal_x: i64 is (surface.width - terminal_width) / 2
  terminal_y: i64 is (surface.height - terminal_height - 52) / 2

  about_width: u64 is 360
  if surface.width < 720 then about_width is 300
  about_height: u64 is 220
  about_x: i64 is surface.width - about_width - 80
  about_y: i64 is 96
  browser_width: u64 is surface.width - 80
  if browser_width > 1200 then browser_width is 1200
  browser_height: u64 is surface.height - 100
  if browser_height > 700 then browser_height is 700
  browser_x: i64 is (surface.width - browser_width) / 2
  browser_y: i64 is 24
  doom_width: u64 is 644
  if doom_width > surface.width - 20 then doom_width is surface.width - 20
  doom_height: u64 is 441
  usable_height: u64 is surface.height - 52
  if doom_height > usable_height - 20 then doom_height is usable_height - 20
  doom_x: i64 is (surface.width - doom_width) / 2
  doom_y: i64 is (usable_height - doom_height) / 2

  if not window_manager_add(manager, 7, doom_x, doom_y, doom_width, doom_height) then return false
  if not window_manager_add(manager, 6, browser_x, browser_y, browser_width, browser_height) then return false
  if not window_manager_add(manager, 2, about_x, about_y, about_width, about_height) then
    return false
  end
  if not window_manager_add(manager, 1, terminal_x, terminal_y, terminal_width, terminal_height) then
    return false
  end
  if not window_manager_add(manager, 3, 100, 130, 520, 300) then return false
  if not window_manager_add(manager, 4, 220, 170, 520, 300) then return false
  if not window_manager_add(manager, 5, surface.width - 420, 220, 320, 300) then return false
  if not window_manager_close(manager, 3) then return false
  if not window_manager_close(manager, 4) then return false
  if not window_manager_close(manager, 5) then return false
  if not window_manager_close(manager, 6) then return false
  if not window_manager_close(manager, 7) then return false
  manager.last_closed_id is 0
  return window_manager_focus(manager, 1)
end

func os_draw_window_frame(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow], title: ptr) do
  if surface == 0 or window == 0 or window.visible == 0 or title == 0 then return false
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  bar_color: u32 is panel_light
  border_color: u32 is muted
  if window.active != 0 then
    bar_color is titlebar
    border_color is orange
  end

  fb_fill_rect(surface, x + 8, y + 10, window.width, window.height, black)
  fb_fill_rect(surface, x, y, window.width, window.height, panel)
  fb_rect_outline(surface, x, y, window.width, window.height, border_color)
  fb_fill_rect(surface, x, y, window.width, 38, bar_color)
  title_icon: ptr is os_icon_terminal
  if window.id == 2 then title_icon is os_icon_about
  if window.id == 3 then title_icon is os_icon_files
  if window.id == 4 then title_icon is os_icon_notes
  if window.id == 5 then title_icon is os_icon_calc
  if window.id == 6 then title_icon is os_icon_web
  if window.id == 7 then title_icon is os_icon_doom
  os_draw_bitmap_icon(surface, x + 10, y + 11, title_icon, 1)
  font_ui_draw_utf8_text(surface, x + 34, y + 10, title, 32, white_large)
  if window.closable != 0 then
    fb_fill_rect(surface, x + window.width - 106, y + 8, 24, 22, panel_light)
    fb_hline(surface, x + window.width - 100, y + 24, 12, white)
    fb_fill_rect(surface, x + window.width - 70, y + 8, 24, 22, panel_light)
    fb_rect_outline(surface, x + window.width - 64, y + 13, 12, 11, white)
    fb_fill_rect(surface, x + window.width - 34, y + 8, 24, 22, orange)
    fb_line(surface, x + window.width - 28, y + 14, x + window.width - 17, y + 24, white)
    fb_line(surface, x + window.width - 17, y + 14, x + window.width - 28, y + 24, white)
  end
  return true
end

func os_draw_terminal_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_terminal) then return false
  x: u64 is window.x
  y: u64 is window.y
  white: u32 is fb_rgb(surface, 242, 247, 252)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  terminal: ptr[TextTerminal] is os_terminal_state
  if terminal.cells != 0 then
    text_terminal_draw(terminal, surface, x + 24, y + 54, white_large)
    cursor_x: u64 is x + 24 + terminal.cursor_x * 12
    cursor_y: u64 is y + 54 + terminal.cursor_y * 16
    if cursor_x + 10 < x + window.width and cursor_y + 15 < y + window.height then
      fb_fill_rect(surface, cursor_x, cursor_y + 14, 10, 2, white)
    end
  else
    font5x7_draw_text(surface, x + 24, y + 72, os_text_terminal_prompt, 32, orange_large)
    font5x7_draw_text(surface, x + 24, y + 108, os_text_terminal_ready, 32, green_large)
    font5x7_draw_text(surface, x + 24, y + 144, os_shell_prompt, 16, white_large)
  end
  return true
end

func os_draw_u64(surface: ptr[FramebufferSurface], x: u64, y: u64, value: u64, style: ptr[BitmapFontStyle]) do
  if surface == 0 or style == 0 then return false
  digits: ptr is os_number_buffer
  count: u64 is 0
  if value == 0 then
    mem.write8(digits, 48)
    count is 1
  else
    while value != 0 and count < 20 do
      mem.write8(ptr.add(digits, count), 48 + value % 10)
      value is value / 10
      count += 1
    end
  end
  index: u64 is 0
  cell_width: u64 is 6 * style.scale
  while index < count do
    character: u64 is mem.read8(ptr.add(digits, count - index - 1))
    if not font5x7_draw_char(surface, x + index * cell_width, y, character, style) then return false
    index += 1
  end
  return true
end

func os_draw_about_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_system_info) then return false
  x: u64 is window.x
  y: u64 is window.y
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  font_ui_draw_utf8_text(surface, x + 22, y + 58, os_text_system_version, 32, orange_large)
  font_ui_draw_utf8_text(surface, x + 22, y + 94, os_text_system_target, 32, white_large)
  font_ui_draw_utf8_text(surface, x + 22, y + 128, os_text_system_memory, 32, green_large)
  if os_system_memory_mib != 0 then
    os_draw_u64(surface, x + 202, y + 128, os_system_memory_mib, green_large)
  end
  font_ui_draw_utf8_text(surface, x + 22, y + 168, os_text_system_machine, 32, white_small)
  keyboard_label: ptr is os_text_keyboard_english
  if os_input_layout_hangul != 0 then keyboard_label is os_text_keyboard_korean
  keyboard_panel: u32 is fb_rgb(surface, 31, 41, 58)
  keyboard_border: u32 is fb_rgb(surface, 255, 102, 35)
  fb_fill_rect(surface, x + 18, y + 184, window.width - 36, 26, keyboard_panel)
  fb_rect_outline(surface, x + 18, y + 184, window.width - 36, 26, keyboard_border)
  font_ui_draw_utf8_text(surface, x + 28, y + 190, keyboard_label, 32, white_small)
  return true
end

func os_draw_file_explorer_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_file_explorer) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  files: ptr[FileExplorerState] is os_file_explorer_state
  if os_surafs_mounted != 0 then
    font_ui_draw_utf8_text(surface, x + 20, y + 50, os_surafs_current_path, os_surafs_current_path_length, white_small)
  else
    font_ui_draw_utf8_text(surface, x + 20, y + 50, os_storage_path_buffer, 96, white_small)
  end
  view_offset: u64 is 0
  if os_surafs_mounted != 0 then view_offset is os_files_view_offset
  row: u64 is 0
  while row < 6 and view_offset + row < files.entry_count do
    entry_index: u64 is view_offset + row
    row_y: u64 is y + 78 + row * 34
    row_color: u32 is panel_light
    if files.selected == entry_index then row_color is titlebar
    fb_fill_rect(surface, x + 18, row_y, window.width - 36, 28, row_color)
    if files.selected == entry_index then fb_rect_outline(surface, x + 18, row_y, window.width - 36, 28, orange)
    if os_surafs_mounted != 0 and entry_index < os_storage_entry_count then
      vfs_entry: ptr[VfsDirEntry] is ptr.index(os_surafs_entries, entry_index, sizeof(VfsDirEntry))
      vfs_name: ptr is vfs_entry.name
      vfs_entry_icon: ptr is os_icon_notes
      if vfs_entry.kind == vfs_kind_directory then vfs_entry_icon is os_icon_files
      os_draw_bitmap_icon(surface, x + 26, row_y + 6, vfs_entry_icon, 1)
      if vfs_entry.name_length == 2 and mem.read8(vfs_name) == 46 and mem.read8(ptr.add(vfs_name, 1)) == 46 then
        font_ui_draw_utf8_text(surface, x + 50, row_y + 6, os_text_parent_folder, 16, white_small)
      else
        font_ui_draw_utf8_text(surface, x + 50, row_y + 6, vfs_name, vfs_entry.name_length, white_small)
      end
    elif os_storage_mounted != 0 and entry_index < os_storage_entry_count then
      fat_name: ptr is ptr.add(os_storage_display_names, entry_index * 13)
      fat_entry: ptr[Fat32DirEntry] is ptr.index(os_storage_root_entries, entry_index, sizeof(Fat32DirEntry))
      fat_entry_icon: ptr is os_icon_notes
      if (fat_entry.attributes & 16) != 0 then fat_entry_icon is os_icon_files
      os_draw_bitmap_icon(surface, x + 26, row_y + 6, fat_entry_icon, 1)
      display_text: ptr is fat_name
      if mem.read8(fat_name) == 46 and mem.read8(ptr.add(fat_name, 1)) == 46 then display_text is os_text_parent_folder
      font_ui_draw_utf8_text(surface, x + 50, row_y + 6, display_text, 16, white_small)
    end
    row += 1
  end
  if os_surafs_mounted != 0 and files.entry_count > 6 then
    track_x: u64 is x + window.width - 14
    track_y: u64 is y + 78
    track_height: u64 is 198
    thumb_height: u64 is (track_height * 6) / files.entry_count
    if thumb_height < 18 then thumb_height is 18
    thumb_range: u64 is track_height - thumb_height
    offset_range: u64 is files.entry_count - 6
    thumb_y: u64 is track_y
    if offset_range != 0 then thumb_y += (thumb_range * view_offset) / offset_range
    fb_fill_rect(surface, track_x, track_y, 4, track_height, panel_light)
    fb_fill_rect(surface, track_x, thumb_y, 4, thumb_height, orange)
  end
  if os_files_name_mode != 0 then
    dialog_y: u64 is y + window.height - 62
    fb_fill_rect(surface, x + 18, dialog_y, window.width - 36, 38, panel_light)
    fb_rect_outline(surface, x + 18, dialog_y, window.width - 36, 38, orange)
    dialog_label: ptr is os_text_files_new_file
    if os_files_name_mode == 2 then dialog_label is os_text_files_new_folder
    if os_files_name_mode == 3 then dialog_label is os_text_files_rename
    if os_files_name_mode == 4 then
      dialog_label is os_text_files_delete
      inside_trash: bool is os_surafs_current_path_length == 10
      if inside_trash then inside_trash is memfs_bytes_equal(os_surafs_current_path, os_surafs_trash_path, 10)
      if inside_trash then dialog_label is os_text_files_delete_permanent
    end
    font_ui_draw_utf8_text(surface, x + 26, dialog_y + 6, dialog_label, 40, white_small)
    if os_files_name_mode != 4 then
      font_ui_draw_utf8_text(surface, x + 96, dialog_y + 6, os_files_name_buffer, os_files_name_length, white_small)
      files_name_width: u64 is font_ui_utf8_width(os_files_name_buffer, os_files_name_length)
      files_composing: u64 is text_input_composing(os_files_text_input_state)
      if files_composing >= 44032 and files_composing <= 55203 then
        font_ui_draw_char(surface, x + 100 + files_name_width, dialog_y + 6, files_composing, white_small)
      end
    end
  elif os_storage_mounted == 0 then
    font_ui_draw_utf8_text(surface, x + 30, y + 84, os_text_no_disk, 32, white_small)
    font_ui_draw_utf8_text(surface, x + 20, y + window.height - 32, os_text_read_only, 48, muted_small)
  else
    font_ui_draw_utf8_text(surface, x + 20, y + window.height - 32, os_text_files_hint, 64, muted_small)
  end
  return true
end

func os_editor_code_mode() do
  if os_surafs_active_file_length < 5 then return false
  suffix: u64 is os_surafs_active_file_length - 5
  if mem.read8(ptr.add(os_surafs_active_file_path, suffix)) != 46 then return false
  if mem.read8(ptr.add(os_surafs_active_file_path, suffix + 1)) != 115 then return false
  if mem.read8(ptr.add(os_surafs_active_file_path, suffix + 2)) != 117 then return false
  if mem.read8(ptr.add(os_surafs_active_file_path, suffix + 3)) != 114 then return false
  return mem.read8(ptr.add(os_surafs_active_file_path, suffix + 4)) == 97
end

func os_editor_syntax_token_is(text: ptr, start: u64, length: u64, keyword: ptr, keyword_length: u64) do
  if length != keyword_length then return false
  return memfs_bytes_equal(ptr.add(text, start), keyword, length)
end

func os_editor_syntax_is_keyword(text: ptr, start: u64, length: u64) do
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_is, 2) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_func, 4) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_end, 3) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_if, 2) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_then, 4) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_else, 4) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_elif, 4) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_while, 5) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_return, 6) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_import, 6) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_struct, 6) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_do, 2) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_global, 6) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_true, 4) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_false, 5) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_not, 3) then return true
  if os_editor_syntax_token_is(text, start, length, os_syntax_keyword_and, 3) then return true
  return os_editor_syntax_token_is(text, start, length, os_syntax_keyword_or, 2)
end

func os_editor_syntax_mark(start: u64, finish: u64, kind: u64) do
  if finish > 4096 then finish is 4096
  index: u64 is start
  while index < finish do
    mem.write8(ptr.add(os_editor_syntax_map, index), kind)
    index += 1
  end
  return true
end

func os_editor_syntax_build(editor: ptr[TextEditorState]) do
  if editor == 0 or editor.buffer == 0 or editor.length >= 4096 then return false
  if not memfs_zero(os_editor_syntax_map, 4096) then return false
  index: u64 is 0
  while index < editor.length do
    value: u64 is mem.read8(ptr.add(editor.buffer, index))
    if value == 35 then
      finish: u64 is index + 1
      while finish < editor.length and mem.read8(ptr.add(editor.buffer, finish)) != 10 do
        finish += 1
      end
      if not os_editor_syntax_mark(index, finish, 3) then return false
      index is finish
    elif value == 34 or value == 39 then
      quote: u64 is value
      finish: u64 is index + 1
      closed: bool is false
      while finish < editor.length and not closed do
        next: u64 is mem.read8(ptr.add(editor.buffer, finish))
        if next == 92 and finish + 1 < editor.length then
          finish += 2
        else
          finish += 1
          if next == quote then closed is true
          if next == 10 then closed is true
        end
      end
      if not os_editor_syntax_mark(index, finish, 2) then return false
      index is finish
    elif value >= 48 and value <= 57 then
      finish: u64 is index + 1
      while finish < editor.length do
        digit: u64 is mem.read8(ptr.add(editor.buffer, finish))
        if not (digit >= 48 and digit <= 57 or digit == 46) then break
        finish += 1
      end
      if not os_editor_syntax_mark(index, finish, 4) then return false
      index is finish
    elif value >= 65 and value <= 90 or value >= 97 and value <= 122 or value == 95 then
      finish: u64 is index + 1
      while finish < editor.length do
        identifier: u64 is mem.read8(ptr.add(editor.buffer, finish))
        if not (identifier >= 65 and identifier <= 90 or identifier >= 97 and identifier <= 122 or identifier >= 48 and identifier <= 57 or identifier == 95) then break
        finish += 1
      end
      if os_editor_syntax_is_keyword(editor.buffer, index, finish - index) then
        if not os_editor_syntax_mark(index, finish, 1) then return false
      end
      index is finish
    else
      index += 1
    end
  end
  return true
end

func os_editor_syntax_self_test() do
  test: ptr[TextEditorState] is os_editor_syntax_test_state
  test.buffer is os_surafs_code_sample
  test.length is 62
  if not os_editor_syntax_build(test) then return false
  if mem.read8(ptr.add(os_editor_syntax_map, 8)) != 1 then return false
  if mem.read8(ptr.add(os_editor_syntax_map, 11)) != 2 then return false
  if mem.read8(ptr.add(os_editor_syntax_map, 38)) != 4 then return false
  return mem.read8(ptr.add(os_editor_syntax_map, 40)) == 3
end

func os_draw_text_editor_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  global os_editor_syntax_reported
  code_mode: bool is os_editor_code_mode()
  if not code_mode then os_editor_syntax_reported is 0
  editor_title: ptr is os_text_text_editor
  if code_mode then editor_title is os_text_code_editor
  if not os_draw_window_frame(surface, window, editor_title) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  selection: u32 is fb_rgb(surface, 16, 91, 132)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  editor: ptr[TextEditorState] is os_text_editor_state
  fb_rect_outline(surface, x + 16, y + 50, window.width - 32, window.height - 90, muted)
  box: ptr[FontUtf8TextBox] is os_editor_text_box
  box.x is x + 26
  box.y is y + 62
  box.width is window.width - 52
  box.line_height is 17
  box.max_lines is (window.height - 112) / box.line_height
  if box.max_lines == 0 then box.max_lines is 1
  cursor_line: u64 is font_ui_utf8_line_at(editor.buffer, editor.length, box.width, editor.cursor)
  box.first_line is 0
  if cursor_line >= box.max_lines then box.first_line is cursor_line - box.max_lines + 1
  box.cursor_index is editor.cursor
  box.selection_start is text_editor_selection_start(editor)
  box.selection_end is text_editor_selection_end(editor)
  box.selection_color is selection
  box.syntax_map is 0
  if code_mode then
    if not os_editor_syntax_self_test() then return false
    if not os_editor_syntax_build(editor) then return false
    box.syntax_map is os_editor_syntax_map
    box.syntax_keyword is orange
    box.syntax_string is fb_rgb(surface, 116, 204, 151)
    box.syntax_comment is muted
    box.syntax_number is fb_rgb(surface, 113, 180, 255)
    if os_editor_syntax_reported == 0 then
      if not os_serial_cstr_line(os_editor_syntax_marker) then return false
      os_editor_syntax_reported is 1
    end
  end
  if not font_ui_draw_utf8_box(surface, editor.buffer, editor.length, box, white_small) then return false
  if box.cursor_visible != 0 and box.cursor_x + 5 < x + window.width - 16 and box.cursor_y + 8 < y + window.height - 40 then
    fb_fill_rect(surface, box.cursor_x, box.cursor_y + 7, 5, 1, white)
  end
  editor_hint: ptr is os_text_editor_hint
  if os_storage_mounted != 0 then editor_hint is os_text_editor_save_hint
  if os_editor_save_as_active != 0 then
    dialog_y: u64 is y + window.height - 64
    fb_fill_rect(surface, x + 16, dialog_y, window.width - 32, 30, panel)
    fb_rect_outline(surface, x + 16, dialog_y, window.width - 32, 30, orange)
    font_ui_draw_utf8_text(surface, x + 26, dialog_y + 6, os_text_editor_save_as, 16, white_small)
    font_ui_draw_utf8_text(surface, x + 82, dialog_y + 6, os_editor_save_name_buffer, os_editor_save_name_length, white_small)
    save_name_width: u64 is font_ui_utf8_width(os_editor_save_name_buffer, os_editor_save_name_length)
    save_composing: u64 is text_input_composing(os_editor_save_text_input_state)
    if save_composing >= 44032 and save_composing <= 55203 then
      font_ui_draw_char(surface, x + 86 + save_name_width, dialog_y + 6, save_composing, white_small)
    end
    editor_hint is os_text_editor_save_controls
    if os_editor_save_name_exists != 0 then editor_hint is os_text_editor_save_exists
  elif os_editor_find_mode != 0 then
    dialog_y: u64 is y + window.height - 88
    dialog_height: u64 is 50
    if os_editor_find_mode == 1 then dialog_height is 28
    fb_fill_rect(surface, x + 16, dialog_y, window.width - 32, dialog_height, panel)
    fb_rect_outline(surface, x + 16, dialog_y, window.width - 32, dialog_height, orange)
    font_ui_draw_utf8_text(surface, x + 24, dialog_y + 4, os_text_editor_find, 12, white_small)
    font_ui_draw_utf8_text(surface, x + 76, dialog_y + 4, os_editor_find_buffer, os_editor_find_length, white_small)
    if os_editor_find_mode == 2 then
      font_ui_draw_utf8_text(surface, x + 24, dialog_y + 26, os_text_editor_replace, 12, white_small)
      font_ui_draw_utf8_text(surface, x + 94, dialog_y + 26, os_editor_replace_buffer, os_editor_replace_length, white_small)
    end
    active_y: u64 is dialog_y + 3
    if os_editor_find_field != 0 then active_y is dialog_y + 25
    fb_rect_outline(surface, x + 20, active_y, window.width - 40, 20, selection)
    active_buffer: ptr is os_editor_find_buffer
    active_length: u64 is os_editor_find_length
    active_x: u64 is x + 76
    if os_editor_find_field != 0 then
      active_buffer is os_editor_replace_buffer
      active_length is os_editor_replace_length
      active_x is x + 94
    end
    active_width: u64 is font_ui_utf8_width(active_buffer, active_length)
    find_composing: u64 is text_input_composing(os_editor_find_text_input_state)
    if find_composing >= 44032 and find_composing <= 55203 then
      font_ui_draw_char(surface, active_x + active_width + 4, active_y + 1, find_composing, white_small)
    end
    editor_hint is os_text_editor_find_controls
    if os_editor_find_mode == 2 then editor_hint is os_text_editor_replace_controls
  end
  font_ui_draw_utf8_text(surface, x + 20, y + window.height - 32, editor_hint, 48, muted_small)
  input_label: ptr is os_text_input_english
  text_state: ptr[TextInputState] is os_text_input_state
  if text_state.hangul != 0 then input_label is os_text_input_korean
  composing: u64 is text_input_composing(text_state)
  if composing >= 44032 and composing <= 55203 then
    font_ui_draw_char(surface, x + window.width - 100, y + window.height - 34, composing, muted_small)
  end
  font_ui_draw_utf8_text(surface, x + window.width - 78, y + window.height - 32, input_label, 16, muted_small)
  return true
end

func os_calculator_keypad_value(row: u64, column: u64) do
  if row == 0 and column == 0 then return 55
  if row == 0 and column == 1 then return 56
  if row == 0 and column == 2 then return 57
  if row == 0 and column == 3 then return 47
  if row == 1 and column == 0 then return 52
  if row == 1 and column == 1 then return 53
  if row == 1 and column == 2 then return 54
  if row == 1 and column == 3 then return 42
  if row == 2 and column == 0 then return 49
  if row == 2 and column == 1 then return 50
  if row == 2 and column == 2 then return 51
  if row == 2 and column == 3 then return 45
  if row == 3 and column == 0 then return 67
  if row == 3 and column == 1 then return 48
  if row == 3 and column == 2 then return 61
  if row == 3 and column == 3 then return 43
  return 0
end

func os_draw_calculator_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if not os_draw_window_frame(surface, window, os_text_calculator) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  button: u32 is fb_rgb(surface, 44, 58, 78)
  operation_button: u32 is fb_rgb(surface, 64, 78, 100)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  calculator: ptr[CalculatorState] is os_calculator_state
  if not calculator_format(calculator, os_calculator_text, 16) then return false
  if not calculator_format_expression(calculator, os_calculator_expression, 32) then return false
  fb_fill_rect(surface, x + 18, y + 50, window.width - 36, 68, panel_light)
  fb_rect_outline(surface, x + 18, y + 50, window.width - 36, 68, orange)
  font_ui_draw_utf8_text(surface, x + 30, y + 56, os_calculator_expression, 32, muted_small)
  font_ui_draw_utf8_text(surface, x + 30, y + 82, os_calculator_text, 16, white_large)
  row: u64 is 0
  while row < 4 do
    column: u64 is 0
    while column < 4 do
      button_x: u64 is x + 24 + column * 68
      button_y: u64 is y + 128 + row * 36
      label: u64 is os_calculator_keypad_value(row, column)
      fill: u32 is button
      if column == 3 or row == 3 and column != 1 then fill is operation_button
      if label == 61 then fill is orange
      fb_fill_rect(surface, button_x, button_y, 62, 30, fill)
      fb_rect_outline(surface, button_x, button_y, 62, 30, orange)
      if not font5x7_draw_char(surface, button_x + 25, button_y + 8, label, white_large) then return false
      column += 1
    end
    row += 1
  end
  font_ui_draw_utf8_text(surface, x + 22, y + 274, os_text_calculator_hint, 48, muted_small)
  return true
end

func os_browser_normalize_dom_text(node_index: u64, capacity: u64) do
  global font_utf8_consumed
  document: ptr[HtmlDomDocument] is os_browser_dom_document
  node: ptr[HtmlDomNode] is html_dom_node(document, node_index)
  if node == 0 or node.kind != 2 then return 0
  if capacity > 4095 then capacity is 4095
  if capacity == 0 then return 0
  input: ptr is ptr.add(document.input, node.source_start)
  input_bytes: u64 is node.source_bytes
  override: ptr[BrowserJsValue] is os_browser_js_dom_override
  override_status: u64 is browser_js_dom_text_override(os_browser_js_dom_host, node_index, override)
  if override_status == 2 then return 0
  if override_status == 1 then
    input is override.data
    input_bytes is override.bytes
  end
  output_length: u64 is 0
  pending_space: bool is false
  cursor: u64 is 0
  while cursor < input_bytes and output_length < capacity do
    value: u64 is mem.read8(ptr.add(input, cursor))
    if html_dom_space(value) then
      if output_length != 0 then
        pending_space is true
      end
      cursor += 1
    else
      codepoint: u64 is font_utf8_next(input, input_bytes, cursor, addr_of(font_utf8_consumed))
      consumed: u64 is font_utf8_consumed
      if consumed == 0 or cursor + consumed > input_bytes then break
      if codepoint == 0 then break
      required: u64 is consumed
      if pending_space then required += 1
      if output_length + required > capacity then break
      if pending_space then
        mem.write8(ptr.add(os_browser_dom_text_buffer, output_length), 32)
        output_length += 1
        pending_space is false
      end
      if not net_copy(ptr.add(os_browser_dom_text_buffer, output_length), ptr.add(input, cursor), consumed) then return 0
      output_length += consumed
      cursor += consumed
    end
  end
  mem.write8(ptr.add(os_browser_dom_text_buffer, output_length), 0)
  return output_length
end

func os_draw_browser_image(surface: ptr[FramebufferSurface], image: ptr[BrowserImage], x: u64, y: u64, width: u64, height: u64) do
  if surface == 0 or image == 0 or image.decoded == 0 or image.pixels == 0 then return false
  if width == 0 or height == 0 or image.width == 0 or image.height == 0 then return false
  if x >= surface.width or y >= surface.height then return false
  draw_width: u64 is width
  draw_height: u64 is height
  if draw_width > surface.width - x then draw_width is surface.width - x
  if draw_height > surface.height - y then draw_height is surface.height - y
  destination_y: u64 is 0
  while destination_y < draw_height do
    source_y: u64 is destination_y * image.height / height
    destination_x: u64 is 0
    while destination_x < draw_width do
      source_x: u64 is destination_x * image.width / width
      source_offset: u64 is (source_y * image.width + source_x) * 4
      red: u64 is mem.read8(ptr.add(image.pixels, source_offset))
      green: u64 is mem.read8(ptr.add(image.pixels, source_offset + 1))
      blue: u64 is mem.read8(ptr.add(image.pixels, source_offset + 2))
      alpha: u64 is mem.read8(ptr.add(image.pixels, source_offset + 3))
      if alpha == 255 then
        fb_put_pixel(surface, x + destination_x, y + destination_y, fb_rgb(surface, red, green, blue))
      else
        if alpha != 0 then
          destination: u64 is fb_get_pixel(surface, x + destination_x, y + destination_y)
          destination_red: u64 is destination & 255
          destination_green: u64 is (destination >> 8) & 255
          destination_blue: u64 is (destination >> 16) & 255
          if surface.pixel_format == 1 then
            destination_red is (destination >> 16) & 255
            destination_blue is destination & 255
          end
          inverse: u64 is 255 - alpha
          red is (red * alpha + destination_red * inverse + 127) / 255
          green is (green * alpha + destination_green * inverse + 127) / 255
          blue is (blue * alpha + destination_blue * inverse + 127) / 255
          fb_put_pixel(surface, x + destination_x, y + destination_y, fb_rgb(surface, red, green, blue))
        end
      end
      destination_x += 1
    end
    destination_y += 1
  end
  return true
end

func os_draw_browser_form_controls(surface: ptr[FramebufferSurface], origin_x: u64, origin_y: u64, viewport_width: u64, viewport_height: u64) do
  if surface == 0 then return false
  state: ptr[BrowserFormState] is os_browser_form_state
  text_style: ptr[BitmapFontStyle] is os_font_browser_dom
  text_style.foreground is fb_rgb(surface, 18, 28, 39)
  text_style.background is 0
  text_style.scale is 1
  text_style.opaque is 0
  index: u64 is 0
  while index < state.count do
    control: ptr[BrowserFormControl] is browser_form_control_at(state, index)
    box_index: u64 is 0
    found_box: ptr[CssBox] is 0
    while box_index < os_browser_dom_box_count and found_box == 0 do
      candidate: ptr[CssBox] is ptr.add(os_browser_dom_boxes, box_index * 144)
      if candidate.node_index == control.node_index then found_box is candidate
      box_index += 1
    end
    if found_box != 0 and found_box.width != 0 and found_box.height != 0 and found_box.x < viewport_width and found_box.y >= os_browser_scroll_y and found_box.y - os_browser_scroll_y < viewport_height then
      visible_y: u64 is found_box.y - os_browser_scroll_y
      draw_width: u64 is found_box.width
      draw_height: u64 is found_box.height
      if draw_width > viewport_width - found_box.x then draw_width is viewport_width - found_box.x
      if draw_height > viewport_height - visible_y then draw_height is viewport_height - visible_y
      x: u64 is origin_x + found_box.x
      y: u64 is origin_y + visible_y
      border: u32 is fb_rgb(surface, 82, 96, 108)
      if state.focused == index and os_browser_form_editing != 0 then border is fb_rgb(surface, 255, 102, 35)
      if control.kind == 3 then
        size: u64 is 18
        if size > draw_height then size is draw_height
        fb_fill_rect(surface, x, y, size, size, fb_rgb(surface, 247, 247, 243))
        fb_rect_outline(surface, x, y, size, size, border)
        if (control.flags & 2) != 0 and size >= 10 then
          fb_line(surface, x + 3, y + 8, x + 7, y + 13, fb_rgb(surface, 255, 102, 35))
          fb_line(surface, x + 7, y + 13, x + 15, y + 4, fb_rgb(surface, 255, 102, 35))
        end
      else
        background: u32 is fb_rgb(surface, 247, 247, 243)
        if control.kind == 4 or control.kind == 5 then background is fb_rgb(surface, 25, 36, 42)
        if (control.flags & 1) != 0 then background is fb_rgb(surface, 205, 208, 205)
        fb_fill_rect(surface, x, y, draw_width, draw_height, background)
        fb_rect_outline(surface, x, y, draw_width, draw_height, border)
        if control.kind == 1 or control.kind == 2 then
          value: ptr is browser_form_value_at(state, index)
          value_bytes: u64 is control.value_bytes
          if control.kind == 2 then
            if not browser_form_zero(os_browser_form_text_buffer, 256) then return false
            if value_bytes > 31 then value_bytes is 31
            mask_index: u64 is 0
            while mask_index < value_bytes do
              mem.write8(ptr.add(os_browser_form_text_buffer, mask_index), 42)
              mask_index += 1
            end
            value is os_browser_form_text_buffer
          end
          if value_bytes != 0 and draw_width > 12 and draw_height >= 14 then
            font_ui_draw_utf8_text(surface, x + 6, y + 7, value, value_bytes, text_style)
          end
          if state.focused == index and os_browser_form_editing != 0 and draw_height >= 14 then
            cursor_x: u64 is x + 6 + font_ui_utf8_width(value, value_bytes)
            if cursor_x + 2 < x + draw_width then fb_vline(surface, cursor_x, y + 7, 12, fb_rgb(surface, 255, 102, 35))
          end
        end
      end
    end
    index += 1
  end
  return true
end

func os_browser_update_scroll_limit(viewport_height: u64) do
  global os_browser_scroll_max, os_browser_scroll_y
  content_height: u64 is 0
  index: u64 is 0
  while index < os_browser_dom_box_count do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    bottom: u64 is box.y + box.outer_height
    if bottom > content_height then content_height is bottom
    index += 1
  end
  os_browser_scroll_max is 0
  if content_height > viewport_height then os_browser_scroll_max is content_height - viewport_height
  if os_browser_scroll_y > os_browser_scroll_max then os_browser_scroll_y is os_browser_scroll_max
  return true
end

func os_browser_scroll_by(direction: i64, amount: u64) do
  global os_browser_scroll_y, os_browser_scroll_reported
  if os_browser_dom_ready == 0 or amount == 0 then return false
  previous: u64 is os_browser_scroll_y
  if direction < 0 then
    if amount > os_browser_scroll_y then os_browser_scroll_y is 0 else os_browser_scroll_y -= amount
  else
    if amount > os_browser_scroll_max - os_browser_scroll_y then os_browser_scroll_y is os_browser_scroll_max else os_browser_scroll_y += amount
  end
  if os_browser_scroll_y == previous then return true
  if os_browser_scroll_reported == 0 then
    if not os_serial_cstr_line(os_browser_scroll_marker) then return false
    os_browser_scroll_reported is 1
  end
  return os_redraw_desktop()
end

func os_browser_scrollbar_press(window: ptr[DesktopWindow], pointer_x: i64, pointer_y: i64) do
  if window == 0 or os_browser_dom_ready == 0 or os_browser_scroll_max == 0 then return false
  viewport_height: u64 is window.height - 144
  if viewport_height < 28 then return false
  track_x: i64 is window.x + window.width - 36
  track_y: i64 is window.y + 98
  if pointer_x < track_x or pointer_x >= track_x + 10 then return false
  if pointer_y < track_y or pointer_y >= track_y + viewport_height then return false
  content_height: u64 is viewport_height + os_browser_scroll_max
  thumb_height: u64 is (viewport_height * viewport_height) / content_height
  if thumb_height < 28 then thumb_height is 28
  if thumb_height > viewport_height then thumb_height is viewport_height
  thumb_range: u64 is viewport_height - thumb_height
  thumb_offset: u64 is 0
  if thumb_range != 0 then thumb_offset is (os_browser_scroll_y * thumb_range) / os_browser_scroll_max
  local_y: u64 is pointer_y - track_y
  if local_y < thumb_offset then return os_browser_scroll_by(-1, viewport_height)
  if local_y >= thumb_offset + thumb_height then return os_browser_scroll_by(1, viewport_height)
  return true
end

func os_browser_link_node_at(page_x: u64, page_y: u64) do
  candidate: u64 is u64("0xffffffffffffffff")
  index: u64 is 0
  while index < os_browser_dom_box_count do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    if box.width != 0 and box.height != 0 and page_x >= box.x and page_x < box.x + box.width and page_y >= box.y and page_y < box.y + box.height then
      node_index: u64 is box.node_index
      depth: u64 is 0
      while node_index != u64("0xffffffffffffffff") and depth < 64 do
        node: ptr[HtmlDomNode] is html_dom_node(os_browser_dom_document, node_index)
        if node == 0 then
          node_index is u64("0xffffffffffffffff")
        else
          if node.kind == 1 and node.tag == 12 then
            candidate is node_index
            node_index is u64("0xffffffffffffffff")
          else
            node_index is node.parent
          end
        end
        depth += 1
      end
    end
    index += 1
  end
  return candidate
end

func os_browser_script_node_at(page_x: u64, page_y: u64) do
  candidate: u64 is u64("0xffffffffffffffff")
  index: u64 is 0
  while index < os_browser_dom_box_count and candidate == u64("0xffffffffffffffff") do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    if box.width != 0 and box.height != 0 and page_x >= box.x and page_x < box.x + box.width and page_y >= box.y and page_y < box.y + box.height then
      node_index: u64 is box.node_index
      depth: u64 is 0
      while node_index != u64("0xffffffffffffffff") and depth < 64 and candidate == u64("0xffffffffffffffff") do
        node: ptr[HtmlDomNode] is html_dom_node(os_browser_dom_document, node_index)
        if node == 0 then
          node_index is u64("0xffffffffffffffff")
        else
          onclick: ptr[HtmlDomAttribute] is html_dom_find_attribute(os_browser_dom_document, node_index, 20)
          if onclick != 0 and onclick.has_value != 0 and onclick.source_bytes != 0 then
            candidate is node_index
          else
            node_index is node.parent
          end
        end
        depth += 1
      end
    end
    index += 1
  end
  return candidate
end

func os_browser_activate_script(window: ptr[DesktopWindow], pointer_x: i64, pointer_y: i64) do
  global os_browser_js_click_reported
  if window == 0 or os_browser_dom_ready == 0 then return false
  local_x: i64 is pointer_x - window.x - 24
  local_y: i64 is pointer_y - window.y - 98
  if local_x < 0 or local_y < 0 then return false
  if local_x >= window.width - 48 or local_y >= window.height - 144 then return false
  node_index: u64 is os_browser_script_node_at(local_x, local_y + os_browser_scroll_y)
  if node_index == u64("0xffffffffffffffff") then return false
  document: ptr[HtmlDomDocument] is os_browser_dom_document
  onclick: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, node_index, 20)
  if onclick == 0 or onclick.has_value == 0 or onclick.source_bytes == 0 then return false
  if not os_browser_execute_script(ptr.add(document.input, onclick.source_start), onclick.source_bytes) then return false
  if os_browser_js_error == 0 and os_browser_js_click_reported == 0 then
    if not os_serial_cstr_line(os_browser_js_click_marker) then return false
    os_browser_js_click_reported is 1
  end
  return os_redraw_desktop()
end

func os_browser_dom_slice_equal(document: ptr[HtmlDomDocument], first_start: u64, second_start: u64, byte_count: u64) do
  if document == 0 then return false
  cursor: u64 is 0
  while cursor < byte_count do
    if mem.read8(ptr.add(document.input, first_start + cursor)) != mem.read8(ptr.add(document.input, second_start + cursor)) then return false
    cursor += 1
  end
  return true
end

func os_browser_anchor_scroll(document: ptr[HtmlDomDocument], href: ptr[HtmlDomAttribute]) do
  global os_browser_scroll_y, os_browser_scroll_reported
  if document == 0 or href == 0 or href.source_bytes < 2 then return false
  target_start: u64 is href.source_start + 1
  target_bytes: u64 is href.source_bytes - 1
  node_index: u64 is 0
  while node_index < document.node_count do
    id_attribute: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, node_index, 1)
    same_id: bool is id_attribute != 0
    if same_id then same_id is id_attribute.has_value != 0 and id_attribute.source_bytes == target_bytes
    if same_id then same_id is os_browser_dom_slice_equal(document, id_attribute.source_start, target_start, target_bytes)
    if same_id then
      box_index: u64 is 0
      while box_index < os_browser_dom_box_count do
        box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, box_index * 144)
        if box.node_index == node_index then
          os_browser_scroll_y is box.y
          if os_browser_scroll_y > os_browser_scroll_max then os_browser_scroll_y is os_browser_scroll_max
          if os_browser_scroll_reported == 0 then
            if not os_serial_cstr_line(os_browser_scroll_marker) then return false
            os_browser_scroll_reported is 1
          end
          return true
        end
        box_index += 1
      end
    end
    node_index += 1
  end
  return false
end

func os_browser_form_hit(page_x: u64, page_y: u64) do
  state: ptr[BrowserFormState] is os_browser_form_state
  box_index: u64 is 0
  while box_index < os_browser_dom_box_count do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, box_index * 144)
    if box.width != 0 and box.height != 0 and page_x >= box.x and page_x < box.x + box.width and page_y >= box.y and page_y < box.y + box.height then
      control_index: u64 is browser_form_find_node(state, box.node_index)
      if control_index != u64("0xffffffffffffffff") then return control_index
    end
    box_index += 1
  end
  return u64("0xffffffffffffffff")
end

func os_browser_activate_form(window: ptr[DesktopWindow], pointer_x: i64, pointer_y: i64) do
  global os_browser_form_editing, os_browser_form_focus_reported
  global os_browser_scroll_y, os_browser_scroll_max, os_browser_scroll_reported
  if window == 0 or os_browser_dom_ready == 0 then return false
  local_x: i64 is pointer_x - window.x - 24
  local_y: i64 is pointer_y - window.y - 98
  if local_x < 0 or local_y < 0 then return false
  if local_x >= window.width - 48 or local_y >= window.height - 144 then return false
  control_index: u64 is os_browser_form_hit(local_x, local_y + os_browser_scroll_y)
  if control_index == u64("0xffffffffffffffff") then return false
  state: ptr[BrowserFormState] is os_browser_form_state
  control: ptr[BrowserFormControl] is browser_form_control_at(state, control_index)
  if control == 0 or (control.flags & 1) != 0 then return true
  if control.kind == 3 then
    if not browser_form_toggle(state, control_index) then return false
    os_browser_form_editing is 0
  elif control.kind == 4 then
    os_browser_form_editing is 0
    state.focused is u64("0xffffffffffffffff")
    if not os_browser_submit_form(control_index) then return false
    os_browser_scroll_y is 0
    os_browser_scroll_max is 0
    os_browser_scroll_reported is 0
  elif control.kind == 5 then
    os_browser_form_editing is 0
    state.focused is u64("0xffffffffffffffff")
  else
    if not browser_form_focus(state, control_index) then return false
    os_browser_form_editing is 1
    text_input_reset(os_browser_text_input_state)
    if os_input_layout_hangul != 0 then
      if not text_input_set_hangul(os_browser_text_input_state, true, os_browser_text_input_result) then return false
    end
    if os_browser_form_focus_reported == 0 then
      if not os_serial_cstr_line(os_browser_form_focus_marker) then return false
      os_browser_form_focus_reported is 1
    end
  end
  return os_redraw_desktop()
end

func os_browser_activate_link(window: ptr[DesktopWindow], pointer_x: i64, pointer_y: i64) do
  global os_browser_dom_render_reported, os_browser_dom_viewport_width, os_browser_dom_viewport_height
  global os_browser_scroll_y, os_browser_scroll_max, os_browser_scroll_reported, os_browser_link_reported
  if window == 0 or os_browser_dom_ready == 0 then return false
  local_x: i64 is pointer_x - window.x - 24
  local_y: i64 is pointer_y - window.y - 98
  if local_x < 0 or local_y < 0 then return false
  if local_x >= window.width - 48 or local_y >= window.height - 144 then return false
  page_x: u64 is local_x
  page_y: u64 is local_y + os_browser_scroll_y
  link_node: u64 is os_browser_link_node_at(page_x, page_y)
  if link_node == u64("0xffffffffffffffff") then return false
  document: ptr[HtmlDomDocument] is os_browser_dom_document
  href: ptr[HtmlDomAttribute] is html_dom_find_attribute(document, link_node, 3)
  if href == 0 or href.has_value == 0 or href.source_bytes == 0 then return false
  location: ptr is ptr.add(document.input, href.source_start)
  if mem.read8(location) == 35 then
    if not os_browser_anchor_scroll(document, href) then return false
    if os_browser_link_reported == 0 then
      if not os_serial_cstr_line(os_browser_link_marker) then return false
      os_browser_link_reported is 1
    end
    return os_redraw_desktop()
  end
  if not os_browser_copy_redirect(location, href.source_bytes) then return false
  os_browser_dom_render_reported is 0
  os_browser_dom_viewport_width is 0
  os_browser_dom_viewport_height is 0
  os_browser_scroll_y is 0
  os_browser_scroll_max is 0
  os_browser_scroll_reported is 0
  os_browser_navigate(os_network_context)
  if os_browser_link_reported == 0 then
    if not os_serial_cstr_line(os_browser_link_marker) then return false
    os_browser_link_reported is 1
  end
  return os_redraw_desktop()
end

func os_draw_browser_dom_layout(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  global os_browser_dom_box_count, os_browser_dom_viewport_width, os_browser_dom_viewport_height, os_browser_dom_render_error, os_browser_image_render_reported
  os_browser_dom_render_error is 0
  if surface == 0 or window == 0 or os_browser_dom_ready == 0 then
    os_browser_dom_render_error is 1
    return false
  end
  viewport_width: u64 is window.width - 48
  viewport_height: u64 is window.height - 144
  if viewport_width == 0 or viewport_height == 0 then
    os_browser_dom_render_error is 2
    return false
  end
  if viewport_width != os_browser_dom_viewport_width or viewport_height != os_browser_dom_viewport_height then
    os_browser_dom_box_count is css_box_layout(os_browser_dom_document, os_browser_dom_computed, os_browser_dom_boxes, 1024, viewport_width, viewport_height)
    if os_browser_dom_box_count == 0 then
      os_browser_dom_render_error is 3
      return false
    end
    os_browser_dom_viewport_width is viewport_width
    os_browser_dom_viewport_height is viewport_height
  end
  if not os_browser_update_scroll_limit(viewport_height) then return false
  origin_x: u64 is window.x + 24
  origin_y: u64 is window.y + 98
  index: u64 is 0
  painted_backgrounds: u64 is 0
  while index < os_browser_dom_box_count and painted_backgrounds < 64 do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    if box.flags == 0 and box.x < viewport_width and box.y >= os_browser_scroll_y and box.y - os_browser_scroll_y < viewport_height then
      style: ptr[CssComputedStyle] is ptr.add(os_browser_dom_computed, box.node_index * 288)
      visible_y: u64 is box.y - os_browser_scroll_y
      draw_width: u64 is box.width
      draw_height: u64 is box.height
      if draw_width > viewport_width - box.x then draw_width is viewport_width - box.x
      if draw_height > viewport_height - visible_y then draw_height is viewport_height - visible_y
      if style.background <= u64("0xffffff") and draw_width != 0 and draw_height != 0 then
        background: u32 is fb_rgb(surface, (style.background >> 16) & 255, (style.background >> 8) & 255, style.background & 255)
        fb_fill_rect(surface, origin_x + box.x, origin_y + visible_y, draw_width, draw_height, background)
        painted_backgrounds += 1
      end
      border_color: u32 is fb_rgb(surface, (style.color >> 16) & 255, (style.color >> 8) & 255, style.color & 255)
      top: u64 is style.border_top
      right: u64 is style.border_right
      bottom: u64 is style.border_bottom
      left: u64 is style.border_left
      if top > draw_height then top is draw_height
      if bottom > draw_height then bottom is draw_height
      if left > draw_width then left is draw_width
      if right > draw_width then right is draw_width
      if top != 0 then fb_fill_rect(surface, origin_x + box.x, origin_y + visible_y, draw_width, top, border_color)
      if bottom != 0 then fb_fill_rect(surface, origin_x + box.x, origin_y + visible_y + draw_height - bottom, draw_width, bottom, border_color)
      if left != 0 then fb_fill_rect(surface, origin_x + box.x, origin_y + visible_y, left, draw_height, border_color)
      if right != 0 then fb_fill_rect(surface, origin_x + box.x + draw_width - right, origin_y + visible_y, right, draw_height, border_color)
    end
    index += 1
  end
  index is 0
  painted_images: u64 is 0
  while index < os_browser_dom_box_count and painted_images < 4 do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    if box.flags == 0 and box.node_index < 1024 and box.content_x < viewport_width and box.content_y >= os_browser_scroll_y and box.content_y - os_browser_scroll_y < viewport_height and box.content_width != 0 and box.content_height != 0 then
      node: ptr[HtmlDomNode] is html_dom_node(os_browser_dom_document, box.node_index)
      if node != 0 and node.kind == 1 and node.tag == 15 then
        resource_index: u64 is mem.read64(ptr.add(os_browser_image_node_map, box.node_index * 8))
        if resource_index < os_browser_image_count then
          image: ptr[BrowserImage] is os_browser_image_at(resource_index)
          image_width: u64 is box.content_width
          image_height: u64 is box.content_height
          if image_width > viewport_width - box.content_x then image_width is viewport_width - box.content_x
          image_y: u64 is box.content_y - os_browser_scroll_y
          if image_height > viewport_height - image_y then image_height is viewport_height - image_y
          if image_width != 0 and image_height != 0 then
            if not os_draw_browser_image(surface, image, origin_x + box.content_x, origin_y + image_y, image_width, image_height) then
              os_browser_dom_render_error is 5
              return false
            end
            painted_images += 1
          end
        end
      end
    end
    index += 1
  end
  if painted_images != 0 and os_browser_image_render_reported == 0 then
    if not os_serial_cstr_line(os_browser_image_render_marker) then return false
    os_browser_image_render_reported is 1
  end
  if not os_draw_browser_form_controls(surface, origin_x, origin_y, viewport_width, viewport_height) then
    os_browser_dom_render_error is 6
    return false
  end
  index is 0
  painted_texts: u64 is 0
  painted_text_bytes: u64 is 0
  while index < os_browser_dom_box_count and painted_texts < 32 and painted_text_bytes < 2048 do
    box: ptr[CssBox] is ptr.add(os_browser_dom_boxes, index * 144)
    if box.flags == 1 and box.x < viewport_width and box.y >= os_browser_scroll_y and box.y - os_browser_scroll_y < viewport_height and box.width != 0 and box.height != 0 then
      node: ptr[HtmlDomNode] is html_dom_node(os_browser_dom_document, box.node_index)
      text_capacity: u64 is 2048 - painted_text_bytes
      if text_capacity > 256 then text_capacity is 256
      text_length: u64 is os_browser_normalize_dom_text(box.node_index, text_capacity)
      if text_length != 0 then
        style: ptr[CssComputedStyle] is ptr.add(os_browser_dom_computed, box.node_index * 288)
        text_style: ptr[BitmapFontStyle] is os_font_browser_dom
        text_style.foreground is fb_rgb(surface, (style.color >> 16) & 255, (style.color >> 8) & 255, style.color & 255)
        text_style.background is 0
        text_style.scale is 1
        resolved_font_size: u64 is css_font_size_resolve(style.font_size, os_browser_dom_viewport_width)
        if resolved_font_size >= 36 then text_style.scale is 2
        text_style.opaque is 0
        text_box: ptr[FontUtf8TextBox] is os_browser_dom_text_box
        text_box.x is origin_x + box.x
        text_y: u64 is box.y - os_browser_scroll_y
        text_box.y is origin_y + text_y
        text_box.width is box.width
        if text_box.width > viewport_width - box.x then text_box.width is viewport_width - box.x
        text_box.line_height is box.line_height
        if text_box.line_height == 0 then text_box.line_height is 18
        text_box.first_line is 0
        text_box.max_lines is box.height / text_box.line_height
        visible_lines: u64 is (viewport_height - text_y) / text_box.line_height
        if text_box.max_lines > visible_lines then text_box.max_lines is visible_lines
        text_box.cursor_index is text_length
        text_box.selection_start is 0
        text_box.selection_end is 0
        text_box.selection_color is 0
        text_box.syntax_map is 0
        if text_box.max_lines != 0 then
          if not font_ui_draw_utf8_box(surface, os_browser_dom_text_buffer, text_length, text_box, text_style) then
            os_browser_dom_render_error is 4
            return false
          end
          painted_texts += 1
          painted_text_bytes += text_length
        end
      end
    end
    index += 1
  end
  return true
end

func os_draw_browser_scrollbar(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  if surface == 0 or window == 0 or os_browser_dom_ready == 0 or os_browser_scroll_max == 0 then return true
  viewport_height: u64 is window.height - 144
  if viewport_height < 28 then return true
  content_height: u64 is viewport_height + os_browser_scroll_max
  thumb_height: u64 is (viewport_height * viewport_height) / content_height
  if thumb_height < 28 then thumb_height is 28
  if thumb_height > viewport_height then thumb_height is viewport_height
  thumb_range: u64 is viewport_height - thumb_height
  thumb_offset: u64 is 0
  if thumb_range != 0 then thumb_offset is (os_browser_scroll_y * thumb_range) / os_browser_scroll_max
  track_x: u64 is window.x + window.width - 36
  track_y: u64 is window.y + 98
  track: u32 is fb_rgb(surface, 221, 226, 233)
  thumb: u32 is fb_rgb(surface, 92, 108, 128)
  outline: u32 is fb_rgb(surface, 58, 72, 90)
  fb_fill_rect(surface, track_x, track_y, 10, viewport_height, track)
  fb_fill_rect(surface, track_x + 1, track_y + thumb_offset, 8, thumb_height, thumb)
  fb_rect_outline(surface, track_x, track_y + thumb_offset, 10, thumb_height, outline)
  return true
end

func os_draw_browser_window(surface: ptr[FramebufferSurface], window: ptr[DesktopWindow]) do
  global os_browser_dom_render_reported
  if not os_draw_window_frame(surface, window, os_text_browser) then return false
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  page: u32 is fb_rgb(surface, (os_browser_css_page_rgb >> 16) & 255, (os_browser_css_page_rgb >> 8) & 255, os_browser_css_page_rgb & 255)
  page_panel: u32 is fb_rgb(surface, (os_browser_css_card_rgb >> 16) & 255, (os_browser_css_card_rgb >> 8) & 255, os_browser_css_card_rgb & 255)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  heading_style: ptr[BitmapFontStyle] is os_font_browser_heading
  body_style: ptr[BitmapFontStyle] is os_font_browser_body
  link_style: ptr[BitmapFontStyle] is os_font_browser_link
  fb_fill_rect(surface, x + 16, y + 50, window.width - 32, 30, panel_light)
  fb_rect_outline(surface, x + 16, y + 50, window.width - 32, 30, orange)
  font_ui_draw_utf8_text(surface, x + 28, y + 56, os_browser_address_buffer, 96, white_small)
  if window.active != 0 and os_browser_form_editing == 0 and os_browser_address_length < 95 then
    cursor_x: u64 is x + 28 + font_ui_utf8_width(os_browser_address_buffer, os_browser_address_length)
    browser_input: ptr[TextInputState] is os_browser_text_input_state
    composing: u64 is text_input_composing(browser_input)
    if composing >= 44032 and composing <= 55203 and cursor_x + 15 < x + window.width - 18 then
      font_ui_draw_char(surface, cursor_x, y + 56, composing, white_small)
      cursor_x += 15
    end
    if cursor_x + 2 < x + window.width - 18 then fb_vline(surface, cursor_x, y + 59, 10, orange)
  end
  fb_fill_rect(surface, x + 16, y + 90, window.width - 32, window.height - 128, page)
  fb_fill_rect(surface, x + 24, y + 98, window.width - 48, window.height - 144, page_panel)
  fb_rect_outline(surface, x + 16, y + 90, window.width - 32, window.height - 128, muted)
  dom_drawn: bool is false
  if os_browser_dom_ready != 0 then
    if os_draw_browser_dom_layout(surface, window) then
      dom_drawn is true
      if os_browser_dom_render_reported == 0 then
        if not os_serial_cstr_line(os_browser_dom_render_marker) then return false
        os_browser_dom_render_reported is 1
      end
    else
      if not os_serial_text(os_browser_dom_render_error_prefix) then return false
      if not os_serial_u64(os_browser_dom_render_error) then return false
      if not serial_write_byte(1016, 10, 1000000) then return false
      os_browser_dom_ready is 0
    end
  end
  if dom_drawn and not os_draw_browser_scrollbar(surface, window) then return false
  if not dom_drawn then
  if os_browser_layout_line_count != 0 then
    line: u64 is 0
    draw_y: u64 is y + 108
    content_bottom: u64 is y + window.height - 44
    while line < os_browser_layout_line_count and draw_y + 8 < content_bottom do
      style_id: u64 is mem.read8(ptr.add(os_browser_layout_styles, line))
      style: ptr[BitmapFontStyle] is body_style
      draw_x: u64 is x + 30
      line_height: u64 is 18
      if style_id == 1 then
        style is heading_style
        draw_x is x + 36
        line_height is 18
        fb_fill_rect(surface, x + 26, draw_y, 3, 14, orange)
      end
      if style_id == 2 then
        style is link_style
        fb_fill_rect(surface, x + 26, draw_y + 3, 3, 3, orange)
      end
      font_ui_draw_utf8_text(surface, draw_x, draw_y, ptr.add(os_browser_layout_lines, line * 256), 255, style)
      draw_y += line_height
      line += 1
    end
  else
    if os_browser_text_length != 0 then
      font_ui_draw_utf8_text(surface, x + 24, y + 104, os_browser_text_buffer, 4096, body_style)
    end
  end
  end
  status: ptr is os_browser_status_text
  if status == 0 then status is os_text_browser_status_network
  font_ui_draw_utf8_text(surface, x + 20, y + window.height - 31, status, 48, muted_small)
  return true
end

func os_draw_managed_windows(surface: ptr[FramebufferSurface]) do
  manager: ptr[WindowManager] is os_window_manager_state
  if surface == 0 or manager.windows == 0 then return false
  drawn: u64 is 0
  last_z: u64 is 0
  while drawn < manager.count do
    selected: ptr[DesktopWindow] is 0
    selected_z: u64 is 0
    index: u64 is 0
    while index < manager.capacity do
      candidate: ptr[DesktopWindow] is window_manager_at(manager, index)
      if candidate.visible != 0 and candidate.z_order > last_z and (selected == 0 or candidate.z_order < selected_z) then
        selected is candidate
        selected_z is candidate.z_order
      end
      index += 1
    end
    if selected == 0 then return false
    if selected.id == 1 then
      if not os_draw_terminal_window(surface, selected) then return false
    end
    if selected.id == 2 then
      if not os_draw_about_window(surface, selected) then return false
    end
    if selected.id == 3 then
      if not os_draw_file_explorer_window(surface, selected) then return false
    end
    if selected.id == 4 then
      if not os_draw_text_editor_window(surface, selected) then return false
    end
    if selected.id == 5 then
      if not os_draw_calculator_window(surface, selected) then return false
    end
    if selected.id == 6 then
      if not os_draw_browser_window(surface, selected) then return false
    end
    if selected.id == 7 then
      if not os_draw_doom_window(surface, selected) then return false
    end
    last_z is selected_z
    drawn += 1
  end
  return true
end

func os_redraw_terminal() do
  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 then return false
  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  if window == 0 or window.visible == 0 then return os_present_with_pointer()
  x: u64 is window.x
  y: u64 is window.y
  panel: u32 is fb_rgb(back, 20, 27, 40)
  white: u32 is fb_rgb(back, 242, 247, 252)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  terminal: ptr[TextTerminal] is os_terminal_state
  fb_fill_rect(back, x + 1, y + 39, window.width - 2, window.height - 40, panel)
  if terminal.cells != 0 then
    text_terminal_draw(terminal, back, x + 24, y + 54, white_large)
    cursor_x: u64 is x + 24 + terminal.cursor_x * 12
    cursor_y: u64 is y + 54 + terminal.cursor_y * 16
    if cursor_x + 10 < x + window.width and cursor_y + 15 < y + window.height then
      fb_fill_rect(back, cursor_x, cursor_y + 14, 10, 2, white)
    end
  end
  return os_present_with_pointer()
end

func os_redraw_browser_address() do
  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 then return false
  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, 6)
  if window == 0 or window.visible == 0 then return os_present_with_pointer()
  x: u64 is window.x
  y: u64 is window.y
  panel_light: u32 is fb_rgb(back, 31, 41, 58)
  orange: u32 is fb_rgb(back, 255, 102, 35)
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  fb_fill_rect(back, x + 16, y + 50, window.width - 32, 30, panel_light)
  fb_rect_outline(back, x + 16, y + 50, window.width - 32, 30, orange)
  font_ui_draw_utf8_text(back, x + 28, y + 56, os_browser_address_buffer, 96, white_small)
  if window.active != 0 and os_browser_form_editing == 0 and os_browser_address_length < 95 then
    cursor_x: u64 is x + 28 + font_ui_utf8_width(os_browser_address_buffer, os_browser_address_length)
    browser_input: ptr[TextInputState] is os_browser_text_input_state
    composing: u64 is text_input_composing(browser_input)
    if composing >= 44032 and composing <= 55203 and cursor_x + 15 < x + window.width - 18 then
      font_ui_draw_char(back, cursor_x, y + 56, composing, white_small)
      cursor_x += 15
    end
    if cursor_x + 2 < x + window.width - 18 then fb_vline(back, cursor_x, y + 59, 10, orange)
  end
  return os_present_with_pointer()
end

func os_redraw_desktop() do
  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 then return false
  if not os_draw_desktop(back) then return false
  return os_present_with_pointer()
end

func os_activate_window(manager: ptr[WindowManager], id: u64) do
  if manager == 0 then return 0
  window: ptr[DesktopWindow] is window_manager_find(manager, id)
  if window == 0 then return 0
  if window.visible == 0 then
    if not window_manager_show(manager, id) then return 0
    return 2
  end
  if not window_manager_focus(manager, id) then return 0
  return 1
end

func os_desktop_pointer_press(manager: ptr[WindowManager], x: i64, y: i64) do
  global os_start_menu_reported, os_window_reopen_reported, os_window_minimize_reported, os_window_maximize_reported, os_files_app_reported, os_editor_app_reported, os_calculator_app_reported, os_browser_app_reported, os_directory_reported, os_calculator_keypad_reported, os_calculator_last_input_source
  global os_browser_form_editing, os_browser_navigation_fetch_active
  if manager == 0 then return false
  shell: ptr[DesktopShell] is os_desktop_shell_state
  terminal_window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  system_window: ptr[DesktopWindow] is window_manager_find(manager, 2)
  terminal_visible: u64 is 0
  system_visible: u64 is 0
  if terminal_window != 0 then terminal_visible is terminal_window.visible
  if system_window != 0 then system_visible is system_window.visible
  taskbar_y: u64 is desktop_shell_taskbar_y(shell)
  doom_icon_x: i64 is 126
  doom_icon_y: i64 is 114
  if shell.height >= 720 then
    doom_icon_x is 34
    doom_icon_y is 574
  end
  doom_hit: bool is false
  if desktop_shell_contains(x, y, doom_icon_x, doom_icon_y, 48, 48) and window_manager_top_at(manager, x, y) == 0 then
    doom_hit is true
  end
  if shell.width >= 1200 and desktop_shell_contains(x, y, 944, taskbar_y + 8, 100, 36) then doom_hit is true
  if doom_hit then
    shell.start_open is 0
    manager.dragging_id is 0
    return os_doom_launch()
  end
  browser_hit: bool is desktop_shell_contains(x, y, 34, 482, 48, 48)
  if shell.width >= 1100 and desktop_shell_contains(x, y, 832, taskbar_y + 8, 100, 36) then browser_hit is true
  if browser_hit then
    shell.start_open is 0
    manager.dragging_id is 0
    if os_activate_window(manager, 6) == 0 then return false
    if not os_serial_cstr_line(os_browser_focus_marker) then return false
    if os_browser_app_reported == 0 then
      if not os_serial_cstr_line(os_browser_app_marker) then return false
      os_browser_app_reported is 1
    end
    return true
  end
  action: u64 is desktop_shell_pointer_press(shell, x, y, terminal_visible, system_visible)

  if action == desktop_action_none then
    top: ptr[DesktopWindow] is window_manager_top_at(manager, x, y)
    if top != 0 then
      frame_x: i64 is x - top.x
      frame_y: i64 is y - top.y
      if frame_y >= 0 and frame_y < 38 and frame_x >= top.width - 114 and frame_x < top.width - 76 then
        if not window_manager_minimize(manager, top.id) then return false
        if os_window_minimize_reported == 0 then
          if not os_serial_cstr_line(os_window_minimize_marker) then return false
          os_window_minimize_reported is 1
        end
        return true
      end
      if frame_y >= 0 and frame_y < 38 and frame_x >= top.width - 76 and frame_x < top.width - 38 then
        if not window_manager_toggle_maximize(manager, top.id) then return false
        if os_window_maximize_reported == 0 then
          if not os_serial_cstr_line(os_window_maximize_marker) then return false
          os_window_maximize_reported is 1
        end
        return true
      end
    end
    if top != 0 and top.id == 2 then
      local_x: i64 is x - top.x
      local_y: i64 is y - top.y
      if local_x >= 18 and local_x < top.width - 18 and local_y >= 184 and local_y < 210 then
        if not window_manager_focus(manager, 2) then return false
        state: ptr[TextInputState] is os_text_input_state
        result: ptr[TextInputResult] is os_text_input_result
        enabled: bool is os_input_layout_hangul == 0
        if not text_input_set_hangul(state, enabled, result) then return false
        if not os_input_layout_record(state) then return false
        packed: u64 is os_text_input_pack(result)
        if packed != 0 then return os_editor_ring3_dispatch(packed)
        return os_redraw_desktop()
      end
    end
    if top != 0 and top.id == 6 then
      if manager.active_id != 6 and not window_manager_focus(manager, 6) then return false
      # A network yield may deliver this click while the current HTTP/TLS
      # request still owns the shared browser buffers.  Window controls and
      # pointer movement remain live, but browser content cannot start a
      # nested request until the current fetch has completed.
      if os_browser_navigation_fetch_active != 0 then return true
      browser_local_y: i64 is y - top.y
      if browser_local_y >= 50 and browser_local_y < 80 then
        os_browser_form_editing is 0
        os_browser_form_state.focused is u64("0xffffffffffffffff")
        text_input_reset(os_browser_text_input_state)
        return os_redraw_desktop()
      end
      if os_browser_scrollbar_press(top, x, y) then return true
      if os_browser_activate_script(top, x, y) then return true
      if os_browser_activate_form(top, x, y) then return true
      if os_browser_activate_link(top, x, y) then return true
    end
    if top != 0 and top.id == 3 then
      local_y: i64 is y - top.y
      files: ptr[FileExplorerState] is os_file_explorer_state
      visible_rows: u64 is files.entry_count
      if visible_rows > 6 then visible_rows is 6
      if local_y >= 78 and local_y < 78 + visible_rows * 34 then
        row: u64 is (local_y - 78) / 34
        entry_index: u64 is row
        if os_surafs_mounted != 0 then entry_index += os_files_view_offset
        if entry_index < files.entry_count then
          if not window_manager_focus(manager, 3) then return false
          return os_files_ring3_dispatch(entry_index)
        end
      end
    end
    if top != 0 and top.id == 5 then
      local_x: i64 is x - top.x
      local_y: i64 is y - top.y
      if local_x >= 24 and local_x < 296 and local_y >= 128 and local_y < 266 then
        column: u64 is (local_x - 24) / 68
        row: u64 is (local_y - 128) / 36
        button_x: u64 is 24 + column * 68
        button_y: u64 is 128 + row * 36
        if local_x < button_x + 62 and local_y < button_y + 30 then
          value: u64 is os_calculator_keypad_value(row, column)
          if value != 0 then
            if not window_manager_focus(manager, 5) then return false
            os_calculator_last_input_source is 1
            if os_calculator_keypad_reported == 0 then
              if not os_serial_cstr_line(os_calculator_keypad_marker) then return false
              os_calculator_keypad_reported is 1
            end
            return os_calculator_ring3_dispatch(value)
          end
        end
      end
    end
    window_manager_pointer_press(manager, x, y)
    return true
  end
  manager.dragging_id is 0
  if action == desktop_action_start_toggle then
    if shell.start_open != 0 and os_start_menu_reported == 0 then
      if not os_serial_cstr_line(os_start_menu_marker) then return false
      os_start_menu_reported is 1
    end
    return true
  end
  if action == desktop_action_shutdown then
    os_terminal_cstr_line(os_desktop_shutdown_marker, 48)
    if not os_serial_cstr_line(os_desktop_shutdown_marker) then return false
    if not os_serial_cstr_line(os_shutdown_marker) then return false
    os_serial_drain()
    os_power_shutdown(17)
    return true
  end

  target_id: u64 is 0
  if action == desktop_action_terminal_menu or action == desktop_action_terminal_taskbar then
    target_id is 1
  end
  if action == desktop_action_system_menu or action == desktop_action_system_taskbar or action == desktop_action_about_icon then
    target_id is 2
  end
  if action == desktop_action_files_icon or action == desktop_action_files_taskbar or action == desktop_action_files_menu then target_id is 3
  if action == desktop_action_editor_icon or action == desktop_action_editor_taskbar or action == desktop_action_editor_menu then target_id is 4
  if action == desktop_action_calculator_icon or action == desktop_action_calculator_taskbar or action == desktop_action_calculator_menu then target_id is 5
  if target_id == 0 then return true
  if target_id == 2 then return os_system_ring3_dispatch()
  reopened: u64 is os_activate_window(manager, target_id)
  if reopened == 0 then return false
  if reopened == 2 and os_window_reopen_reported == 0 then
    if not os_serial_cstr_line(os_window_reopen_marker) then return false
    os_window_reopen_reported is 1
  end
  if target_id == 3 and os_files_app_reported == 0 then
    if not os_serial_cstr_line(os_files_app_marker) then return false
    os_files_app_reported is 1
  end
  if target_id == 4 and os_editor_app_reported == 0 then
    if not os_serial_cstr_line(os_editor_app_marker) then return false
    os_editor_app_reported is 1
  end
  if target_id == 5 and os_calculator_app_reported == 0 then
    if not os_serial_cstr_line(os_calculator_app_marker) then return false
    os_calculator_app_reported is 1
  end
  return true
end

func os_draw_start_menu(surface: ptr[FramebufferSurface]) do
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if surface == 0 or shell.start_open == 0 then return true
  menu_y: u64 is desktop_shell_menu_y(shell)
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small

  fb_fill_rect(surface, 18, menu_y + 8, 260, 330, black)
  fb_fill_rect(surface, 10, menu_y, 260, 330, panel)
  fb_rect_outline(surface, 10, menu_y, 260, 330, orange)
  fb_fill_rect(surface, 10, menu_y, 260, 42, titlebar)
  font_ui_draw_utf8_text(surface, 24, menu_y + 11, os_text_brand, 32, white_large)
  font_ui_draw_utf8_text(surface, 176, menu_y + 11, os_text_applications, 32, muted_small)
  fb_fill_rect(surface, 20, menu_y + 54, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 65, os_icon_terminal, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 64, os_text_terminal, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 96, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 107, os_icon_about, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 106, os_text_system_short, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 138, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 149, os_icon_files, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 148, os_text_files, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 180, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 191, os_icon_notes, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 190, os_text_editor_icon, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 222, 240, 38, panel_light)
  os_draw_bitmap_icon(surface, 30, menu_y + 233, os_icon_calc, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 232, os_text_calculator_icon, 32, white_small)
  fb_fill_rect(surface, 20, menu_y + 280, 240, 36, panel_light)
  fb_rect_outline(surface, 20, menu_y + 280, 240, 36, orange)
  os_draw_bitmap_icon(surface, 30, menu_y + 290, os_icon_logo, 1)
  font_ui_draw_utf8_text(surface, 54, menu_y + 289, os_text_shutdown, 32, white_small)
  return true
end

func os_draw_desktop(surface: ptr[FramebufferSurface]) do
  if surface == 0 or surface.width < 640 or surface.height < 400 then return false

  navy: u32 is fb_rgb(surface, 12, 24, 44)
  navy_light: u32 is fb_rgb(surface, 18, 39, 70)
  panel: u32 is fb_rgb(surface, 20, 27, 40)
  panel_light: u32 is fb_rgb(surface, 31, 41, 58)
  titlebar: u32 is fb_rgb(surface, 16, 91, 132)
  orange: u32 is fb_rgb(surface, 255, 102, 35)
  orange_light: u32 is fb_rgb(surface, 255, 153, 92)
  white: u32 is fb_rgb(surface, 242, 247, 252)
  muted: u32 is fb_rgb(surface, 155, 172, 190)
  green: u32 is fb_rgb(surface, 94, 211, 132)
  black: u32 is fb_rgb(surface, 3, 8, 15)
  white_large: ptr[BitmapFontStyle] is os_font_white_large
  white_small: ptr[BitmapFontStyle] is os_font_white_small
  orange_large: ptr[BitmapFontStyle] is os_font_orange_large
  green_large: ptr[BitmapFontStyle] is os_font_green_large
  muted_small: ptr[BitmapFontStyle] is os_font_muted_small
  browser_heading: ptr[BitmapFontStyle] is os_font_browser_heading
  browser_body: ptr[BitmapFontStyle] is os_font_browser_body
  browser_link: ptr[BitmapFontStyle] is os_font_browser_link
  font5x7_style_init(white_large, white, panel, 2, 0)
  font5x7_style_init(white_small, white, panel, 1, 0)
  font5x7_style_init(orange_large, orange_light, panel, 2, 0)
  font5x7_style_init(green_large, green, panel, 2, 0)
  font5x7_style_init(muted_small, muted, panel_light, 1, 0)
  browser_heading_color: u32 is fb_rgb(surface, (os_browser_css_heading_rgb >> 16) & 255, (os_browser_css_heading_rgb >> 8) & 255, os_browser_css_heading_rgb & 255)
  browser_body_color: u32 is fb_rgb(surface, (os_browser_css_text_rgb >> 16) & 255, (os_browser_css_text_rgb >> 8) & 255, os_browser_css_text_rgb & 255)
  browser_link_color: u32 is fb_rgb(surface, (os_browser_css_link_rgb >> 16) & 255, (os_browser_css_link_rgb >> 8) & 255, os_browser_css_link_rgb & 255)
  font5x7_style_init(browser_heading, browser_heading_color, white, 1, 0)
  font5x7_style_init(browser_body, browser_body_color, white, 1, 0)
  font5x7_style_init(browser_link, browser_link_color, white, 1, 0)

  if not fb_clear(surface, navy) then return false

  band_height: u64 is surface.height / 8
  band: u64 is 0
  while band < 8 do
    if (band & 1) == 0 then
      fb_fill_rect(surface, 0, band * band_height, surface.width, band_height, navy_light)
    end
    band += 1
  end

  # Embedded raster logo and application images.
  os_draw_bitmap_icon(surface, 28, 24, os_icon_logo, 3)
  font_ui_draw_utf8_text(surface, 96, 31, os_text_brand, 32, white_large)

  os_draw_bitmap_icon(surface, 34, 114, os_icon_files, 3)
  font_ui_draw_utf8_text(surface, 36, 164, os_text_files, 16, white_small)
  if surface.height >= 720 then
    os_draw_bitmap_icon(surface, 34, 574, os_icon_doom, 3)
    font_ui_draw_utf8_text(surface, 36, 624, os_text_doom_icon, 16, white_small)
  else
    os_draw_bitmap_icon(surface, 126, 114, os_icon_doom, 3)
    font_ui_draw_utf8_text(surface, 128, 164, os_text_doom_icon, 16, white_small)
  end
  os_draw_bitmap_icon(surface, 34, 206, os_icon_about, 3)
  font_ui_draw_utf8_text(surface, 36, 256, os_text_about_icon, 16, white_small)
  if surface.height >= 520 then
    os_draw_bitmap_icon(surface, 34, 298, os_icon_notes, 3)
    font_ui_draw_utf8_text(surface, 36, 348, os_text_editor_icon, 16, white_small)
    os_draw_bitmap_icon(surface, 34, 390, os_icon_calc, 3)
    font_ui_draw_utf8_text(surface, 36, 440, os_text_calculator_icon, 16, white_small)
  end
  if surface.height >= 620 then
    os_draw_bitmap_icon(surface, 34, 482, os_icon_web, 3)
    font_ui_draw_utf8_text(surface, 36, 532, os_text_browser_icon, 16, white_small)
  end

  if not os_draw_managed_windows(surface) then return false

  manager: ptr[WindowManager] is os_window_manager_state
  fullscreen_window: ptr[DesktopWindow] is window_manager_find(manager, manager.active_id)
  if fullscreen_window != 0 and fullscreen_window.visible != 0 and fullscreen_window.state == window_state_fullscreen() then
    return true
  end

  # Taskbar and start button.
  taskbar_y: u64 is surface.height - 52
  fb_fill_rect(surface, 0, taskbar_y, surface.width, 52, panel_light)
  fb_hline(surface, 0, taskbar_y, surface.width, orange)
  start_color: u32 is titlebar
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if shell.start_open != 0 then start_color is orange
  fb_fill_rect(surface, 10, taskbar_y + 8, 104, 36, start_color)
  fb_rect_outline(surface, 10, taskbar_y + 8, 104, 36, orange)
  os_draw_bitmap_icon(surface, 18, taskbar_y + 18, os_icon_logo, 1)
  font_ui_draw_utf8_text(surface, 42, taskbar_y + 14, os_text_start, 16, white_large)
  fb_fill_rect(surface, 126, taskbar_y + 8, 158, 36, panel)
  os_draw_bitmap_icon(surface, 138, taskbar_y + 18, os_icon_terminal, 1)
  font_ui_draw_utf8_text(surface, 160, taskbar_y + 14, os_text_terminal, 16, white_small)
  terminal_window: ptr[DesktopWindow] is window_manager_find(manager, 1)
  if terminal_window != 0 and terminal_window.active != 0 then
    fb_hline(surface, 126, taskbar_y + 43, 158, orange)
  end
  about: ptr[DesktopWindow] is window_manager_find(manager, 2)
  fb_fill_rect(surface, 296, taskbar_y + 8, 188, 36, panel)
  os_draw_bitmap_icon(surface, 306, taskbar_y + 18, os_icon_about, 1)
  font_ui_draw_utf8_text(surface, 328, taskbar_y + 14, os_text_about_icon, 16, white_small)
  if about != 0 and about.active != 0 then
    fb_hline(surface, 296, taskbar_y + 43, 188, orange)
  end
  if surface.width >= 900 then
    fb_fill_rect(surface, 496, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 504, taskbar_y + 18, os_icon_files, 1)
    font_ui_draw_utf8_text(surface, 526, taskbar_y + 14, os_text_files, 16, white_small)
    files_window: ptr[DesktopWindow] is window_manager_find(manager, 3)
    if files_window != 0 and files_window.active != 0 then
      fb_hline(surface, 496, taskbar_y + 43, 100, orange)
    end
    fb_fill_rect(surface, 608, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 616, taskbar_y + 18, os_icon_notes, 1)
    font_ui_draw_utf8_text(surface, 638, taskbar_y + 14, os_text_editor_icon, 16, white_small)
    editor_window: ptr[DesktopWindow] is window_manager_find(manager, 4)
    if editor_window != 0 and editor_window.active != 0 then
      fb_hline(surface, 608, taskbar_y + 43, 100, orange)
    end
    fb_fill_rect(surface, 720, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 728, taskbar_y + 18, os_icon_calc, 1)
    font_ui_draw_utf8_text(surface, 750, taskbar_y + 14, os_text_calculator_icon, 16, white_small)
    calculator_window: ptr[DesktopWindow] is window_manager_find(manager, 5)
    if calculator_window != 0 and calculator_window.active != 0 then
      fb_hline(surface, 720, taskbar_y + 43, 100, orange)
    end
  end
  if surface.width >= 1100 then
    fb_fill_rect(surface, 832, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 840, taskbar_y + 18, os_icon_web, 1)
    font_ui_draw_utf8_text(surface, 862, taskbar_y + 14, os_text_browser_icon, 16, white_small)
    browser_window: ptr[DesktopWindow] is window_manager_find(manager, 6)
    if browser_window != 0 and browser_window.active != 0 then
      fb_hline(surface, 832, taskbar_y + 43, 100, orange)
    end
  end
  if surface.width >= 1200 then
    fb_fill_rect(surface, 944, taskbar_y + 8, 100, 36, panel)
    os_draw_bitmap_icon(surface, 952, taskbar_y + 18, os_icon_doom, 1)
    font_ui_draw_utf8_text(surface, 974, taskbar_y + 14, os_text_doom_icon, 16, white_small)
    doom_window: ptr[DesktopWindow] is window_manager_find(manager, 7)
    if doom_window != 0 and doom_window.active != 0 then
      fb_hline(surface, 944, taskbar_y + 43, 100, orange)
    end
  end
  time: ptr[RtcTime] is os_rtc_time_state
  clock_label: ptr is os_text_clock_unknown
  if time.valid != 0 then clock_label is os_clock_text
  font_ui_draw_utf8_text(surface, surface.width - 54, taskbar_y + 14, clock_label, 8, muted_small)
  if not os_draw_start_menu(surface) then return false
  return true
end

func os_graphics_start(framebuffer: ptr, width: u64, height: u64, stride: u64, pixel_format: u64) do
  global os_graphics_status, os_graphics_message, os_mouse_x, os_mouse_y
  front: ptr[FramebufferSurface] is os_front_surface_state
  back: ptr[FramebufferSurface] is os_back_surface_state
  os_graphics_message is os_shell_status
  os_mouse_x is width / 2
  os_mouse_y is height / 2
  os_graphics_status is 1
  if not fb_surface_init(front, framebuffer, width, height, stride, pixel_format) then return false
  os_graphics_status is 2
  if not fb_surface_init(back, os_backbuffer_address, width, height, stride, pixel_format) then return false
  os_graphics_status is 3
  if not os_window_manager_start(back) then return false
  os_graphics_status is 4
  shell: ptr[DesktopShell] is os_desktop_shell_state
  if not desktop_shell_init(shell, width, height, 52) then return false
  files: ptr[FileExplorerState] is os_file_explorer_state
  if not file_explorer_init(files, 1) then return false
  editor: ptr[TextEditorState] is os_text_editor_state
  if not text_editor_init(editor, os_text_editor_buffer, 4096) then return false
  calculator: ptr[CalculatorState] is os_calculator_state
  if not calculator_reset(calculator) then return false
  os_clock_refresh()
  if not os_draw_desktop(back) then return false
  os_graphics_status is 5
  background_sample: u32 is fb_get_pixel(back, 2, 2)
  taskbar_sample: u32 is fb_get_pixel(back, 2, height - 20)
  if background_sample == taskbar_sample then return false
  os_graphics_status is 6
  if fb_sample_hash(back) == 0 then return false
  os_graphics_status is 7
  if not os_present_with_pointer() then return false
  os_graphics_status is 0
  return true
end

func os_shell_accept(value: u64) do
  global os_shell_length, os_terminal_scroll_reported
  if os_terminal_ring3_ready != 0 then return os_terminal_ring3_dispatch(value)
  terminal: ptr[TextTerminal] is os_terminal_state
  if value == 13 then return true
  if value == 10 then
    if not serial_write_byte(1016, 10, 1000000) then return false
    if not text_terminal_newline(terminal) then return false
    if not os_shell_execute(os_shell_input, os_shell_length) then return false
    if terminal.scroll_count > 0 and os_terminal_scroll_reported == 0 then
      if not os_serial_line(os_terminal_scroll_marker, 26) then return false
      os_terminal_scroll_reported is 1
    end
    os_shell_length is 0
    mem.write8(os_shell_input, 0)
    if not os_serial_text(os_shell_prompt) then return false
    if not os_terminal_prompt() then return false
    return os_redraw_terminal()
  end
  if value == 8 or value == 127 then
    if os_shell_length > 0 then
      os_shell_length -= 1
      mem.write8(ptr.add(os_shell_input, os_shell_length), 0)
      text_terminal_put(terminal, 8)
      return os_redraw_terminal()
    end
    return true
  end
  if value >= 32 and value <= 126 and os_shell_length < 63 then
    mem.write8(ptr.add(os_shell_input, os_shell_length), value)
    os_shell_length += 1
    mem.write8(ptr.add(os_shell_input, os_shell_length), 0)
    if not text_terminal_put(terminal, value) then return false
    return os_redraw_terminal()
  end
  return true
end

func os_calculator_ring3_invalid(frame: ptr[OsUserInterruptFrame]) interrupt do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(6)
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(40)
  return
end

func os_calculator_ring3_general_protection(frame: ptr[OsUserInterruptFrame]) interrupt_error do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(13)
  serial_write_byte(1016, 32, 1000000)
  if frame != 0 then
    os_serial_u64(frame.error)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(frame.rip)
  end
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(41)
  return
end

func os_calculator_ring3_page_fault(frame: ptr[OsUserInterruptFrame]) interrupt_error do
  os_serial_cstr_line(os_calculator_ring3_fault_marker)
  os_serial_u64(cpu.read_cr2())
  serial_write_byte(1016, 32, 1000000)
  os_serial_u64(os_calculator_worker.code_address)
  serial_write_byte(1016, 32, 1000000)
  os_serial_u64(os_calculator_worker.code_size)
  serial_write_byte(1016, 32, 1000000)
  if frame != 0 then
    os_serial_u64(frame.error)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(frame.rip)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(frame.rsp)
  end
  serial_write_byte(1016, 10, 1000000)
  os_serial_drain()
  os_vm_exit(42)
  return
end

func os_calculator_ring3_interrupt(frame: ptr[OsUserInterruptFrame]) interrupt do
  global os_calculator_cr3_reported, os_editor_cr3_reported, os_editor_irq_debug_stage, os_files_cr3_reported, os_terminal_cr3_reported, os_system_cr3_reported, os_user_app_active_id, os_shell_length, os_terminal_user_action, os_terminal_user_command, os_terminal_user_input, os_system_memory_mib, os_system_pixel_count
  if frame == 0 or frame.cs != 35 or (frame.cs & 3) != 3 then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(43)
    return
  end

  active_id: u64 is os_user_app_active_id
  if active_id != 1 and active_id != 2 and active_id != 3 and active_id != 4 and active_id != 5 then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(56)
    return
  end
  space: ptr[ProcessAddressSpace] is 0
  if active_id == 1 then space is os_calculator_process_space
  if active_id == 2 then space is os_editor_process_space
  if active_id == 3 then space is os_files_process_space
  if active_id == 4 then space is os_terminal_process_space
  if active_id == 5 then space is os_system_process_space
  if space == 0 or space.root == 0 or space.root == os_kernel_page_root or paging.root() != space.root then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(50)
    return
  end

  return_target: ptr is 0
  if active_id == 1 then
    mailbox: ptr[UserCalculatorMailbox] is os_user_worker_mailbox_address
    if mailbox.status != 1 or mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then
      os_serial_cstr_line(os_calculator_ring3_fault_marker)
      os_vm_exit(44)
      return
    end
    calculator: ptr[CalculatorState] is os_calculator_state
    calculator.left is mailbox.left
    calculator.right is mailbox.right
    calculator.operation is mailbox.operation
    calculator.entering_right is mailbox.entering_right
    calculator.result is mailbox.result
    calculator.has_result is mailbox.has_result
    calculator.error is mailbox.error
    return_target is addr_of(os_calculator_user_return)
  elif active_id == 2 then
    if os_editor_irq_debug_stage == 0 then
      if not os_serial_cstr_line(os_editor_irq_enter_marker) then os_vm_exit(108)
      os_editor_irq_debug_stage is 1
    end
    editor_mailbox: ptr[UserTextEditorMailbox] is os_user_worker_mailbox_address
    editor: ptr[TextEditorState] is os_text_editor_state
    if editor_mailbox.status != 1 or editor_mailbox.error > 3 then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(53)
      return
    end
    if editor_mailbox.request_sequence == 0 or editor_mailbox.response_sequence != editor_mailbox.request_sequence then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(54)
      return
    end
    if editor_mailbox.capacity != editor.capacity or editor_mailbox.length >= editor_mailbox.capacity then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(55)
      return
    end
    if editor_mailbox.cursor > editor_mailbox.length or editor_mailbox.selection_anchor > editor_mailbox.length then
      os_serial_cstr_line(os_editor_ring3_fault_marker)
      os_vm_exit(55)
      return
    end
    editor_user_buffer: ptr is ptr.add(os_user_worker_mailbox_address, 96)
    if editor_mailbox.cursor != 0 and editor_mailbox.cursor != editor_mailbox.length then
      if (mem.read8(ptr.add(editor_user_buffer, editor_mailbox.cursor)) & 192) == 128 then
        os_serial_cstr_line(os_editor_ring3_fault_marker)
        os_vm_exit(55)
        return
      end
    end
    if editor_mailbox.selection_anchor != 0 and editor_mailbox.selection_anchor != editor_mailbox.length then
      if (mem.read8(ptr.add(editor_user_buffer, editor_mailbox.selection_anchor)) & 192) == 128 then
        os_serial_cstr_line(os_editor_ring3_fault_marker)
        os_vm_exit(55)
        return
      end
    end
    if os_editor_irq_debug_stage == 1 then
      if not os_serial_cstr_line(os_editor_irq_valid_marker) then os_vm_exit(109)
      os_editor_irq_debug_stage is 2
    end
    editor.length is editor_mailbox.length
    editor.dirty is editor_mailbox.dirty
    editor.cursor is editor_mailbox.cursor
    editor.selection_anchor is editor_mailbox.selection_anchor
    copy_index: u64 is 0
    while copy_index < editor.capacity do
      mem.write8(ptr.add(editor.buffer, copy_index), mem.read8(ptr.add(os_user_worker_mailbox_address, 96 + copy_index)))
      copy_index += 1
    end
    if os_editor_irq_debug_stage == 2 then
      if not os_serial_cstr_line(os_editor_irq_copy_marker) then os_vm_exit(110)
      os_editor_irq_debug_stage is 3
    end
    return_target is addr_of(os_editor_user_return)
  elif active_id == 3 then
    files_mailbox: ptr[UserFileExplorerMailbox] is os_user_worker_mailbox_address
    files: ptr[FileExplorerState] is os_file_explorer_state
    if files_mailbox.status != 1 or files_mailbox.error != 0 or files_mailbox.action != 1 then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(65)
      return
    end
    if files_mailbox.request_sequence == 0 or files_mailbox.response_sequence != files_mailbox.request_sequence then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(66)
      return
    end
    if files_mailbox.entry_count != files.entry_count or files_mailbox.selected >= files.entry_count then
      os_serial_cstr_line(os_files_ring3_fault_marker)
      os_vm_exit(67)
      return
    end
    files.selected is files_mailbox.selected
    return_target is addr_of(os_files_user_return)
  elif active_id == 4 then
    terminal_mailbox: ptr[UserTerminalMailbox] is os_user_worker_mailbox_address
    if terminal_mailbox.status != 1 or terminal_mailbox.error > 2 then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(76)
      return
    end
    if terminal_mailbox.request_sequence == 0 or terminal_mailbox.response_sequence != terminal_mailbox.request_sequence then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(77)
      return
    end
    if terminal_mailbox.capacity != 64 or terminal_mailbox.length >= terminal_mailbox.capacity or terminal_mailbox.action > 3 or terminal_mailbox.command > 11 then
      os_serial_cstr_line(os_terminal_ring3_fault_marker)
      os_vm_exit(78)
      return
    end
    os_shell_length is terminal_mailbox.length
    os_terminal_user_action is terminal_mailbox.action
    os_terminal_user_command is terminal_mailbox.command
    os_terminal_user_input is terminal_mailbox.input
    terminal_copy_index: u64 is 0
    while terminal_copy_index < 64 do
      mem.write8(ptr.add(os_shell_input, terminal_copy_index), mem.read8(ptr.add(os_user_worker_mailbox_address, 80 + terminal_copy_index)))
      terminal_copy_index += 1
    end
    return_target is addr_of(os_terminal_user_return)
  elif active_id == 5 then
    system_mailbox: ptr[UserSystemInfoMailbox] is os_user_worker_mailbox_address
    if system_mailbox.status != 1 or system_mailbox.error != 0 or system_mailbox.action != 1 then
      os_serial_cstr_line(os_system_ring3_fault_marker)
      os_vm_exit(95)
      return
    end
    if system_mailbox.request_sequence == 0 or system_mailbox.response_sequence != system_mailbox.request_sequence then
      os_serial_cstr_line(os_system_ring3_fault_marker)
      os_vm_exit(96)
      return
    end
    if system_mailbox.width < 640 or system_mailbox.height < 400 or system_mailbox.free_pages == 0 then
      os_serial_cstr_line(os_system_ring3_fault_marker)
      os_vm_exit(97)
      return
    end
    os_system_memory_mib is system_mailbox.memory_mib
    os_system_pixel_count is system_mailbox.pixel_count
    return_target is addr_of(os_system_user_return)
  end

  paging.activate(os_kernel_page_root)
  if paging.root() != os_kernel_page_root then
    os_serial_cstr_line(os_calculator_ring3_fault_marker)
    os_vm_exit(51)
    return
  end
  if active_id == 2 and os_editor_irq_debug_stage == 3 then
    if not os_serial_cstr_line(os_editor_irq_kernel_marker) then os_vm_exit(111)
    os_editor_irq_debug_stage is 4
  end
  if active_id == 1 and os_calculator_cr3_reported == 0 then
    if not os_serial_cstr_line(os_calculator_cr3_marker) then os_vm_exit(52)
    os_calculator_cr3_reported is 1
  end
  if active_id == 2 and os_editor_cr3_reported == 0 then
    if not os_serial_cstr_line(os_editor_cr3_marker) then os_vm_exit(57)
    os_editor_cr3_reported is 1
  end
  if active_id == 3 and os_files_cr3_reported == 0 then
    if not os_serial_cstr_line(os_files_cr3_marker) then os_vm_exit(68)
    os_files_cr3_reported is 1
  end
  if active_id == 4 and os_terminal_cr3_reported == 0 then
    if not os_serial_cstr_line(os_terminal_cr3_marker) then os_vm_exit(79)
    os_terminal_cr3_reported is 1
  end
  if active_id == 5 and os_system_cr3_reported == 0 then
    if not os_serial_cstr_line(os_system_cr3_marker) then os_vm_exit(98)
    os_system_cr3_reported is 1
  end
  os_user_app_active_id is 0

  # Return to a clean kernel continuation instead of exposing the interrupted
  # kernel call stack to user mode. The interrupt epilogue sees the rewritten
  # ring-0 selector and therefore keeps the kernel GS base active.
  frame.rip is return_target
  frame.cs is 8
  frame.rflags is 2
  frame.rsp is ptr.add(os_calculator_resume_stack, 16376)
  frame.ss is 16
  frame.rax is 0
  return
end

func os_user_process_queue(app_id: u64) do
  if app_id < 1 or app_id > 7 then return 0
  return ptr.index(os_user_process_queues, app_id - 1, sizeof(IpcQueue))
end

func os_user_process_worker(app_id: u64) do
  if app_id == 1 then return os_calculator_worker
  if app_id == 2 then return os_editor_worker
  if app_id == 3 then return os_files_worker
  if app_id == 4 then return os_terminal_worker
  if app_id == 5 then return os_system_worker
  if app_id == 6 then return os_window_server_worker
  if app_id == 7 then return os_browser_worker
  return 0
end

func os_user_process_id(app_id: u64) do
  if app_id < 1 or app_id > 7 then return 0
  return mem.read64(ptr.index(os_user_process_ids, app_id - 1, 8))
end

func os_user_process_create_app(app_id: u64) do
  if app_id < 1 or app_id > 7 then return 0
  worker: ptr[OsUserWorker] is os_user_process_worker(app_id)
  if worker == 0 or worker.space == 0 or worker.stack == 0 then return 0
  create: ptr[UserProcessCreate] is os_user_process_create
  create.address_space is worker.space
  create.kernel_stack_base is ptr.add(os_user_process_kernel_stacks, (app_id - 1) * 16384)
  create.kernel_stack_size is 16384
  create.entry is worker.code_address
  stack: ptr[ProcessStack] is worker.stack
  create.user_stack_pointer is stack.initial_rsp
  create.argument is worker.mailbox_address | 1
  create.user_gs_base is 0
  create.event_queue is os_user_process_queue(app_id)
  process_id: u64 is user_process_create(os_user_scheduler, create)
  mem.write64(ptr.index(os_user_process_ids, app_id - 1, 8), process_id)
  return process_id
end

func os_user_scheduler_install_gates() do
  cpu.idt_set_gate(os_calculator_ring3_idt, 14, addr_of(user_process_page_fault_interrupt), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 48, addr_of(user_process_kernel_slice_timer_interrupt), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 128, addr_of(process_software_syscall_dispatch), 8, 0, 238)
  cpu.idt_set_gate(os_calculator_ring3_idt, 130, addr_of(user_process_yield_interrupt), 8, 0, 238)
  cpu.load_idt(os_calculator_ring3_idt, 4096)
  return true
end

func os_user_scheduler_start() do
  global os_user_scheduler_ready, os_user_scheduler_timer_count
  global user_process_scheduler_active, process_syscall_active
  if os_user_scheduler_ready != 0 then return true
  if user_process_scheduler_active != 0 or process_syscall_active != 0 then return false
  if os_kernel_page_root == 0 or paging.root() != os_kernel_page_root then return false
  if os_calculator_ring3_ready == 0 or os_editor_ring3_ready == 0 then return false
  if os_files_ring3_ready == 0 or os_terminal_ring3_ready == 0 or os_system_ring3_ready == 0 then return false
  if os_window_server_ring3_ready == 0 or os_browser_ring3_ready == 0 then return false

  app_id: u64 is 1
  while app_id <= 7 do
    queue: ptr[IpcQueue] is os_user_process_queue(app_id)
    storage: ptr is ptr.index(os_user_process_messages, (app_id - 1) * 8, sizeof(IpcMessage))
    if not ipc_queue_init(queue, storage, 8) then return false
    app_id += 1
  end

  scheduler_config: ptr[UserProcessSchedulerConfig] is os_user_scheduler_config
  scheduler_config.processes is os_user_processes
  scheduler_config.capacity is 8
  scheduler_config.tss is os_calculator_ring3_tss
  scheduler_config.kernel_root is os_kernel_page_root
  scheduler_config.kernel_gs_base is 0
  scheduler_config.idle_stack_base is os_user_scheduler_idle_stack
  scheduler_config.idle_stack_size is 16384
  if not user_process_scheduler_init(os_user_scheduler, scheduler_config) then return false

  app_id is 1
  while app_id <= 7 do
    if os_user_process_create_app(app_id) == 0 then return false
    app_id += 1
  end

  if not syscall_table_init(os_user_syscall_table, os_user_syscall_handlers, 128, u64("0xffffffffffffffff")) then return false
  if not process_syscall_init(os_user_syscall_state, os_user_scheduler, os_user_syscall_table, os_user_syscall_scratch) then return false
  if not os_doom_install_syscalls(os_user_syscall_table) then return false

  if not os_user_scheduler_install_gates() then return false

  if apic.mode() == 0 then return false
  apic.write(240, 511)
  sample: u64 is apic_timer_calibrate_pit(11932, 16, 10000000)
  os_user_scheduler_timer_count is apic_timer_count_for_hz(sample, 11932, 100)
  if os_user_scheduler_timer_count == 0 then os_user_scheduler_timer_count is 1000000
  if not apic_timer_configure(48, os_user_scheduler_timer_count, 16, true) then return false

  primed: bool is interrupt.invoke(130)
  if os_user_scheduler.current != os_user_scheduler.capacity then return false
  if os_user_scheduler.runnable_count != 0 or paging.root() != os_kernel_page_root then return false
  app_id is 1
  while app_id <= 7 do
    process_id: u64 is os_user_process_id(app_id)
    if user_process_state(os_user_scheduler, process_id) != 4 then return false
    process_index: u64 is user_process_find_index(os_user_scheduler, process_id)
    if process_index >= os_user_scheduler.capacity then return false
    process: ptr[UserProcess] is user_process_at(os_user_scheduler, process_index)
    if process == 0 or process.frame == 0 or process.address_space == 0 then return false
    space: ptr[ProcessAddressSpace] is process.address_space
    mem.write64(ptr.index(os_user_process_initial_frames, app_id - 1, 8), process.frame)
    mem.write64(ptr.index(os_user_process_initial_roots, app_id - 1, 8), space.root)
    app_id += 1
  end

  os_user_scheduler_ready is 1
  return os_serial_cstr_line(os_user_scheduler_ready_marker)
end

func os_user_process_verify_persistent(app_id: u64) do
  global os_user_scheduler_persistent_mask, os_user_scheduler_persistent_reported
  if app_id < 1 or app_id > 7 then return false
  process_id: u64 is os_user_process_id(app_id)
  index: u64 is user_process_find_index(os_user_scheduler, process_id)
  if index >= os_user_scheduler.capacity then return false
  process: ptr[UserProcess] is user_process_at(os_user_scheduler, index)
  if process == 0 or process.state != 4 or process.address_space == 0 then return false
  if process.blocks < 2 or process.wakes < 1 or process.switches < 2 then return false
  if process.frame != mem.read64(ptr.index(os_user_process_initial_frames, app_id - 1, 8)) then return false
  space: ptr[ProcessAddressSpace] is process.address_space
  if space.root != mem.read64(ptr.index(os_user_process_initial_roots, app_id - 1, 8)) then return false
  if process.kernel_stack_base != ptr.add(os_user_process_kernel_stacks, (app_id - 1) * 16384) then return false
  os_user_scheduler_persistent_mask is os_user_scheduler_persistent_mask | (1 << (app_id - 1))
  if os_user_scheduler_persistent_mask == 127 and os_user_scheduler_persistent_reported == 0 then
    if not os_serial_cstr_line(os_user_scheduler_persistent_marker) then return false
    os_user_scheduler_persistent_reported is 1
  end
  return true
end

func os_user_process_start_app(app_id: u64) do
  if app_id == 1 then return os_calculator_ring3_start()
  if app_id == 2 then return os_editor_ring3_start()
  if app_id == 3 then return os_files_ring3_start()
  if app_id == 4 then return os_terminal_ring3_start()
  if app_id == 5 then return os_system_ring3_start()
  if app_id == 6 then return os_window_server_ring3_start()
  if app_id == 7 then return os_browser_ring3_start()
  return false
end

func os_user_process_restart(app_id: u64) do
  global os_user_scheduler_persistent_mask, os_user_scheduler_restart_count, os_graphics_message
  if os_user_scheduler_ready == 0 or app_id < 1 or app_id > 7 then return false
  if os_user_scheduler.current != os_user_scheduler.capacity then return false
  if paging.root() != os_kernel_page_root then return false

  old_process_id: u64 is os_user_process_id(app_id)
  old_state: u64 is user_process_state(os_user_scheduler, old_process_id)
  if old_process_id == 0 or old_state != 2 and old_state != 3 then return false
  if not user_process_reap(os_user_scheduler, old_process_id) then return false
  mem.write64(ptr.index(os_user_process_ids, app_id - 1, 8), 0)

  worker: ptr[OsUserWorker] is os_user_process_worker(app_id)
  if worker == 0 or not os_user_worker_clear(worker) then return false
  queue: ptr[IpcQueue] is os_user_process_queue(app_id)
  storage: ptr is ptr.index(os_user_process_messages, (app_id - 1) * 8, sizeof(IpcMessage))
  if not ipc_queue_init(queue, storage, 8) then return false
  if not os_user_process_start_app(app_id) then return false

  # Calculator startup installs its legacy one-shot gates while rebuilding the
  # worker address space. Restore the persistent scheduler ABI before the new
  # process is allowed to execute.
  if not os_user_scheduler_install_gates() then return false
  new_process_id: u64 is os_user_process_create_app(app_id)
  if new_process_id == 0 or new_process_id == old_process_id then return false

  attempts: u64 is 0
  state: u64 is user_process_state(os_user_scheduler, new_process_id)
  while state == 1 and attempts < 64 do
    primed: bool is interrupt.invoke(130)
    if paging.root() != os_kernel_page_root then return false
    state is user_process_state(os_user_scheduler, new_process_id)
    attempts += 1
  end
  if state != 4 or queue.count != 0 then return false
  if os_user_scheduler.current != os_user_scheduler.capacity then return false

  process_index: u64 is user_process_find_index(os_user_scheduler, new_process_id)
  if process_index >= os_user_scheduler.capacity then return false
  process: ptr[UserProcess] is user_process_at(os_user_scheduler, process_index)
  if process == 0 or process.frame == 0 or process.address_space == 0 then return false
  space: ptr[ProcessAddressSpace] is process.address_space
  if space.root == 0 or space.root == os_kernel_page_root then return false
  mem.write64(ptr.index(os_user_process_initial_frames, app_id - 1, 8), process.frame)
  mem.write64(ptr.index(os_user_process_initial_roots, app_id - 1, 8), space.root)
  os_user_scheduler_persistent_mask is os_user_scheduler_persistent_mask & ~(1 << (app_id - 1))
  if os_user_scheduler_restart_count != u64("0xffffffffffffffff") then
    os_user_scheduler_restart_count += 1
  end
  os_graphics_message is os_text_user_process_restarted
  return os_serial_cstr_line(os_user_scheduler_restarted_marker)
end

func os_user_process_handle_failure(app_id: u64, dispatch_status: u64) do
  global os_calculator_ring3_ready, os_editor_ring3_ready, os_files_ring3_ready, os_terminal_ring3_ready, os_system_ring3_ready, os_window_server_ring3_ready, os_browser_ring3_ready, os_graphics_message
  if dispatch_status != 2 and dispatch_status != 3 and dispatch_status != 4 then return false
  window_id: u64 is 0
  if app_id == 1 then
    os_calculator_ring3_ready is 0
    window_id is 5
  elif app_id == 2 then
    os_editor_ring3_ready is 0
    window_id is 4
  elif app_id == 3 then
    os_files_ring3_ready is 0
    window_id is 3
  elif app_id == 4 then
    os_terminal_ring3_ready is 0
    window_id is 1
  elif app_id == 5 then
    os_system_ring3_ready is 0
    window_id is 2
  elif app_id == 6 then
    os_window_server_ring3_ready is 0
    window_id is 0
  elif app_id == 7 then
    os_browser_ring3_ready is 0
    window_id is 6
  else
    return false
  end

  manager: ptr[WindowManager] is os_window_manager_state
  window: ptr[DesktopWindow] is window_manager_find(manager, window_id)
  was_visible: u64 is 0
  if window != 0 and window.visible != 0 then
    was_visible is 1
    if not window_manager_close(manager, window_id) then return false
  end
  os_graphics_message is os_text_user_process_stopped
  if not os_serial_cstr_line(os_user_scheduler_isolated_marker) then return false
  if not os_redraw_desktop() then return false
  if not os_user_process_restart(app_id) then return false
  if was_visible != 0 and not window_manager_show(manager, window_id) then return false
  return os_redraw_desktop()
end

func os_user_process_fault_probe() do
  if os_user_scheduler_ready == 0 or os_calculator_ring3_ready == 0 then return false
  old_process_id: u64 is os_user_process_id(1)
  index: u64 is user_process_find_index(os_user_scheduler, old_process_id)
  if index >= os_user_scheduler.capacity then return false
  process: ptr[UserProcess] is user_process_at(os_user_scheduler, index)
  if process == 0 or process.state != 4 or process.frame == 0 then return false
  frame: ptr[UserInterruptFrame] is process.frame
  frame.rip is 4096
  status: u64 is os_user_scheduler_dispatch(1, u64("0xf17a"))
  if status != 2 then return false
  if not os_user_process_handle_failure(1, status) then return false

  new_process_id: u64 is os_user_process_id(1)
  if new_process_id == 0 or new_process_id == old_process_id then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false
  sequence_before: u64 is os_calculator_ring3_sequence
  if not os_calculator_ring3_dispatch(67) then return false
  if os_calculator_ring3_sequence == sequence_before then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false
  return os_serial_cstr_line(os_user_scheduler_restart_event_marker)
end

func os_user_process_hang_probe() do
  global os_system_ring3_sequence
  if os_user_scheduler_ready == 0 or os_calculator_ring3_ready == 0 then return false
  if os_system_ring3_ready == 0 then return false
  old_process_id: u64 is os_user_process_id(1)
  old_mouse_x: i64 is os_mouse_x
  old_mouse_y: i64 is os_mouse_y

  # Queue a second real desktop job before Calculator enters its intentional
  # non-yielding loop. The scheduler must let System Information finish under
  # its own CR3 while APIC slices continue returning to the input loop.
  system_mailbox: ptr[UserSystemInfoMailbox] is os_system_mailbox_transfer
  if not os_system_mailbox_snapshot(system_mailbox) then return false
  os_system_ring3_sequence += 1
  if os_system_ring3_sequence == 0 then os_system_ring3_sequence is 1
  system_sequence: u64 is os_system_ring3_sequence
  system_mailbox.request_sequence is system_sequence
  system_mailbox.response_sequence is 0
  system_mailbox.action is 0
  system_mailbox.status is 0
  system_mailbox.error is 0
  system_mailbox.memory_mib is 0
  system_mailbox.pixel_count is 0
  if not os_user_worker_copy_to_mailbox(os_system_worker, system_mailbox, sizeof(UserSystemInfoMailbox)) then return false
  if not os_user_scheduler_post(5, system_sequence) then return false

  if not os_serial_cstr_line(os_user_scheduler_hang_started_marker) then return false
  if not os_calculator_ring3_dispatch(u64("0xf17b")) then return false

  new_process_id: u64 is os_user_process_id(1)
  if new_process_id == 0 or new_process_id == old_process_id then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false
  if os_mouse_x == old_mouse_x and os_mouse_y == old_mouse_y then return false
  if not os_serial_cstr_line(os_user_scheduler_hang_input_marker) then return false
  if user_process_state(os_user_scheduler, os_user_process_id(5)) != 4 then return false
  if not os_user_worker_copy_from_mailbox(os_system_worker, system_mailbox, sizeof(UserSystemInfoMailbox)) then return false
  if system_mailbox.response_sequence != system_sequence then return false
  if not os_system_accept_mailbox() then return false
  if not os_user_process_verify_persistent(5) then return false
  if not os_user_process_report_cr3(5) then return false
  if not os_serial_cstr_line(os_user_scheduler_background_marker) then return false

  sequence_before: u64 is os_calculator_ring3_sequence
  if not os_calculator_ring3_dispatch(67) then return false
  if os_calculator_ring3_sequence == sequence_before then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false
  return os_serial_cstr_line(os_user_scheduler_hang_recovered_marker)
end

func os_browser_process_fault_probe() do
  global os_browser_address_length
  if os_user_scheduler_ready == 0 or os_browser_ring3_ready == 0 then return false
  old_process_id: u64 is os_user_process_id(7)
  index: u64 is user_process_find_index(os_user_scheduler, old_process_id)
  if index >= os_user_scheduler.capacity then return false
  process: ptr[UserProcess] is user_process_at(os_user_scheduler, index)
  if process == 0 or process.state != 4 or process.frame == 0 then return false
  frame: ptr[UserInterruptFrame] is process.frame
  frame.rip is 4096
  status: u64 is os_user_scheduler_dispatch(7, u64("0xb707"))
  if status != 2 then return false
  if not os_user_process_handle_failure(7, status) then return false

  new_process_id: u64 is os_user_process_id(7)
  if new_process_id == 0 or new_process_id == old_process_id then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false

  saved_length: u64 is os_browser_address_length
  if saved_length > 255 then return false
  copy_index: u64 is 0
  while copy_index <= saved_length do
    mem.write8(ptr.add(os_browser_fault_address_save, copy_index), mem.read8(ptr.add(os_browser_address_buffer, copy_index)))
    copy_index += 1
  end
  if not net_zero(os_browser_address_buffer, 256) then return false
  if not net_copy(os_browser_address_buffer, os_browser_internal_form_address, 16) then return false
  os_browser_address_length is 16
  sequence_before: u64 is os_browser_ring3_sequence
  authorized: bool is os_browser_ring3_authorize()
  if not net_zero(os_browser_address_buffer, 256) then return false
  if saved_length != 0 and not net_copy(os_browser_address_buffer, os_browser_fault_address_save, saved_length) then return false
  os_browser_address_length is saved_length
  mem.write8(ptr.add(os_browser_address_buffer, saved_length), 0)
  if not authorized or os_browser_ring3_sequence == sequence_before then return false
  if user_process_state(os_user_scheduler, new_process_id) != 4 then return false
  return os_serial_cstr_line(os_browser_process_isolated_marker)
end

func os_user_scheduler_post(app_id: u64, request_sequence: u64) do
  global os_user_scheduler_concurrent_reported
  if os_user_scheduler_ready == 0 or app_id < 1 or app_id > 7 then return 0
  process_id: u64 is os_user_process_id(app_id)
  if process_id == 0 or user_process_state(os_user_scheduler, process_id) != 4 then return 0
  message: ptr[IpcMessage] is os_user_process_post
  if not ipc_message_clear(message) then return 0
  message.kind is 200 + app_id
  message.flags is request_sequence
  message.value0 is app_id
  message.value1 is request_sequence
  if not user_process_post_event(os_user_scheduler, 0, process_id, message) then return 0
  if os_user_scheduler.runnable_count >= 2 and os_user_scheduler_concurrent_reported == 0 then
    if not os_serial_cstr_line(os_user_scheduler_concurrent_marker) then return false
    os_user_scheduler_concurrent_reported is 1
  end
  return true
end

func os_user_scheduler_dispatch(app_id: u64, request_sequence: u64) do
  if not os_user_scheduler_post(app_id, request_sequence) then return 0
  process_id: u64 is os_user_process_id(app_id)
  attempts: u64 is 0
  state: u64 is user_process_state(os_user_scheduler, process_id)
  while state == 1 and attempts < 64 do
    scheduled: bool is interrupt.invoke(130)
    if paging.root() != os_kernel_page_root then return 0
    state is user_process_state(os_user_scheduler, process_id)
    if state == 1 then
      if not os_input_poll_once() then return 0
    end
    attempts += 1
  end

  if state == 1 then
    if os_user_scheduler.current != os_user_scheduler.capacity then return 0
    if not user_process_terminate(os_user_scheduler, process_id, 124) then return 0
    if not os_serial_cstr_line(os_user_scheduler_watchdog_marker) then return 0
    return 4
  end
  if state == 4 then
    if not os_user_process_verify_persistent(app_id) then return 0
    return 1
  end
  if state == 3 then
    os_serial_cstr_line(os_user_scheduler_fault_marker)
    os_serial_u64(app_id)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(user_process_fault_address(os_user_scheduler, process_id))
    serial_write_byte(1016, 10, 1000000)
    return 2
  end
  if state == 2 then
    os_serial_cstr_line(os_user_scheduler_exit_marker)
    os_serial_u64(app_id)
    serial_write_byte(1016, 32, 1000000)
    os_serial_u64(user_process_exit_code(os_user_scheduler, process_id))
    serial_write_byte(1016, 10, 1000000)
    return 3
  end
  return 0
end

func os_calculator_accept_mailbox() do
  mailbox: ptr[UserCalculatorMailbox] is os_calculator_mailbox_transfer
  if mailbox.status != 1 or mailbox.request_sequence == 0 then return false
  if mailbox.response_sequence != mailbox.request_sequence then return false
  calculator: ptr[CalculatorState] is os_calculator_state
  calculator.left is mailbox.left
  calculator.right is mailbox.right
  calculator.operation is mailbox.operation
  calculator.entering_right is mailbox.entering_right
  calculator.result is mailbox.result
  calculator.has_result is mailbox.has_result
  calculator.error is mailbox.error
  return true
end

func os_editor_accept_mailbox() do
  mailbox: ptr[UserTextEditorMailbox] is os_editor_mailbox_transfer
  editor: ptr[TextEditorState] is os_text_editor_state
  if mailbox.status != 1 or mailbox.error > 3 then return false
  if mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.capacity != editor.capacity or mailbox.length >= mailbox.capacity then return false
  if mailbox.cursor > mailbox.length or mailbox.selection_anchor > mailbox.length then return false
  user_buffer: ptr is ptr.add(os_editor_mailbox_transfer, 96)
  if mailbox.cursor != 0 and mailbox.cursor != mailbox.length then
    if (mem.read8(ptr.add(user_buffer, mailbox.cursor)) & 192) == 128 then return false
  end
  if mailbox.selection_anchor != 0 and mailbox.selection_anchor != mailbox.length then
    if (mem.read8(ptr.add(user_buffer, mailbox.selection_anchor)) & 192) == 128 then return false
  end
  editor.length is mailbox.length
  editor.dirty is mailbox.dirty
  editor.cursor is mailbox.cursor
  editor.selection_anchor is mailbox.selection_anchor
  index: u64 is 0
  while index < editor.capacity do
    mem.write8(ptr.add(editor.buffer, index), mem.read8(ptr.add(user_buffer, index)))
    index += 1
  end
  return true
end

func os_files_accept_mailbox() do
  mailbox: ptr[UserFileExplorerMailbox] is os_files_mailbox_transfer
  files: ptr[FileExplorerState] is os_file_explorer_state
  if mailbox.status != 1 or mailbox.error != 0 or mailbox.action != 1 then return false
  if mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.entry_count != files.entry_count or mailbox.selected >= files.entry_count then return false
  files.selected is mailbox.selected
  return true
end

func os_terminal_accept_mailbox() do
  global os_shell_length, os_terminal_user_action, os_terminal_user_command, os_terminal_user_input
  mailbox: ptr[UserTerminalMailbox] is os_terminal_mailbox_transfer
  if mailbox.status != 1 or mailbox.error > 2 then return false
  if mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.capacity != 64 or mailbox.length >= mailbox.capacity then return false
  if mailbox.action > 3 or mailbox.command > 11 then return false
  os_shell_length is mailbox.length
  os_terminal_user_action is mailbox.action
  os_terminal_user_command is mailbox.command
  os_terminal_user_input is mailbox.input
  index: u64 is 0
  while index < 64 do
    mem.write8(ptr.add(os_shell_input, index), mem.read8(ptr.add(os_terminal_mailbox_transfer, 80 + index)))
    index += 1
  end
  return true
end

func os_system_accept_mailbox() do
  global os_system_memory_mib, os_system_pixel_count
  mailbox: ptr[UserSystemInfoMailbox] is os_system_mailbox_transfer
  if mailbox.status != 1 or mailbox.error != 0 or mailbox.action != 1 then return false
  if mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.width < 640 or mailbox.height < 400 or mailbox.free_pages == 0 then return false
  os_system_memory_mib is mailbox.memory_mib
  os_system_pixel_count is mailbox.pixel_count
  return true
end

func os_user_process_report_cr3(app_id: u64) do
  global os_calculator_cr3_reported, os_editor_cr3_reported, os_files_cr3_reported, os_terminal_cr3_reported, os_system_cr3_reported, os_window_server_cr3_reported, os_browser_cr3_reported
  process_id: u64 is os_user_process_id(app_id)
  index: u64 is user_process_find_index(os_user_scheduler, process_id)
  if index >= os_user_scheduler.capacity then return false
  process: ptr[UserProcess] is user_process_at(os_user_scheduler, index)
  if process == 0 or process.address_space == 0 then return false
  space: ptr[ProcessAddressSpace] is process.address_space
  if space.root == 0 or space.root == os_kernel_page_root then return false
  if app_id == 1 and os_calculator_cr3_reported == 0 then
    if not os_serial_cstr_line(os_calculator_cr3_marker) then return false
    os_calculator_cr3_reported is 1
  elif app_id == 2 and os_editor_cr3_reported == 0 then
    if not os_serial_cstr_line(os_editor_cr3_marker) then return false
    os_editor_cr3_reported is 1
  elif app_id == 3 and os_files_cr3_reported == 0 then
    if not os_serial_cstr_line(os_files_cr3_marker) then return false
    os_files_cr3_reported is 1
  elif app_id == 4 and os_terminal_cr3_reported == 0 then
    if not os_serial_cstr_line(os_terminal_cr3_marker) then return false
    os_terminal_cr3_reported is 1
  elif app_id == 5 and os_system_cr3_reported == 0 then
    if not os_serial_cstr_line(os_system_cr3_marker) then return false
    os_system_cr3_reported is 1
  elif app_id == 6 and os_window_server_cr3_reported == 0 then
    if not os_serial_cstr_line(os_window_server_cr3_marker) then return false
    os_window_server_cr3_reported is 1
  elif app_id == 7 and os_browser_cr3_reported == 0 then
    if not os_serial_cstr_line(os_browser_cr3_marker) then return false
    os_browser_cr3_reported is 1
  end
  return true
end

func os_calculator_ring3_start() do
  global os_calculator_ring3_ready, os_kernel_page_root
  if os_calculator_ring3_ready != 0 then return true

  # The copied function has only internal relative branches and no global
  # references, so it can execute from process-owned code pages.
  source: ptr is addr_of(user_calculator_program)
  source_end: ptr is addr_of(user_calculator_program_end)
  if source_end <= source or source_end - source > 8192 then return false
  code_size: u64 is source_end - source

  cpu.disable_interrupts()
  io.out8(33, 255)
  io.out8(161, 255)
  cpu.tss_set_rsp(os_calculator_ring3_tss, 0, ptr.add(os_calculator_kernel_stack, 16384))
  cpu.tss_set_ist(os_calculator_ring3_tss, 1, ptr.add(os_calculator_fault_stack, 16384))
  cpu.tss_set_iomap(os_calculator_ring3_tss, 104)
  cpu.gdt_set_tss(os_calculator_ring3_gdt, 5, os_calculator_ring3_tss, 103)
  cpu.load_gdt(os_calculator_ring3_gdt, 56)
  cpu.reload_segments(8, 16)
  cpu.load_task_register(40)

  cpu.idt_set_gate(os_calculator_ring3_idt, 6, addr_of(os_calculator_ring3_invalid), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 8, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 10, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 11, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 12, addr_of(os_calculator_ring3_general_protection), 8, 1, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 13, addr_of(os_calculator_ring3_general_protection), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 14, addr_of(os_calculator_ring3_page_fault), 8, 0, 142)
  cpu.idt_set_gate(os_calculator_ring3_idt, 128, addr_of(os_calculator_ring3_interrupt), 8, 0, 238)
  cpu.load_idt(os_calculator_ring3_idt, 4096)
  percpu.set_base(0)
  percpu.set_kernel_base(0)

  os_kernel_page_root is paging.root()
  if os_kernel_page_root == 0 or not ptr.is_aligned(os_kernel_page_root, 4096) then return false

  buffers: ptr[ProcessSpaceBuffers] is os_calculator_process_buffers
  buffers.owned_pages is os_calculator_process_owned_pages
  buffers.owned_capacity is 32
  buffers.mappings is os_calculator_process_mappings
  buffers.mapping_capacity is 16

  config: ptr[OsUserWorkerConfig] is os_calculator_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is sizeof(UserCalculatorMailbox)
  config.event_address is os_user_worker_mailbox_address + 4096
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 8192

  worker: ptr[OsUserWorker] is os_calculator_worker
  space: ptr[ProcessAddressSpace] is os_calculator_process_space
  stack: ptr[ProcessStack] is os_calculator_process_stack
  setup: ptr[OsUserWorkerInit] is os_calculator_worker_init
  setup.space is space
  setup.buffers is buffers
  setup.stack is stack
  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  mailbox: ptr[UserCalculatorMailbox] is os_calculator_mailbox_transfer
  mailbox.left is 0
  mailbox.right is 0
  mailbox.operation is 0
  mailbox.entering_right is 0
  mailbox.result is 0
  mailbox.has_result is 0
  mailbox.error is 0
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.input is 0
  mailbox.status is 0
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserCalculatorMailbox)) then return false

  os_calculator_ring3_ready is 1
  return os_serial_cstr_line(os_calculator_ring3_ready_marker)
end

func os_calculator_ring3_dispatch(value: u64) do
  global os_calculator_ring3_sequence, os_user_app_active_id
  if os_calculator_ring3_ready == 0 then return true
  if os_user_app_active_id != 0 then return false
  calculator: ptr[CalculatorState] is os_calculator_state
  mailbox: ptr[UserCalculatorMailbox] is os_calculator_mailbox_transfer

  mailbox.left is calculator.left
  mailbox.right is calculator.right
  mailbox.operation is calculator.operation
  mailbox.entering_right is calculator.entering_right
  mailbox.result is calculator.result
  mailbox.has_result is calculator.has_result
  mailbox.error is calculator.error
  os_calculator_ring3_sequence += 1
  if os_calculator_ring3_sequence == 0 then os_calculator_ring3_sequence is 1
  mailbox.request_sequence is os_calculator_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.input is value
  mailbox.status is 0

  worker: ptr[OsUserWorker] is os_calculator_worker
  if not os_user_worker_copy_to_mailbox(worker, mailbox, sizeof(UserCalculatorMailbox)) then return false
  os_user_app_active_id is 1
  dispatch_status: u64 is os_user_scheduler_dispatch(1, mailbox.request_sequence)
  os_user_app_active_id is 0
  if dispatch_status != 1 then return os_user_process_handle_failure(1, dispatch_status)
  if not os_user_worker_copy_from_mailbox(worker, mailbox, sizeof(UserCalculatorMailbox)) then return false
  if not os_calculator_accept_mailbox() then return false
  if not os_user_process_report_cr3(1) then return false
  return os_calculator_complete()
end


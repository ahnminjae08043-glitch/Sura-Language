  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false

  if not net_zero(os_browser_mailbox_transfer, 384) then return false
  mailbox: ptr[UserBrowserMailbox] is os_browser_mailbox_transfer
  mailbox.command is 1
  if not os_user_worker_copy_to_mailbox(worker, os_browser_mailbox_transfer, 384) then return false
  os_browser_ring3_ready is 1
  return os_serial_cstr_line(os_browser_ring3_ready_marker)
end

func os_browser_ring3_authorize() do
  global os_browser_ring3_sequence, os_browser_ring3_result_reported
  # The boot-time default page is fetched before the persistent scheduler is
  # constructed. Every later graphical navigation must cross the worker.
  if os_user_scheduler_ready == 0 then return true
  if os_browser_ring3_ready == 0 or os_browser_address_length == 0 or os_browser_address_length > 255 then return false
  mailbox: ptr[UserBrowserMailbox] is os_browser_mailbox_transfer
  if not net_zero(os_browser_mailbox_transfer, 384) then return false
  mailbox.command is 1
  mailbox.address_length is os_browser_address_length
  os_browser_ring3_sequence += 1
  if os_browser_ring3_sequence == 0 then os_browser_ring3_sequence is 1
  mailbox.request_sequence is os_browser_ring3_sequence
  index: u64 is 0
  while index < os_browser_address_length do
    mem.write8(ptr.add(os_browser_mailbox_transfer, 128 + index), mem.read8(ptr.add(os_browser_address_buffer, index)))
    index += 1
  end
  mem.write8(ptr.add(os_browser_mailbox_transfer, 128 + os_browser_address_length), 0)

  worker: ptr[OsUserWorker] is os_browser_worker
  if not os_user_worker_copy_to_mailbox(worker, os_browser_mailbox_transfer, 384) then return false
  dispatch_status: u64 is os_user_scheduler_dispatch(7, mailbox.request_sequence)
  if dispatch_status != 1 then
    if not os_user_process_handle_failure(7, dispatch_status) then return false
    return false
  end
  if not os_user_worker_copy_from_mailbox(worker, os_browser_mailbox_transfer, 384) then return false
  if mailbox.status != 1 or mailbox.error != 0 or mailbox.action != 1 then return false
  if mailbox.request_sequence == 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.address_length != os_browser_address_length then return false
  if mailbox.scheme != 1 and mailbox.scheme != 2 then return false
  if mailbox.host_length == 0 or mailbox.host_length > 253 then return false
  if mailbox.host_start > mailbox.address_length or mailbox.host_length > mailbox.address_length - mailbox.host_start then return false
  if mailbox.path_start != mailbox.host_start + mailbox.host_length then return false
  if mailbox.path_start > mailbox.address_length or mailbox.path_length != mailbox.address_length - mailbox.path_start then return false
  if mailbox.storage_allowed != 0 or mailbox.device_allowed != 0 then return false

  address: ptr is ptr.add(os_browser_mailbox_transfer, 128)
  internal: bool is mailbox.host_length == 10
  if internal and mem.read8(ptr.add(address, mailbox.host_start)) != 115 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 1)) != 117 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 2)) != 114 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 3)) != 97 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 4)) != 46 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 5)) != 108 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 6)) != 111 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 7)) != 99 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 8)) != 97 then internal is false
  if internal and mem.read8(ptr.add(address, mailbox.host_start + 9)) != 108 then internal is false
  if internal and mailbox.network_allowed != 0 then return false
  if not internal and mailbox.network_allowed != 1 then return false

  if not os_user_process_report_cr3(7) then return false
  if not os_user_process_verify_persistent(7) then return false
  if os_browser_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_browser_ring3_result_marker) then return false
    os_browser_ring3_result_reported is 1
  end
  return true
end

func os_window_server_mailbox_prepare(mailbox: ptr[UserWindowServerMailbox]) do
  if mailbox == 0 then return false
  mailbox.request_sequence is 0
  mailbox.response_sequence is 0
  mailbox.command is 1
  mailbox.status is 0
  mailbox.error is 0
  mailbox.generation is 0
  mailbox.width is 16
  mailbox.height is 16
  mailbox.stride is 16
  mailbox.damage_x is 0
  mailbox.damage_y is 0
  mailbox.damage_width is 16
  mailbox.damage_height is 16
  mailbox.background is 66051
  mailbox.surface_count is 2
  mailbox.remove_owner is 0
  mailbox.first_owner is 101
  mailbox.first_x is 1
  mailbox.first_y is 1
  mailbox.first_width is 8
  mailbox.first_height is 8
  mailbox.first_z is 1
  mailbox.first_active is 1
  mailbox.first_offset is 1536
  mailbox.first_stride is 8
  mailbox.second_owner is 202
  mailbox.second_x is 4
  mailbox.second_y is 4
  mailbox.second_width is 8
  mailbox.second_height is 8
  mailbox.second_z is 2
  mailbox.second_active is 1
  mailbox.second_offset is 2560
  mailbox.second_stride is 8
  mailbox.output_offset is 512
  mailbox.composed_pixels is 0
  mailbox.active_surfaces is 0
  mailbox.shared_address is 0
  mailbox.shared_pixels is 0
  mailbox.shared_index is 0
  mailbox.shared_write is 0
  mailbox.shared_original is 0
  mailbox.shared_observed is 0
  index: u64 is 0
  while index < 64 do
    mem.write32(ptr.add(os_window_server_mailbox_transfer, 1536 + index * 4), 287454020)
    mem.write32(ptr.add(os_window_server_mailbox_transfer, 2560 + index * 4), 2864434397)
    index += 1
  end
  return true
end

func os_window_server_ring3_start() do
  global os_window_server_ring3_ready
  if os_window_server_ring3_ready != 0 then return true
  if os_kernel_page_root == 0 then return false

  source: ptr is addr_of(user_window_server_program)
  source_end: ptr is addr_of(user_window_server_program_end)
  if source_end <= source or source_end - source > 16384 then return false

  buffers: ptr[ProcessSpaceBuffers] is os_window_server_process_buffers
  buffers.owned_pages is os_window_server_process_owned_pages
  buffers.owned_capacity is 64
  buffers.mappings is os_window_server_process_mappings
  buffers.mapping_capacity is 2048

  config: ptr[OsUserWorkerConfig] is os_window_server_worker_config
  config.code_address is os_user_worker_code_address
  config.mailbox_address is os_user_worker_mailbox_address
  config.mailbox_bytes is 4096
  config.event_address is os_user_worker_mailbox_address + 4096
  config.stack_top is os_user_worker_stack_top
  config.stack_pages is 4
  config.guard_pages is 1
  config.max_code_bytes is 16384

  worker: ptr[OsUserWorker] is os_window_server_worker
  setup: ptr[OsUserWorkerInit] is os_window_server_worker_init
  setup.space is os_window_server_process_space
  setup.buffers is buffers
  setup.stack is os_window_server_process_stack
  setup.allocator is os_allocator_state
  setup.kernel_root is os_kernel_page_root
  setup.config is config
  setup.source is source
  setup.source_end is source_end
  if not os_user_worker_init(worker, setup) then return false
  page_index: u64 is 0
  while page_index < os_backbuffer_pages do
    virtual_page: u64 is os_window_server_shared_address + page_index * 4096
    physical_page: u64 is os_backbuffer_address + page_index * 4096
    if not process_space_map_shared_page(os_window_server_process_space, virtual_page, physical_page, true, false) then return false
    page_index += 1
  end

  mailbox: ptr[UserWindowServerMailbox] is os_window_server_mailbox_transfer
  if not os_window_server_mailbox_prepare(mailbox) then return false
  if not os_user_worker_copy_to_mailbox(worker, os_window_server_mailbox_transfer, 4096) then return false
  os_window_server_ring3_ready is 1
  return os_serial_cstr_line(os_window_server_ring3_ready_marker)
end

func os_window_server_ring3_dispatch() do
  global os_window_server_ring3_sequence, os_window_server_ring3_result_reported, os_user_app_active_id
  if os_window_server_ring3_ready == 0 or os_user_app_active_id != 0 then return false
  mailbox: ptr[UserWindowServerMailbox] is os_window_server_mailbox_transfer
  os_window_server_ring3_sequence += 1
  if os_window_server_ring3_sequence == 0 then os_window_server_ring3_sequence is 1
  mailbox.request_sequence is os_window_server_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.command is 1
  mailbox.status is 0
  mailbox.error is 0
  mailbox.composed_pixels is 0
  mailbox.active_surfaces is 0
  worker: ptr[OsUserWorker] is os_window_server_worker
  if not os_user_worker_copy_to_mailbox(worker, os_window_server_mailbox_transfer, 4096) then return false
  os_user_app_active_id is 6
  dispatch_status: u64 is os_user_scheduler_dispatch(6, mailbox.request_sequence)
  os_user_app_active_id is 0
  if dispatch_status != 1 then return os_user_process_handle_failure(6, dispatch_status)
  if not os_user_worker_copy_from_mailbox(worker, os_window_server_mailbox_transfer, 4096) then return false
  if mailbox.status != 1 or mailbox.error != 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.active_surfaces != 2 or mailbox.composed_pixels != 256 then return false
  if mem.read32(ptr.add(os_window_server_mailbox_transfer, 512 + (2 * 16 + 2) * 4)) != 287454020 then return false
  if mem.read32(ptr.add(os_window_server_mailbox_transfer, 512 + (5 * 16 + 5) * 4)) != 2864434397 then return false
  if not os_user_process_report_cr3(6) then return false
  if not os_user_process_verify_persistent(6) then return false

  back: ptr[FramebufferSurface] is os_back_surface_state
  if back == 0 or back.pixels == 0 or back.stride == 0 then return false
  expected: u64 is fb_get_pixel(back, 2, 2)
  requested: u64 is expected ^ 16777215
  os_window_server_ring3_sequence += 1
  if os_window_server_ring3_sequence == 0 then os_window_server_ring3_sequence is 1
  mailbox.request_sequence is os_window_server_ring3_sequence
  mailbox.response_sequence is 0
  mailbox.command is 3
  mailbox.status is 0
  mailbox.error is 0
  mailbox.shared_address is os_window_server_shared_address
  mailbox.shared_pixels is os_backbuffer_pages * 1024
  mailbox.shared_index is 2 * back.stride + 2
  mailbox.shared_write is requested
  mailbox.shared_original is 0
  mailbox.shared_observed is 0
  if not os_user_worker_copy_to_mailbox(worker, os_window_server_mailbox_transfer, 4096) then return false
  os_user_app_active_id is 6
  shared_dispatch: u64 is os_user_scheduler_dispatch(6, mailbox.request_sequence)
  os_user_app_active_id is 0
  if shared_dispatch != 1 then return os_user_process_handle_failure(6, shared_dispatch)
  if not os_user_worker_copy_from_mailbox(worker, os_window_server_mailbox_transfer, 4096) then return false
  if mailbox.status != 1 or mailbox.error != 0 or mailbox.response_sequence != mailbox.request_sequence then return false
  if mailbox.shared_original != expected or mailbox.shared_observed != requested then return false
  if fb_get_pixel(back, 2, 2) != expected then return false
  if not os_user_process_verify_persistent(6) then return false
  if not os_serial_cstr_line(os_window_server_shared_marker) then return false
  if os_window_server_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_window_server_ring3_result_marker) then return false
    os_window_server_ring3_result_reported is 1
  end
  return true
end

func os_shell_loop() do
  global os_rtc_reported, os_key_repeat_active
  while true do
    if os_doom_running != 0 then
      doom_poll_count: u64 is 0
      while doom_poll_count < 16 do
        if not os_input_poll_once() then
          os_serial_text(os_shell_loop_failure_prefix)
          os_serial_u64(6)
          serial_write_byte(1016, 10, 1000000)
          return false
        end
        doom_poll_count += 1
      end
      if not os_doom_service() then
        os_serial_text(os_shell_loop_failure_prefix)
        os_serial_u64(7)
        serial_write_byte(1016, 10, 1000000)
        return false
      end
      cpu.pause()
      continue
    end
    value: u64 is serial_read_byte(1016, 1000)
    if value != 65535 then
      if not os_shell_accept(value) then
        os_serial_text(os_shell_loop_failure_prefix)
        os_serial_u64(1)
        serial_write_byte(1016, 10, 1000000)
        return false
      end
    end
    poll_count: u64 is 0
    while poll_count < 16 do
      if not os_input_poll_once() then
        os_serial_text(os_shell_loop_failure_prefix)
        os_serial_u64(2)
        serial_write_byte(1016, 10, 1000000)
        return false
      end
      poll_count += 1
    end
    if not os_key_repeat_poll() then
      os_key_repeat_active is 0
      os_input_recover(4)
    end
    if not os_browser_navigation_service() then
      os_serial_text(os_shell_loop_failure_prefix)
      os_serial_u64(5)
      serial_write_byte(1016, 10, 1000000)
      return false
    end
    clock_status: u64 is os_clock_refresh()
    if clock_status != 0 and os_rtc_reported == 0 then
      if not os_serial_cstr_line(os_rtc_marker) then return false
      os_rtc_reported is 1
    end
    if clock_status == 2 then
      if not os_redraw_desktop() then
        os_serial_text(os_shell_loop_failure_prefix)
        os_serial_u64(4)
        serial_write_byte(1016, 10, 1000000)
        return false
      end
    end
    cpu.pause()
  end
  return true
end

func os_files_complete() do
  global os_directory_reported, os_files_ring3_result_reported
  if os_files_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_files_ring3_result_marker) then os_vm_exit(69)
    os_files_ring3_result_reported is 1
  end
  if os_storage_mounted != 0 then
    if not os_storage_open_selected() then os_vm_exit(70)
    if os_surafs_location_token() != os_files_previous_cluster and os_directory_reported == 0 then
      if not os_serial_cstr_line(os_storage_directory_marker) then os_vm_exit(71)
      os_directory_reported is 1
    end
    if not os_storage_save_settings() then os_vm_exit(72)
  end
  if not os_redraw_desktop() then os_vm_exit(73)
  return true
end

func os_files_user_return() do
  if not os_files_complete() then os_vm_exit(73)
  if not os_shell_loop() then os_vm_exit(74)
  os_vm_exit(75)
  return
end

func os_system_complete() do
  global os_system_ring3_result_reported, os_system_app_reported, os_window_reopen_reported
  if os_system_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_system_ring3_result_marker) then os_vm_exit(99)
    os_system_ring3_result_reported is 1
  end
  if os_system_memory_mib == 0 or os_system_pixel_count == 0 then os_vm_exit(100)
  manager: ptr[WindowManager] is os_window_manager_state
  reopened: u64 is os_activate_window(manager, 2)
  if reopened == 0 then os_vm_exit(101)
  if reopened == 2 and os_window_reopen_reported == 0 then
    if not os_serial_cstr_line(os_window_reopen_marker) then os_vm_exit(102)
    os_window_reopen_reported is 1
  end
  if os_system_app_reported == 0 then
    if not os_serial_cstr_line(os_system_app_marker) then os_vm_exit(103)
    os_system_app_reported is 1
  end
  if not os_redraw_desktop() then os_vm_exit(104)
  return true
end

func os_system_user_return() do
  if not os_system_complete() then os_vm_exit(104)
  if not os_shell_loop() then os_vm_exit(105)
  os_vm_exit(106)
  return
end

func os_terminal_render_input(terminal: ptr[TextTerminal], value: u64) do
  if terminal == 0 then return false
  byte_count: u64 is (value >> 56) & 7
  if byte_count == 0 then return text_terminal_put(terminal, value)
  index: u64 is 0
  while index < byte_count do
    mem.write8(ptr.add(os_text_input_utf8, index), (value >> (index * 8)) & 255)
    index += 1
  end
  return text_terminal_write_utf8(terminal, os_text_input_utf8, byte_count)
end

func os_terminal_report_korean() do
  global os_terminal_korean_input_reported
  if os_terminal_korean_input_reported != 0 or os_shell_length != 15 then return true
  index: u64 is 0
  while index < 15 do
    if mem.read8(ptr.add(os_shell_input, index)) != mem.read8(ptr.add(os_text_terminal_korean_phrase, index)) then
      return true
    end
    index += 1
  end
  if not os_serial_cstr_line(os_terminal_korean_input_marker) then return false
  os_terminal_korean_input_reported is 1
  return true
end

func os_terminal_complete() do
  global os_terminal_ring3_result_reported, os_terminal_scroll_reported, os_terminal_user_action
  terminal: ptr[TextTerminal] is os_terminal_state
  if os_terminal_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_terminal_ring3_result_marker) then os_vm_exit(80)
    os_terminal_ring3_result_reported is 1
  end
  action: u64 is os_terminal_user_action
  os_terminal_user_action is 0
  if action == 1 then
    if not os_terminal_render_input(terminal, os_terminal_user_input) then os_vm_exit(81)
    if not os_terminal_report_korean() then os_vm_exit(81)
    if not os_redraw_terminal() then os_vm_exit(82)
  elif action == 2 then
    if not text_terminal_put(terminal, 8) then os_vm_exit(83)
    if not os_redraw_terminal() then os_vm_exit(84)
  elif action == 3 then
    if not serial_write_byte(1016, 10, 1000000) then os_vm_exit(85)
    if not text_terminal_newline(terminal) then os_vm_exit(86)
    if not os_shell_execute_command(os_terminal_user_command) then os_vm_exit(87)
    if terminal.scroll_count > 0 and os_terminal_scroll_reported == 0 then
      if not os_serial_line(os_terminal_scroll_marker, 26) then os_vm_exit(88)
      os_terminal_scroll_reported is 1
    end
    if not os_serial_text(os_shell_prompt) then os_vm_exit(89)
    if not os_terminal_prompt() then os_vm_exit(90)
    if not os_redraw_terminal() then os_vm_exit(91)
  end
  return true
end

func os_terminal_user_return() do
  if not os_terminal_complete() then os_vm_exit(91)
  if not os_shell_loop() then os_vm_exit(92)
  os_vm_exit(93)
  return
end

func os_editor_complete() do
  global os_editor_input_reported, os_editor_ring3_result_reported, os_korean_input_reported
  if os_editor_ring3_result_reported == 0 then
    if not os_serial_cstr_line(os_editor_ring3_result_marker) then os_vm_exit(58)
    os_editor_ring3_result_reported is 1
  end
  if os_storage_mounted != 0 then
    if not os_storage_save_notes() then os_vm_exit(59)
  end
  if not os_serial_text(os_editor_event_marker) then os_vm_exit(59)
  if not os_serial_u64(os_editor_ring3_sequence) then os_vm_exit(59)
  if not serial_write_byte(1016, 10, 1000000) then os_vm_exit(59)
  if os_editor_input_reported == 0 then
    if not os_serial_cstr_line(os_editor_input_marker) then os_vm_exit(60)
    os_editor_input_reported is 1
  end
  editor: ptr[TextEditorState] is os_text_editor_state
  if os_korean_input_reported == 0 and editor.length >= 6 then
    index: u64 is 0
    while index + 5 < editor.length do
      matches: bool is mem.read8(ptr.add(editor.buffer, index)) == 237
      if matches then matches is mem.read8(ptr.add(editor.buffer, index + 1)) == 149
      if matches then matches is mem.read8(ptr.add(editor.buffer, index + 2)) == 156
      if matches then matches is mem.read8(ptr.add(editor.buffer, index + 3)) == 234
      if matches then matches is mem.read8(ptr.add(editor.buffer, index + 4)) == 184
      if matches then matches is mem.read8(ptr.add(editor.buffer, index + 5)) == 128
      if matches then
        if not os_serial_cstr_line(os_korean_input_marker) then os_vm_exit(107)
        os_korean_input_reported is 1
        index is editor.length
      else
        index += 1
      end
    end
  end
  if not os_redraw_desktop() then os_vm_exit(61)
  return true
end

func os_editor_user_return() do
  if not os_editor_complete() then os_vm_exit(61)
  if not os_shell_loop() then os_vm_exit(62)
  os_vm_exit(63)

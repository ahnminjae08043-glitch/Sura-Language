# The archived 1.10.0 release ZIP is the historical compatibility probe input
# that sura_compatibility_gate.ps1 requires on every platform; its SHA-256 is
# pinned by release-1.10.0.json, so the file is immutable evidence, not output.
!tests/compat/SuraLanguage-1.10.0-windows-x64.zip
dist/
build/
artifacts/
sura.pkg.json
# The stable-API compatibility fixture is a required CI input, not a local
# package artifact; keep it tracked despite the global ignore above.
!tests/compat/api_fixture/sura.pkg.json
sura_walk_*/

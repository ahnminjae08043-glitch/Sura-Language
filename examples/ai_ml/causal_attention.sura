use autograd

# One causal self-attention forward/backward pass.
query is autograd.parameter([[[1, 0], [0.5, 0.5], [0, 1]]])
key is autograd.parameter([[[1, 0], [0, 1], [0.5, 0.5]]])
value is autograd.parameter([[[1, 2], [3, 4], [5, 6]]])

context is autograd.causal_attention(query, key, value)
loss is autograd.mean(context)
autograd.backward(loss)

print("attention shape={autograd.shape(context)}")
print("context={autograd.data(context)}")
print("loss={autograd.item(loss)}")
print("query gradient={autograd.grad(query)}")

assert_eq(autograd.shape(context).join(","), "1,3,2")

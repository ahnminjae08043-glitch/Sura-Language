use media
use os
use console

if os.argc() < 1 then
  throw "usage: sura examples/video_to_text.sura <video-file>"
end

if not media.available() then
  throw "FFmpeg was not found; install it or set SURA_FFMPEG"
end

clip is media.ascii_frames(os.argv()[0], {width: 80, fps: 8, max_frames: 240, charset: " .:-=+*#%@", dither: true})

delay_ms is 1000 / clip.fps
for frame in clip.frames do
  console.clear()
  console.raw(frame)
  console.raw("\n")
  wait(delay_ms)
end

print("played {clip.frame_count} text frames")

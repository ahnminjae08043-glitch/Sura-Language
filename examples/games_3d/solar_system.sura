# Perspective solar system model. Space pauses, Q/Escape quits.

SMOKE is argc() > 0 and argv()[0] == "--smoke"
W is 820
H is 560
if not win_init(W, H, "Sura Solar System 3D") then
  print("win_init failed")
  exit(1)
end

names is ["Mercury", "Venus", "Earth", "Mars", "Jupiter"]
orbit is [55, 85, 120, 160, 220]
speed is [0.047, 0.035, 0.028, 0.022, 0.012]
sizes is [4, 7, 8, 6, 16]
red is [180, 235, 70, 225, 220]
green is [175, 180, 150, 90, 165]
blue is [165, 80, 255, 60, 105]
time is 0
paused is false
frame is 0
running is true

func project(x, y, z) do
  depth is z + 520
  return {x: W / 2 + x * 430 / depth, y: H / 2 + y * 430 / depth, scale: 430 / depth}
end

while running do
  frame += 1
  if key_down("q") or key_down("escape") then running is false
  if key_down("space") then paused is true
  if SMOKE then paused is false
  if not paused then time += 1

  win_clear(2, 3, 13)
  star is 0
  while star < 70 do
    x is (star * 97) % W
    y is (star * 53) % H
    win_rect(x, y, 1, 1, 100 + star % 120, 110 + star % 110, 170 + star % 80)
    star += 1
  end
  sun is project(0, 0, 0)
  win_circle(sun.x, sun.y, 30, 255, 195, 45)

  i is 0
  while i < names.len() do
    a is time * speed[i] + i * 0.9
    wx is cos(a) * orbit[i]
    wz is sin(a) * orbit[i]
    wy is sin(a) * orbit[i] * 0.24
    planet is project(wx, wy, wz)
    radius is sizes[i] * planet.scale
    if radius < 3 then radius is 3
    win_line(sun.x, sun.y, planet.x, planet.y, 28, 38, 65)
    win_circle(planet.x, planet.y, radius, red[i], green[i], blue[i])
    if i == 2 then win_text("Earth", planet.x + 10, planet.y - 12, 130, 200, 255)
    i += 1
  end
  win_text("SOLAR SYSTEM 3D", 18, 16, 225, 235, 255)
  if paused then win_text("PAUSED", 18, 42, 255, 210, 90)
  if not win_update() then running is false
  if SMOKE and frame >= 12 then running is false
  wait(16)
end

win_close()
print("solar_system: frames={frame}, time={time}")
assert(frame > 0)

# This file exercises compiler features needed by future kernel and driver
# code. It is a UEFI application test, not a complete operating system.

import "support/freestanding_helpers.sura"
import "support/freestanding_constants.sura"

struct PciConfigHeader packed do
  vendor_id: u16
  device_id: u16
  command: u16
  status: u16
  revision: u8
  class_code: u8
end

struct InterruptFrame packed do
  r15: u64
  r14: u64
  r13: u64
  r12: u64
  r11: u64
  r10: u64
  r9: u64
  r8: u64
  rdi: u64
  rsi: u64
  rbp: u64
  rbx: u64
  rdx: u64
  rcx: u64
  rax: u64
  error_code: u64
  rip: u64
  cs: u64
  rflags: u64
  interrupted_rsp: u64
  ss: u64
end

boot_counter: u64 is 0
timer_ticks: u64 is 0
last_fault_error: u64 is 0
saved_context_rsp: u64 is 0
pci_header is static.struct(PciConfigHeader)
page_buffer is static.zero(4096, 4096)
idt_table is static.zero(4096, 16)
gdt_table is static.zero(128, 16)
tss_state is static.zero(104, 16)
kernel_stack is static.zero(4096, 16)
fault_stack is static.zero(4096, 16)
fpu_state is static.zero(4096, 64)
percpu_state is static.zero(256, 64)
task_stack is static.zero(4096, 16)
interrupt_stub is static.bytes([250, 244, 235, 252], 16)
driver_name is static.utf8("sura-device")

func add_pair(left: u64, right: u64) -> u64 do
  return left + right
end

func identity(value: u64) -> u64 do
  return value
end

func context_task_entry(argument: u64) -> u64 do
  return argument + 1
end

func context_task_exit(result: u64) do
  return
end

func timer_interrupt(frame: ptr[InterruptFrame]) interrupt do
  atomic.fetch_add64(addr_of(timer_ticks), 1)
  return
end

func page_fault_interrupt(frame: ptr[InterruptFrame]) interrupt_error do
  global last_fault_error
  last_fault_error is frame.error_code
  return
end

func efi_main(image_handle: u64, system_table: ptr) -> u64 do
  global boot_counter
  boot_counter += 1

  header: ptr[PciConfigHeader] is pci_header
  header.command is 7
  vendor: u16 is header.vendor_id

  old_count: u64 is atomic.fetch_add64(addr_of(boot_counter), 1)
  cpu_leaf: u32 is cpu.cpuid_eax(0)
  nested: u64 is add_pair(1, identity(2))
  imported_value: u64 is os_feature_mix(1, 2)
  header_bytes: usize is sizeof(PciConfigHeader)
  command_offset: usize is offset_of(PciConfigHeader, command)
  second_header: ptr is ptr.index(pci_header, 1, header_bytes)

  cpu.idt_set_gate(idt_table, 32, addr_of(timer_interrupt), 8, 0, 142)
  cpu.idt_set_gate(idt_table, 14, addr_of(page_fault_interrupt), 8, 0, 142)
  cpu.tss_set_rsp(tss_state, 0, ptr.add(kernel_stack, 4096))
  cpu.tss_set_ist(tss_state, 1, ptr.add(fault_stack, 4096))
  cpu.tss_set_iomap(tss_state, 104)
  cpu.gdt_set_tss(gdt_table, 3, tss_state, 103)

  if vendor == 0 and old_count >= 0 and cpu_leaf >= 0 and nested == 3 and imported_value == 7 and command_offset == 4 and second_header > 0 then
    atomic.fence()
  end

  # These instructions are emitted for compiler verification but deliberately
  # not executed by this UEFI feature test. A future kernel integration step
  # will provide valid code/data descriptors and CPU feature policy first.
  if 0 == 1 then
    cpu.load_gdt(gdt_table, 128)
    cpu.reload_segments(8, 16)
    cpu.load_idt(idt_table, 4096)
    cpu.load_task_register(24)
    cpu.fninit()
    cpu.fxsave(fpu_state)
    cpu.fxrstor(fpu_state)
    cpu.xsetbv(0, 7)
    cpu.xsave(fpu_state, 7)
    cpu.xrstor(fpu_state, 7)
    cpu.stac()
    cpu.clac()
    cpu.swapgs()
    cpu.wbinvd()

    percpu.set_base(percpu_state)
    percpu.set_kernel_base(percpu_state)
    percpu.write64(0, apic.current_id())
    current_cpu: u64 is percpu.read64(0)
    current_cpu_address: ptr is percpu.address(0)
    apic_mode: u64 is apic.mode()
    apic_base: ptr is apic.base()
    apic_id_register: u64 is apic.read(32)
    icr_pending: bool is apic.icr_busy()
    apic.write(240, 511)
    apic.eoi()
    apic.send_ipi(1, 64)
    apic.send_init(1)
    apic.send_startup(1, 32768)

    virtual_address: u64 is u64("0xffff800012345678")
    pml4_slot: u64 is paging.pml4_index(virtual_address)
    pdpt_slot: u64 is paging.pdpt_index(virtual_address)
    pd_slot: u64 is paging.pd_index(virtual_address)
    pt_slot: u64 is paging.pt_index(virtual_address)
    page_offset: u64 is paging.offset(virtual_address)
    canonical: bool is paging.is_canonical48(virtual_address)
    page_entry: u64 is paging.entry(page_buffer, 3)
    mapped_address: ptr is paging.entry_address(page_entry)
    entry_flags: u64 is paging.entry_flags(page_entry)
    entry_present: bool is paging.present(page_entry)
    large_page: bool is paging.large(page_entry)
    paging.write(page_buffer, 1, page_entry)
    stored_entry: u64 is paging.read(page_buffer, 1)
    paging.map(page_buffer, 2, page_buffer, 3)
    paging.clear(page_buffer, 2)
    active_root: ptr is paging.root()
    paging.activate(page_buffer)
    paging.invalidate(virtual_address)
    paging.flush()

    context_bytes: usize is context.frame_size()
    initial_context_rsp: ptr is context.init(ptr.add(task_stack, 4096), addr_of(context_task_entry), 7, addr_of(context_task_exit))
    context.switch(addr_of(saved_context_rsp), initial_context_rsp)
  end

  return 0
end

# Window focus, z-order, hit-test, drag, resize, minimize, maximize,
# fullscreen, close, and boundary coverage.

import "../../stdlib/freestanding/window_manager.sura"

window_manager_state is static.struct(WindowManager)
window_storage is static.struct(DesktopWindow, 4)

func efi_main(image_handle: u64, system_table: ptr) -> u64 do
  uefi.write("Sura window manager feature test")
  uefi.newline()
  manager: ptr[WindowManager] is window_manager_state
  if not window_manager_init(manager, window_storage, 4, 800, 600, 48) then return 1
  if not window_manager_add(manager, 1, 80, 80, 420, 280) then return 2
  if not window_manager_add(manager, 2, 180, 140, 360, 240) then return 3
  if not window_manager_focus(manager, 2) then return 4
  top: ptr[DesktopWindow] is window_manager_top_at(manager, 200, 160)
  if top == 0 or top.id != 2 then return 5

  if window_manager_pointer_press(manager, 100, 92) != 1 then return 6
  if manager.active_id != 1 or manager.dragging_id != 1 then return 7
  if not window_manager_pointer_move(manager, -100, -100, 1) then return 8
  first: ptr[DesktopWindow] is window_manager_find(manager, 1)
  if first.x != 0 or first.y != 0 then return 9
  window_manager_pointer_release(manager)

  if window_manager_pointer_press(manager, 410, 10) != 1 then return 10
  if manager.last_closed_id != 1 or first.visible != 0 then return 11
  if manager.active_id != 2 then return 12
  if not window_manager_show(manager, 1) then return 13
  if first.visible == 0 or manager.active_id != 1 or manager.count != 2 then return 14
  if not window_manager_close(manager, 1) then return 15

  second: ptr[DesktopWindow] is window_manager_find(manager, 2)
  window_manager_pointer_press(manager, 200, 150)
  window_manager_pointer_move(manager, 2000, 2000, 1)
  window_manager_pointer_release(manager)
  if second.x != 440 or second.y != 312 then return 16

  # Bottom-right interactive resize remains inside the work area.
  if not window_manager_restore(manager, 2) then return 17
  second.x is 180
  second.y is 140
  second.width is 360
  second.height is 240
  if window_manager_pointer_press(manager, 535, 375) != 2 then return 18
  if manager.resizing_id != 2 then return 19
  if not window_manager_pointer_move(manager, 700, 500, 1) then return 20
  window_manager_pointer_release(manager)
  if second.width != 521 or second.height != 361 then return 21

  if not window_manager_minimize(manager, 2) then return 22
  if second.visible != 0 or second.state != window_state_minimized() then return 23
  if not window_manager_show(manager, 2) then return 24
  if second.visible == 0 or second.state != window_state_normal() then return 25

  original_x: i64 is second.x
  original_y: i64 is second.y
  original_width: u64 is second.width
  original_height: u64 is second.height
  if not window_manager_maximize(manager, 2) then return 26
  if second.x != 0 or second.y != 0 or second.width != 800 or second.height != 552 then return 27
  if second.state != window_state_maximized() then return 28
  if not window_manager_restore(manager, 2) then return 29
  if second.x != original_x or second.y != original_y then return 30
  if second.width != original_width or second.height != original_height then return 31

  if not window_manager_fullscreen(manager, 2) then return 32
  if second.width != 800 or second.height != 600 or second.state != window_state_fullscreen() then return 33
  if not window_manager_toggle_fullscreen(manager, 2) then return 34
  if second.state != window_state_normal() or second.height != original_height then return 35
  return 0
end

# SuraOS public constants.
#
# The project deliberately keeps constants in ordinary Sura values instead of
# relying on native headers.  Every subsystem can therefore be loaded and
# tested by the stock Sura runtime.

SURAOS_NAME is "SuraOS"
SURAOS_VERSION is "0.1.0"
SURAOS_CODENAME is "Aurora"
SURAOS_ARCH is "SVM32"
SURAOS_DISK_SCHEMA is "sura.os.disk.v1"
SURAOS_SNAPSHOT_SCHEMA is "sura.os.snapshot.v1"
SURAOS_EXEC_SCHEMA is "sura.os.executable.v1"
SURAOS_DEFAULT_MEMORY is 65536
SURAOS_DEFAULT_QUANTUM is 24
SURAOS_DEFAULT_STACK is 1024
SURAOS_MAX_PROCESSES is 128
SURAOS_MAX_OPEN_FILES is 64
SURAOS_MAX_PATH is 256
SURAOS_MAX_FILE_BYTES is 1048576
SURAOS_MAX_STEPS_PER_RUN is 100000

SURAOS_MODE_USER is "USER"
SURAOS_MODE_KERNEL is "KERNEL"

SURAOS_LOG_TRACE is "TRACE"
SURAOS_LOG_DEBUG is "DEBUG"
SURAOS_LOG_INFO is "INFO"
SURAOS_LOG_WARN is "WARN"
SURAOS_LOG_ERROR is "ERROR"
SURAOS_LOG_FATAL is "FATAL"

SURAOS_PROCESS_NEW is "NEW"
SURAOS_PROCESS_READY is "READY"
SURAOS_PROCESS_RUNNING is "RUNNING"
SURAOS_PROCESS_WAITING is "WAITING"
SURAOS_PROCESS_STOPPED is "STOPPED"
SURAOS_PROCESS_TERMINATED is "TERMINATED"
SURAOS_PROCESS_ZOMBIE is "ZOMBIE"

SURAOS_SIGNAL_TERM is 1
SURAOS_SIGNAL_KILL is 2
SURAOS_SIGNAL_STOP is 3
SURAOS_SIGNAL_CONT is 4
SURAOS_SIGNAL_CHILD is 5

SURAOS_ERR_OK is 0
SURAOS_ERR_GENERIC is -1
SURAOS_ERR_NOT_FOUND is -2
SURAOS_ERR_PERMISSION is -3
SURAOS_ERR_INVALID is -4
SURAOS_ERR_NO_MEMORY is -5
SURAOS_ERR_BUSY is -6
SURAOS_ERR_EXISTS is -7
SURAOS_ERR_NOT_DIR is -8
SURAOS_ERR_IS_DIR is -9
SURAOS_ERR_BAD_FD is -10
SURAOS_ERR_LIMIT is -11
SURAOS_ERR_IO is -12
SURAOS_ERR_TIMEOUT is -13
SURAOS_ERR_FAULT is -14
SURAOS_ERR_NO_CHILD is -15

SURAOS_PERM_READ is 4
SURAOS_PERM_WRITE is 2
SURAOS_PERM_EXEC is 1
SURAOS_PERM_DEFAULT_FILE is 6
SURAOS_PERM_DEFAULT_DIR is 7

SURAOS_NODE_FILE is "file"
SURAOS_NODE_DIR is "directory"
SURAOS_NODE_DEVICE is "device"
SURAOS_NODE_LINK is "link"

SURAOS_SEEK_SET is 0
SURAOS_SEEK_CURRENT is 1
SURAOS_SEEK_END is 2

SURAOS_OPEN_READ is "r"
SURAOS_OPEN_WRITE is "w"
SURAOS_OPEN_APPEND is "a"
SURAOS_OPEN_READ_WRITE is "rw"

SURAOS_SYSCALL_EXIT is 0
SURAOS_SYSCALL_PRINT is 1
SURAOS_SYSCALL_PRINT_NUMBER is 2
SURAOS_SYSCALL_GET_PID is 3
SURAOS_SYSCALL_SLEEP is 4
SURAOS_SYSCALL_YIELD is 5
SURAOS_SYSCALL_OPEN is 6
SURAOS_SYSCALL_READ is 7
SURAOS_SYSCALL_WRITE is 8
SURAOS_SYSCALL_CLOSE is 9
SURAOS_SYSCALL_SPAWN is 10
SURAOS_SYSCALL_WAIT is 11
SURAOS_SYSCALL_ALLOC is 12
SURAOS_SYSCALL_FREE is 13
SURAOS_SYSCALL_GET_TIME is 14
SURAOS_SYSCALL_SEND is 15
SURAOS_SYSCALL_RECEIVE is 16
SURAOS_SYSCALL_LIST_DIR is 17
SURAOS_SYSCALL_GET_USER is 18
SURAOS_SYSCALL_RANDOM is 19

SURAOS_OPCODE_NOP is "NOP"
SURAOS_OPCODE_MOV is "MOV"
SURAOS_OPCODE_MOVI is "MOVI"
SURAOS_OPCODE_LOAD is "LOAD"
SURAOS_OPCODE_STORE is "STORE"
SURAOS_OPCODE_ADD is "ADD"
SURAOS_OPCODE_ADDI is "ADDI"
SURAOS_OPCODE_SUB is "SUB"
SURAOS_OPCODE_SUBI is "SUBI"
SURAOS_OPCODE_MUL is "MUL"
SURAOS_OPCODE_DIV is "DIV"
SURAOS_OPCODE_MOD is "MOD"
SURAOS_OPCODE_AND is "AND"
SURAOS_OPCODE_OR is "OR"
SURAOS_OPCODE_XOR is "XOR"
SURAOS_OPCODE_NOT is "NOT"
SURAOS_OPCODE_SHL is "SHL"
SURAOS_OPCODE_SHR is "SHR"
SURAOS_OPCODE_INC is "INC"
SURAOS_OPCODE_DEC is "DEC"
SURAOS_OPCODE_CMP is "CMP"
SURAOS_OPCODE_JMP is "JMP"
SURAOS_OPCODE_JZ is "JZ"
SURAOS_OPCODE_JNZ is "JNZ"
SURAOS_OPCODE_JG is "JG"
SURAOS_OPCODE_JGE is "JGE"
SURAOS_OPCODE_JL is "JL"
SURAOS_OPCODE_JLE is "JLE"
SURAOS_OPCODE_PUSH is "PUSH"
SURAOS_OPCODE_POP is "POP"
SURAOS_OPCODE_CALL is "CALL"
SURAOS_OPCODE_RET is "RET"
SURAOS_OPCODE_SYSCALL is "SYSCALL"
SURAOS_OPCODE_HALT is "HALT"
SURAOS_OPCODE_TRAP is "TRAP"

SURAOS_REGISTER_NAMES is ["R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "PC", "SP", "BP"]
SURAOS_GENERAL_REGISTERS is ["R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7"]

func suraos_error_name(code) do
  if code == SURAOS_ERR_OK then return "OK"
  if code == SURAOS_ERR_GENERIC then return "GENERIC"
  if code == SURAOS_ERR_NOT_FOUND then return "NOT_FOUND"
  if code == SURAOS_ERR_PERMISSION then return "PERMISSION"
  if code == SURAOS_ERR_INVALID then return "INVALID"
  if code == SURAOS_ERR_NO_MEMORY then return "NO_MEMORY"
  if code == SURAOS_ERR_BUSY then return "BUSY"
  if code == SURAOS_ERR_EXISTS then return "EXISTS"
  if code == SURAOS_ERR_NOT_DIR then return "NOT_DIRECTORY"
  if code == SURAOS_ERR_IS_DIR then return "IS_DIRECTORY"
  if code == SURAOS_ERR_BAD_FD then return "BAD_FILE_DESCRIPTOR"
  if code == SURAOS_ERR_LIMIT then return "LIMIT"
  if code == SURAOS_ERR_IO then return "IO"
  if code == SURAOS_ERR_TIMEOUT then return "TIMEOUT"
  if code == SURAOS_ERR_FAULT then return "FAULT"
  if code == SURAOS_ERR_NO_CHILD then return "NO_CHILD"
  return "UNKNOWN_ERROR"
end

func suraos_process_is_alive(state) do
  return state != SURAOS_PROCESS_TERMINATED and state != SURAOS_PROCESS_ZOMBIE
end

func suraos_process_is_runnable(state) do
  return state == SURAOS_PROCESS_READY or state == SURAOS_PROCESS_RUNNING
end

func suraos_register_valid(name) do
  return SURAOS_REGISTER_NAMES.contains(name.upper())
end

func suraos_opcode_valid(name) do
  op is name.upper()
  valid is [SURAOS_OPCODE_NOP, SURAOS_OPCODE_MOV, SURAOS_OPCODE_MOVI, SURAOS_OPCODE_LOAD, SURAOS_OPCODE_STORE, SURAOS_OPCODE_ADD, SURAOS_OPCODE_ADDI, SURAOS_OPCODE_SUB, SURAOS_OPCODE_SUBI, SURAOS_OPCODE_MUL, SURAOS_OPCODE_DIV, SURAOS_OPCODE_MOD, SURAOS_OPCODE_AND, SURAOS_OPCODE_OR, SURAOS_OPCODE_XOR, SURAOS_OPCODE_NOT, SURAOS_OPCODE_SHL, SURAOS_OPCODE_SHR, SURAOS_OPCODE_INC, SURAOS_OPCODE_DEC, SURAOS_OPCODE_CMP, SURAOS_OPCODE_JMP, SURAOS_OPCODE_JZ, SURAOS_OPCODE_JNZ, SURAOS_OPCODE_JG, SURAOS_OPCODE_JGE, SURAOS_OPCODE_JL, SURAOS_OPCODE_JLE, SURAOS_OPCODE_PUSH, SURAOS_OPCODE_POP, SURAOS_OPCODE_CALL, SURAOS_OPCODE_RET, SURAOS_OPCODE_SYSCALL, SURAOS_OPCODE_HALT, SURAOS_OPCODE_TRAP]
  return valid.contains(op)
end

func suraos_syscall_number(name) do
  upper is name.upper()
  if upper == "EXIT" then return SURAOS_SYSCALL_EXIT
  if upper == "PRINT" then return SURAOS_SYSCALL_PRINT
  if upper == "PRINT_NUMBER" then return SURAOS_SYSCALL_PRINT_NUMBER
  if upper == "GET_PID" then return SURAOS_SYSCALL_GET_PID
  if upper == "SLEEP" then return SURAOS_SYSCALL_SLEEP
  if upper == "YIELD" then return SURAOS_SYSCALL_YIELD
  if upper == "OPEN" then return SURAOS_SYSCALL_OPEN
  if upper == "READ" then return SURAOS_SYSCALL_READ
  if upper == "WRITE" then return SURAOS_SYSCALL_WRITE
  if upper == "CLOSE" then return SURAOS_SYSCALL_CLOSE
  if upper == "SPAWN" then return SURAOS_SYSCALL_SPAWN
  if upper == "WAIT" then return SURAOS_SYSCALL_WAIT
  if upper == "ALLOC" then return SURAOS_SYSCALL_ALLOC
  if upper == "FREE" then return SURAOS_SYSCALL_FREE
  if upper == "GET_TIME" then return SURAOS_SYSCALL_GET_TIME
  if upper == "SEND" then return SURAOS_SYSCALL_SEND
  if upper == "RECEIVE" then return SURAOS_SYSCALL_RECEIVE
  if upper == "LIST_DIR" then return SURAOS_SYSCALL_LIST_DIR
  if upper == "GET_USER" then return SURAOS_SYSCALL_GET_USER
  if upper == "RANDOM" then return SURAOS_SYSCALL_RANDOM
  return -1
end

func suraos_syscall_name(number) do
  if number == SURAOS_SYSCALL_EXIT then return "EXIT"
  if number == SURAOS_SYSCALL_PRINT then return "PRINT"
  if number == SURAOS_SYSCALL_PRINT_NUMBER then return "PRINT_NUMBER"
  if number == SURAOS_SYSCALL_GET_PID then return "GET_PID"
  if number == SURAOS_SYSCALL_SLEEP then return "SLEEP"
  if number == SURAOS_SYSCALL_YIELD then return "YIELD"
  if number == SURAOS_SYSCALL_OPEN then return "OPEN"
  if number == SURAOS_SYSCALL_READ then return "READ"
  if number == SURAOS_SYSCALL_WRITE then return "WRITE"
  if number == SURAOS_SYSCALL_CLOSE then return "CLOSE"
  if number == SURAOS_SYSCALL_SPAWN then return "SPAWN"
  if number == SURAOS_SYSCALL_WAIT then return "WAIT"
  if number == SURAOS_SYSCALL_ALLOC then return "ALLOC"
  if number == SURAOS_SYSCALL_FREE then return "FREE"
  if number == SURAOS_SYSCALL_GET_TIME then return "GET_TIME"
  if number == SURAOS_SYSCALL_SEND then return "SEND"
  if number == SURAOS_SYSCALL_RECEIVE then return "RECEIVE"
  if number == SURAOS_SYSCALL_LIST_DIR then return "LIST_DIR"
  if number == SURAOS_SYSCALL_GET_USER then return "GET_USER"
  if number == SURAOS_SYSCALL_RANDOM then return "RANDOM"
  return "UNKNOWN"
end

func suraos_banner() do
  return "{SURAOS_NAME} {SURAOS_VERSION} ({SURAOS_CODENAME}) {SURAOS_ARCH}"
end

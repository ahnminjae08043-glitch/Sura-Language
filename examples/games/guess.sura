// ================================
// 수라 숫자 맞추기 게임
// ================================

random 1 ~ 100 target
count is 0

cls
print "=============================="
print " 숫자 맞추기 게임! (1 ~ 100)"
print "=============================="
print

while 1 do
    input "숫자 입력: " guess
    count + 1

    if guess < target then print "더 큰 숫자입니다!"
    if guess > target then print "더 작은 숫자입니다!"

    if guess == target then
        print
        print "=============================="
        print "정답!"
        print "시도 횟수: " + count
        print "=============================="
        break
    end
end

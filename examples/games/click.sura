// ================================
// 수라 엔진: 마우스 & 이미지 테스트
// ================================

win_init 800 600 "수라 마우스 트래킹 시스템"

print "마우스를 움직여보세요! 좌클릭하면 이미지가 커집니다."
print "종료하려면 Q를 누르세요."

while 1 do
    win_clear 40 40 50

    // 종료 키 확인
    key_down "q" k_q
    if k_q then break

    // 1. 마우스 위치 가져오기
    mouse_pos mx my

    // 2. 마우스 왼쪽 버튼 클릭 확인
    mouse_down "left" m_click

    // 3. 클릭 여부에 따라 이미지 크기 다르게 하기
    if m_click then
        size is 150
    else
        size is 80
    end

    // 4. 마우스 위치(mx, my)에 진짜 이미지 그리기!
    img_x is mx - (size / 2)
    img_y is my - (size / 2)
    
    // player.png 파일이 폴더에 있어야 합니다!
    win_image "player.png" img_x img_y size size

    win_update
    sleep 16
end

// ================================
// 수라 엔진: 업그레이드 바운스볼
// ================================

win_init 800 600 "수라 바운스볼: 별을 찾아라!"

// 공 설정
px is 100
py is 450
vy is 0
speed is 7

// 게임 상태
is_running is 1

print "게임 시작! [A, D] 이동 / [Q] 종료"

while is_running do
    // 1. 화면 초기화 (진한 남색 배경)
    win_clear 20 20 40

    // 2. 입력 처리
    key_down "a" k_a
    key_down "d" k_d
    key_down "q" k_q
    if k_q then break

    if k_a then px - speed
    if k_d then px + speed

    // 3. 물리 엔진 (중력)
    vy + 1
    py + vy

    // 4. 충돌 체크 (바닥)
    if py > 530 then
        py is 530
        vy is -20  // 튕겨오르기
    end

    // 5. 발판들 그리기 및 충돌 체크
    // 발판 1
    win_rect 300 400 150 20 100 200 100
    if px > 280 and px < 450 then
        if py > 380 and py < 400 then
            if vy > 0 then
                py is 380
                vy is -20
            end
        end
    end

    // 발판 2 (높은 곳)
    win_rect 550 250 150 20 100 200 100
    if px > 530 and px < 700 then
        if py > 230 and py < 250 then
            if vy > 0 then
                py is 230
                vy is -20
            end
        end
    end

    // 6. 목표지점 (황금 별)
    win_rect 600 150 40 40 255 215 0
    if px > 580 and px < 640 then
        if py > 130 and py < 190 then
            print "성공! 황금 별을 찾았습니다!"
            is_running is 0
        end
    end

    // 7. 공 그리기
    win_rect px py 25 25 255 100 100

    // 화면 업데이트
    win_update
    sleep 16
end

print "게임 종료"

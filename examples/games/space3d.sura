# ============================================================
#  수라 스타블라스터 3D  v1.0
#  3D 원근 투영 우주 슈팅 게임
#
#  조작법:
#    W / S     조준 위 / 아래
#    A / D     조준 왼쪽 / 오른쪽
#    F         발사!
#    Q         종료
# ============================================================

# ── ANSI 이스케이프 코드 ──────────────────────────────────
file_write_bytes("_esc_tmp.dat", [27])
ESC is file_read("_esc_tmp.dat")
file_delete("_esc_tmp.dat")

CLR  is ESC + "[2J" + ESC + "[H"
RST  is ESC + "[0m"
BOLD is ESC + "[1m"
RED  is ESC + "[91m"
GRN  is ESC + "[92m"
YLW  is ESC + "[93m"
CYN  is ESC + "[96m"
MGN  is ESC + "[95m"
WHT  is ESC + "[97m"
DIM  is ESC + "[2m"
BLD_RED is ESC + "[1;91m"
BLD_CYN is ESC + "[1;96m"

# ── 화면 / 카메라 상수 ────────────────────────────────────
SW is 80        # 화면 너비 (열 수)
SH is 18        # 3D 뷰 높이 (행 수)

CAM_POS    is [0, 1, -5]    # 카메라 위치
CAM_TARGET is [0, 0, 20]    # 카메라가 바라보는 점
CAM_FOV    is 75            # 시야각 (도)

# ── 별 배경 (3D 좌표) ─────────────────────────────────────
NUM_STARS is 80
sx is []
sy is []
sz is []

si is 0
while si < NUM_STARS do
    push(sx, random(-95, 95))
    push(sy, random(-60, 60))
    push(sz, random(3, 88))
    si is si + 1
end

# ── 적 함선 ───────────────────────────────────────────────
MAX_EI is 8
ex is []
ey is []
ez is []
ehp is []
ealive is []

# 슬롯 미리 확보
j is 0
while j < MAX_EI do
    push(ex, 0)
    push(ey, 0)
    push(ez, 60)
    push(ehp, 1)
    push(ealive, 0)
    j is j + 1
end

# ── 플레이어 상태 (딕셔너리) ─────────────────────────────
player is {}
player["hp"]      is 100
player["max_hp"]  is 100
player["score"]   is 0
player["wave"]    is 1
player["cx"]      is 40    # 조준 화면 X (0..SW-1)
player["cy"]      is 9     # 조준 화면 Y (0..SH-1)
player["e_spd"]   is 2     # 적 이동 속도
player["msg"]     is "게임 시작! 적 함선을 격추하라!"
player["atk_msg"] is ""

# ── 헬퍼 함수 ─────────────────────────────────────────────

# 화면 버퍼의 pos 위치에 문자 ch 쓰기
func set_char(s, pos, ch) do
    if pos < 0 then
        return s
    end
    if pos >= SW then
        return s
    end
    return substring(s, 0, pos) + ch + substring(s, pos + 1, SW)
end

# HP 바 문자열 생성
func hp_bar(cur, mx, bw) do
    filled is floor(cur * bw / mx)
    if filled < 0 then filled is 0
    if filled > bw then filled is bw
    bar is ""
    i is 0
    while i < bw do
        if i < filled then
            bar is bar + "="
        else
            bar is bar + "."
        end
        i is i + 1
    end
    return bar
end

# 살아있는 적 수 반환
func alive_count() do
    cnt is 0
    j is 0
    while j < MAX_EI do
        if ealive[j] == 1 then
            cnt is cnt + 1
        end
        j is j + 1
    end
    return cnt
end

# ── 게임 로직 함수 ────────────────────────────────────────

# 웨이브 적 재배치 (인덱스 할당)
func reset_enemies() do
    w is player["wave"]
    j is 0
    while j < MAX_EI do
        ex[j]     is random(-40, 40)
        ey[j]     is random(-24, 14)
        ez[j]     is random(38, 58) + w * 8
        ehp[j]    is floor(w / 2) + 1
        ealive[j] is 1
        j is j + 1
    end
end

# 별 한 단계 이동 (속도감 연출)
func step_stars() do
    si is 0
    while si < NUM_STARS do
        sz[si] is sz[si] - 0.4
        if sz[si] < 1 then
            sz[si] is 88
            sx[si] is random(-95, 95)
            sy[si] is random(-60, 60)
        end
        si is si + 1
    end
end

# 적 함선 이동 및 공격 처리
func step_enemies() do
    spd is player["e_spd"]
    total_dmg is 0
    ei is 0
    while ei < MAX_EI do
        if ealive[ei] == 1 then
            ez[ei] is ez[ei] - spd
            if ez[ei] < 2 then
                # 플레이어에게 도달 → 충돌 데미지
                dmg is 8 + player["wave"] * 3 + random(0, 8)
                player["hp"] is player["hp"] - dmg
                ealive[ei] is 0
                total_dmg is total_dmg + dmg
            end
        end
        ei is ei + 1
    end
    return total_dmg
end

# 발사 처리 (화면 좌표 기준 가장 가까운 적 격추)
func fire() do
    cam is {position: CAM_POS, target: CAM_TARGET, fov_deg: CAM_FOV}
    cx is player["cx"]
    cy is player["cy"]

    best_ei is -1
    best_d  is 99999

    ei is 0
    while ei < MAX_EI do
        if ealive[ei] == 1 then
            eproj is camera_project([ex[ei], ey[ei], ez[ei]], cam, SW, SH)
            if eproj.visible then
                dx is eproj.x - cx
                dy is eproj.y - cy
                d  is sqrt(dx * dx + dy * dy)
                if d < best_d then
                    best_d  is d
                    best_ei is ei
                end
            end
        end
        ei is ei + 1
    end

    if best_ei == -1 then
        return "빗나감! 조준 범위 내에 적 없음"
    end
    if best_d > 12 then
        return "빗나감! 거리 " + floor(best_d) + "px  (12px 이내로 조준하세요)"
    end

    # 명중!
    ehp[best_ei] is ehp[best_ei] - 1
    if ehp[best_ei] <= 0 then
        ealive[best_ei] is 0
        bonus is 100 + player["wave"] * 25
        player["score"] is player["score"] + bonus
        return "격추! +" + bonus + "점  (잔적: " + alive_count() + "대)"
    else
        return "명중! 적 잔여HP: " + ehp[best_ei]
    end
end

# ── 3D 렌더링 ─────────────────────────────────────────────

func render() do
    cam is {position: CAM_POS, target: CAM_TARGET, fov_deg: CAM_FOV}

    # 화면 버퍼 초기화 (각 행 = SW 개 공백)
    rows is []
    r is 0
    while r < SH do
        push(rows, string_repeat(" ", SW))
        r is r + 1
    end

    # ── 1) 별 렌더링 ─────────────────────────────────────
    si is 0
    while si < NUM_STARS do
        proj is camera_project([sx[si], sy[si], sz[si]], cam, SW, SH)
        if proj.visible then
            px is floor(proj.x)
            py is floor(proj.y)
            if px >= 0 and px < SW and py >= 0 and py < SH then
                d is proj.depth
                if d > 58 then
                    rows[py] is set_char(rows[py], px, ".")
                elif d > 38 then
                    rows[py] is set_char(rows[py], px, "+")
                else
                    rows[py] is set_char(rows[py], px, "*")
                end
            end
        end
        si is si + 1
    end

    # ── 2) 적 함선 렌더링 (거리별 크기 변화) ────────────
    ei is 0
    while ei < MAX_EI do
        if ealive[ei] == 1 then
            proj is camera_project([ex[ei], ey[ei], ez[ei]], cam, SW, SH)
            if proj.visible then
                px is floor(proj.x)
                py is floor(proj.y)
                d  is proj.depth

                if px >= 0 and px < SW and py >= 0 and py < SH then

                    if d > 50 then
                        # 아주 먼 적 — 점 1개
                        rows[py] is set_char(rows[py], px, "x")

                    elif d > 32 then
                        # 먼 적 — 2칸
                        rows[py] is set_char(rows[py], px - 1, "o")
                        rows[py] is set_char(rows[py], px,     "o")

                    elif d > 18 then
                        # 중간 거리 — (O)
                        rows[py] is set_char(rows[py], px - 1, "(")
                        rows[py] is set_char(rows[py], px,     "O")
                        rows[py] is set_char(rows[py], px + 1, ")")

                    elif d > 9 then
                        # 가까운 적 — 십자형 스프라이트
                        if py - 1 >= 0 then
                            rows[py - 1] is set_char(rows[py - 1], px - 1, "/")
                            rows[py - 1] is set_char(rows[py - 1], px,     "^")
                            rows[py - 1] is set_char(rows[py - 1], px + 1, "\\")
                        end
                        rows[py] is set_char(rows[py], px - 2, "<")
                        rows[py] is set_char(rows[py], px - 1, "[")
                        rows[py] is set_char(rows[py], px,     "@")
                        rows[py] is set_char(rows[py], px + 1, "]")
                        rows[py] is set_char(rows[py], px + 2, ">")
                        if py + 1 < SH then
                            rows[py + 1] is set_char(rows[py + 1], px - 1, "\\")
                            rows[py + 1] is set_char(rows[py + 1], px,     "V")
                            rows[py + 1] is set_char(rows[py + 1], px + 1, "/")
                        end

                    else
                        # 매우 가까운 적 — 위험! 큰 스프라이트
                        if py - 1 >= 0 then
                            rows[py - 1] is set_char(rows[py - 1], px - 2, "\\")
                            rows[py - 1] is set_char(rows[py - 1], px - 1, "#")
                            rows[py - 1] is set_char(rows[py - 1], px,     "!")
                            rows[py - 1] is set_char(rows[py - 1], px + 1, "#")
                            rows[py - 1] is set_char(rows[py - 1], px + 2, "/")
                        end
                        rows[py] is set_char(rows[py], px - 3, "|")
                        rows[py] is set_char(rows[py], px - 2, "X")
                        rows[py] is set_char(rows[py], px - 1, "X")
                        rows[py] is set_char(rows[py], px,     "!")
                        rows[py] is set_char(rows[py], px + 1, "X")
                        rows[py] is set_char(rows[py], px + 2, "X")
                        rows[py] is set_char(rows[py], px + 3, "|")
                        if py + 1 < SH then
                            rows[py + 1] is set_char(rows[py + 1], px - 2, "/")
                            rows[py + 1] is set_char(rows[py + 1], px - 1, "#")
                            rows[py + 1] is set_char(rows[py + 1], px,     "!")
                            rows[py + 1] is set_char(rows[py + 1], px + 1, "#")
                            rows[py + 1] is set_char(rows[py + 1], px + 2, "\\")
                        end
                    end
                end
            end
        end
        ei is ei + 1
    end

    # ── 3) 조준 십자선 (화면 좌표 직접 배치) ─────────────
    cx is player["cx"]
    cy is player["cy"]
    rows[cy] is set_char(rows[cy], cx - 1, "-")
    rows[cy] is set_char(rows[cy], cx,     "+")
    rows[cy] is set_char(rows[cy], cx + 1, "-")
    if cy - 1 >= 0 then rows[cy - 1] is set_char(rows[cy - 1], cx, "|")
    if cy + 1 < SH  then rows[cy + 1] is set_char(rows[cy + 1], cx, "|")

    # ── 4) 플레이어 함선 (화면 하단 고정) ────────────────
    bot is SH - 1
    rows[bot] is set_char(rows[bot], 38, "/")
    rows[bot] is set_char(rows[bot], 39, "|")
    rows[bot] is set_char(rows[bot], 40, "A")
    rows[bot] is set_char(rows[bot], 41, "|")
    rows[bot] is set_char(rows[bot], 42, "\\")

    # ── 5) 프레임 문자열 조합 ─────────────────────────────
    frame is CLR

    r is 0
    while r < SH do
        frame is frame + DIM + rows[r] + RST + "\n"
        r is r + 1
    end

    # ── HUD ───────────────────────────────────────────────
    hp  is player["hp"]
    mhp is player["max_hp"]
    sc  is player["score"]
    wv  is player["wave"]
    ac  is alive_count()
    hb  is hp_bar(hp, mhp, 20)

    frame is frame + CYN + string_repeat("━", SW) + RST + "\n"

    # HP 색상: 절반 이하 → 빨강
    if hp > mhp / 2 then
        frame is frame + " " + GRN + "HP[" + hb + "] " + hp + "/" + mhp + RST
    else
        frame is frame + " " + RED + BOLD + "HP[" + hb + "] " + hp + "/" + mhp + RST
    end

    frame is frame + YLW + "  점수:" + sc + "  웨이브:" + wv + "  적:" + ac + "/" + MAX_EI + RST + "\n"

    # 메시지 행
    am is player["atk_msg"]
    ms is player["msg"]
    if am != "" then
        frame is frame + RED + BOLD + " [피격!] " + am + RST + "\n"
    elif ms != "" then
        frame is frame + WHT + " >> " + ms + RST + "\n"
    else
        frame is frame + "\n"
    end

    frame is frame + DIM + " 조준(" + cx + "," + cy + ")  W/S/A/D=조준이동  F=발사  Q=종료" + RST

    print_n frame
end

# ── 타이틀 화면 ───────────────────────────────────────────

print_n CLR
print WHT + BOLD
print "  ┌────────────────────────────────────────────────┐"
print "  │       수라 스타블라스터 3D  v1.0               │"
print "  │   Sura StarBlaster 3D — 3D 원근 투영 우주 게임  │"
print "  └────────────────────────────────────────────────┘"
print RST
print ""
print CYN + "  [ 조작법 ]"
print "   W / S     조준점 위 / 아래 이동"
print "   A / D     조준점 왼쪽 / 오른쪽 이동"
print "   F         발사!"
print "   Q         종료" + RST
print ""
print YLW + "  [ 목표 ]"
print "  적 함선이 당신을 향해 3D 공간을 날아옵니다."
print "  조준점 [+] 를 적에 겹치고 F 를 눌러 격추하세요."
print "  적이 너무 가까워지면 충돌 피해를 입습니다."
print "  웨이브가 오를수록 적이 더 빠르고 강해집니다." + RST
print ""
print ""
print WHT + "  [Enter] 를 눌러 시작하세요..." + RST
input()

reset_enemies()

# ── 메인 게임 루프 ────────────────────────────────────────

running is 1
while running == 1 do

    render()

    cmd is lower(input("> "))

    player["atk_msg"] is ""

    if cmd == "q" then
        running is 0
        break

    elif cmd == "w" then
        player["cy"] is player["cy"] - 1
        if player["cy"] < 1 then player["cy"] is 1
        player["msg"] is "조준 위로"

    elif cmd == "s" then
        player["cy"] is player["cy"] + 1
        if player["cy"] > SH - 2 then player["cy"] is SH - 2
        player["msg"] is "조준 아래로"

    elif cmd == "a" then
        player["cx"] is player["cx"] - 2
        if player["cx"] < 2 then player["cx"] is 2
        player["msg"] is "조준 왼쪽"

    elif cmd == "d" then
        player["cx"] is player["cx"] + 2
        if player["cx"] > SW - 3 then player["cx"] is SW - 3
        player["msg"] is "조준 오른쪽"

    elif cmd == "f" then
        player["msg"] is fire()

    else
        player["msg"] is "? (W/S/A/D=이동  F=발사  Q=종료)"
    end

    # 적 이동 처리
    dmg is step_enemies()
    if dmg > 0 then
        player["atk_msg"] is "적 함선 충돌! -" + dmg + "HP"
    end

    # 별 이동 (공간 속도감)
    step_stars()

    # HP 체크
    if player["hp"] <= 0 then
        player["hp"] is 0
        running is 0
        break
    end

    # 웨이브 클리어 체크
    if alive_count() == 0 then
        player["wave"] is player["wave"] + 1
        player["score"] is player["score"] + 500
        player["e_spd"] is player["e_spd"] + 0.4
        player["msg"] is "웨이브 " + player["wave"] + " 시작! 클리어 보너스 +500점"
        player["atk_msg"] is ""
        reset_enemies()
    end

end

# 마지막 프레임 렌더
render()

# ── 게임 오버 화면 ────────────────────────────────────────

print_n CLR
print ""
print BOLD
if player["hp"] <= 0 then
    print RED +   "  ╔═════════════════════════════════════════╗"
    print         "  ║           *** GAME  OVER ***            ║"
    print         "  ╚═════════════════════════════════════════╝" + RST
else
    print GRN +   "  ╔═════════════════════════════════════════╗"
    print         "  ║           *** 게임  종료 ***             ║"
    print         "  ╚═════════════════════════════════════════╝" + RST
end
print RST
print ""
print YLW + "  최종 점수    : " + player["score"] + RST
print CYN  + "  클리어 웨이브: " + player["wave"] + RST
print GRN  + "  잔여 HP     : " + player["hp"] + " / " + player["max_hp"] + RST
print ""

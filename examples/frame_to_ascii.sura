# 픽셀 행렬을 문자 프레임으로 — FFmpeg도 영상 파일도 필요 없습니다.
# media.frame_to_text는 grayscale 숫자나 RGB/RGBA 행렬을 그대로 받으므로,
# 여기서는 프레임을 코드로 그려 넣고 바로 문자로 변환합니다.
#
#   .\SuraLanguage.exe examples\frame_to_ascii.sura

use media

W is 48
H is 18
RAMP is " .:-=+*#%@"

# 두 개의 광원이 만드는 밝기 장을 grayscale 행렬로 만든다.
func brightness_field(cx1, cy1, cx2, cy2) do
    rows is []
    y is 0
    while y < H do
        row is []
        x is 0
        while x < W do
            # 가로세로 픽셀 비율이 2:1인 문자 격자를 보정한다.
            dx1 is (x - cx1) * 0.5
            dy1 is y - cy1
            dx2 is (x - cx2) * 0.5
            dy2 is y - cy2
            near1 is 900 / (1 + dx1 * dx1 + dy1 * dy1)
            near2 is 600 / (1 + dx2 * dx2 + dy2 * dy2)
            level is near1 + near2
            if level > 255 then level is 255
            row.push(round(level))
            x is x + 1
        end
        rows.push(row)
        y is y + 1
    end
    return rows
end

print("=== media.frame_to_text: 코드로 만든 프레임 ===")

frame is 0
while frame < 3 do
    cx1 is 12 + frame * 6
    cx2 is 34 - frame * 4
    pixels is brightness_field(cx1, 8, cx2, 11)
    print("")
    shown is frame + 1
    print("프레임 {shown} / 3")
    print(media.frame_to_text(pixels, {charset: RAMP}))
    frame is frame + 1
end

# RGB와 RGBA도 같은 함수로 처리된다. RGBA는 검은 배경 위에 합성된다.
print("")
print("=== RGB / RGBA 한 줄 ===")
strip is [[[0, 0, 0], [255, 0, 0], [0, 255, 0], [0, 0, 255], [255, 255, 255], [255, 255, 255, 128]]]
print(media.frame_to_text(strip, {charset: RAMP}))

print("")
print("frame_to_ascii: PASS")

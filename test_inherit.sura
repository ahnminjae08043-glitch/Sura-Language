# 다단계 상속 테스트 (A → B → C)

class A do
    이름 is "A"
    func 인사() do
        print "안녕, 나는 {self.이름}!"
    end
    func A전용() do
        print "A 전용 메서드"
    end
end

class B extends A do
    점수 is 0
    func 생성자(점수) do
        self.점수 is 점수
    end
    func B전용() do
        print "B 전용, 점수: {self.점수}"
    end
end

class C extends B do
    레벨 is 1
    func 생성자(점수, 레벨) do
        self.점수 is 점수
        self.레벨 is 레벨
        self.이름 is "C"
    end
    func 소개() do
        print "이름:{self.이름} 점수:{self.점수} 레벨:{self.레벨}"
    end
end

c is new C(99, 5)

# C 자신 메서드
c.소개()

# B 메서드 (한 단계 위)
c.B전용()

# A 메서드 (두 단계 위) — 이게 이전에 안 됐던 것
c.A전용()
c.인사()

# 필드 상속 확인
print "이름 필드: {c.이름}"
print "점수 필드: {c.점수}"
print "레벨 필드: {c.레벨}"

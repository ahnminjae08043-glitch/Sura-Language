// ================================
// 수라 표준 라이브러리: web
// 웹 개발 지원 (HTTP, JSON, API)
// 사용법: use web
// ================================
// 내장 명령어 (interpreter.hpp 지원 필요):
//   http_get 주소 결과           → GET 요청
//   http_post 주소 데이터 결과   → POST 요청
//   json_parse 문자열 결과       → JSON 파싱
//   json_stringify 객체 결과     → JSON 문자열화
//   url_encode 문자열 결과       → URL 인코딩
//   url_decode 문자열 결과       → URL 디코딩

// ================================
// 기본 HTTP 클라이언트
// ================================

// GET 요청 (JSON 응답)
// 입력: _url
// 출력: _result (응답 문자열)
func http_get_json do
    http_get _url _result
    json_parse _result _parsed
end

// POST 요청 (JSON 전송)
// 입력: _url, _data (객체)
// 출력: _result (응답 문자열)
func http_post_json do
    json_stringify _data _json_str
    http_post _url _json_str _result
end


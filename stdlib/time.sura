// ================================
// 수라 표준 라이브러리: time
// 사용법: use time
// ================================
// 내장 명령어 (main.cpp 지원):
//   now 변수     → 현재 유닉스 타임스탬프 (초 단위)
//   sleep 밀리초 → 지정 시간만큼 대기
//   wait(ms)     → sleep_ms(ms)와 같은 밀리초 대기 함수

// time_now: current_time에 현재 시각 저장
func time_now do
    now current_time
end

// time_wait: ms 변수(밀리초)만큼 대기
func time_wait do
    sleep ms
end

// fps_wait: 목표 FPS에 맞춰 대기 (fps 변수 설정 후 호출)
// 입력: fps (예: fps is 30 → 약 33ms 대기)
func fps_wait do
    _frame_ms is 1000
    _frame_ms / fps
    sleep _frame_ms
end

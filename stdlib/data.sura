end

// ================================
// JSON 데이터 처리
// ================================

// JSON 파일 읽기
// 입력: _filepath
// 출력: _data
func load_json do
    json_load _filepath _data
end

// JSON 파일 저장
// 입력: _filepath, _data
func save_json do
    json_save _filepath _data
end

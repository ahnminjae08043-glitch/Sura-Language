# Checked FAT32 reader and fixed-size existing-file writer.
#
# Names use the on-disk uppercase, space-padded 11-byte short-name form.
# The caller supplies one aligned sector buffer at least bytes_per_sector long.

import "block.sura"

struct Fat32Volume do
  device: ptr[BlockDevice]
  partition_lba: u64
  total_sectors: u64
  bytes_per_sector: u64
  sectors_per_cluster: u64
  reserved_sectors: u64
  fat_count: u64
  sectors_per_fat: u64
  fat_start_lba: u64
  data_start_lba: u64
  root_cluster: u64
  cluster_count: u64
  max_cluster: u64
  fsinfo_sector: u64
end

struct Fat32DirEntry do
  valid: u64
  attributes: u64
  first_cluster: u64
  file_size: u64
  directory_lba: u64
  directory_offset: u64
end

func fat32_clear_volume(volume: ptr[Fat32Volume]) do
  if volume == 0 then return false
  volume.device is 0
  volume.partition_lba is 0
  volume.total_sectors is 0
  volume.bytes_per_sector is 0
  volume.sectors_per_cluster is 0
  volume.reserved_sectors is 0
  volume.fat_count is 0
  volume.sectors_per_fat is 0
  volume.fat_start_lba is 0
  volume.data_start_lba is 0
  volume.root_cluster is 0
  volume.cluster_count is 0
  volume.max_cluster is 0
  volume.fsinfo_sector is 0
  return true
end

func fat32_clear_entry(entry: ptr[Fat32DirEntry]) do
  if entry == 0 then return false
  entry.valid is 0
  entry.attributes is 0
  entry.first_cluster is 0
  entry.file_size is 0
  entry.directory_lba is 0
  entry.directory_offset is 0
  return true
end

func fat32_mount(volume: ptr[Fat32Volume], device: ptr[BlockDevice], partition_lba: u64, sector_buffer: ptr) do
  if volume == 0 or device == 0 or sector_buffer == 0 then return false
  fat32_clear_volume(volume)
  if not block_device_valid(device) then return false
  if partition_lba >= device.sector_count then return false
  if not block_read(device, partition_lba, 1, sector_buffer) then return false
  if mem.read16(ptr.add(sector_buffer, 510)) != 43605 then return false

  bytes_per_sector: u64 is mem.read16(ptr.add(sector_buffer, 11))
  sectors_per_cluster: u64 is mem.read8(ptr.add(sector_buffer, 13))
  reserved_sectors: u64 is mem.read16(ptr.add(sector_buffer, 14))
  fat_count: u64 is mem.read8(ptr.add(sector_buffer, 16))
  root_entries: u64 is mem.read16(ptr.add(sector_buffer, 17))
  total_sectors: u64 is mem.read16(ptr.add(sector_buffer, 19))
  if total_sectors == 0 then total_sectors is mem.read32(ptr.add(sector_buffer, 32))
  sectors_per_fat: u64 is mem.read32(ptr.add(sector_buffer, 36))
  fs_version: u64 is mem.read16(ptr.add(sector_buffer, 42))
  root_cluster: u64 is mem.read32(ptr.add(sector_buffer, 44)) & 268435455
  fsinfo_sector: u64 is mem.read16(ptr.add(sector_buffer, 48))

  if bytes_per_sector != device.sector_size then return false
  if bytes_per_sector < 512 or not block_power_of_two(bytes_per_sector) then return false
  if sectors_per_cluster == 0 or sectors_per_cluster > 128 then return false
  if not block_power_of_two(sectors_per_cluster) then return false
  if reserved_sectors == 0 or fat_count == 0 or fat_count > 2 then return false
  if root_entries != 0 or sectors_per_fat == 0 or fs_version != 0 then return false
  if total_sectors == 0 or total_sectors > device.sector_count - partition_lba then return false

  fat_sectors: u64 is fat_count * sectors_per_fat
  if fat_sectors / fat_count != sectors_per_fat then return false
  if reserved_sectors > total_sectors or fat_sectors > total_sectors - reserved_sectors then return false
  first_data: u64 is reserved_sectors + fat_sectors
  if first_data >= total_sectors then return false
  data_sectors: u64 is total_sectors - first_data
  cluster_count: u64 is data_sectors / sectors_per_cluster
  if cluster_count < 65525 or cluster_count > 268435445 then return false
  max_cluster: u64 is cluster_count + 1
  if root_cluster < 2 or root_cluster > max_cluster then return false
  fat_entry_bytes: u64 is sectors_per_fat * bytes_per_sector
  if fat_entry_bytes / sectors_per_fat != bytes_per_sector then return false
  fat_entry_capacity: u64 is fat_entry_bytes / 4
  if fat_entry_capacity <= max_cluster then return false
  if fsinfo_sector != 65535 and fsinfo_sector >= reserved_sectors then return false
  data_start_lba: u64 is partition_lba + first_data
  if data_start_lba < partition_lba then return false

  volume.device is device
  volume.partition_lba is partition_lba
  volume.total_sectors is total_sectors
  volume.bytes_per_sector is bytes_per_sector
  volume.sectors_per_cluster is sectors_per_cluster
  volume.reserved_sectors is reserved_sectors
  volume.fat_count is fat_count
  volume.sectors_per_fat is sectors_per_fat
  volume.fat_start_lba is partition_lba + reserved_sectors
  volume.data_start_lba is data_start_lba
  volume.root_cluster is root_cluster
  volume.cluster_count is cluster_count
  volume.max_cluster is max_cluster
  volume.fsinfo_sector is fsinfo_sector
  return true
end

func fat32_cluster_valid(volume: ptr[Fat32Volume], cluster: u64) do
  if volume == 0 then return false
  return cluster >= 2 and cluster <= volume.max_cluster
end

func fat32_cluster_lba(volume: ptr[Fat32Volume], cluster: u64) do
  if not fat32_cluster_valid(volume, cluster) then return 0
  if volume.sectors_per_cluster == 0 then return 0
  cluster_offset: u64 is cluster - 2
  relative: u64 is cluster_offset * volume.sectors_per_cluster
  if cluster_offset != 0 and relative / cluster_offset != volume.sectors_per_cluster then return 0
  if relative >= volume.total_sectors then return 0
  lba: u64 is volume.data_start_lba + relative
  if lba < volume.data_start_lba then return 0
  return lba
end

func fat32_read_fat_entry(volume: ptr[Fat32Volume], cluster: u64, sector_buffer: ptr) do
  if not fat32_cluster_valid(volume, cluster) or sector_buffer == 0 then return 0
  byte_offset: u64 is cluster * 4
  fat_sector: u64 is byte_offset / volume.bytes_per_sector
  entry_offset: u64 is byte_offset % volume.bytes_per_sector
  if fat_sector >= volume.sectors_per_fat then return 0
  if not block_read(volume.device, volume.fat_start_lba + fat_sector, 1, sector_buffer) then return 0
  return mem.read32(ptr.add(sector_buffer, entry_offset)) & 268435455
end

func fat32_is_end_of_chain(cluster: u64) do
  return cluster >= 268435448 and cluster <= 268435455
end

func fat32_cluster_bytes(volume: ptr[Fat32Volume]) do
  if volume == 0 or volume.bytes_per_sector == 0 or volume.sectors_per_cluster == 0 then return 0
  byte_count: u64 is volume.bytes_per_sector * volume.sectors_per_cluster
  if byte_count / volume.sectors_per_cluster != volume.bytes_per_sector then return 0
  return byte_count
end

func fat32_required_clusters(volume: ptr[Fat32Volume], byte_count: u64) do
  if byte_count == 0 then return 0
  cluster_bytes: u64 is fat32_cluster_bytes(volume)
  if cluster_bytes == 0 then return 0
  return 1 + ((byte_count - 1) / cluster_bytes)
end

# Verifies that the prefix needed for byte_count exists and does not repeat a
# cluster. It performs no data writes and is used before reads and overwrites.
func fat32_chain_has_bytes(volume: ptr[Fat32Volume], first_cluster: u64, byte_count: u64, sector_buffer: ptr) do
  if volume == 0 or sector_buffer == 0 then return false
  if byte_count == 0 then return true
  needed: u64 is fat32_required_clusters(volume, byte_count)
  if needed == 0 or needed > volume.cluster_count then return false
  if not fat32_cluster_valid(volume, first_cluster) then return false

  tortoise: u64 is first_cluster
  hare: u64 is first_cluster
  step: u64 is 1
  while step < needed do
    tortoise is fat32_read_fat_entry(volume, tortoise, sector_buffer)
    if fat32_is_end_of_chain(tortoise) or not fat32_cluster_valid(volume, tortoise) then return false

    if hare != 0 then
      hare is fat32_read_fat_entry(volume, hare, sector_buffer)
      if fat32_is_end_of_chain(hare) then
        hare is 0
      else
        if not fat32_cluster_valid(volume, hare) then return false
      end
    end
    if hare != 0 then
      hare is fat32_read_fat_entry(volume, hare, sector_buffer)
      if fat32_is_end_of_chain(hare) then
        hare is 0
      else
        if not fat32_cluster_valid(volume, hare) then return false
      end
    end
    if hare != 0 and hare == tortoise then return false
    step += 1
  end
  return true
end

func fat32_short_name_equal(entry_address: ptr, short_name: ptr) do
  if entry_address == 0 or short_name == 0 then return false
  index: u64 is 0
  while index < 11 do
    if mem.read8(ptr.add(entry_address, index)) != mem.read8(ptr.add(short_name, index)) then return false
    index += 1
  end
  return true
end

func fat32_find_short(volume: ptr[Fat32Volume], directory_cluster: u64, short_name: ptr, result: ptr[Fat32DirEntry], sector_buffer: ptr) do
  if volume == 0 or short_name == 0 or result == 0 or sector_buffer == 0 then return false
  fat32_clear_entry(result)
  if not fat32_cluster_valid(volume, directory_cluster) then return false

  cluster: u64 is directory_cluster
  visited: u64 is 0
  while visited < volume.cluster_count do
    cluster_lba: u64 is fat32_cluster_lba(volume, cluster)
    if cluster_lba == 0 then return false
    sector_index: u64 is 0
    while sector_index < volume.sectors_per_cluster do
      lba: u64 is cluster_lba + sector_index
      if not block_read(volume.device, lba, 1, sector_buffer) then return false
      entry_index: u64 is 0
      entries_per_sector: u64 is volume.bytes_per_sector / 32
      while entry_index < entries_per_sector do
        offset: u64 is entry_index * 32
        entry_address: ptr is ptr.add(sector_buffer, offset)
        first: u64 is mem.read8(entry_address)
        if first == 0 then return false
        attributes: u64 is mem.read8(ptr.add(entry_address, 11))
        if first != 229 and attributes != 15 and (attributes & 8) == 0 then
          if fat32_short_name_equal(entry_address, short_name) then
            high: u64 is mem.read16(ptr.add(entry_address, 20))
            low: u64 is mem.read16(ptr.add(entry_address, 26))
            result.valid is 1
            result.attributes is attributes
            result.first_cluster is ((high << 16) | low) & 268435455
            result.file_size is mem.read32(ptr.add(entry_address, 28))
            result.directory_lba is lba
            result.directory_offset is offset
            return true
          end
        end
        entry_index += 1
      end
      sector_index += 1
    end

    next_cluster: u64 is fat32_read_fat_entry(volume, cluster, sector_buffer)
    if fat32_is_end_of_chain(next_cluster) then return false
    if not fat32_cluster_valid(volume, next_cluster) then return false
    cluster is next_cluster
    visited += 1
  end
  return false
end

func fat32_find_root_short(volume: ptr[Fat32Volume], short_name: ptr, result: ptr[Fat32DirEntry], sector_buffer: ptr) do
  if volume == 0 then return false
  return fat32_find_short(volume, volume.root_cluster, short_name, result, sector_buffer)
end

func fat32_copy_short_name(entry_address: ptr, output: ptr) do
  if entry_address == 0 or output == 0 then return false
  index: u64 is 0
  while index < 11 do
    mem.write8(ptr.add(output, index), mem.read8(ptr.add(entry_address, index)))
    index += 1
  end
  mem.write8(ptr.add(output, 11), 0)
  return true
end

# Returns the ordinal-th visible 8.3 entry in a directory. Long-name,
# volume-label, deleted, and end-marker entries are excluded. The caller
# supplies a 12-byte short_name buffer.
func fat32_list_short(volume: ptr[Fat32Volume], directory_cluster: u64, ordinal: u64, result: ptr[Fat32DirEntry], short_name: ptr, sector_buffer: ptr) do
  if volume == 0 or result == 0 or short_name == 0 or sector_buffer == 0 then return false
  fat32_clear_entry(result)
  mem.write8(short_name, 0)
  if not fat32_cluster_valid(volume, directory_cluster) then return false

  found: u64 is 0
  cluster: u64 is directory_cluster
  visited: u64 is 0
  while visited < volume.cluster_count do
    cluster_lba: u64 is fat32_cluster_lba(volume, cluster)
    if cluster_lba == 0 then return false
    sector_index: u64 is 0
    while sector_index < volume.sectors_per_cluster do
      lba: u64 is cluster_lba + sector_index
      if not block_read(volume.device, lba, 1, sector_buffer) then return false
      entry_index: u64 is 0
      entries_per_sector: u64 is volume.bytes_per_sector / 32
      while entry_index < entries_per_sector do
        offset: u64 is entry_index * 32
        entry_address: ptr is ptr.add(sector_buffer, offset)
        first: u64 is mem.read8(entry_address)
        if first == 0 then return false
        attributes: u64 is mem.read8(ptr.add(entry_address, 11))
        if first != 229 and attributes != 15 and (attributes & 8) == 0 then
          if found == ordinal then
            high: u64 is mem.read16(ptr.add(entry_address, 20))
            low: u64 is mem.read16(ptr.add(entry_address, 26))
            result.valid is 1
            result.attributes is attributes
            result.first_cluster is ((high << 16) | low) & 268435455
            result.file_size is mem.read32(ptr.add(entry_address, 28))
            result.directory_lba is lba
            result.directory_offset is offset
            return fat32_copy_short_name(entry_address, short_name)
          end
          found += 1
        end
        entry_index += 1
      end
      sector_index += 1
    end

    next_cluster: u64 is fat32_read_fat_entry(volume, cluster, sector_buffer)
    if fat32_is_end_of_chain(next_cluster) then return false
    if not fat32_cluster_valid(volume, next_cluster) then return false
    cluster is next_cluster
    visited += 1
  end
  return false
end

func fat32_list_root_short(volume: ptr[Fat32Volume], ordinal: u64, result: ptr[Fat32DirEntry], short_name: ptr, sector_buffer: ptr) do
  if volume == 0 then return false
  return fat32_list_short(volume, volume.root_cluster, ordinal, result, short_name, sector_buffer)
end

func fat32_copy_bytes(destination: ptr, source: ptr, byte_count: u64) do
  if destination == 0 or source == 0 then return false
  index: u64 is 0
  while index < byte_count do
    mem.write8(ptr.add(destination, index), mem.read8(ptr.add(source, index)))
    index += 1
  end
  return true
end

func fat32_read_file(volume: ptr[Fat32Volume], file: ptr[Fat32DirEntry], output: ptr, capacity: u64, sector_buffer: ptr) do
  if volume == 0 or file == 0 or output == 0 or sector_buffer == 0 then return false
  if file.valid == 0 or (file.attributes & 16) != 0 then return false
  if capacity < file.file_size then return false
  if file.file_size == 0 then return true
  if not fat32_cluster_valid(volume, file.first_cluster) then return false
  if not fat32_chain_has_bytes(volume, file.first_cluster, file.file_size, sector_buffer) then return false

  cluster: u64 is file.first_cluster
  remaining: u64 is file.file_size
  output_offset: u64 is 0
  visited: u64 is 0
  while remaining > 0 and visited < volume.cluster_count do
    cluster_lba: u64 is fat32_cluster_lba(volume, cluster)
    if cluster_lba == 0 then return false
    sector_index: u64 is 0
    while sector_index < volume.sectors_per_cluster and remaining > 0 do
      if not block_read(volume.device, cluster_lba + sector_index, 1, sector_buffer) then return false
      take: u64 is volume.bytes_per_sector
      if take > remaining then take is remaining
      if not fat32_copy_bytes(ptr.add(output, output_offset), sector_buffer, take) then return false
      output_offset += take
      remaining -= take
      sector_index += 1
    end
    if remaining == 0 then return true
    next_cluster: u64 is fat32_read_fat_entry(volume, cluster, sector_buffer)
    if fat32_is_end_of_chain(next_cluster) or not fat32_cluster_valid(volume, next_cluster) then return false
    cluster is next_cluster
    visited += 1
  end
  return remaining == 0
end

# Overwrites an existing regular file without changing its length or chain.
# This avoids metadata allocation and is safe only when no other writer uses
# the volume. Every sector write is followed by a final device flush.
func fat32_overwrite_file(volume: ptr[Fat32Volume], file: ptr[Fat32DirEntry], input: ptr, byte_count: u64, sector_buffer: ptr) do
  if volume == 0 or file == 0 or input == 0 or sector_buffer == 0 then return false
  device: ptr[BlockDevice] is volume.device
  if device == 0 or device.read_only != 0 or file.valid == 0 then return false
  if (file.attributes & 17) != 0 then return false
  if byte_count != file.file_size then return false
  if byte_count == 0 then return block_flush(device)
  if not fat32_cluster_valid(volume, file.first_cluster) then return false
  if not fat32_chain_has_bytes(volume, file.first_cluster, byte_count, sector_buffer) then return false

  cluster: u64 is file.first_cluster
  remaining: u64 is byte_count
  input_offset: u64 is 0
  visited: u64 is 0
  while remaining > 0 and visited < volume.cluster_count do
    cluster_lba: u64 is fat32_cluster_lba(volume, cluster)
    if cluster_lba == 0 then return false
    sector_index: u64 is 0
    while sector_index < volume.sectors_per_cluster and remaining > 0 do
      take: u64 is volume.bytes_per_sector
      if take > remaining then take is remaining
      if take < volume.bytes_per_sector then
        if not block_read(volume.device, cluster_lba + sector_index, 1, sector_buffer) then return false
      end
      if not fat32_copy_bytes(sector_buffer, ptr.add(input, input_offset), take) then return false
      if not block_write(volume.device, cluster_lba + sector_index, 1, sector_buffer) then return false
      input_offset += take
      remaining -= take
      sector_index += 1
    end
    if remaining == 0 then return block_flush(device)
    next_cluster: u64 is fat32_read_fat_entry(volume, cluster, sector_buffer)
    if fat32_is_end_of_chain(next_cluster) or not fat32_cluster_valid(volume, next_cluster) then return false
    cluster is next_cluster
    visited += 1
  end
  return false
end

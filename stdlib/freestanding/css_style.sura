css_top_name is static.utf8("top")
css_right_name is static.utf8("right")
css_bottom_name is static.utf8("bottom")
css_left_name is static.utf8("left")
css_margin_name is static.utf8("margin")
css_margin_top_name is static.utf8("margin-top")
css_margin_right_name is static.utf8("margin-right")
css_margin_bottom_name is static.utf8("margin-bottom")
css_margin_left_name is static.utf8("margin-left")
css_padding_name is static.utf8("padding")
css_padding_top_name is static.utf8("padding-top")
css_padding_right_name is static.utf8("padding-right")
css_padding_bottom_name is static.utf8("padding-bottom")
css_padding_left_name is static.utf8("padding-left")
css_border_width_name is static.utf8("border-width")
css_border_name is static.utf8("border")
css_border_top_name is static.utf8("border-top")
css_border_right_name is static.utf8("border-right")
css_border_bottom_name is static.utf8("border-bottom")
css_border_left_name is static.utf8("border-left")
css_border_top_width_name is static.utf8("border-top-width")
css_border_right_width_name is static.utf8("border-right-width")
css_border_bottom_width_name is static.utf8("border-bottom-width")
css_border_left_width_name is static.utf8("border-left-width")
css_font_size_name is static.utf8("font-size")
css_line_height_name is static.utf8("line-height")
css_box_sizing_name is static.utf8("box-sizing")
css_justify_content_name is static.utf8("justify-content")
css_align_items_name is static.utf8("align-items")
css_flex_wrap_name is static.utf8("flex-wrap")

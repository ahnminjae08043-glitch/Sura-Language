css_column_gap_name is static.utf8("column-gap")
css_grid_template_columns_name is static.utf8("grid-template-columns")
css_clamp_value is static.utf8("clamp(")
css_auto_value is static.utf8("auto")
css_none_value is static.utf8("none")
css_block_value is static.utf8("block")
css_inline_value is static.utf8("inline")
css_inline_block_value is static.utf8("inline-block")
css_flex_value is static.utf8("flex")
css_inline_flex_value is static.utf8("inline-flex")
css_grid_value is static.utf8("grid")
css_inline_grid_value is static.utf8("inline-grid")
css_border_box_value is static.utf8("border-box")
css_content_box_value is static.utf8("content-box")

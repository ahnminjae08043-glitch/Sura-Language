# Allocation-free bounded CSS computed-style foundation.
#
# Supported selectors include tag, .class, #id, compound, descendant, and
# direct-child selectors. Supported properties cover display,
# foreground/background colors, width/height, min/max dimensions, bounded
# percentage/calc/viewport dimension values,
# margin/padding/border-width longhands and 1-4 value shorthands, border and
# side-border width extraction from compound shorthands, font-size,
# line-height, box-sizing, static/relative/absolute/fixed positioning with
# signed pixel offsets, flex alignment/wrapping/gaps, and bounded grid column
# counts. Rules cascade by selector specificity and source order; inline style
# wins with specificity 1000.

import "html_dom.sura"

struct CssComputedStyle do
  display: u64
  color: u64
  background: u64
  width: u64
  height: u64
  margin_top: u64
  margin_right: u64
  margin_bottom: u64
  margin_left: u64
  padding_top: u64
  padding_right: u64
  padding_bottom: u64
  padding_left: u64
  border_top: u64
  border_right: u64
  border_bottom: u64
  border_left: u64
  font_size: u64
  line_height: u64
  box_sizing: u64
  justify_content: u64
  align_items: u64
  flex_wrap: u64
  flex_direction: u64
  gap_row: u64
  gap_column: u64
  grid_columns: u64
  min_width: u64
  max_width: u64
  min_height: u64
  max_height: u64
  position: u64
  top: u64
  right: u64
  bottom: u64
  left: u64
end

struct CssRule do
  selector_kind: u64
  selector_tag: u64
  selector_start: u64
  selector_bytes: u64
  specificity: u64
  property_mask: u64
end

struct CssStylesheet do
  input: ptr
  input_bytes: u64
  rules: ptr
  styles: ptr
  capacity: u64
  count: u64
end

css_display_name is static.utf8("display")
css_color_name is static.utf8("color")
css_background_name is static.utf8("background")
css_background_color_name is static.utf8("background-color")
css_width_name is static.utf8("width")
css_height_name is static.utf8("height")
css_min_width_name is static.utf8("min-width")
css_max_width_name is static.utf8("max-width")
css_min_height_name is static.utf8("min-height")
css_max_height_name is static.utf8("max-height")

# RSA public operation for freestanding x86-64 Sura.
#
# Integers use little-endian 32-bit limbs stored in 64-bit slots. Montgomery
# reduction avoids division and keeps every limb product within u64. The
# initial implementation intentionally accepts only the public exponent 65537,
# which is the exponent used by the current suralang.site certificate chain.

struct RsaPublicWorkspace do
  modulus: ptr
  operand: ptr
  base: ptr
  result: ptr
  r2: ptr
  temporary: ptr
  encoded: ptr
  encoded_capacity: u64
  limb_capacity: u64
  limb_count: u64
  modulus_bytes: u64
  n0_inverse: u64
  initialized: u64
end

struct RsaPublicBuffers do
  modulus: ptr
  operand: ptr
  base: ptr
  result: ptr
  r2: ptr
  temporary: ptr
  encoded: ptr
  encoded_capacity: u64
  limb_capacity: u64
end

func rsa_public_clear(buffer: ptr, slots: u64) do
  if buffer == 0 then return false
  index: u64 is 0
  while index < slots do
    mem.write64(ptr.index(buffer, index, 8), 0)
    index += 1
  end
  return true
end

func rsa_public_workspace_init(workspace: ptr[RsaPublicWorkspace], buffers: ptr[RsaPublicBuffers]) do
  if workspace == 0 or buffers == 0 then return false
  if buffers.modulus == 0 or buffers.operand == 0 or buffers.base == 0 then return false
  if buffers.result == 0 or buffers.r2 == 0 or buffers.temporary == 0 then return false
  if buffers.encoded == 0 or buffers.encoded_capacity < 128 then return false
  if buffers.limb_capacity < 32 or buffers.limb_capacity > 128 then return false
  workspace.modulus is buffers.modulus
  workspace.operand is buffers.operand
  workspace.base is buffers.base
  workspace.result is buffers.result
  workspace.r2 is buffers.r2
  workspace.temporary is buffers.temporary
  workspace.encoded is buffers.encoded
  workspace.encoded_capacity is buffers.encoded_capacity
  workspace.limb_capacity is buffers.limb_capacity
  workspace.limb_count is 0
  workspace.modulus_bytes is 0
  workspace.n0_inverse is 0
  workspace.initialized is 1
  if not rsa_public_clear(workspace.modulus, workspace.limb_capacity) then return false
  if not rsa_public_clear(workspace.operand, workspace.limb_capacity) then return false
  if not rsa_public_clear(workspace.base, workspace.limb_capacity) then return false
  if not rsa_public_clear(workspace.result, workspace.limb_capacity) then return false
  if not rsa_public_clear(workspace.r2, workspace.limb_capacity) then return false
  return rsa_public_clear(workspace.temporary, workspace.limb_capacity * 2 + 2)
end

func rsa_public_load_be(output: ptr, limb_capacity: u64, input: ptr, input_bytes: u64) do
  if output == 0 or input == 0 or input_bytes == 0 then return false
  limbs: u64 is (input_bytes + 3) / 4
  if limbs > limb_capacity then return false
  if not rsa_public_clear(output, limb_capacity) then return false
  byte_index: u64 is 0
  while byte_index < input_bytes do
    source_index: u64 is input_bytes - 1 - byte_index
    limb_index: u64 is byte_index / 4
    shift: u64 is (byte_index & 3) * 8
    value: u64 is mem.read64(ptr.index(output, limb_index, 8))
    value is value | (mem.read8(ptr.add(input, source_index)) << shift)
    mem.write64(ptr.index(output, limb_index, 8), value & u64("0xffffffff"))
    byte_index += 1
  end
  return true
end

func rsa_public_store_be(input: ptr, limb_count: u64, output: ptr, output_bytes: u64) do
  if input == 0 or output == 0 or limb_count == 0 then return false
  if output_bytes > limb_count * 4 then return false
  byte_index: u64 is 0
  while byte_index < output_bytes do
    limb_index: u64 is byte_index / 4
    shift: u64 is (byte_index & 3) * 8
    value: u64 is mem.read64(ptr.index(input, limb_index, 8))
    mem.write8(ptr.add(output, output_bytes - 1 - byte_index), (value >> shift) & 255)
    byte_index += 1
  end
  return true
end

func rsa_public_compare(left: ptr, right: ptr, limbs: u64) do
  if left == 0 or right == 0 then return 0
  index: i64 is limbs - 1
  while index >= 0 do
    left_value: u64 is mem.read64(ptr.index(left, index, 8)) & u64("0xffffffff")
    right_value: u64 is mem.read64(ptr.index(right, index, 8)) & u64("0xffffffff")
    if left_value > right_value then return 1
    if left_value < right_value then return 2
    index -= 1
  end
  return 0
end

func rsa_public_subtract(left: ptr, right: ptr, output: ptr, limbs: u64) do
  if left == 0 or right == 0 or output == 0 then return false
  borrow: u64 is 0
  index: u64 is 0
  while index < limbs do
    left_value: u64 is mem.read64(ptr.index(left, index, 8)) & u64("0xffffffff")
    right_value: u64 is mem.read64(ptr.index(right, index, 8)) & u64("0xffffffff")
    subtrahend: u64 is right_value + borrow
    next_borrow: u64 is 0
    if left_value < subtrahend then next_borrow is 1
    difference: u64 is (left_value - subtrahend) & u64("0xffffffff")
    mem.write64(ptr.index(output, index, 8), difference)
    borrow is next_borrow
    index += 1
  end
  return borrow == 0
end

func rsa_public_copy_limbs(output: ptr, input: ptr, limbs: u64) do
  if output == 0 or input == 0 then return false
  index: u64 is 0
  while index < limbs do
    mem.write64(ptr.index(output, index, 8), mem.read64(ptr.index(input, index, 8)) & u64("0xffffffff"))
    index += 1
  end
  return true
end

func rsa_public_inverse32(odd_value: u64) do
  value: u64 is odd_value & u64("0xffffffff")
  if (value & 1) == 0 then return 0
  inverse: u64 is 1
  iteration: u64 is 0
  while iteration < 5 do
    inverse is (inverse * (2 - value * inverse)) & u64("0xffffffff")
    iteration += 1
  end
  return (0 - inverse) & u64("0xffffffff")
end

func rsa_public_double_mod(workspace: ptr[RsaPublicWorkspace], value: ptr) do
  if workspace == 0 or value == 0 or workspace.limb_count == 0 then return false
  carry: u64 is 0
  index: u64 is 0
  while index < workspace.limb_count do
    current: u64 is mem.read64(ptr.index(value, index, 8)) & u64("0xffffffff")
    doubled: u64 is (current << 1) | carry
    mem.write64(ptr.index(value, index, 8), doubled & u64("0xffffffff"))
    carry is (doubled >> 32) & 1
    index += 1
  end
  if carry != 0 then
    borrow: u64 is 0
    index is 0
    while index < workspace.limb_count do
      current: u64 is mem.read64(ptr.index(value, index, 8)) & u64("0xffffffff")
      modulus_value: u64 is mem.read64(ptr.index(workspace.modulus, index, 8)) & u64("0xffffffff")
      subtrahend: u64 is modulus_value + borrow
      next_borrow: u64 is 0
      if current < subtrahend then next_borrow is 1
      mem.write64(ptr.index(value, index, 8), (current - subtrahend) & u64("0xffffffff"))
      borrow is next_borrow
      index += 1
    end
    return true
  end
  if rsa_public_compare(value, workspace.modulus, workspace.limb_count) != 2 then
    return rsa_public_subtract(value, workspace.modulus, value, workspace.limb_count)
  end
  return true
end

func rsa_public_load_modulus(workspace: ptr[RsaPublicWorkspace], modulus: ptr, modulus_bytes: u64) do
  if workspace == 0 or workspace.initialized == 0 or modulus == 0 then return false
  if modulus_bytes < 128 or modulus_bytes > workspace.encoded_capacity then return false
  if modulus_bytes > workspace.limb_capacity * 4 then return false
  if mem.read8(modulus) == 0 or (mem.read8(ptr.add(modulus, modulus_bytes - 1)) & 1) == 0 then return false
  workspace.limb_count is (modulus_bytes + 3) / 4
  workspace.modulus_bytes is modulus_bytes
  if not rsa_public_load_be(workspace.modulus, workspace.limb_capacity, modulus, modulus_bytes) then return false
  workspace.n0_inverse is rsa_public_inverse32(mem.read64(workspace.modulus))
  if workspace.n0_inverse == 0 then return false
  if not rsa_public_clear(workspace.r2, workspace.limb_capacity) then return false
  mem.write64(workspace.r2, 1)
  rounds: u64 is workspace.limb_count * 64
  round: u64 is 0
  while round < rounds do
    if not rsa_public_double_mod(workspace, workspace.r2) then return false
    round += 1
  end
  return true
end

func rsa_public_montgomery_multiply(workspace: ptr[RsaPublicWorkspace], left: ptr, right: ptr, output: ptr) do
  if workspace == 0 or workspace.limb_count == 0 then return false
  if left == 0 or right == 0 or output == 0 then return false
  limbs: u64 is workspace.limb_count
  temporary: ptr is workspace.temporary
  if not rsa_public_clear(temporary, limbs * 2 + 2) then return false
  mask: u64 is u64("0xffffffff")
  i: u64 is 0
  while i < limbs do
    carry: u64 is 0
    j: u64 is 0
    while j < limbs do
      offset: u64 is i + j
      current: u64 is mem.read64(ptr.index(temporary, offset, 8)) & mask
      product: u64 is (mem.read64(ptr.index(left, i, 8)) & mask) * (mem.read64(ptr.index(right, j, 8)) & mask)
      combined: u64 is current + product + carry
      mem.write64(ptr.index(temporary, offset, 8), combined & mask)
      carry is combined >> 32
      j += 1
    end
    offset: u64 is i + limbs
    while carry != 0 do
      combined: u64 is (mem.read64(ptr.index(temporary, offset, 8)) & mask) + carry
      mem.write64(ptr.index(temporary, offset, 8), combined & mask)
      carry is combined >> 32
      offset += 1
    end
    i += 1
  end

  i is 0
  while i < limbs do
    multiplier: u64 is ((mem.read64(ptr.index(temporary, i, 8)) & mask) * workspace.n0_inverse) & mask
    carry: u64 is 0
    j: u64 is 0
    while j < limbs do
      offset: u64 is i + j
      current: u64 is mem.read64(ptr.index(temporary, offset, 8)) & mask
      product: u64 is multiplier * (mem.read64(ptr.index(workspace.modulus, j, 8)) & mask)
      combined: u64 is current + product + carry
      mem.write64(ptr.index(temporary, offset, 8), combined & mask)
      carry is combined >> 32
      j += 1
    end
    offset: u64 is i + limbs
    while carry != 0 do
      combined: u64 is (mem.read64(ptr.index(temporary, offset, 8)) & mask) + carry
      mem.write64(ptr.index(temporary, offset, 8), combined & mask)
      carry is combined >> 32
      offset += 1
    end
    i += 1
  end

  index: u64 is 0
  while index < limbs do
    mem.write64(ptr.index(output, index, 8), mem.read64(ptr.index(temporary, limbs + index, 8)) & mask)
    index += 1
  end
  high: u64 is mem.read64(ptr.index(temporary, limbs * 2, 8))
  if high != 0 or rsa_public_compare(output, workspace.modulus, limbs) != 2 then
    rsa_public_subtract(output, workspace.modulus, output, limbs)
  end
  return true
end

func rsa_public_exponent_65537(workspace: ptr[RsaPublicWorkspace], signature: ptr, signature_bytes: u64) do
  if workspace == 0 or workspace.limb_count == 0 or signature == 0 then return false
  if signature_bytes != workspace.modulus_bytes then return false
  if not rsa_public_load_be(workspace.operand, workspace.limb_capacity, signature, signature_bytes) then return false
  if rsa_public_compare(workspace.operand, workspace.modulus, workspace.limb_count) != 2 then return false
  if not rsa_public_montgomery_multiply(workspace, workspace.operand, workspace.r2, workspace.base) then return false
  if not rsa_public_copy_limbs(workspace.result, workspace.base, workspace.limb_count) then return false
  iteration: u64 is 0
  while iteration < 16 do
    if not rsa_public_montgomery_multiply(workspace, workspace.result, workspace.result, workspace.result) then return false
    iteration += 1
  end
  if not rsa_public_montgomery_multiply(workspace, workspace.result, workspace.base, workspace.result) then return false
  if not rsa_public_clear(workspace.operand, workspace.limb_capacity) then return false
  mem.write64(workspace.operand, 1)
  if not rsa_public_montgomery_multiply(workspace, workspace.result, workspace.operand, workspace.result) then return false
  return rsa_public_store_be(workspace.result, workspace.limb_count, workspace.encoded, workspace.modulus_bytes)
end

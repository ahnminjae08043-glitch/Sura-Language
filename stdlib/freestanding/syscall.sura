# Software-interrupt syscall dispatch for the freestanding x86-64 target.
# The frame layout matches a Sura `interrupt` function after register saving.
# The caller owns the IDT gate, privilege checks, user-pointer validation,
# synchronization, and per-CPU table policy.

struct SoftwareSyscallFrame packed do
  r15: u64
  r14: u64
  r13: u64
  r12: u64
  r11: u64
  r10: u64
  r9: u64
  r8: u64
  rdi: u64
  rsi: u64
  rbp: u64
  rbx: u64
  rdx: u64
  rcx: u64
  rax: u64
  error_code: u64
  rip: u64
  cs: u64
  rflags: u64
  interrupted_rsp: u64
  ss: u64
end

struct SoftwareSyscallTable do
  handlers: ptr
  capacity: u64
  invalid_result: u64
end

software_syscall_active: ptr is 0

func syscall_table_init(state: ptr[SoftwareSyscallTable], handlers: ptr, capacity: u64, invalid_result: u64) do
  global software_syscall_active
  if state == 0 or handlers == 0 or capacity == 0 then return false

  index: u64 is 0
  while index < capacity do
    mem.write64(ptr.index(handlers, index, 8), 0)
    index += 1
  end

  state.handlers is handlers
  state.capacity is capacity
  state.invalid_result is invalid_result
  software_syscall_active is state
  return true
end

func syscall_table_set(state: ptr[SoftwareSyscallTable], number: u64, handler: ptr) do
  if state == 0 or state.handlers == 0 or handler == 0 or number >= state.capacity then return false
  mem.write64(ptr.index(state.handlers, number, 8), handler)
  return true
end

func syscall_table_remove(state: ptr[SoftwareSyscallTable], number: u64) do
  if state == 0 or state.handlers == 0 or number >= state.capacity then return false
  mem.write64(ptr.index(state.handlers, number, 8), 0)
  return true
end

func syscall_dispatch(state: ptr[SoftwareSyscallTable], frame: ptr[SoftwareSyscallFrame]) do
  if state == 0 or state.handlers == 0 or frame == 0 then return 0

  number: u64 is frame.rax
  if number >= state.capacity then
    frame.rax is state.invalid_result
    return state.invalid_result
  end

  handler: ptr is mem.read64(ptr.index(state.handlers, number, 8))
  if handler == 0 then
    frame.rax is state.invalid_result
    return state.invalid_result
  end

  result: u64 is call.indirect(handler, frame.rdi, frame.rsi, frame.rdx, frame.r10, frame.r8)
  frame.rax is result
  return result
end

func software_syscall_dispatch(frame: ptr[SoftwareSyscallFrame]) interrupt do
  global software_syscall_active
  if software_syscall_active == 0 then
    frame.rax is u64("0xffffffffffffffff")
    return
  end
  state: ptr[SoftwareSyscallTable] is software_syscall_active
  syscall_dispatch(state, frame)
  return
end

# TLS 1.3 record protection for TLS_AES_128_GCM_SHA256.
#
# The caller supplies AES-GCM workspace storage, key/IV storage, plaintext
# workspace, and record buffers. Sequence numbers are advanced only after a
# complete authenticated operation.

import "aes128_gcm.sura"

struct Tls13RecordProtection do
  key: ptr
  iv: ptr
  nonce: ptr
  aes_workspace: ptr
  sequence: u64
  initialized: u64
end

struct Tls13RecordBuffers do
  key: ptr
  iv: ptr
  nonce: ptr
  aes_workspace: ptr
end

struct Tls13EncryptRequest do
  content: ptr
  content_bytes: u64
  content_type: u64
  padding_bytes: u64
  inner_plaintext: ptr
  inner_capacity: u64
  record: ptr
  record_capacity: u64
  record_bytes: u64
  aes_request: ptr
end

struct Tls13DecryptRequest do
  record: ptr
  record_bytes: u64
  plaintext: ptr
  plaintext_capacity: u64
  content_bytes: u64
  content_type: u64
  aes_request: ptr
end

func tls13_record_copy(destination: ptr, source: ptr, byte_count: u64) do
  if byte_count == 0 then return true
  if destination == 0 or source == 0 then return false
  index: u64 is 0
  while index < byte_count do
    mem.write8(ptr.add(destination, index), mem.read8(ptr.add(source, index)))
    index += 1
  end
  return true
end

func tls13_content_type_valid(content_type: u64) do
  return content_type == 20 or content_type == 21 or content_type == 22 or content_type == 23
end

func tls13_record_init(state: ptr[Tls13RecordProtection], buffers: ptr[Tls13RecordBuffers], key: ptr, iv: ptr) do
  if state == 0 or buffers == 0 or key == 0 or iv == 0 then return false
  if buffers.key == 0 or buffers.iv == 0 or buffers.nonce == 0 or buffers.aes_workspace == 0 then return false
  state.key is buffers.key
  state.iv is buffers.iv
  state.nonce is buffers.nonce
  state.aes_workspace is buffers.aes_workspace
  state.sequence is 0
  state.initialized is 1
  if not tls13_record_copy(state.key, key, 16) then return false
  if not tls13_record_copy(state.iv, iv, 12) then return false
  return tls13_record_copy(state.nonce, iv, 12)
end

func tls13_record_nonce(state: ptr[Tls13RecordProtection]) do
  if state == 0 or state.initialized == 0 then return false
  if not tls13_record_copy(state.nonce, state.iv, 12) then return false
  index: u64 is 0
  while index < 8 do
    sequence_byte: u64 is (state.sequence >> ((7 - index) * 8)) & 255
    offset: u64 is 4 + index
    mem.write8(ptr.add(state.nonce, offset), mem.read8(ptr.add(state.nonce, offset)) ^ sequence_byte)
    index += 1
  end
  return true
end

func tls13_record_write_header(record: ptr, encrypted_bytes: u64) do
  if record == 0 or encrypted_bytes > 16640 then return false
  mem.write8(record, 23)
  mem.write8(ptr.add(record, 1), 3)
  mem.write8(ptr.add(record, 2), 3)
  mem.write8(ptr.add(record, 3), (encrypted_bytes >> 8) & 255)
  mem.write8(ptr.add(record, 4), encrypted_bytes & 255)
  return true
end

func tls13_record_encrypt(state: ptr[Tls13RecordProtection], request: ptr[Tls13EncryptRequest]) do
  if state == 0 or state.initialized == 0 or request == 0 then return false
  if not tls13_content_type_valid(request.content_type) then return false
  if request.content_bytes != 0 and request.content == 0 then return false
  if request.content_bytes > 16384 or request.padding_bytes > 255 then return false
  inner_bytes: u64 is request.content_bytes + 1 + request.padding_bytes
  encrypted_bytes: u64 is inner_bytes + 16
  if encrypted_bytes > 16640 then return false
  if request.inner_plaintext == 0 or request.inner_capacity < inner_bytes then return false
  if request.record == 0 or request.record_capacity < encrypted_bytes + 5 then return false
  if request.aes_request == 0 or state.sequence == u64("0xffffffffffffffff") then return false
  if not tls13_record_copy(request.inner_plaintext, request.content, request.content_bytes) then return false
  mem.write8(ptr.add(request.inner_plaintext, request.content_bytes), request.content_type)
  padding_index: u64 is 0
  while padding_index < request.padding_bytes do
    mem.write8(ptr.add(request.inner_plaintext, request.content_bytes + 1 + padding_index), 0)
    padding_index += 1
  end
  if not tls13_record_write_header(request.record, encrypted_bytes) then return false
  if not tls13_record_nonce(state) then return false

  aes: ptr[Aes128GcmRequest] is request.aes_request
  aes.key is state.key
  aes.nonce is state.nonce
  aes.nonce_bytes is 12
  aes.aad is request.record
  aes.aad_bytes is 5
  aes.input is request.inner_plaintext
  aes.input_bytes is inner_bytes
  aes.output is ptr.add(request.record, 5)
  aes.output_capacity is request.record_capacity - 5
  aes.tag is ptr.add(request.record, 5 + inner_bytes)
  aes.tag_bytes is 16
  aes_workspace: ptr[Aes128GcmWorkspace] is state.aes_workspace
  if not aes128_gcm_encrypt(aes_workspace, aes) then return false
  request.record_bytes is encrypted_bytes + 5
  state.sequence += 1
  return true
end

func tls13_record_decrypt(state: ptr[Tls13RecordProtection], request: ptr[Tls13DecryptRequest]) do
  if state == 0 or state.initialized == 0 or request == 0 then return false
  if request.record == 0 or request.record_bytes < 22 or request.record_bytes > 16645 then return false
  if mem.read8(request.record) != 23 then return false
  if mem.read8(ptr.add(request.record, 1)) != 3 or mem.read8(ptr.add(request.record, 2)) != 3 then return false
  encrypted_bytes: u64 is (mem.read8(ptr.add(request.record, 3)) << 8) | mem.read8(ptr.add(request.record, 4))
  if encrypted_bytes + 5 != request.record_bytes or encrypted_bytes < 17 or encrypted_bytes > 16640 then return false
  plaintext_bytes: u64 is encrypted_bytes - 16
  if request.plaintext == 0 or request.plaintext_capacity < plaintext_bytes then return false
  if request.aes_request == 0 or state.sequence == u64("0xffffffffffffffff") then return false
  if not tls13_record_nonce(state) then return false

  aes: ptr[Aes128GcmRequest] is request.aes_request
  aes.key is state.key
  aes.nonce is state.nonce
  aes.nonce_bytes is 12
  aes.aad is request.record
  aes.aad_bytes is 5
  aes.input is ptr.add(request.record, 5)
  aes.input_bytes is plaintext_bytes
  aes.output is request.plaintext
  aes.output_capacity is request.plaintext_capacity
  aes.tag is ptr.add(request.record, 5 + plaintext_bytes)
  aes.tag_bytes is 16
  aes_workspace: ptr[Aes128GcmWorkspace] is state.aes_workspace
  if not aes128_gcm_decrypt(aes_workspace, aes) then return false

  content_end: i64 is plaintext_bytes - 1
  while content_end >= 0 and mem.read8(ptr.add(request.plaintext, content_end)) == 0 do
    content_end -= 1
  end
  if content_end < 0 then return false
  content_type: u64 is mem.read8(ptr.add(request.plaintext, content_end))
  if not tls13_content_type_valid(content_type) then return false
  request.content_type is content_type
  request.content_bytes is content_end
  state.sequence += 1
  return true
end

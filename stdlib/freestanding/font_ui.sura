# Antialiased UI font renderer for ASCII and modern precomposed Hangul.
#
# The generated atlas uses Noto Sans CJK KR Regular under SIL OFL 1.1. Four
# 2-bit coverage samples are packed into each byte. The renderer blends against
# the existing framebuffer pixel, so callers do not need an opaque text box.

import "font_hangul.sura"
import "font_ui_atlas.sura"

func font_ui_glyph_index(codepoint: u64) do
  codepoint is font_hangul_display_codepoint(codepoint)
  if codepoint >= 32 and codepoint <= 126 then return codepoint - 32
  if codepoint >= 44032 and codepoint <= 55203 then return 95 + codepoint - 44032
  return u64("0xffffffffffffffff")
end

func font_ui_codepoint_advance(codepoint: u64) do
  codepoint is font_hangul_display_codepoint(codepoint)
  if codepoint >= 44032 and codepoint <= 55203 then return 15
  if codepoint >= 32 and codepoint <= 126 then return mem.read8(ptr.add(font_ui_ascii_advance, codepoint - 32))
  return 7
end

func font_ui_blend(surface: ptr[FramebufferSurface], background: u32, foreground: u32, coverage: u64) do
  if surface == 0 or coverage == 0 then return background
  if coverage >= 3 then return foreground
  background_red: u64 is background & 255
  background_blue: u64 is (background >> 16) & 255
  foreground_red: u64 is foreground & 255
  foreground_blue: u64 is (foreground >> 16) & 255
  if surface.pixel_format == 1 then
    swap: u64 is background_red
    background_red is background_blue
    background_blue is swap
    swap is foreground_red
    foreground_red is foreground_blue
    foreground_blue is swap
  end
  background_green: u64 is (background >> 8) & 255
  foreground_green: u64 is (foreground >> 8) & 255
  inverse: u64 is 3 - coverage
  red: u64 is (background_red * inverse + foreground_red * coverage + 1) / 3
  green: u64 is (background_green * inverse + foreground_green * coverage + 1) / 3
  blue: u64 is (background_blue * inverse + foreground_blue * coverage + 1) / 3
  return fb_rgb(surface, red, green, blue)
end

func font_ui_draw_char(surface: ptr[FramebufferSurface], x: u64, y: u64, codepoint: u64, style: ptr[BitmapFontStyle]) do
  if surface == 0 or style == 0 or style.scale == 0 then return false
  codepoint is font_hangul_display_codepoint(codepoint)
  glyph: u64 is font_ui_glyph_index(codepoint)
  if glyph == u64("0xffffffffffffffff") then
    return font5x7_draw_char(surface, x, y + 4, 63, style)
  end
  row: u64 is 0
  while row < 16 do
    column: u64 is 0
    while column < 16 do
      packed: u64 is mem.read8(ptr.add(font_ui_glyph_atlas, glyph * 64 + row * 4 + column / 4))
      shift: u64 is (3 - column % 4) * 2
      coverage: u64 is (packed >> shift) & 3
      if coverage != 0 then
        background: u32 is fb_get_pixel(surface, x + column, y + row)
        color: u32 is font_ui_blend(surface, background, style.foreground, coverage)
        fb_put_pixel(surface, x + column, y + row, color)
      end
      column += 1
    end
    row += 1
  end
  return true
end

func font_ui_draw_utf8_text(surface: ptr[FramebufferSurface], x: u64, y: u64, text: ptr, length: u64, style: ptr[BitmapFontStyle]) do
  global font_utf8_consumed
  if surface == 0 or text == 0 or style == 0 or style.scale == 0 then return false
  origin_x: u64 is x
  cursor_x: u64 is x
  cursor_y: u64 is y
  index: u64 is 0
  while index < length do
    if mem.read8(ptr.add(text, index)) == 0 then return true
    codepoint: u64 is font_utf8_next(text, length, index, addr_of(font_utf8_consumed))
    if font_utf8_consumed == 0 then return false
    codepoint is font_hangul_display_codepoint(codepoint)
    if codepoint == 10 then
      cursor_x is origin_x
      cursor_y += 18
    else
      if not font_ui_draw_char(surface, cursor_x, cursor_y, codepoint, style) then return false
      cursor_x += font_ui_codepoint_advance(codepoint)
    end
    index += font_utf8_consumed
  end
  return true
end

func font_ui_utf8_width(text: ptr, length: u64) do
  global font_utf8_consumed
  if text == 0 then return 0
  width: u64 is 0
  line_width: u64 is 0
  index: u64 is 0
  while index < length and mem.read8(ptr.add(text, index)) != 0 do
    codepoint: u64 is font_utf8_next(text, length, index, addr_of(font_utf8_consumed))
    if font_utf8_consumed == 0 then return width
    codepoint is font_hangul_display_codepoint(codepoint)
    if codepoint == 10 then
      if line_width > width then width is line_width
      line_width is 0
    else
      line_width += font_ui_codepoint_advance(codepoint)
    end
    index += font_utf8_consumed
  end
  if line_width > width then width is line_width
  return width
end

font_ui_box_style is static.struct(BitmapFontStyle)

func font_ui_utf8_line_at(text: ptr, length: u64, width: u64, stop_index: u64) do
  global font_utf8_consumed
  if text == 0 or width == 0 then return 0
  if stop_index > length then stop_index is length
  line: u64 is 0
  line_width: u64 is 0
  index: u64 is 0
  while index < length and mem.read8(ptr.add(text, index)) != 0 do
    codepoint: u64 is font_utf8_next(text, length, index, addr_of(font_utf8_consumed))
    if font_utf8_consumed == 0 then return line
    codepoint is font_hangul_display_codepoint(codepoint)
    if codepoint == 10 then
      if index >= stop_index then return line
      line += 1
      line_width is 0
    else
      advance: u64 is font_ui_codepoint_advance(codepoint)
      if line_width != 0 and line_width + advance > width then
        line += 1
        line_width is 0
      end
      if index >= stop_index then return line
      line_width += advance
    end
    index += font_utf8_consumed
  end
  return line
end

func font_ui_draw_utf8_box(surface: ptr[FramebufferSurface], text: ptr, length: u64, box: ptr[FontUtf8TextBox], style: ptr[BitmapFontStyle]) do
  global font_utf8_consumed
  if surface == 0 or text == 0 or box == 0 or style == 0 then return false
  if style.scale == 0 or box.width == 0 or box.max_lines == 0 then return false
  line_height: u64 is box.line_height
  if line_height == 0 then line_height is 18
  box.cursor_x is box.x
  box.cursor_y is box.y
  box.cursor_line is 0
  box.cursor_visible is 0
  cursor_index: u64 is box.cursor_index
  if cursor_index > length then cursor_index is length
  selection_start: u64 is box.selection_start
  selection_end: u64 is box.selection_end
  if selection_start > length then selection_start is length
  if selection_end > length then selection_end is length
  if selection_start > selection_end then
    swap: u64 is selection_start
    selection_start is selection_end
    selection_end is swap
  end

  line: u64 is 0
  line_width: u64 is 0
  index: u64 is 0
  cursor_set: bool is false
  while index < length and mem.read8(ptr.add(text, index)) != 0 do
    codepoint: u64 is font_utf8_next(text, length, index, addr_of(font_utf8_consumed))
    if font_utf8_consumed == 0 then return false
    codepoint is font_hangul_display_codepoint(codepoint)
    if codepoint == 10 then
      if index == cursor_index then
        box.cursor_line is line
        if line >= box.first_line and line < box.first_line + box.max_lines then
          box.cursor_x is box.x + line_width
          box.cursor_y is box.y + (line - box.first_line) * line_height
          box.cursor_visible is 1
        end
        cursor_set is true
      end
      if index < selection_end and index + font_utf8_consumed > selection_start then
        if line >= box.first_line and line < box.first_line + box.max_lines then
          fb_fill_rect(surface, box.x + line_width, box.y + (line - box.first_line) * line_height, 4, 16, box.selection_color)
        end
      end
      line += 1
      line_width is 0
    else
      advance: u64 is font_ui_codepoint_advance(codepoint)
      if line_width != 0 and line_width + advance > box.width then
        line += 1
        line_width is 0
      end
      if index == cursor_index then
        box.cursor_line is line
        if line >= box.first_line and line < box.first_line + box.max_lines then
          box.cursor_x is box.x + line_width
          box.cursor_y is box.y + (line - box.first_line) * line_height
          box.cursor_visible is 1
        end
        cursor_set is true
      end
      if line >= box.first_line and line < box.first_line + box.max_lines then
        draw_x: u64 is box.x + line_width
        draw_y: u64 is box.y + (line - box.first_line) * line_height
        if index < selection_end and index + font_utf8_consumed > selection_start then
          fb_fill_rect(surface, draw_x, draw_y, advance, 16, box.selection_color)
        end
        draw_color: u32 is style.foreground
        if box.syntax_map != 0 then
          syntax_kind: u64 is mem.read8(ptr.add(box.syntax_map, index))
          if syntax_kind == 1 then draw_color is box.syntax_keyword
          if syntax_kind == 2 then draw_color is box.syntax_string
          if syntax_kind == 3 then draw_color is box.syntax_comment
          if syntax_kind == 4 then draw_color is box.syntax_number
        end
        draw_style: ptr[BitmapFontStyle] is font_ui_box_style
        draw_style.foreground is draw_color
        draw_style.background is style.background
        draw_style.scale is 1
        draw_style.opaque is style.opaque
        if not font_ui_draw_char(surface, draw_x, draw_y, codepoint, draw_style) then return false
      end
      line_width += advance
    end
    index += font_utf8_consumed
  end

  if not cursor_set then
    box.cursor_line is line
    if line >= box.first_line and line < box.first_line + box.max_lines then
      box.cursor_x is box.x + line_width
      box.cursor_y is box.y + (line - box.first_line) * line_height
      box.cursor_visible is 1
    end
  end
  return true
end

# Bounded TLS 1.3 encrypted-handshake message parsers.

struct Tls13CertificateList do
  certificate_count: u64
  certificate0: ptr
  certificate0_bytes: u64
  certificate1: ptr
  certificate1_bytes: u64
  certificate2: ptr
  certificate2_bytes: u64
  certificate3: ptr
  certificate3_bytes: u64
end

struct Tls13CertificateVerifyMessage do
  signature_scheme: u64
  signature: ptr
  signature_bytes: u64
end

tls13_message_alpn_http11 is static.bytes([104, 116, 116, 112, 47, 49, 46, 49], 1)

func tls13_message_u16(input: ptr, offset: u64) do
  return (mem.read8(ptr.add(input, offset)) << 8) | mem.read8(ptr.add(input, offset + 1))
end

func tls13_message_u24(input: ptr, offset: u64) do
  return (mem.read8(ptr.add(input, offset)) << 16) | (mem.read8(ptr.add(input, offset + 1)) << 8) | mem.read8(ptr.add(input, offset + 2))
end

func tls13_handshake_message_valid(message: ptr, message_bytes: u64, expected_type: u64) do
  if message == 0 or message_bytes < 4 then return false
  if mem.read8(message) != expected_type then return false
  return tls13_message_u24(message, 1) == message_bytes - 4
end

func tls13_encrypted_extensions_parse(message: ptr, message_bytes: u64) do
  if not tls13_handshake_message_valid(message, message_bytes, 8) then return false
  if message_bytes < 6 then return false
  extensions_bytes: u64 is tls13_message_u16(message, 4)
  if extensions_bytes != message_bytes - 6 then return false
  cursor: u64 is 6
  alpn_seen: u64 is 0
  while cursor < message_bytes do
    if message_bytes - cursor < 4 then return false
    extension_type: u64 is tls13_message_u16(message, cursor)
    extension_bytes: u64 is tls13_message_u16(message, cursor + 2)
    cursor += 4
    if extension_bytes > message_bytes - cursor then return false
    if extension_type == 16 then
      if alpn_seen != 0 or extension_bytes != 11 then return false
      if tls13_message_u16(message, cursor) != 9 then return false
      if mem.read8(ptr.add(message, cursor + 2)) != 8 then return false
      index: u64 is 0
      while index < 8 do
        if mem.read8(ptr.add(message, cursor + 3 + index)) != mem.read8(ptr.add(tls13_message_alpn_http11, index)) then return false
        index += 1
      end
      alpn_seen is 1
    end
    cursor is cursor + extension_bytes
  end
  return cursor == message_bytes
end

func tls13_certificate_list_clear(result: ptr[Tls13CertificateList]) do
  if result == 0 then return false
  result.certificate_count is 0
  result.certificate0 is 0
  result.certificate0_bytes is 0
  result.certificate1 is 0
  result.certificate1_bytes is 0
  result.certificate2 is 0
  result.certificate2_bytes is 0
  result.certificate3 is 0
  result.certificate3_bytes is 0
  return true
end

func tls13_certificate_list_set(result: ptr[Tls13CertificateList], index: u64, certificate: ptr, certificate_bytes: u64) do
  if result == 0 or certificate == 0 or certificate_bytes == 0 then return false
  if index == 0 then
    result.certificate0 is certificate
    result.certificate0_bytes is certificate_bytes
    return true
  end
  if index == 1 then
    result.certificate1 is certificate
    result.certificate1_bytes is certificate_bytes
    return true
  end
  if index == 2 then
    result.certificate2 is certificate
    result.certificate2_bytes is certificate_bytes
    return true
  end
  if index == 3 then
    result.certificate3 is certificate
    result.certificate3_bytes is certificate_bytes
    return true
  end
  return false
end

func tls13_certificate_message_parse(message: ptr, message_bytes: u64, result: ptr[Tls13CertificateList]) do
  if result == 0 or not tls13_certificate_list_clear(result) then return false
  if not tls13_handshake_message_valid(message, message_bytes, 11) then return false
  if message_bytes < 8 then return false
  context_bytes: u64 is mem.read8(ptr.add(message, 4))
  if context_bytes != 0 then return false
  cursor: u64 is 5
  if message_bytes - cursor < 3 then return false
  list_bytes: u64 is tls13_message_u24(message, cursor)
  cursor += 3
  if list_bytes != message_bytes - cursor then return false
  list_end: u64 is cursor + list_bytes
  count: u64 is 0
  while cursor < list_end do
    if count >= 4 or list_end - cursor < 3 then return false
    certificate_bytes: u64 is tls13_message_u24(message, cursor)
    cursor += 3
    if certificate_bytes < 128 or certificate_bytes > list_end - cursor then return false
    certificate: ptr is ptr.add(message, cursor)
    cursor is cursor + certificate_bytes
    if list_end - cursor < 2 then return false
    extension_bytes: u64 is tls13_message_u16(message, cursor)
    cursor += 2
    if extension_bytes > list_end - cursor then return false
    if not tls13_certificate_list_set(result, count, certificate, certificate_bytes) then return false
    cursor is cursor + extension_bytes
    count += 1
  end
  if count == 0 or cursor != list_end then return false
  result.certificate_count is count
  return true
end

func tls13_certificate_verify_message_parse(message: ptr, message_bytes: u64, result: ptr[Tls13CertificateVerifyMessage]) do
  if result == 0 then return false
  if not tls13_handshake_message_valid(message, message_bytes, 15) then return false
  if message_bytes < 8 then return false
  signature_bytes: u64 is tls13_message_u16(message, 6)
  if signature_bytes == 0 or signature_bytes != message_bytes - 8 then return false
  result.signature_scheme is tls13_message_u16(message, 4)
  result.signature is ptr.add(message, 8)
  result.signature_bytes is signature_bytes
  return true
end

func tls13_finished_message_parse(message: ptr, message_bytes: u64) do
  if not tls13_handshake_message_valid(message, message_bytes, 20) then return 0
  if message_bytes != 36 then return 0
  return ptr.add(message, 4)
end

# Bounded X.509 path verification for the freestanding Sura TLS client.
#
# The leaf and untrusted intermediates are supplied separately from the
# built-in trust anchors. A parsed certificate is never accepted merely
# because it is self-signed.

import "x509.sura"
import "rsa_sha256.sura"
import "rsa_sha384.sura"

struct X509ChainVerifyRequest do
  certificates: ptr
  certificate_count: u64
  trusted_roots: ptr
  trusted_root_count: u64
  hostname: ptr
  hostname_bytes: u64
  current_time: u64
  rsa_workspace: ptr
  rsa_request: ptr
  rsa_sha384_workspace: ptr
  rsa_sha384_request: ptr
  time_scratch: ptr
end

func x509_bytes_equal(left: ptr, left_bytes: u64, right: ptr, right_bytes: u64) do
  if left_bytes != right_bytes then return false
  if left_bytes == 0 then return true
  if left == 0 or right == 0 then return false
  difference: u64 is 0
  index: u64 is 0
  while index < left_bytes do
    difference is difference | (mem.read8(ptr.add(left, index)) ^ mem.read8(ptr.add(right, index)))
    index += 1
  end
  return difference == 0
end

func x509_chain_pointer_at(pointers: ptr, count: u64, index: u64) do
  if pointers == 0 or index >= count then return 0
  return mem.read64(ptr.add(pointers, index * 8))
end

func x509_leaf_policy(certificate: ptr[X509Certificate], hostname: ptr, hostname_bytes: u64, current_time: u64, time_scratch: ptr[X509DateTime], workspace: ptr[X509Workspace]) do
  if certificate == 0 or workspace == 0 then return false
  if certificate.is_ca != 0 then return false
  if certificate.has_san == 0 then return false
  if not x509_hostname_matches(certificate, hostname, hostname_bytes, workspace) then return false
  if not x509_certificate_time_valid(certificate, current_time, time_scratch) then return false
  if certificate.has_key_usage != 0 and (certificate.key_usage & 32768) == 0 then return false
  return true
end

func x509_ca_policy(certificate: ptr[X509Certificate], current_time: u64, time_scratch: ptr[X509DateTime]) do
  if certificate == 0 then return false
  if certificate.has_basic_constraints == 0 or certificate.is_ca == 0 then return false
  if certificate.has_key_usage != 0 and (certificate.key_usage & 1024) == 0 then return false
  return x509_certificate_time_valid(certificate, current_time, time_scratch)
end

func x509_verify_link(child: ptr[X509Certificate], issuer: ptr[X509Certificate], rsa_workspace: ptr[RsaSha256Workspace], rsa_request: ptr[RsaSha256VerifyRequest], rsa_sha384_workspace: ptr[RsaSha384Workspace], rsa_sha384_request: ptr[RsaSha384VerifyRequest]) do
  if child == 0 or issuer == 0 then return false
  if child.signature_algorithm != 1 and child.signature_algorithm != 4 then return false
  if not x509_bytes_equal(child.issuer, child.issuer_bytes, issuer.subject, issuer.subject_bytes) then return false
  if issuer.has_basic_constraints == 0 or issuer.is_ca == 0 then return false
  if issuer.has_key_usage != 0 and (issuer.key_usage & 1024) == 0 then return false
  if child.signature_algorithm == 1 then
    if rsa_workspace == 0 or rsa_request == 0 then return false
    rsa_request.modulus is issuer.modulus
    rsa_request.modulus_bytes is issuer.modulus_bytes
    rsa_request.exponent is issuer.exponent
    rsa_request.signature is child.signature
    rsa_request.signature_bytes is child.signature_bytes
    rsa_request.message is child.tbs
    rsa_request.message_bytes is child.tbs_bytes
    return rsa_pkcs1_v15_sha256_verify(rsa_workspace, rsa_request)
  end
  if rsa_sha384_workspace == 0 or rsa_sha384_request == 0 then return false
  rsa_sha384_request.modulus is issuer.modulus
  rsa_sha384_request.modulus_bytes is issuer.modulus_bytes
  rsa_sha384_request.exponent is issuer.exponent
  rsa_sha384_request.signature is child.signature
  rsa_sha384_request.signature_bytes is child.signature_bytes
  rsa_sha384_request.message is child.tbs
  rsa_sha384_request.message_bytes is child.tbs_bytes
  return rsa_pkcs1_v15_sha384_verify(rsa_sha384_workspace, rsa_sha384_request)
end

func x509_verify_chain(request: ptr[X509ChainVerifyRequest], parse_workspace: ptr[X509Workspace]) do
  if request == 0 or parse_workspace == 0 then return false
  if request.certificate_count == 0 or request.certificate_count > 4 then return false
  if request.trusted_root_count == 0 or request.trusted_root_count > 16 then return false
  leaf: ptr[X509Certificate] is x509_chain_pointer_at(request.certificates, request.certificate_count, 0)
  if not x509_leaf_policy(leaf, request.hostname, request.hostname_bytes, request.current_time, request.time_scratch, parse_workspace) then return false

  index: u64 is 1
  while index < request.certificate_count do
    certificate: ptr[X509Certificate] is x509_chain_pointer_at(request.certificates, request.certificate_count, index)
    if not x509_ca_policy(certificate, request.current_time, request.time_scratch) then return false
    child: ptr[X509Certificate] is x509_chain_pointer_at(request.certificates, request.certificate_count, index - 1)
    if not x509_verify_link(child, certificate, request.rsa_workspace, request.rsa_request, request.rsa_sha384_workspace, request.rsa_sha384_request) then return false
    index += 1
  end

  last: ptr[X509Certificate] is x509_chain_pointer_at(request.certificates, request.certificate_count, request.certificate_count - 1)
  root_index: u64 is 0
  while root_index < request.trusted_root_count do
    root: ptr[X509Certificate] is x509_chain_pointer_at(request.trusted_roots, request.trusted_root_count, root_index)
    if root != 0 then
      if x509_bytes_equal(last.der, last.der_bytes, root.der, root.der_bytes) then return true
      if x509_verify_link(last, root, request.rsa_workspace, request.rsa_request, request.rsa_sha384_workspace, request.rsa_sha384_request) then return true
    end
    root_index += 1
  end
  return false
end

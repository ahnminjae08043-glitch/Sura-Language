// ================================
// 수라 표준 라이브러리: os
// 시스템 프로그래밍 지원
// 사용법: use os
// ================================
// 내장 명령어 (interpreter.hpp 지원 필요):
//   system_exec 명령어 결과      → 시스템 명령어 실행
//   env_get 변수명 결과          → 환경변수 읽기
//   env_set 변수명 값            → 환경변수 설정
//   dir_list 경로 결과           → 디렉토리 목록
//   file_exists 경로 결과        → 파일 존재 여부
//   file_delete 경로             → 파일 삭제
//   file_copy 소스 목표          → 파일 복사
//   file_move 소스 목표          → 파일 이동
//   dir_create 경로              → 디렉토리 생성
//   dir_delete 경로              → 디렉토리 삭제

// ================================
// 환경변수 관리
// ================================

// 환경변수 읽기
// 입력: _env_name
// 출력: _value
func get_env do
    env_get _env_name _value
end

// 환경변수 설정
// 입력: _env_name, _value
func set_env do
    env_set _env_name _value
end

// 현재 작업 디렉토리
// 출력: _cwd
func get_cwd do
    env_get "PWD" _cwd
end

// ================================
// 파일 시스템
// ================================

// 파일 존재 여부 확인
// 입력: _filepath
// 출력: _exists (0 또는 1)
func path_exists do
    file_exists _filepath _exists
end

// 파일 크기 (바이트)
// 입력: _filepath
// 출력: _size
func file_size do
    # 파일 크기 조회
end

// 파일 수정 시간
// 입력: _filepath
// 출력: _timestamp
func file_modified_time do
    # 파일 수정 시간 조회
end

// 파일 복사
// 입력: _source, _dest
func copy_file do
    file_copy _source _dest
end

// 파일 이동/이름변경
// 입력: _source, _dest
func move_file do
    file_move _source _dest
end

// 파일 삭제
// 입력: _filepath
func delete_file do
    file_delete _filepath
end

// ================================
// 디렉토리 관리
// ================================

// 디렉토리 목록
// 입력: _dirpath
// 출력: _items (배열)
func list_dir do
    dir_list _dirpath _items
end

// 디렉토리 생성
// 입력: _dirpath
func create_dir do
    dir_create _dirpath
end

// 디렉토리 삭제
// 입력: _dirpath
func delete_dir do
    dir_delete _dirpath
end


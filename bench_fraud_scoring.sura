# Real-world workload: score a payment transaction stream for fraud risk.
# Models amount, merchant, country, time, device age, velocity, and account age checks.

func transaction_risk(i) do
  amount_cents is 1200 + ((i * 7919) % 250000)
  merchant is (i * 37 + 11) % 97
  country is (i * 53 + 17) % 29
  hour is (i * 13) % 24
  device_age is (i * 19 + 5) % 365
  prior_declines is (i * 7) % 6
  velocity is (i * 23 + merchant) % 40
  account_age is 1 + ((i * 31) % 900)

  risk is prior_declines * 95 + velocity * 7
  if amount_cents > 150000 then
    risk is risk + 180
  end
  if country == 3 or country == 17 then
    risk is risk + 140
  end
  if hour < 5 or hour > 22 then
    risk is risk + 75
  end
  if device_age < 7 then
    risk is risk + 130
  end
  if account_age > 180 and prior_declines == 0 then
    risk is risk - 90
  end
  if merchant % 13 == 0 then
    risk is risk + 60
  end
  return risk
end

runs is 5
transactions is 220000
total_ms is 0
checksum is 0

repeat runs do
  t0 is clock()
  blocked is 0
  reviewed is 0
  total is 0
  max_risk is -999999
  i is 0
  while i < transactions do
    risk is transaction_risk(i)
    if risk >= 520 then
      blocked is blocked + 1
    elif risk >= 330 then
      reviewed is reviewed + 1
    end
    if risk > max_risk then
      max_risk is risk
    end
    total is total + risk
    i is i + 1
  end
  t1 is clock()
  total_ms is total_ms + (t1 - t0) * 1000
  checksum is blocked * 11 + reviewed * 7 + max_risk + total
end

avg is total_ms / runs
print "fraud transactions: {transactions}"
print "checksum: {checksum}"
print "avg ({runs} runs): {avg} ms"

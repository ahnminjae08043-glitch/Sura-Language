nums is [3, 1, 4, 1, 5]
result is nums.filter(func(x) do return x > 2 end).map(func(x) do return x * 2 end)
print result.join(",")
print nums.includes(4)
print nums.index_of(5)
print nums.slice(1, 3).join(":")
print nums.concat([9]).join(",")
nums.unshift(8)
print nums.shift()
print nums.pop()
print nums.sort(func(a, b) do return a < b end).reverse().join(",")

arr is [1, [2, [3]], 4]
print arr.flat().join("-")

words is "hello world".split(" ")
print words.len()
print "  AbC  ".trim().lower().repeat(2)
print "hello world".replace("world", "sura")
print "hello".contains("ell")
print "hello".starts_with("he")
print "hello".ends_with("lo")
print "hello".index_of("l")
print "hello".sub(1, 3)
print "42".to_num() + 8

d is {"a": 1, "b": 2}
print d.has("a")
print d.keys().len()
print d.values().len()
print d.delete("a")
print d.has("a")

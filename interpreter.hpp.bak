// ════════════════════════════════════════════════════════════════════
//  ANSI 색상 (Windows MSYS2/MinGW 터미널 지원)
// ════════════════════════════════════════════════════════════════════
namespace SuraColor {
    inline const char* RESET   = "\033[0m";
    inline const char* BOLD    = "\033[1m";
    inline const char* RED     = "\033[1;31m";
    inline const char* YELLOW  = "\033[1;33m";
    inline const char* CYAN    = "\033[1;36m";
    inline const char* GREEN   = "\033[1;32m";
    inline const char* GRAY    = "\033[0;90m";
    inline const char* MAGENTA = "\033[1;35m";
}

// ════════════════════════════════════════════════════════════════════
//  런타임 오류
// ════════════════════════════════════════════════════════════════════
struct RuntimeError : std::runtime_error {
    int         line;
    std::string raw_msg;
    RuntimeError(const std::string& msg, int ln = 0)
        : std::runtime_error("[수라 런타임 오류] " +
            (ln ? std::to_string(ln) + "줄: " : "") + msg)
        , line(ln), raw_msg(msg) {}
};

// ════════════════════════════════════════════════════════════════════
//  제어 흐름 신호
// ════════════════════════════════════════════════════════════════════
struct BreakSignal    {};
struct ContinueSignal {};
struct ReturnSignal   { Value value; };
struct SuraThrow      { std::string message; int line = 0; };

// ════════════════════════════════════════════════════════════════════
//  ★ 전역 난수 엔진 — 프로그램 시작 시 한 번만 초기화
//    chrono 기반 고해상도 시드로 매 실행마다 다른 결과 보장
// ════════════════════════════════════════════════════════════════════
namespace SuraRandom {
    // Mersenne Twister — rand()보다 품질 높고 편향 없음
    inline std::mt19937_64 engine{
        static_cast<uint64_t>(
            std::chrono::high_resolution_clock::now().time_since_epoch().count()
        )
    };

    // [0.0, 1.0) 실수 난수
    inline double real() {
        std::uniform_real_distribution<double> dist(0.0, 1.0);
        return dist(engine);
    }

    // [lo, hi] 정수 난수
    inline int integer(int lo, int hi) {
        if (lo > hi) std::swap(lo, hi);
        std::uniform_int_distribution<int> dist(lo, hi);
        return dist(engine);
    }

    // 시드 재설정 (사용자가 원할 때)
    inline void seed(uint64_t s) { engine.seed(s); }
}

// ════════════════════════════════════════════════════════════════════
//  Scope — 변수 스코프 관리
// ════════════════════════════════════════════════════════════════════
class Scope {
    std::vector<std::unordered_map<std::string, Value>> stack;
public:
    Scope() { push(); }

    void push() { stack.emplace_back(); }
    void pop()  { if (stack.size() > 1) stack.pop_back(); }
    int  depth() const { return (int)stack.size(); }

    Value get(const std::string& name) const {
        for (int i = (int)stack.size() - 1; i >= 0; --i) {
            auto it = stack[i].find(name);
            if (it != stack[i].end()) return it->second;
        }
        // ★ 개선된 에러 메시지: 유사한 변수명 제안
        std::string hint = find_similar(name);
        std::string msg = "정의되지 않은 변수: '" + name + "'\n"
                          "  힌트: '" + name + " is 값' 으로 먼저 선언하세요";
        if (!hint.empty())
            msg += "\n  혹시 '" + hint + "' 을(를) 쓰려고 하셨나요?";
        throw RuntimeError(msg);
    }

    Value& get_ref(const std::string& name) {
        for (int i = (int)stack.size() - 1; i >= 0; --i) {
            auto it = stack[i].find(name);
            if (it != stack[i].end()) return it->second;
        }
        throw RuntimeError("정의되지 않은 변수: '" + name + "'");
    }

    void set(const std::string& name, Value val) {
        for (int i = (int)stack.size() - 1; i >= 0; --i) {
            auto it = stack[i].find(name);
            if (it != stack[i].end()) { it->second = std::move(val); return; }
        }
        stack.back().try_emplace(name, std::move(val));
    }

    void set_local(const std::string& name, Value val) {
        stack.back()[name] = std::move(val);
    }

    bool exists(const std::string& name) const {
        for (int i = (int)stack.size() - 1; i >= 0; --i)
            if (stack[i].find(name) != stack[i].end()) return true;
        return false;
    }

    // ★ 유사 변수명 탐색 (레벤슈타인 거리 1~2)
    std::string find_similar(const std::string& name) const {
        for (int i = (int)stack.size() - 1; i >= 0; --i) {
            for (auto& [k, _] : stack[i]) {
                if (k == name) continue;
                if (levenshtein(k, name) <= 2) return k;
            }
        }
        return "";
    }

    struct Guard {
        Scope& s;
        bool   dismissed = false;
        explicit Guard(Scope& s) : s(s) { s.push(); }
        ~Guard() { if (!dismissed) s.pop(); }
    };
    Guard make_guard() { return Guard(*this); }

private:
    // ★ 레벤슈타인 거리 계산 (오타 힌트용)
    static int levenshtein(const std::string& a, const std::string& b) {
        int m = (int)a.size(), n = (int)b.size();
        if (std::abs(m - n) > 3) return 99; // 길이 차이 크면 조기 종료
        std::vector<int> dp(n + 1);
        std::iota(dp.begin(), dp.end(), 0);
        for (int i = 1; i <= m; ++i) {
            int prev = dp[0]; dp[0] = i;
            for (int j = 1; j <= n; ++j) {
                int tmp = dp[j];
                dp[j] = a[i-1] == b[j-1] ? prev
                       : 1 + std::min({prev, dp[j], dp[j-1]});
                prev = tmp;
            }
        }
        return dp[n];
    }
};

// ════════════════════════════════════════════════════════════════════
//  텍스트 그리드
// ════════════════════════════════════════════════════════════════════
struct Grid {
    int w = 0, h = 0;
    std::vector<std::string> cells;

    void init(int width, int height) {
        w = width; h = height;
        cells.assign((size_t)(w * h), " ");
    }
    void clear() { cells.assign((size_t)(w * h), " "); }

    void set(int x, int y, const std::string& v) {
        if (x >= 0 && x < w && y >= 0 && y < h)
            cells[(size_t)(y * w + x)] = v;
    }
    std::string get(int x, int y) const {
        if (x >= 0 && x < w && y >= 0 && y < h)
            return cells[(size_t)(y * w + x)];
        return " ";
    }
    void draw() const {
        for (int y = 0; y < h; ++y) {
            for (int x = 0; x < w; ++x) std::cout << cells[(size_t)(y * w + x)];
            std::cout << "\n";
        }
    }
};

// ════════════════════════════════════════════════════════════════════
//  함수/클래스/인스턴스 정보
// ════════════════════════════════════════════════════════════════════
struct FuncInfo {
    std::vector<std::string>               params;
    std::unordered_map<std::string, Value> defaults;
    Block* body = nullptr;
};

struct ClassInfo {
    std::string parent;
    std::unordered_map<std::string, Value>    field_defaults;
    std::unordered_map<std::string, FuncInfo> methods;
};

struct InstanceData {
    std::string class_name;
    std::unordered_map<std::string, Value> fields;
};

// ════════════════════════════════════════════════════════════════════
//  Interpreter
// ════════════════════════════════════════════════════════════════════
class Interpreter {
    Scope scope;
    std::unordered_map<std::string, FuncInfo>     functions;
    std::unordered_map<std::string, ClassInfo>    classes;
    std::unordered_map<std::string, InstanceData> instances;
    int inst_counter = 0;

    std::vector<BlockPtr> owned_asts;
    Grid grid;

    std::unique_ptr<sf::RenderWindow> sf_window;
    std::map<std::string, sf::Texture> textures;
    std::map<std::string, sf::Font>    fonts;
    int win_w = 0, win_h = 0;

    struct CallFrame { std::string name; int line; };
    std::vector<CallFrame> call_stack;
    std::string current_src;

    // ── 바이트코드 실행 ───────────────────────────────────────────
    Value run_bytecode(const BytecodeChunk& chunk) {
        std::vector<Value> stack;
        std::vector<Value> globals(chunk.global_vars.size(), Value::nil());
        size_t ip = 0;

        while (ip < chunk.code.size()) {
            const auto& inst = chunk.code[ip++];

            switch (inst.op) {
            case OpCode::PUSH_CONST:
                stack.push_back(chunk.constants[inst.operand]);
                break;
            case OpCode::PUSH_NIL:
                stack.push_back(Value::nil());
                break;
            case OpCode::POP:
                if (!stack.empty()) stack.pop_back();
                break;
            case OpCode::LOAD_VAR: {
                int idx = get_var_index(inst.str_operand);
                stack.push_back((idx >= 0 && idx < (int)globals.size())
                    ? globals[idx] : Value::nil());
                break;
            }
            case OpCode::STORE_VAR: {
                if (!stack.empty()) {
                    Value val = stack.back(); stack.pop_back();
                    int idx = get_var_index(inst.str_operand);
                    if (idx >= 0 && idx < (int)globals.size())
                        globals[idx] = std::move(val);
                }
                break;
            }
            case OpCode::ADD: {
                if (stack.size() >= 2) {
                    Value b = stack.back(); stack.pop_back();
                    Value a = stack.back(); stack.pop_back();
                    stack.push_back(a + b);
                }
                break;
            }
            case OpCode::SUB: {
                if (stack.size() >= 2) {
                    Value b = stack.back(); stack.pop_back();
                    Value a = stack.back(); stack.pop_back();
                    stack.push_back(a - b);
                }
                break;
            }
            case OpCode::MUL: {
                if (stack.size() >= 2) {
                    Value b = stack.back(); stack.pop_back();
                    Value a = stack.back(); stack.pop_back();
                    stack.push_back(a * b);
                }
                break;
            }
            case OpCode::DIV: {
                if (stack.size() >= 2) {
                    Value b = stack.back(); stack.pop_back();
                    Value a = stack.back(); stack.pop_back();
                    stack.push_back(a / b);
                }
                break;
            }
            case OpCode::EQ: {
                if (stack.size() >= 2) {
                    Value b = stack.back(); stack.pop_back();
                    Value a = stack.back(); stack.pop_back();
                    stack.push_back(Value(a.eq(b)));
                }
                break;
            }
            case OpCode::PRINT: {
                if (!stack.empty()) {
                    Value v = stack.back(); stack.pop_back();
                    std::cout << v.to_str() << std::endl;
                }
                break;
            }
            case OpCode::HALT:
                return stack.empty() ? Value::nil() : stack.back();
            default: break;
            }
        }
        return stack.empty() ? Value::nil() : stack.back();
    }

    int get_var_index(const std::string&) { return 0; }

    std::string get_source_line(int ln) const {
        if (ln <= 0 || current_src.empty()) return "";
        int cur = 1; size_t start = 0;
        while (cur < ln) {
            size_t pos = current_src.find('\n', start);
            if (pos == std::string::npos) return "";
            start = pos + 1; ++cur;
        }
        size_t end  = current_src.find('\n', start);
        std::string line = current_src.substr(start,
            end == std::string::npos ? std::string::npos : end - start);
        size_t trim = line.find_first_not_of(" \t");
        return (trim == std::string::npos) ? line : line.substr(trim);
    }

    void print_error(const std::string& msg, int ln,
                     const std::string& kind = "런타임 오류") const {
        using namespace SuraColor;
        std::cerr << "\n" << RED << "╔══ 수라 " << kind << " ";
        if (ln > 0) std::cerr << "(" << ln << "줄) ";
        std::cerr << "══╗" << RESET << "\n";

        if (ln > 0) {
            std::string src_line = get_source_line(ln);
            if (!src_line.empty()) {
                std::cerr << GRAY << "  " << ln << " │ " << RESET
                          << BOLD << src_line << RESET << "\n";
                std::cerr << YELLOW << "    └─ 여기서 문제 발생" << RESET << "\n";
            }
        }

        std::cerr << RED << "║" << RESET << "  ";
        for (char c : msg) {
            if (c == '\n') std::cerr << "\n" << RED << "║" << RESET << "  ";
            else           std::cerr << c;
        }
        std::cerr << "\n";

        if (!call_stack.empty()) {
            std::cerr << CYAN << "║  호출 경로:" << RESET << "\n";
            for (int i = (int)call_stack.size() - 1; i >= 0; --i) {
                std::cerr << CYAN << "║" << RESET
                          << GRAY << "    [" << (i + 1) << "] " << RESET
                          << call_stack[i].name
                          << GRAY << " (" << call_stack[i].line << "줄)" << RESET << "\n";
            }
        }
        std::cerr << RED << "+" << std::string(30, '=') << "+" << RESET << "\n\n";
    }

    void print_warning(const std::string& msg, int ln = 0) const {
        using namespace SuraColor;
        std::cerr << YELLOW << "⚠ 경고";
        if (ln > 0) std::cerr << " (" << ln << "줄)";
        std::cerr << ": " << RESET << msg << "\n";
    }

    std::string stack_trace() const {
        if (call_stack.empty()) return "";
        std::string s = "\n  호출 경로:";
        for (int i = (int)call_stack.size() - 1; i >= 0; --i)
            s += "\n    [" + std::to_string(i + 1) + "] "
               + call_stack[i].name + " ("
               + std::to_string(call_stack[i].line) + "줄)";
        return s;
    }

    std::string interpolate(const std::string& s, int ln) {
        if (s.find('{') == std::string::npos) return s;
        std::string result;
        result.reserve(s.size()); // ★ 성능: 미리 메모리 예약
        size_t i = 0;
        while (i < s.size()) {
            if (s[i] == '{') {
                if (i + 1 < s.size() && s[i + 1] == '{') { result += '{'; i += 2; continue; }
                size_t end = s.find('}', i + 1);
                if (end == std::string::npos) { result += s[i++]; continue; }
                std::string expr_str = s.substr(i + 1, end - i - 1);
                try {
                    Parser p;
                    auto wrap = p.parse_source("_ is " + expr_str + "\n");
                    if (!wrap->body.empty() && wrap->body[0]->kind == NK::ASSIGN) {
                        auto* a = static_cast<const AssignStmt*>(wrap->body[0].get());
                        result += eval(a->value.get()).to_str();
                    } else result += expr_str;
                } catch (...) { result += "{" + expr_str + "}"; }
                i = end + 1;
            } else {
                result += s[i++];
            }
        }
        return result;
    }

    bool is_instance_id(const std::string& id) const {
        return id.size() > 7 && id.substr(0, 7) == "__inst_";
    }

    // ════════════════════════════════════════════════════════════════
    //  표현식 평가
    // ════════════════════════════════════════════════════════════════
    Value eval(const Expr* e) {
        if (!e) return Value::nil();

        switch (e->kind) {
        case NK::NUM_LIT:  return Value(static_cast<const NumLit*>(e)->value);
        case NK::STR_LIT:  return Value(interpolate(static_cast<const StrLit*>(e)->value, e->line));
        case NK::BOOL_LIT: return Value(static_cast<const BoolLit*>(e)->value);
        case NK::NIL_LIT:  return Value::nil();
        case NK::IDENT:    return scope.get(static_cast<const Ident*>(e)->name);

        case NK::ARRAY_LIT: {
            auto* al = static_cast<const ArrayLit*>(e);
            Value arr = Value::make_array();
            arr.arr_ptr->reserve(al->elements.size()); // ★ 성능: 용량 예약
            for (auto& el : al->elements)
                arr.arr_ptr->push_back(eval(el.get()));
            return arr;
        }

        case NK::DICT_LIT: {
            auto* dl = static_cast<const DictLit*>(e);
            Value dict = Value::make_dict();
            for (auto& [k, v] : dl->pairs)
                (*dict.dict_ptr)[k] = eval(v.get());
            return dict;
        }

        case NK::INDEX: {
            auto* idx = static_cast<const IndexExpr*>(e);
            Value obj = eval(idx->obj.get());
            Value key = eval(idx->key.get());
            if (obj.is_arr())  return obj.arr_get((int)key.to_num());
            if (obj.is_dict()) return obj.dict_get(key.to_str());
            if (obj.is_str()) {
                int i = (int)key.to_num();
                const std::string& s = obj.str;
                if (i < 0) i += (int)s.size();
                if (i >= 0 && i < (int)s.size()) return Value(std::string(1, s[i]));
            }
            return Value::nil();
        }

        case NK::DOT_ACCESS: {
            auto* da = static_cast<const DotAccess*>(e);
            Value obj = eval(da->obj.get());
            const std::string& prop = da->prop;
            if (obj.is_str() && is_instance_id(obj.str)) {
                auto it = instances.find(obj.str);
                if (it != instances.end() && it->second.fields.count(prop))
                    return it->second.fields.at(prop);
                return Value::nil();
            }
            if (obj.is_dict()) return obj.dict_get(prop);
            if (obj.is_arr()) {
                if (prop == "길이" || prop == "len" || prop == "크기")
                    return Value((double)obj.arr_size());
            }
            if (obj.is_str()) {
                if (prop == "길이" || prop == "len")
                    return Value((double)obj.str.size());
            }
            return Value::nil();
        }

        case NK::UNARY_OP: {
            auto* u = static_cast<const UnaryOp*>(e);
            Value v = eval(u->operand.get());
            if (u->op == "-")   return v.negate();
            if (u->op == "not" || u->op == "!") return v.logical_not();
            if (u->op == "~")   return Value((double)(~(long long)v.to_num()));
            return v;
        }

        case NK::BIN_OP: {
            auto* b = static_cast<const BinOp*>(e);
            const std::string& op = b->op;
            if (op == "and") return Value(eval(b->left.get()).truthy() && eval(b->right.get()).truthy());
            if (op == "or")  return Value(eval(b->left.get()).truthy() || eval(b->right.get()).truthy());

            Value lv = eval(b->left.get());
            Value rv = eval(b->right.get());

            if (op == "+")  return lv + rv;
            if (op == "-")  return lv - rv;
            if (op == "*")  return lv * rv;
            if (op == "/")  return lv / rv;
            if (op == "%")  return lv.mod(rv);
            if (op == "==") return Value(lv.eq(rv));
            if (op == "!=") return Value(lv.neq(rv));
            if (op == ">")  return Value(lv.gt(rv));
            if (op == "<")  return Value(lv.lt(rv));
            if (op == ">=") return Value(lv.gte(rv));
            if (op == "<=") return Value(lv.lte(rv));

            if (op == "in") {
                if (rv.is_arr() && rv.arr_ptr) {
                    for (auto& item : *rv.arr_ptr)
                        if (lv.eq(item)) return Value(true);
                    return Value(false);
                }
                if (rv.is_dict()) return Value(rv.dict_has(lv.to_str()));
                if (rv.is_str())  return Value(rv.str.find(lv.to_str()) != std::string::npos);
                return Value(false);
            }

            {
                auto li = (long long)lv.to_num();
                auto ri = (long long)rv.to_num();
                if (op == "&")  return Value((double)(li & ri));
                if (op == "|")  return Value((double)(li | ri));
                if (op == "^")  return Value((double)(li ^ ri));
                if (op == "<<") return Value((double)(li << ri));
                if (op == ">>") return Value((double)(li >> ri));
            }
            return Value::nil();
        }

        case NK::CALL: {
            auto* ce = static_cast<const CallExpr*>(e);
            std::vector<Value> args;
            args.reserve(ce->args.size()); // ★ 성능
            for (auto& a : ce->args) args.push_back(eval(a.get()));
            return call_function(ce->name, args, ce->line);
        }

        case NK::METHOD_CALL: {
            auto* mc = static_cast<const MethodCallExpr*>(e);
            Value obj = eval(mc->obj.get());
            std::vector<Value> args;
            args.reserve(mc->args.size()); // ★ 성능
            for (auto& a : mc->args) args.push_back(eval(a.get()));
            if (obj.is_str() && is_instance_id(obj.str))
                return call_method(obj.str, mc->method, args, mc->line);
            return Value::nil();
        }

        case NK::SUPER_CALL: {
            auto* sc = static_cast<const SuperCallExpr*>(e);
            Value self_val = scope.get("self");
            if (!self_val.is_str() || !is_instance_id(self_val.str))
                throw RuntimeError("super는 메서드 안에서만 사용 가능합니다", e->line);
            std::string self_id    = self_val.str;
            std::string class_name = instances.at(self_id).class_name;
            const FuncInfo* meth = find_parent_method(class_name, sc->method);
            if (!meth)
                throw RuntimeError("부모 클래스에 '" + sc->method + "' 메서드가 없습니다\n"
                                   "  힌트: 부모 클래스에 해당 메서드를 정의했는지 확인하세요", e->line);
            std::vector<Value> args;
            for (auto& a : sc->args) args.push_back(eval(a.get()));
            auto g = scope.make_guard();
            scope.set_local("self", self_val);
            for (size_t i = 0; i < meth->params.size(); ++i)
                scope.set_local(meth->params[i], i < args.size() ? args[i] : Value::nil());
            Value ret = Value::nil();
            try { exec(meth->body); } catch (ReturnSignal& rs) { ret = rs.value; }
            return ret;
        }

        case NK::NEW_EXPR: {
            auto* ne = static_cast<const NewExpr*>(e);
            std::string id = "__inst_" + std::to_string(++inst_counter);
            InstanceData inst;
            inst.class_name = ne->class_name;
            {
                std::vector<std::string> chain;
                std::string cur = ne->class_name;
                while (!cur.empty() && classes.count(cur)) {
                    chain.push_back(cur);
                    cur = classes[cur].parent;
                }
                for (int i = (int)chain.size() - 1; i >= 0; --i)
                    for (auto& [k, v] : classes[chain[i]].field_defaults)
                        inst.fields[k] = v;
            }
            instances[id] = std::move(inst);
            std::string ctor_name;
            if (find_method(ne->class_name, "생성자")) ctor_name = "생성자";
            else if (find_method(ne->class_name, "init")) ctor_name = "init";
            if (!ctor_name.empty()) {
                std::vector<Value> ctor_args;
                for (auto& a : ne->args) ctor_args.push_back(eval(a.get()));
                call_method(id, ctor_name, ctor_args, ne->line);
            }
            return Value(id);
        }

        case NK::TERNARY: {
            auto* te = static_cast<const TernaryExpr*>(e);
            return eval(te->cond.get()).truthy()
                   ? eval(te->then_val.get())
                   : eval(te->else_val.get());
        }

        default: return Value::nil();
        }
    }

    // ════════════════════════════════════════════════════════════════
    //  문장 실행
    // ════════════════════════════════════════════════════════════════
    void exec(const Stmt* s) {
        if (!s) return;

        switch (s->kind) {
        case NK::BLOCK:
            for (auto& stmt : static_cast<const Block*>(s)->body)
                exec(stmt.get());
            break;

        case NK::ASSIGN: {
            auto* a = static_cast<const AssignStmt*>(s);
            if (a->value && a->value->kind == NK::ARRAY_LIT) {
                Value arr = Value::make_array();
                auto* al = static_cast<const ArrayLit*>(a->value.get());
                arr.arr_ptr->reserve(al->elements.size()); // ★ 성능
                for (auto& el : al->elements)
                    arr.arr_ptr->push_back(eval(el.get()));
                scope.set(a->name, arr);
            } else {
                scope.set(a->name, eval(a->value.get()));
            }
            break;
        }

        case NK::IN_PLACE: {
            auto* ip = static_cast<const InPlaceStmt*>(s);
            Value cur = scope.get(ip->name);
            Value rhs = eval(ip->value.get());
            Value result;
            if      (ip->op == "+") result = cur + rhs;
            else if (ip->op == "-") result = cur - rhs;
            else if (ip->op == "*") result = cur * rhs;
            else if (ip->op == "/") result = cur / rhs;
            else if (ip->op == "%") result = cur.mod(rhs);
            else result = rhs;
            scope.set(ip->name, result);
            break;
        }

        case NK::DOT_ASSIGN: {
            auto* da = static_cast<const DotAssignStmt*>(s);
            Value obj = scope.get(da->obj_name);
            Value val = eval(da->value.get());
            if (obj.is_str() && is_instance_id(obj.str))
                instances[obj.str].fields[da->prop] = val;
            else if (obj.is_dict())
                obj.dict_set(da->prop, val);
            break;
        }

        case NK::INDEX_ASSIGN: {
            auto* ia = static_cast<const IndexAssignStmt*>(s);
            Value& obj = scope.get_ref(ia->name);
            Value  key = eval(ia->key.get());
            Value  val = eval(ia->value.get());
            if (obj.is_arr())  obj.arr_set((int)key.to_num(), val);
            if (obj.is_dict()) obj.dict_set(key.to_str(), val);
            break;
        }

        case NK::IF: {
            auto* is = static_cast<const IfStmt*>(s);
            if (eval(is->cond.get()).truthy()) {
                auto g = scope.make_guard(); exec(is->then_block.get());
            } else if (is->else_block) {
                auto g = scope.make_guard(); exec(is->else_block.get());
            }
            break;
        }

        case NK::WHILE: {
            auto* ws = static_cast<const WhileStmt*>(s);
            while (eval(ws->cond.get()).truthy()) {
                auto g = scope.make_guard();
                try { exec(ws->body.get()); }
                catch (BreakSignal&)    { break; }
                catch (ContinueSignal&) { continue; }
            }
            break;
        }

        case NK::REPEAT: {
            auto* rs = static_cast<const RepeatStmt*>(s);
            int count = (int)eval(rs->count.get()).to_num();
            for (int i = 0; i < count; ++i) {
                auto g = scope.make_guard();
                try { exec(rs->body.get()); }
                catch (BreakSignal&)    { goto repeat_done; }
                catch (ContinueSignal&) { continue; }
            }
            repeat_done:;
            break;
        }

        case NK::FOR: {
            auto* fs = static_cast<const ForStmt*>(s);
            double from = eval(fs->from.get()).to_num();
            double to   = eval(fs->to.get()).to_num();
            double step = fs->step ? eval(fs->step.get()).to_num() : 1.0;
            if (step == 0) break;
            for (double i = from;
                 step > 0 ? i <= to : i >= to;
                 i += step) {
                auto g = scope.make_guard();
                scope.set_local(fs->var, Value(i));
                try { exec(fs->body.get()); }
                catch (BreakSignal&)    { goto for_done; }
                catch (ContinueSignal&) { continue; }
            }
            for_done:;
            break;
        }

        case NK::FOREACH: {
            auto* fe  = static_cast<const ForeachStmt*>(s);
            Value col = eval(fe->collection.get());
            bool  kv  = !fe->var2.empty();
            if (col.is_arr() && col.arr_ptr) {
                int idx = 0;
                for (auto& item : *col.arr_ptr) {
                    auto g = scope.make_guard();
                    if (kv) {
                        scope.set_local(fe->var,  Value((double)idx));
                        scope.set_local(fe->var2, item);
                    } else {
                        scope.set_local(fe->var, item);
                    }
                    try { exec(fe->body.get()); }
                    catch (BreakSignal&)    { goto foreach_done; }
                    catch (ContinueSignal&) { ++idx; continue; }
                    ++idx;
                }
            } else if (col.is_str()) {
                for (char ch : col.str) {
                    auto g = scope.make_guard();
                    scope.set_local(fe->var, Value(std::string(1, ch)));
                    try { exec(fe->body.get()); }
                    catch (BreakSignal&)    { goto foreach_done; }
                    catch (ContinueSignal&) { continue; }
                }
            } else if (col.is_dict() && col.dict_ptr) {
                for (auto& [k, v] : *col.dict_ptr) {
                    auto g = scope.make_guard();
                    scope.set_local(fe->var, Value(k));
                    if (kv) scope.set_local(fe->var2, v);
                    try { exec(fe->body.get()); }
                    catch (BreakSignal&)    { goto foreach_done; }
                    catch (ContinueSignal&) { continue; }
                }
            }
            foreach_done:;
            break;
        }

        case NK::FUNC_DEF: {
            auto* fd = static_cast<const FuncDef*>(s);
            FuncInfo fi;
            fi.params = fd->params;
            fi.body   = fd->body.get();
            for (size_t i = 0; i < fd->params.size(); ++i)
                if (i < fd->defaults.size() && fd->defaults[i])
                    fi.defaults[fd->params[i]] = eval(fd->defaults[i].get());
            functions[fd->name] = std::move(fi);
            break;
        }

        case NK::CLASS_DEF: {
            auto* cd = static_cast<const ClassDef*>(s);
            ClassInfo ci;
            ci.parent = cd->parent;
            for (auto& [k, v] : cd->field_defaults)
                ci.field_defaults[k] = eval(v.get());
            for (auto& [mname, fd] : cd->methods) {
                FuncInfo fi;
                fi.params = fd.params;
                fi.body   = fd.body;
                for (size_t i = 0; i < fd.params.size(); ++i)
                    if (i < fd.defaults.size() && fd.defaults[i])
                        fi.defaults[fd.params[i]] = eval(fd.defaults[i].get());
                ci.methods[mname] = std::move(fi);
            }
            classes[cd->name] = std::move(ci);
            break;
        }

        case NK::NEW_INST: {
            auto* ni = static_cast<const NewInstStmt*>(s);
            std::string id = "__inst_" + std::to_string(++inst_counter);
            InstanceData inst;
            inst.class_name = ni->class_name;
            {
                std::vector<std::string> chain;
                std::string cur = ni->class_name;
                while (!cur.empty() && classes.count(cur)) {
                    chain.push_back(cur);
                    cur = classes[cur].parent;
                }
                for (int i = (int)chain.size() - 1; i >= 0; --i)
                    for (auto& [k, v] : classes[chain[i]].field_defaults)
                        inst.fields[k] = v;
            }
            instances[id] = std::move(inst);
            std::string ctor_name;
            if (find_method(ni->class_name, "생성자")) ctor_name = "생성자";
            else if (find_method(ni->class_name, "init")) ctor_name = "init";
            if (!ctor_name.empty()) {
                std::vector<Value> ctor_args;
                for (auto& a : ni->args) ctor_args.push_back(eval(a.get()));
                call_method(id, ctor_name, ctor_args, ni->line);
            }
            scope.set(ni->var, Value(id));
            break;
        }

        case NK::RETURN: {
            auto* rs = static_cast<const ReturnStmt*>(s);
            throw ReturnSignal{ rs->value ? eval(rs->value.get()) : Value::nil() };
        }

        case NK::BREAK:    throw BreakSignal{};
        case NK::CONTINUE: throw ContinueSignal{};

        case NK::THROW: {
            auto* ts = static_cast<const ThrowStmt*>(s);
            throw SuraThrow{ eval(ts->msg.get()).to_str(), ts->line };
        }

        case NK::TRY: {
            auto* ts = static_cast<const TryStmt*>(s);
            try {
                auto g = scope.make_guard();
                exec(ts->try_block.get());
            } catch (SuraThrow& e) {
                auto g = scope.make_guard();
                scope.set_local(ts->catch_var, Value(e.message));
                exec(ts->catch_block.get());
            } catch (RuntimeError& e) {
                auto g = scope.make_guard();
                scope.set_local(ts->catch_var, Value(std::string(e.raw_msg)));
                exec(ts->catch_block.get());
            } catch (std::runtime_error& e) {
                auto g = scope.make_guard();
                scope.set_local(ts->catch_var, Value(std::string(e.what())));
                exec(ts->catch_block.get());
            }
            break;
        }

        case NK::EXPR_STMT: {
            auto* es = static_cast<const ExprStmt*>(s);
            Value v = eval(es->expr.get());
            std::cout << v.to_str() << "\n";
            break;
        }

        case NK::CMD:
            exec_cmd(static_cast<const CmdStmt*>(s));
            break;

        case NK::USE: {
            auto* us = static_cast<const UseStmt*>(s);
            load_lib(us->lib, us->line);
            break;
        }

        default: break;
        }
    }

    // ════════════════════════════════════════════════════════════════
    //  내장 명령어
    // ════════════════════════════════════════════════════════════════
    void exec_cmd(const CmdStmt* c) {
        const std::string& cmd = c->cmd;
        const auto&        args = c->args;
        const int          ln   = c->line;

        auto arg   = [&](size_t i) -> Value { return eval(args[i].get()); };
        auto ident = [&](size_t i) -> std::string {
            if (i < args.size() && args[i]->kind == NK::IDENT)
                return static_cast<const Ident*>(args[i].get())->name;
            return arg(i).to_str();
        };
        auto need = [&](size_t n) {
            if (args.size() < n)
                throw RuntimeError(
                    "'" + cmd + "' 명령어: 인자가 부족합니다\n"
                    "  필요한 인자 수: " + std::to_string(n) +
                    "\n  제공된 인자 수: " + std::to_string(args.size()) +
                    "\n  힌트: 사용법을 다시 확인해 보세요", ln);
        };

        // ── 출력 ──────────────────────────────────────────────────
        if (cmd == "print") {
            std::string out;
            for (auto& a : args) out += eval(a.get()).to_str();
            std::cout << out << "\n";
        }
        else if (cmd == "print_n" || cmd == "print_no_nl") {
            for (auto& a : args) std::cout << eval(a.get()).to_str();
        }

        // ── 입력 ──────────────────────────────────────────────────
        else if (cmd == "input") {
            need(1);
            if (args.size() >= 2) std::cout << arg(0).to_str();
            std::string line_in;
            std::getline(std::cin, line_in);
            scope.set(ident(args.size() >= 2 ? 1 : 0), Value(line_in));
        }

        // ── 타입 변환 ─────────────────────────────────────────────
        else if (cmd == "to_num") {
            need(2); scope.set(ident(1), Value(arg(0).to_num(ln)));
        }
        else if (cmd == "to_str") {
            need(2); scope.set(ident(1), Value(arg(0).to_str()));
        }
        else if (cmd == "type") {
            need(2); scope.set(ident(1), Value(std::string(arg(0).type_name())));
        }

        // ── 수학 ──────────────────────────────────────────────────
        else if (cmd == "abs")   { need(2); scope.set(ident(1), Value(std::fabs(arg(0).to_num(ln)))); }
        else if (cmd == "sqrt")  {
            need(2);
            double v = arg(0).to_num(ln);
            if (v < 0) throw RuntimeError(
                "sqrt: 음수에는 제곱근을 구할 수 없습니다 (입력값: " + std::to_string(v) + ")\n"
                "  힌트: abs 명령어로 절댓값을 먼저 구해보세요", ln);
            scope.set(ident(1), Value(std::sqrt(v)));
        }
        else if (cmd == "floor") { need(2); scope.set(ident(1), Value(std::floor(arg(0).to_num(ln)))); }
        else if (cmd == "ceil")  { need(2); scope.set(ident(1), Value(std::ceil(arg(0).to_num(ln)))); }
        else if (cmd == "round") { need(2); scope.set(ident(1), Value(std::round(arg(0).to_num(ln)))); }
        else if (cmd == "pow")   { need(3); scope.set(ident(2), Value(std::pow(arg(0).to_num(ln), arg(1).to_num(ln)))); }
        else if (cmd == "min")   { need(3); scope.set(ident(2), Value(std::min(arg(0).to_num(ln), arg(1).to_num(ln)))); }
        else if (cmd == "max")   { need(3); scope.set(ident(2), Value(std::max(arg(0).to_num(ln), arg(1).to_num(ln)))); }
        else if (cmd == "sin")   { need(2); scope.set(ident(1), Value(std::sin(arg(0).to_num(ln)))); }
        else if (cmd == "cos")   { need(2); scope.set(ident(1), Value(std::cos(arg(0).to_num(ln)))); }
        else if (cmd == "tan")   { need(2); scope.set(ident(1), Value(std::tan(arg(0).to_num(ln)))); }
        else if (cmd == "log")   {
            need(2);
            double v = arg(0).to_num(ln);
            if (v <= 0) throw RuntimeError(
                "log: 0 이하의 값에는 로그를 구할 수 없습니다 (입력값: " + std::to_string(v) + ")", ln);
            scope.set(ident(1), Value(std::log(v)));
        }

        // ★★★ 수정: rand — [0.0, 1.0) 실수 난수 (Mersenne Twister)
        else if (cmd == "rand") {
            need(1);
            scope.set(ident(0), Value(SuraRandom::real()));
        }

        // ★★★ 수정: rand_int — [lo, hi] 정수 난수 (편향 없음)
        else if (cmd == "rand_int") {
            need(3);
            int lo = (int)arg(0).to_num(ln);
            int hi = (int)arg(1).to_num(ln);
            if (lo > hi) {
                print_warning("rand_int: 최솟값(" + std::to_string(lo) +
                              ")이 최댓값(" + std::to_string(hi) + ")보다 큽니다. 자동으로 교환합니다", ln);
                std::swap(lo, hi);
            }
            scope.set(ident(2), Value((double)SuraRandom::integer(lo, hi)));
        }

        // ★★★ 수정: random — rand_int와 동일, 일관성 유지
        else if (cmd == "random") {
            need(3);
            int lo = (int)arg(0).to_num(ln);
            int hi = (int)arg(1).to_num(ln);
            if (lo > hi) {
                print_warning("random: 최솟값(" + std::to_string(lo) +
                              ")이 최댓값(" + std::to_string(hi) + ")보다 큽니다. 자동으로 교환합니다", ln);
                std::swap(lo, hi);
            }
            scope.set(ident(2), Value((double)SuraRandom::integer(lo, hi)));
        }

        // ★★★ 신규: rand_seed — 난수 시드 수동 설정 (재현 가능한 결과용)
        else if (cmd == "rand_seed") {
            need(1);
            SuraRandom::seed((uint64_t)arg(0).to_num(ln));
        }

        // ★★★ 신규: rand_float — [lo, hi) 실수 난수
        else if (cmd == "rand_float") {
            need(3);
            double lo = arg(0).to_num(ln);
            double hi = arg(1).to_num(ln);
            if (lo > hi) std::swap(lo, hi);
            std::uniform_real_distribution<double> dist(lo, hi);
            scope.set(ident(2), Value(dist(SuraRandom::engine)));
        }

        // ★★★ 신규: arr_shuffle — 배열을 무작위로 섞기
        else if (cmd == "arr_shuffle") {
            need(1);
            Value& v = scope.get_ref(ident(0));
            if (v.is_arr() && v.arr_ptr)
                std::shuffle(v.arr_ptr->begin(), v.arr_ptr->end(), SuraRandom::engine);
        }

        // ★★★ 신규: arr_sample — 배열에서 무작위 원소 1개 선택
        else if (cmd == "arr_sample") {
            need(2);
            Value v = scope.get(ident(0));
            if (!v.is_arr() || !v.arr_ptr || v.arr_ptr->empty())
                throw RuntimeError("arr_sample: 배열이 비어 있습니다", ln);
            int idx = SuraRandom::integer(0, (int)v.arr_ptr->size() - 1);
            scope.set(ident(1), (*v.arr_ptr)[idx]);
        }

        else if (cmd == "inc") { need(1); scope.set(ident(0), Value(scope.get(ident(0)).to_num(ln) + 1)); }
        else if (cmd == "dec") { need(1); scope.set(ident(0), Value(scope.get(ident(0)).to_num(ln) - 1)); }

        // ── 문자열 ────────────────────────────────────────────────
        else if (cmd == "str_len") {
            need(2); scope.set(ident(1), Value((double)arg(0).to_str().size()));
        }
        else if (cmd == "str_sub") {
            need(4);
            std::string s = arg(0).to_str();
            int start = (int)arg(1).to_num(ln);
            int len   = (int)arg(2).to_num(ln);
            start = std::max(0, std::min(start, (int)s.size()));
            len   = std::max(0, std::min(len, (int)s.size() - start));
            scope.set(ident(3), Value(s.substr((size_t)start, (size_t)len)));
        }
        else if (cmd == "str_upper") {
            need(2);
            std::string s = arg(0).to_str();
            std::transform(s.begin(), s.end(), s.begin(), ::toupper);
            scope.set(ident(1), Value(s));
        }
        else if (cmd == "str_lower") {
            need(2);
            std::string s = arg(0).to_str();
            std::transform(s.begin(), s.end(), s.begin(), ::tolower);
            scope.set(ident(1), Value(s));
        }
        else if (cmd == "str_find") {
            need(3);
            std::string src = arg(0).to_str();
            std::string pat = arg(1).to_str();
            size_t pos = src.find(pat);
            scope.set(ident(2), pos == std::string::npos ? Value(-1.0) : Value((double)pos));
        }
        else if (cmd == "str_replace") {
            need(4);
            std::string src  = arg(0).to_str();
            std::string from = arg(1).to_str();
            std::string to   = arg(2).to_str();
            if (from.empty()) { scope.set(ident(3), Value(src)); break; }
            size_t pos = 0;
            while ((pos = src.find(from, pos)) != std::string::npos) {
                src.replace(pos, from.size(), to);
                pos += to.size();
            }
            scope.set(ident(3), Value(src));
        }
        else if (cmd == "str_split") {
            need(3);
            std::string src = arg(0).to_str();
            std::string sep = arg(1).to_str();
            Value arr = Value::make_array();
            if (sep.empty()) {
                for (char ch : src)
                    arr.arr_ptr->push_back(Value(std::string(1, ch)));
            } else {
                size_t pos = 0, nxt;
                while ((nxt = src.find(sep, pos)) != std::string::npos) {
                    arr.arr_ptr->push_back(Value(src.substr(pos, nxt - pos)));
                    pos = nxt + sep.size();
                }
                arr.arr_ptr->push_back(Value(src.substr(pos)));
            }
            scope.set(ident(2), arr);
        }
        else if (cmd == "str_join") {
            need(3);
            Value arr = arg(0);
            std::string sep = arg(1).to_str();
            std::string out;
            if (arr.is_arr() && arr.arr_ptr) {
                for (size_t i = 0; i < arr.arr_ptr->size(); ++i) {
                    if (i) out += sep;
                    out += (*arr.arr_ptr)[i].to_str();
                }
            }
            scope.set(ident(2), Value(out));
        }
        else if (cmd == "str_num") {
            need(2);
            std::string s = arg(0).to_str();
            scope.set(ident(1), s.empty() ? Value(0.0) : Value((double)(unsigned char)s[0]));
        }
        else if (cmd == "num_str") {
            need(2);
            int code = (int)arg(0).to_num(ln);
            scope.set(ident(1), Value(std::string(1, (char)code)));
        }

        // ★★★ 신규: str_trim — 앞뒤 공백 제거
        else if (cmd == "str_trim") {
            need(2);
            std::string s = arg(0).to_str();
            size_t start = s.find_first_not_of(" \t\r\n");
            size_t end   = s.find_last_not_of(" \t\r\n");
            scope.set(ident(1), Value(
                start == std::string::npos ? std::string{} : s.substr(start, end - start + 1)
            ));
        }

        // ★★★ 신규: str_starts — 특정 문자열로 시작하는지 확인
        else if (cmd == "str_starts") {
            need(3);
            std::string s   = arg(0).to_str();
            std::string pre = arg(1).to_str();
            scope.set(ident(2), Value(s.size() >= pre.size() && s.substr(0, pre.size()) == pre));
        }

        // ★★★ 신규: str_ends — 특정 문자열로 끝나는지 확인
        else if (cmd == "str_ends") {
            need(3);
            std::string s   = arg(0).to_str();
            std::string suf = arg(1).to_str();
            scope.set(ident(2), Value(s.size() >= suf.size() &&
                s.substr(s.size() - suf.size()) == suf));
        }

        // ── 배열 ──────────────────────────────────────────────────
        else if (cmd == "arr_new") {
            need(1); scope.set(ident(0), Value::make_array());
        }
        else if (cmd == "arr_push") {
            need(2);
            Value& v = scope.get_ref(ident(0));
            if (!v.is_arr()) throw RuntimeError(
                "arr_push: '" + ident(0) + "' 는 배열이 아닙니다 (현재 타입: " +
                std::string(v.type_name()) + ")\n  힌트: arr_new 로 배열을 먼저 만드세요", ln);
            v.arr_ptr->push_back(arg(1));
        }
        else if (cmd == "arr_pop") {
            need(1);
            Value& v = scope.get_ref(ident(0));
            if (v.is_arr() && v.arr_ptr && !v.arr_ptr->empty()) {
                Value last = v.arr_ptr->back();
                v.arr_ptr->pop_back();
                if (args.size() >= 2) scope.set(ident(1), last);
            }
        }
        else if (cmd == "arr_get") {
            need(3);
            Value v   = scope.get(ident(0));
            int   idx = (int)arg(1).to_num(ln);
            // ★ 개선: 범위 초과 시 명확한 오류 메시지
            if (!v.is_arr() || !v.arr_ptr)
                throw RuntimeError("arr_get: '" + ident(0) + "' 는 배열이 아닙니다", ln);
            if (idx < 0 || idx >= (int)v.arr_ptr->size())
                throw RuntimeError(
                    "arr_get: 인덱스 " + std::to_string(idx) + " 는 범위를 벗어났습니다\n"
                    "  배열 크기: " + std::to_string(v.arr_ptr->size()) +
                    "  (유효 범위: 0 ~ " + std::to_string((int)v.arr_ptr->size() - 1) + ")", ln);
            scope.set(ident(2), v.arr_get(idx));
        }
        else if (cmd == "arr_set") {
            need(3);
            Value& v  = scope.get_ref(ident(0));
            int    idx = (int)arg(1).to_num(ln);
            v.arr_set(idx, arg(2));
        }
        else if (cmd == "arr_len") {
            need(2);
            Value v = scope.get(ident(0));
            scope.set(ident(1), Value((double)v.arr_size()));
        }
        else if (cmd == "arr_insert") {
            need(3);
            Value& v  = scope.get_ref(ident(0));
            int    idx = (int)arg(1).to_num(ln);
            if (v.is_arr()) {
                idx = std::max(0, std::min(idx, (int)v.arr_ptr->size()));
                v.arr_ptr->insert(v.arr_ptr->begin() + idx, arg(2));
            }
        }
        else if (cmd == "arr_remove") {
            need(2);
            Value& v  = scope.get_ref(ident(0));
            int    idx = (int)arg(1).to_num(ln);
            if (v.is_arr() && idx >= 0 && idx < (int)v.arr_ptr->size())
                v.arr_ptr->erase(v.arr_ptr->begin() + idx);
        }
        else if (cmd == "arr_sort") {
            need(1);
            Value& v = scope.get_ref(ident(0));
            if (v.is_arr())
                std::sort(v.arr_ptr->begin(), v.arr_ptr->end(),
                    [](const Value& a, const Value& b){ return a.lt(b); });
        }
        else if (cmd == "arr_copy") {
            need(2);
            Value src = scope.get(ident(0));
            if (src.is_arr()) {
                Value dst = Value::make_array();
                *dst.arr_ptr = *src.arr_ptr;
                scope.set(ident(1), dst);
            }
        }

        // ★★★ 신규: arr_contains — 값 존재 여부 확인
        else if (cmd == "arr_contains") {
            need(3);
            Value arr = scope.get(ident(0));
            Value target = arg(1);
            bool found = false;
            if (arr.is_arr() && arr.arr_ptr)
                for (auto& item : *arr.arr_ptr)
                    if (item.eq(target)) { found = true; break; }
            scope.set(ident(2), Value(found));
        }

        // ★★★ 신규: arr_reverse — 배열 뒤집기
        else if (cmd == "arr_reverse") {
            need(1);
            Value& v = scope.get_ref(ident(0));
            if (v.is_arr() && v.arr_ptr)
                std::reverse(v.arr_ptr->begin(), v.arr_ptr->end());
        }

        // ── 딕셔너리 ──────────────────────────────────────────────
        else if (cmd == "dict_new") {
            need(1); scope.set(ident(0), Value::make_dict());
        }
        else if (cmd == "dict_set") {
            need(3);
            Value& v = scope.get_ref(ident(0));
            if (!v.is_dict()) throw RuntimeError(
                "dict_set: '" + ident(0) + "' 는 딕셔너리가 아닙니다 (현재 타입: " +
                std::string(v.type_name()) + ")\n  힌트: dict_new 로 딕셔너리를 먼저 만드세요", ln);
            v.dict_set(arg(1).to_str(), arg(2));
        }
        else if (cmd == "dict_get") {
            need(3);
            Value v = scope.get(ident(0));
            scope.set(ident(2), v.dict_get(arg(1).to_str()));
        }
        else if (cmd == "dict_has") {
            need(3);
            Value v = scope.get(ident(0));
            scope.set(ident(2), Value(v.dict_has(arg(1).to_str())));
        }
        else if (cmd == "dict_del") {
            need(2);
            Value& v = scope.get_ref(ident(0));
            if (v.is_dict()) v.dict_ptr->erase(arg(1).to_str());
        }
        else if (cmd == "dict_keys") {
            need(2);
            Value v = scope.get(ident(0));
            Value arr = Value::make_array();
            if (v.is_dict())
                for (auto& [k, _] : *v.dict_ptr)
                    arr.arr_ptr->push_back(Value(k));
            scope.set(ident(1), arr);
        }
        else if (cmd == "dict_len") {
            need(2);
            Value v = scope.get(ident(0));
            scope.set(ident(1), Value(v.is_dict() && v.dict_ptr
                ? (double)v.dict_ptr->size() : 0.0));
        }

        // ── 텍스트 그리드 ──────────────────────────────────────────
        else if (cmd == "grid_init") {
            need(2);
            grid.init((int)arg(0).to_num(ln), (int)arg(1).to_num(ln));
        }
        else if (cmd == "grid_set") {
            need(3);
            grid.set((int)arg(0).to_num(ln), (int)arg(1).to_num(ln), arg(2).to_str());
        }
        else if (cmd == "grid_get") {
            need(3);
            scope.set(ident(2), Value(grid.get((int)arg(0).to_num(ln), (int)arg(1).to_num(ln))));
        }
        else if (cmd == "grid_clear") { grid.clear(); }
        else if (cmd == "grid_draw")  { grid.draw();  }

        // ── SFML ──────────────────────────────────────────────────
        else if (cmd == "win_init") {
            need(3);
            win_w = (int)arg(0).to_num(ln);
            win_h = (int)arg(1).to_num(ln);
            std::string title = arg(2).to_str();
            sf_window = std::make_unique<sf::RenderWindow>(
                sf::VideoMode({(unsigned)win_w, (unsigned)win_h}),
                sf::String::fromUtf8(title.begin(), title.end())
            );
            sf_window->setFramerateLimit(60);
        }
        else if (cmd == "win_fps") {
            need(1);
            if (sf_window) sf_window->setFramerateLimit((unsigned)arg(0).to_num(ln));
        }
        else if (cmd == "win_title") {
            need(1);
            if (sf_window) {
                std::string t = arg(0).to_str();
                sf_window->setTitle(sf::String::fromUtf8(t.begin(), t.end()));
            }
        }
        else if (cmd == "win_close") {
            if (sf_window) sf_window->close();
        }
        else if (cmd == "win_open") {
            need(1);
            scope.set(ident(0), Value(sf_window && sf_window->isOpen()));
        }
        else if (cmd == "win_clear") {
            if (!sf_window) return;
            if (args.size() >= 3)
                sf_window->clear(sf::Color(
                    (uint8_t)arg(0).to_num(ln),
                    (uint8_t)arg(1).to_num(ln),
                    (uint8_t)arg(2).to_num(ln),
                    args.size() >= 4 ? (uint8_t)arg(3).to_num(ln) : 255));
            else
                sf_window->clear(sf::Color::Black);
        }
        else if (cmd == "win_update") {
            if (!sf_window) return;
            while (const auto event = sf_window->pollEvent()) {
                if (event->is<sf::Event::Closed>()) {
                    sf_window->close();
                    throw BreakSignal{};
                }
            }
            sf_window->display();
        }
        else if (cmd == "win_rect") {
            if (!sf_window || args.size() < 7) return;
            sf::RectangleShape r({(float)arg(2).to_num(ln), (float)arg(3).to_num(ln)});
            r.setPosition({(float)arg(0).to_num(ln), (float)arg(1).to_num(ln)});
            r.setFillColor(sf::Color(
                (uint8_t)arg(4).to_num(ln),
                (uint8_t)arg(5).to_num(ln),
                (uint8_t)arg(6).to_num(ln),
                args.size() >= 8 ? (uint8_t)arg(7).to_num(ln) : 255));
            sf_window->draw(r);
        }
        else if (cmd == "win_circle") {
            if (!sf_window || args.size() < 6) return;
            sf::CircleShape c((float)arg(2).to_num(ln));
            c.setPosition({(float)arg(0).to_num(ln), (float)arg(1).to_num(ln)});
            c.setFillColor(sf::Color(
                (uint8_t)arg(3).to_num(ln),
                (uint8_t)arg(4).to_num(ln),
                (uint8_t)arg(5).to_num(ln),
                args.size() >= 7 ? (uint8_t)arg(6).to_num(ln) : 255));
            sf_window->draw(c);
        }
        else if (cmd == "win_image") {
            if (!sf_window || args.size() < 3) return;
            std::string path = arg(0).to_str();
            if (!textures.count(path)) {
                if (!textures[path].loadFromFile(path))
                    throw RuntimeError("이미지 파일을 불러올 수 없습니다: '" + path + "'\n"
                                       "  힌트: 파일 경로가 올바른지 확인하세요", ln);
            }
            sf::Sprite sprite(textures[path]);
            sprite.setPosition({(float)arg(1).to_num(ln), (float)arg(2).to_num(ln)});
            if (args.size() >= 5) {
                auto ts = textures[path].getSize();
                float sx = (float)arg(3).to_num(ln) / ts.x;
                float sy = (float)arg(4).to_num(ln) / ts.y;
                sprite.setScale({sx, sy});
            }
            sf_window->draw(sprite);
        }
        else if (cmd == "win_text") {
            if (!sf_window || args.size() < 7) return;
            std::string font_path = args.size() >= 8 ? arg(7).to_str() : "";
            if (font_path.empty()) font_path = "default";
            if (!fonts.count(font_path) && font_path != "default") {
                if (!fonts[font_path].openFromFile(font_path))
                    throw RuntimeError("폰트 파일을 불러올 수 없습니다: '" + font_path + "'", ln);
            }
            if (fonts.count(font_path)) {
                std::string text_str = arg(0).to_str();
                sf::Text text(fonts[font_path],
                    sf::String::fromUtf8(text_str.begin(), text_str.end()),
                    (unsigned)arg(3).to_num(ln));
                text.setPosition({(float)arg(1).to_num(ln), (float)arg(2).to_num(ln)});
                text.setFillColor(sf::Color(
                    (uint8_t)arg(4).to_num(ln),
                    (uint8_t)arg(5).to_num(ln),
                    (uint8_t)arg(6).to_num(ln)));
                sf_window->draw(text);
            }
        }
        else if (cmd == "load_font") {
            need(1);
            std::string path = arg(0).to_str();
            if (!fonts[path].openFromFile(path))
                throw RuntimeError("폰트 파일을 불러올 수 없습니다: '" + path + "'", ln);
        }
        else if (cmd == "load_image") {
            need(1);
            std::string path = arg(0).to_str();
            if (!textures[path].loadFromFile(path))
                throw RuntimeError("이미지 파일을 불러올 수 없습니다: '" + path + "'", ln);
        }

        // ── 마우스 ────────────────────────────────────────────────
        else if (cmd == "mouse_pos") {
            need(2);
            if (sf_window) {
                auto p = sf::Mouse::getPosition(*sf_window);
                scope.set(ident(0), Value((double)p.x));
                scope.set(ident(1), Value((double)p.y));
            }
        }
        else if (cmd == "mouse_down") {
            need(2);
            bool pressed;
            std::string btn = arg(0).to_str();
            if      (btn == "left"   || btn == "왼쪽") pressed = sf::Mouse::isButtonPressed(sf::Mouse::Button::Left);
            else if (btn == "right"  || btn == "오른쪽") pressed = sf::Mouse::isButtonPressed(sf::Mouse::Button::Right);
            else if (btn == "middle" || btn == "가운데") pressed = sf::Mouse::isButtonPressed(sf::Mouse::Button::Middle);
            else pressed = false;
            scope.set(ident(1), Value(pressed));
        }

        // ── 키보드 ────────────────────────────────────────────────
        else if (cmd == "key_down") {
            need(2);
            std::string k = arg(0).to_str();
            sf::Keyboard::Key sfk = sf::Keyboard::Key::Unknown;
            if      (k == "up"    || k == "위")         sfk = sf::Keyboard::Key::Up;
            else if (k == "down"  || k == "아래")       sfk = sf::Keyboard::Key::Down;
            else if (k == "left"  || k == "왼쪽")       sfk = sf::Keyboard::Key::Left;
            else if (k == "right" || k == "오른쪽")     sfk = sf::Keyboard::Key::Right;
            else if (k == "space" || k == "스페이스")   sfk = sf::Keyboard::Key::Space;
            else if (k == "enter" || k == "엔터")       sfk = sf::Keyboard::Key::Enter;
            else if (k == "escape"|| k == "에스케이프") sfk = sf::Keyboard::Key::Escape;
            else if (k == "shift" || k == "쉬프트")     sfk = sf::Keyboard::Key::LShift;
            else if (k == "ctrl"  || k == "컨트롤")     sfk = sf::Keyboard::Key::LControl;
            else if (k.size() == 1 && k[0] >= 'a' && k[0] <= 'z')
                sfk = static_cast<sf::Keyboard::Key>(
                    (int)sf::Keyboard::Key::A + (k[0] - 'a'));
            else if (k.size() == 1 && k[0] >= '0' && k[0] <= '9')
                sfk = static_cast<sf::Keyboard::Key>(
                    (int)sf::Keyboard::Key::Num0 + (k[0] - '0'));
            scope.set(ident(1), Value(sfk != sf::Keyboard::Key::Unknown &&
                sf::Keyboard::isKeyPressed(sfk)));
        }

        // ── 파일 I/O ───────────────────────────────────────────────
        else if (cmd == "file_save") {
            need(2);
            std::string path = arg(0).to_str();
            std::ofstream f(path);
            if (!f) throw RuntimeError(
                "파일을 저장할 수 없습니다: '" + path + "'\n"
                "  힌트: 경로가 올바른지, 쓰기 권한이 있는지 확인하세요", ln);
            f << arg(1).to_str();
        }
        else if (cmd == "file_load") {
            need(2);
            std::string path = arg(0).to_str();
            std::ifstream f(path);
            if (!f) throw RuntimeError(
                "파일을 불러올 수 없습니다: '" + path + "'\n"
                "  힌트: 파일이 존재하는지, 읽기 권한이 있는지 확인하세요", ln);
            std::string content((std::istreambuf_iterator<char>(f)), {});
            scope.set(ident(1), Value(content));
        }
        else if (cmd == "file_exists") {
            need(2);
            std::ifstream f(arg(0).to_str());
            scope.set(ident(1), Value(f.good()));
        }

        // ── 유틸리티 ──────────────────────────────────────────────
        else if (cmd == "sleep") {
            need(1); sura_sleep((int)arg(0).to_num(ln));
        }
        else if (cmd == "time") {
            need(1);
            scope.set(ident(0), Value((double)std::time(nullptr)));
        }
        else if (cmd == "exit") {
            int code = args.empty() ? 0 : (int)arg(0).to_num(ln);
            std::exit(code);
        }

        // ── 사용자 정의 함수 호출 ─────────────────────────────────
        else if (functions.count(cmd)) {
            std::vector<Value> fargs;
            fargs.reserve(args.size()); // ★ 성능
            for (auto& a : args) fargs.push_back(eval(a.get()));
            call_function(cmd, fargs, ln);
        }

        // ── super.method ──────────────────────────────────────────
        else if (cmd.size() > 10 && cmd.substr(0, 10) == "__super__.") {
            std::string method = cmd.substr(10);
            Value self_val = scope.get("self");
            if (!self_val.is_str() || !is_instance_id(self_val.str))
                throw RuntimeError("super는 메서드 안에서만 사용 가능합니다", ln);
            std::string self_id    = self_val.str;
            std::string class_name = instances.at(self_id).class_name;
            const FuncInfo* meth = find_parent_method(class_name, method);
            if (!meth)
                throw RuntimeError("부모 클래스에 '" + method + "' 메서드가 없습니다", ln);
            std::vector<Value> margs;
            for (auto& a : args) margs.push_back(eval(a.get()));
            auto g = scope.make_guard();
            scope.set_local("self", self_val);
            for (size_t i = 0; i < meth->params.size(); ++i)
                scope.set_local(meth->params[i], i < margs.size() ? margs[i] : Value::nil());
            try { exec(meth->body); } catch (ReturnSignal&) {}
        }

        // ── obj.method ────────────────────────────────────────────
        else if (cmd.find('.') != std::string::npos) {
            size_t dot = cmd.find('.');
            std::string obj_name = cmd.substr(0, dot);
            std::string method   = cmd.substr(dot + 1);
            Value obj = scope.get(obj_name);
            if (obj.is_str() && is_instance_id(obj.str)) {
                std::vector<Value> margs;
                for (auto& a : args) margs.push_back(eval(a.get()));
                call_method(obj.str, method, margs, ln);
            } else {
                throw RuntimeError(
                    "'" + obj_name + "' 는 인스턴스가 아닙니다 (현재 타입: " +
                    std::string(obj.type_name()) + ")\n"
                    "  힌트: 'new 클래스이름()' 으로 인스턴스를 먼저 만드세요", ln);
            }
        }

        // ── 알 수 없는 명령어 ─────────────────────────────────────
        else {
            // ★ 개선: 유사한 명령어 제안
            static const std::vector<std::string> builtin_cmds = {
                "print","input","rand","rand_int","random","rand_float","rand_seed",
                "arr_push","arr_pop","arr_get","arr_set","arr_len","arr_new",
                "arr_sort","arr_copy","arr_shuffle","arr_sample","arr_contains","arr_reverse",
                "dict_new","dict_set","dict_get","dict_has","dict_del","dict_keys","dict_len",
                "str_len","str_sub","str_upper","str_lower","str_find","str_replace",
                "str_split","str_join","str_trim","str_starts","str_ends",
                "abs","sqrt","floor","ceil","round","pow","min","max",
                "sin","cos","tan","log","inc","dec",
                "to_num","to_str","type","sleep","time","exit",
                "file_save","file_load","file_exists",
                "win_init","win_clear","win_update","win_rect","win_circle",
                "win_text","win_image","win_fps","win_title","win_close","win_open",
                "mouse_pos","mouse_down","key_down","load_font","load_image",
                "grid_init","grid_set","grid_get","grid_clear","grid_draw"
            };
            std::string closest;
            int min_dist = 99;
            for (auto& bc : builtin_cmds) {
                int d = Scope::levenshtein_static(bc, cmd); // 아래 정의
                if (d < min_dist) { min_dist = d; closest = bc; }
            }
            std::string hint_msg;
            if (min_dist <= 3 && !closest.empty())
                hint_msg = "\n  혹시 '" + closest + "' 을(를) 쓰려고 하셨나요?";

            throw RuntimeError(
                "알 수 없는 명령어: '" + cmd + "'" + hint_msg +
                "\n  힌트: 철자를 확인하거나 함수로 정의되어 있는지 확인하세요" +
                stack_trace(), ln);
        }
    }

    // ════════════════════════════════════════════════════════════════
    //  함수 호출
    // ════════════════════════════════════════════════════════════════
    Value call_function(const std::string& name, const std::vector<Value>& args, int ln) {
        if (!functions.count(name))
            throw RuntimeError(
                "정의되지 않은 함수: '" + name + "'\n"
                "  힌트: 함수 이름이 맞는지, 함수 정의가 호출 이전에 있는지 확인하세요"
                + stack_trace(), ln);

        if (call_stack.size() >= 256)
            throw RuntimeError(
                "스택 오버플로: 재귀 깊이가 256을 초과했습니다\n"
                "  힌트: 재귀 함수에 탈출 조건이 있는지 확인하세요"
                + stack_trace(), ln);

        call_stack.push_back({name, ln});
        auto& info = functions[name];
        auto  g    = scope.make_guard();

        for (size_t i = 0; i < info.params.size(); ++i) {
            Value v;
            if (i < args.size()) {
                v = args[i];
            } else {
                auto it = info.defaults.find(info.params[i]);
                v = (it != info.defaults.end()) ? it->second : Value::nil();
            }
            scope.set_local(info.params[i], v);
        }

        Value ret = Value::nil();
        try { exec(info.body); }
        catch (ReturnSignal& rs) { ret = rs.value; }

        call_stack.pop_back();
        return ret;
    }

    const FuncInfo* find_method(const std::string& class_name,
                                const std::string& method_name) const {
        std::string cur = class_name;
        while (!cur.empty()) {
            auto it = classes.find(cur);
            if (it == classes.end()) break;
            auto mit = it->second.methods.find(method_name);
            if (mit != it->second.methods.end()) return &mit->second;
            cur = it->second.parent;
        }
        return nullptr;
    }

    const FuncInfo* find_parent_method(const std::string& class_name,
                                       const std::string& method_name) const {
        auto it = classes.find(class_name);
        if (it == classes.end()) return nullptr;
        return find_method(it->second.parent, method_name);
    }

    Value call_method(const std::string& id, const std::string& name,
                      const std::vector<Value>& args, int ln) {
        if (!instances.count(id))
            throw RuntimeError("내부 오류: 인스턴스를 찾을 수 없습니다: " + id, ln);

        if (call_stack.size() >= 256)
            throw RuntimeError(
                "스택 오버플로: 재귀 깊이가 256을 초과했습니다" + stack_trace(), ln);

        auto& inst = instances[id];
        if (!classes.count(inst.class_name))
            throw RuntimeError("클래스를 찾을 수 없습니다: '" + inst.class_name + "'", ln);

        const FuncInfo* meth = find_method(inst.class_name, name);
        if (!meth) return Value::nil();

        call_stack.push_back({inst.class_name + "." + name, ln});
        auto  g = scope.make_guard();
        scope.set_local("self", Value(id));
        for (size_t i = 0; i < meth->params.size(); ++i) {
            Value v;
            if (i < args.size()) {
                v = args[i];
            } else {
                auto it = meth->defaults.find(meth->params[i]);
                v = (it != meth->defaults.end()) ? it->second : Value::nil();
            }
            scope.set_local(meth->params[i], v);
        }

        Value ret = Value::nil();
        try { exec(meth->body); } catch (ReturnSignal& rs) { ret = rs.value; }
        call_stack.pop_back();
        return ret;
    }

    void load_lib(const std::string& lib_name, int ln) {
        std::string path = lib_name;
        if (path.find('.') == std::string::npos) path += ".sura";
        std::ifstream f(path);
        if (!f) throw RuntimeError(
            "라이브러리 파일을 찾을 수 없습니다: '" + path + "'\n"
            "  힌트: 파일이 같은 폴더에 있는지 확인하세요", ln);
        std::string src((std::istreambuf_iterator<char>(f)), {});
        try {
            Parser p;
            auto ast = p.parse_source(src);
            exec(ast.get());
            owned_asts.push_back(std::move(ast));
        } catch (RuntimeError& e) {
            throw RuntimeError("라이브러리 '" + lib_name + "' 실행 중 오류: " + e.raw_msg, ln);
        }
    }

public:
    // ★ 명령어 힌트용 정적 레벤슈타인 (exec_cmd에서 접근)
    static int levenshtein_static(const std::string& a, const std::string& b) {
        int m = (int)a.size(), n = (int)b.size();
        if (std::abs(m - n) > 3) return 99;
        std::vector<int> dp(n + 1);
        std::iota(dp.begin(), dp.end(), 0);
        for (int i = 1; i <= m; ++i) {
            int prev = dp[0]; dp[0] = i;
            for (int j = 1; j <= n; ++j) {
                int tmp = dp[j];
                dp[j] = a[i-1] == b[j-1] ? prev
                       : 1 + std::min({prev, dp[j], dp[j-1]});
                prev = tmp;
            }
        }
        return dp[n];
    }

    Interpreter() {} // ★ srand 제거 — SuraRandom이 자동 초기화

    void run(const std::string& src, bool use_bytecode = false) {
        current_src = src;
        try {
            if (use_bytecode) {
                Parser p;
                auto ast = p.parse_source(src);
                JitCompiler jit_compiler;
                JitChunk jit_chunk = jit_compiler.compile(ast.get());
                JitVM vm;
                vm.run(jit_chunk);
                owned_asts.push_back(std::move(ast));
            } else {
                Parser p;
                auto ast = p.parse_source(src);
                exec(ast.get());
                owned_asts.push_back(std::move(ast));
            }
        } catch (RuntimeError& e) {
            print_error(e.raw_msg, e.line);
            call_stack.clear();
        } catch (SuraThrow& e) {
            print_error(e.message, e.line, "예외 (throw)");
            call_stack.clear();
        } catch (std::exception& e) {
            std::string msg = e.what();
            int ln = 0;
            auto pos = msg.find("줄:");
            if (pos != std::string::npos) {
                size_t start = pos;
                while (start > 0 && std::isdigit((unsigned char)msg[start - 1])) --start;
                try { ln = std::stoi(msg.substr(start, pos - start)); } catch (...) {}
            }
            print_error(msg, ln, "파서 오류");
            call_stack.clear();
        } catch (...) {
            using namespace SuraColor;
            std::cerr << RED
                      << "╔══ 수라 알 수 없는 오류 ══╗\n"
                      << "║  내부에서 처리되지 않은 예외 발생\n"
                      << "╚══════════════════════════╝"
                      << RESET << "\n";
            call_stack.clear();
        }
    }

    void run_jit(const std::string& src, bool dump_bytecode = false) {
        try {
            Parser p;
            auto ast = p.parse_source(src);
            JitCompiler jit_compiler;
            JitChunk jit_chunk = jit_compiler.compile(ast.get());
            if (dump_bytecode) JitVM::dump(jit_chunk);
            JitVM vm;
            vm.run(jit_chunk);
            owned_asts.push_back(std::move(ast));
        } catch (std::exception& e) {
            std::cerr << "[JIT 오류] " << e.what() << "\n";
        }
    }

    void run_file(const std::string& path, bool use_bytecode = false) {
        std::ifstream f(path);
        if (!f) {
            using namespace SuraColor;
            std::cerr << RED
                      << "╔══ 수라 파일 오류 ══╗\n"
                      << "║  파일을 열 수 없습니다: " << path << "\n"
                      << "║  힌트: 파일 경로와 이름을 확인하세요\n"
                      << "╚════════════════════╝"
                      << RESET << "\n";
            return;
        }
        std::string src((std::istreambuf_iterator<char>(f)), {});
        run(src, use_bytecode);
    }

    void run_file_jit(const std::string& path, bool dump_bytecode = false) {
        std::ifstream f(path);
        if (!f) {
            std::cerr << "[JIT] 파일을 열 수 없습니다: " << path << "\n";
            return;
        }
        std::string src((std::istreambuf_iterator<char>(f)), {});
        run_jit(src, dump_bytecode);
    }
};
# Phase 9: test new opcodes inside JIT-compiled functions
# All ops happen inside `f()` so JIT compiles them

func f(x, y) do
    a is -x                  # NEG
    b is x % y               # MOD
    c is x == y              # CMP_EQ
    d is x != y              # CMP_NEQ
    e is not c               # LOGICAL_NOT
    g is x & y               # BIT_AND
    h is x | y               # BIT_OR
    i is x ^ y               # BIT_XOR
    j is ~x                  # BIT_NOT
    k is x << 2              # LSHIFT
    l is x >> 1              # RSHIFT
    return a + b + g + h + i + k + l + j
end

# Warm up & JIT compile (LAZY threshold = 5)
i is 0
acc is 0
while i < 100 do
    acc is acc + f(7, 3)
    i is i + 1
end

print "acc:"
print acc
print "f(7,3) breakdown:"
print -7         # expect -7
print 7 % 3      # expect 1
print 7 == 3     # expect false
print 7 != 3     # expect true
print not (7 == 3)  # expect true
print 7 & 3      # expect 3
print 7 | 3      # expect 7
print 7 ^ 3      # expect 4
print ~7         # expect -8
print 7 << 2     # expect 28
print 7 >> 1     # expect 3

enum JsMode do
  READY
  SCORE is 7
  LABEL is "mode"
end

assert_eq(JsMode.READY, "READY")
assert_eq(JsMode.SCORE, 7)
assert_eq(JsMode.LABEL, "mode")

struct JsVec2 do
  x is 0
  y is 0

  func add(other) do
    return JsVec2(self.x + other.x, self.y + other.y)
  end
end

vec_js is JsVec2(2, 3)
vec_sum_js is vec_js.add(JsVec2(4, 5))
assert_eq(vec_sum_js.x, 6)
assert_eq(vec_sum_js.y, 8)

class JsPoint do
  func init(x, y) do
    self.x is x
    self.y is y
  end

  func sum() do
    return self.x + self.y
  end
end

class JsNamedPoint extends JsPoint do
  func label() do
    return "point:{self.x},{self.y}"
  end
end

class JsScoredPoint extends JsPoint do
  func init(x, y, score) do
    super.init(x, y)
    self.x is x
    self.y is y
    self.score is score
  end

  func score_label() do
    return "score:{self.score}"
  end
end

point_js is new JsPoint(7, 8)
assert_eq(point_js.sum(), 15)
point_js.x is point_js.x + 1
assert_eq(point_js.x, 8)
named_point_js is new JsNamedPoint(2, 3)
assert_eq(named_point_js.sum(), 5)
assert_eq(named_point_js.label(), "point:2,3")
scored_point_js is new JsScoredPoint(4, 6, 10)
assert_eq(scored_point_js.sum(), 10)
assert_eq(scored_point_js.score, 10)
assert_eq(scored_point_js.score_label(), "score:10")


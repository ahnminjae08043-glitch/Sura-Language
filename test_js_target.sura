assert(not http_status_retryable(404))
assert_eq(http.retry_after({"Retry-After": "2"}, 100), 2000)
assert_eq(http.retry_after({}, 150), 150)
assert_eq(http.backoff_delays(4, 100, 2, 500).join(","), "100,200,400,500")
assert_eq(http_backoff_delays(3, 50, 3, 500).join(","), "50,150,450")

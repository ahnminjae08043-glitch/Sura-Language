assert_eq(cookies.korean, korean_bytes)
assert_eq(cookies.repeated[1], "two")
assert_eq(cookie_get({"Cookie": cookie_text}, "session"), "abc 123")
parsed_url_js is url_parse("https://api.example.com:8443/v1/search?q=sura+agent&tag=ai&tag=tools#top")

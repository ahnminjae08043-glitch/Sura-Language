ini_roundtrip_js is ini_parse(json.ini_stringify({name: "Sura", agent: {model: "llama", note: "hello world"}}))
assert_eq(ini_roundtrip_js.agent.model, "llama")
template_data_js is {user: {name: "Sura"}, scores: [9], meta: {ok: true}}
assert_eq(template_render("Hi [[ user.name ]] score [[ scores[0] ]] missing [[missing]]", template_data_js, "n/a"), "Hi Sura score 9 missing n/a")
assert(template_render("Meta [[meta]]", template_data_js).contains("\"ok\":true"))
assert_eq(json.template_render("Hi [[user.name]]", template_data_js), "Hi Sura")
note_path_js is "note.txt"
note_url_js is "file://" + path.abs(note_path_js)
assert(file_write(note_path_js, json.stringify({ok: true, message: "tool context"})) > 0)
request_spec_js is {url: note_url_js}
assert(http_get(note_url_js).contains("tool context"))
assert_eq(http_request(request_spec_js), file_read(note_path_js))
full_response_js is http.request_full(request_spec_js)
assert(full_response_js.ok)
assert_eq(full_response_js.status, 200)
assert_eq(http.request_json(request_spec_js).message, "tool context")
assert_eq(http_request_json_checked(request_spec_js).ok, true)
assert_eq(http.request_retry(request_spec_js, 2, 1).attempts, 1)
assert_eq(http_request_retry_json_checked(request_spec_js, 2, 1).message, "tool context")
live_http_url_js is env_get("SURA_JS_HTTP_URL", "")
if length(live_http_url_js) > 0 then
  live_full_js is http.request_full({url: live_http_url_js + "/json", query: {q: "sura agent"}, headers: {"X-Sura": "js"}, timeout: 5})
  assert(live_full_js.ok)
  assert_eq(live_full_js.status, 200)
  assert(live_full_js.body.contains("\"ok\":true"))
  live_json_js is http.request_json_checked({url: live_http_url_js + "/json", query: {q: "sura agent"}, headers: {"X-Sura": "js"}, timeout: 5})
  assert_eq(live_json_js.query, "sura agent")
  assert_eq(live_json_js.header, "js")
  live_post_js is http.request_json_checked({url: live_http_url_js + "/echo", method: "POST", json: {name: "sura"}, timeout: 5})
  assert_eq(live_post_js.method, "POST")
  assert(live_post_js.body.contains("\"name\":\"sura\""))
  live_form_js is http.request_json_checked({url: live_http_url_js + "/echo", form: {q: "sura agent", tag: ["ai", "tools"]}, timeout: 5})
  assert_eq(live_form_js.method, "POST")
  assert(live_form_js.content_type.contains("application/x-www-form-urlencoded"))
  assert(live_form_js.body.contains("q=sura+agent"))
  assert(live_form_js.body.contains("tag=tools"))
  live_tool_spec_js is tool.spec("http_get", {url: live_http_url_js + "/json"})
  assert(tool.allowed(live_tool_spec_js, {tools: ["http_get"], url_prefixes: ["http://127.0.0.1"]}))
  assert(tool.call(live_tool_spec_js).contains("\"ok\":true"))
  live_async_js is async.http_get(live_http_url_js + "/json")
  assert(async.await_timeout(live_async_js, 1000, "timeout").contains("\"ok\":true"))
end
static_port_js is to_int(env_get("SURA_JS_STATIC_PORT", "0"))
if static_port_js > 0 then
  static_root_js is path.join(env_get("TEMP", "."), "sura_js_static_target")
  mkdir(static_root_js)
  static_file_js is path.join(static_root_js, "index.txt")
  assert(file_write(static_file_js, "sura static ok") > 0)
  static_server_js is http.serve_static(static_root_js, static_port_js)
  assert_eq(static_server_js.type, "http_server")
  assert_eq(static_server_js.port, static_port_js)
  assert(http.server_url(static_server_js).contains("http://127.0.0.1:"))
  assert_eq(http_get(http.server_url(static_server_js) + "index.txt").trim(), "sura static ok")
  assert(http.server_stop(static_server_js))
  assert_eq(file_delete(static_file_js), true)
end
route_port_js is to_int(env_get("SURA_JS_ROUTE_PORT", "0"))
if route_port_js > 0 then
  routes_js is {"GET /health": {json: {ok: true, name: "sura"}}, "POST /echo": {status: 201, echo: true, headers: {"X-Sura": "routes"}}, "/plain": "plain route"}
  route_server_js is http_serve_routes(routes_js, route_port_js)
  assert_eq(route_server_js.type, "http_routes_server")
  assert_eq(route_server_js.port, route_port_js)
  health_js is http_request_json({url: http_server_url(route_server_js) + "health", timeout: 5})
  assert(health_js.ok)
  assert_eq(health_js.name, "sura")
  assert_eq(http.get(http_server_url(route_server_js) + "plain").trim(), "plain route")
  route_echo_full_js is http.request_full({method: "POST", url: http_server_url(route_server_js) + "echo?q=sura&q=agent", json: {message: "한글"}, timeout: 5})
  assert_eq(route_echo_full_js.status, 201)
  assert_eq(route_echo_full_js.headers["x-sura"], "routes")
  route_echo_js is json.parse(route_echo_full_js.body)
  assert_eq(route_echo_js.method, "POST")
  assert_eq(route_echo_js.query.q[0], "sura")
  assert_eq(route_echo_js.query.q[1], "agent")
  assert_eq(json.parse(route_echo_js.body).message, "한글")
  route_form_js is json.parse(http.request_full({method: "POST", url: http_server_url(route_server_js) + "echo", form: {q: "sura agent", tag: ["ai", "tools"]}, timeout: 5}).body)
  assert(route_form_js.headers["content-type"].contains("application/x-www-form-urlencoded"))
  assert_eq(http.form_parse(route_form_js.body).q, "sura agent")
  assert_eq(http.form_parse(route_form_js.body).tag[1], "tools")
  assert(http_server_stop(route_server_js))
end
async_get_js is async.http_get(note_url_js)
assert(async.status(async_get_js).known)
assert_eq(async.await_timeout(async_get_js, 1000, "timeout"), file_read(note_path_js))
assert(not async.status(async_get_js).known)
async_request_js is async.http_request(request_spec_js)
async_timer_js is async.sleep(250)
assert(async.status(async_timer_js).running)
assert_eq(async.await_timeout(async_timer_js, 0, "pending"), "pending")
assert(async.status(async_timer_js).known)
assert_eq(async.await(async_timer_js), "")
async_all_ids_js is [async_request_js, async.http_get(note_url_js)]
assert_eq(async.all_timeout(async_all_ids_js, 1000, ["timeout"])[0], file_read(note_path_js))
assert_eq(async.all_timeout([async.http_get(note_url_js)], 100, ["timeout"])[0], file_read(note_path_js))
async_any_id_a_js is async.http_get(note_url_js)
async_any_id_b_js is async.sleep(20)
async_first_js is async.any([async_any_id_a_js, async_any_id_b_js], 100, nil)
assert_eq(async_first_js.output, file_read(note_path_js))
assert_eq(async.await(async_any_id_b_js), "")
async_forget_js is async.sleep(1)
wait(50)
assert(async.forget(async_forget_js))
assert(not async.status(async_forget_js).known)
async_cleanup_js is async.sleep(1)
wait(50)
assert(async.cleanup() >= 1)
assert(not async.status(async_cleanup_js).known)
async_direct_sleep_js is async_sleep(1)
assert_eq(async_await(async_direct_sleep_js), "")
tool_spec_js is tool.spec("http_get", {url: note_url_js})
assert(tool.validate(tool_spec_js))
assert(tool.allowed(tool_spec_js, {tools: ["http_get"], url_prefixes: ["file://"]}))
assert_contains(tool.schema("http_get").required, "url")
llm_messages_js is llm.messages("You are concise", "Summarize Sura")
assert_eq(llm_messages_js[0].role, "system")
assert(llm.request_json("model", llm_messages_js, 0.2).contains("\"model\":\"model\""))
structured_js is llm.request_schema("model", llm_messages_js, agent_schema_js, 0.2, "agent_plan")
assert_eq(structured_js.response_format.type, "json_schema")
assert_eq(structured_js.response_format.json_schema.schema.properties.goal.type, "string")
assert(llm.request_schema_json("model", llm_messages_js, agent_schema_js, 0.2, "agent_plan").contains("\"response_format\""))
llm_tool_defs_js is llm.tools(["http_get"])
assert_eq(llm_tool_defs_js[0].type, "function")
assert_eq(llm_tool_defs_js[0].function.name, "http_get")
assert_contains(llm_tool_defs_js[0].function.parameters.required, "url")
llm_tool_request_js is llm.request_tools("model", llm_messages_js, ["http_get"], 0)
assert_eq(llm_tool_request_js.tools[0].function.name, "http_get")
assert(llm.request_tools_json("model", llm_messages_js, ["http_get"], 0).contains("\"tools\""))
llm_tool_schema_request_js is llm.request_tools_schema("model", llm_messages_js, ["http_get"], agent_schema_js, 0, "agent_plan")
assert_eq(llm_tool_schema_request_js.tools[0].function.name, "http_get")
assert_eq(llm_tool_schema_request_js.response_format.json_schema.name, "agent_plan")
assert(llm.request_tools_schema_json("model", llm_messages_js, ["http_get"], agent_schema_js, 0, "agent_plan").contains("\"response_format\""))
assert_eq(llm.extract_text({choices: [{message: {content: "ok"}}]}), "ok")
llm_usage_js is llm.usage({usage: {prompt_tokens: 3, completion_tokens: 4, total_tokens: 7}})
assert_eq(llm_usage_js.input_tokens, 3)
assert_eq(llm_usage_js.output_tokens, 4)
llm_responses_usage_js is llm_usage({usage: {input_tokens: 5, output_tokens: 6}})
assert_eq(llm_responses_usage_js.total_tokens, 11)
llm_cost_js is llm.cost({usage: {input_tokens: 1000000, output_tokens: 500000}}, {input_per_million: 2, output_per_million: 8, currency: "USD"})
assert_eq(llm_cost_js.input_cost, 2)
assert_eq(llm_cost_js.output_cost, 4)
assert_eq(llm_cost_js.total_cost, 6)
assert_eq(llm_cost_js.currency, "USD")
llm_alias_cost_js is llm_cost({usage: {prompt_tokens: 1000000, completion_tokens: 1000000}}, {prompt_per_million: 1, completion_per_million: 2})
assert_eq(llm_alias_cost_js.total_cost, 3)
llm_budget_js is llm.budget({usage: {input_tokens: 1000000, output_tokens: 500000}}, {input_per_million: 2, output_per_million: 8}, 7)
assert_eq(llm_budget_js.within_budget, true)
assert_eq(llm_budget_js.over_budget, false)
assert_eq(llm_budget_js.remaining, 1)
llm_over_budget_js is llm_budget({usage: {input_tokens: 1000000, output_tokens: 500000}}, {input_per_million: 2, output_per_million: 8}, 5)
assert_eq(llm_over_budget_js.within_budget, false)
assert_eq(llm_over_budget_js.over_budget, true)
assert_eq(llm_over_budget_js.remaining, -1)
llm_mock_path_js is path.join(env_get("TEMP", "."), "sura_llm_mock_response_js_target.json")
llm_mock_url_js is "file://" + regex_replace(path.abs(llm_mock_path_js), "\\\\", "/")
assert(file_write(llm_mock_path_js, json.stringify({choices: [{message: {content: "mock ok"}}]})) > 0)
llm_chat_raw_js is llm.chat(llm_mock_url_js, "test-key", "model", llm_messages_js, 0.2)
assert_eq(llm.extract_text(llm_chat_raw_js), "mock ok")
llm_chat_request_raw_js is llm.chat_request(llm_mock_url_js, "test-key", llm_tool_schema_request_js)
assert_eq(llm.extract_text(llm_chat_request_raw_js), "mock ok")
llm_chat_request_json_raw_js is llm.chat_request(llm_mock_url_js, "test-key", llm.request_tools_schema_json("model", llm_messages_js, ["http_get"], agent_schema_js, 0, "agent_plan"))
assert_eq(llm.extract_text(llm_chat_request_json_raw_js), "mock ok")
assert_eq(file_delete(llm_mock_path_js), true)
llm_json_response_js is {choices: [{message: {content: json.stringify({goal: "ship", max_steps: 3})}}]}
llm_json_output_js is llm.extract_json(llm_json_response_js, agent_schema_js)
assert_eq(llm_json_output_js.goal, "ship")
assert_eq(llm_json_output_js.max_steps, 3)
model_response_js is {choices: [{message: {tool_calls: [{id: "call_1", function: {name: "http_get", arguments: json.stringify({url: note_url_js})}}]}}]}
tool_call_js is llm.tool_calls(model_response_js)[0]
assert_eq(tool_call_js.name, "http_get")
assert_eq(llm.tool_result(tool_call_js, {ok: true}).role, "tool")
tool_messages_js is llm.run_tools(model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]})
assert(tool_messages_js[0].content.contains("tool context"))
next_messages_js is llm.next_messages(llm_messages_js, model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]})
assert_eq(next_messages_js[length(llm_messages_js)].role, "assistant")
assert_eq(next_messages_js[length(llm_messages_js) + 1].role, "tool")
assert(next_messages_js[length(llm_messages_js) + 1].content.contains("tool context"))
next_request_js is llm.next_request("model", llm_messages_js, model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]}, ["http_get"], 0)
assert_eq(next_request_js.messages[length(llm_messages_js) + 1].role, "tool")
assert_eq(next_request_js.tools[0].function.name, "http_get")
assert(llm.next_request_json("model", llm_messages_js, model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]}, ["http_get"], 0).contains("\"tools\""))
next_schema_request_js is llm.next_schema_request("model", llm_messages_js, model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]}, ["http_get"], agent_schema_js, 0, "agent_plan")
assert_eq(next_schema_request_js.messages[length(llm_messages_js) + 1].role, "tool")
assert_eq(next_schema_request_js.response_format.json_schema.name, "agent_plan")
assert(llm.next_schema_request_json("model", llm_messages_js, model_response_js, {tools: ["http_get"], url_prefixes: ["file://"]}, ["http_get"], agent_schema_js, 0, "agent_plan").contains("\"response_format\""))
assert_eq(file_delete(note_path_js), true)
sse_chunk_hel_js is json.stringify({choices: [{delta: {content: "Hel"}}]})
sse_chunk_lo_js is json.stringify({choices: [{delta: {content: "lo"}}]})
sse_text_js is "event: message\n" + "data: " + sse_chunk_hel_js + "\n\n" + "data: " + sse_chunk_lo_js + "\n\n" + "data: [DONE]\n\n"
sse_events_js is sse_parse(sse_text_js)
assert_eq(sse_events_js[0].event, "message")
assert(sse_events_js[0].data.contains("Hel"))
sse_chunks_js is sse_data(sse_text_js, true)
assert_eq(sse_chunks_js.len(), 2)
json_sse_events_js is json.sse_parse(sse_text_js)
assert_eq(json_sse_events_js[0].event, "message")
assert_eq(json.sse_data(sse_text_js, true).len(), 2)
assert_eq(llm.stream_text(sse_text_js), "Hello")
assert_eq(llm_stream_text([{choices: [{text: "fallback"}]}]), "fallback")

plan_stream is stream_from(["plan", "act", "observe", "done"])
assert_eq(stream_count(plan_stream), 4)
assert_eq(stream_take(plan_stream, 2).join(","), "plan,act")
assert_eq(stream_skip(plan_stream, 1), 1)
assert_eq(stream_next(plan_stream), "done")
assert_eq(type(stream_next(plan_stream)), "nil")
batch_stream is stream_from(["a", "b", "c"])
batch_rows is stream_batch(batch_stream, 2)
assert_eq(batch_rows[0].join(","), "a,b")
assert_eq(batch_rows[1].join(","), "c")
assert_eq(stream_count(batch_stream), 0)
event_stream is stream_from([{kind: "log", msg: "start"}, {kind: "metric", msg: "cpu"}, {kind: "log", msg: "stop"}])
log_stream is stream_filter(event_stream, {kind: "log"})
assert_eq(stream_join(stream_map(log_stream, "msg"), "|"), "start|stop")
window_rows is stream_window(stream_from(["a", "b", "c", "d"]), 2, 2)
assert_eq(window_rows[0].join(","), "a,b")
assert_eq(window_rows[1].join(","), "c,d")
line_stream is stream_from("alpha\nbeta")
assert_eq(stream_join(line_stream, "|"), "alpha|beta")
metric_stream_js is stream_from([{ms: 10}, {ms: 20}, {ms: 30}])
assert_eq(stream_sum(metric_stream_js, "ms"), 60)
assert_eq(stream_count(metric_stream_js), 0)
assert_eq(stream_avg(stream_from([2, 4, 6])), 4)
assert_eq(type(stream_avg(stream_from([]))), "nil")
module_events is stream.from([{kind: "log", msg: "start"}, {kind: "metric", msg: "cpu"}, {kind: "log", msg: "stop"}])
assert_eq(stream.join(stream.map(stream.filter(module_events, {kind: "log"}), "msg"), " | "), "start | stop")
assert_eq(stream.batch(stream.from(["a", "b", "c"]), 2)[0].len(), 2)
module_metric_stream_js is stream.from([{ms: 3}, {ms: 7}])
assert_eq(stream.sum(module_metric_stream_js, "ms"), 10)
assert_eq(stream.avg(stream.from([4, 6])), 5)

who is "Sura"
agent is {name: "agent", score: 7}
assert_eq("hello {who}", "hello Sura")
assert_eq("agent {agent[\"name\"]}", "agent agent")
assert_eq("score {agent.score + 3}", "score 10")
assert_eq("score index {agent[\"score\"] + 3}", "score index 10")
assert_eq("fib {fib(5)}", "fib 5")
assert_eq("json {} done", "json {} done")
assert_eq("literal and only", "literal and only")

print "js target: PASS"

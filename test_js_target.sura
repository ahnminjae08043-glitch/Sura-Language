func typed_scale(value: int, factor: int) -> int do
  return value * factor
end

assert_eq(typed_scale(5, 3), 15)

func make_js_adder(base) do
  func add_js_value(value) do
    return base + value
  end
  return add_js_value
end

add_five_js is make_js_adder(5)
assert_eq(add_five_js(7), 12)

block_double_js is func(value) do

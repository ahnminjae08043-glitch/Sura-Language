use math
use array
use string
use vector
import "tests/wasm_import_fixture.sura"

assert_eq(wasm_import_double(wasm_import_value), 42)

func square(x: int) -> int do
  return x * x
end

func sum_to(n: int) -> int do
  total: int is 0
  i: int is 1
  while i <= n do
    total += i
    i += 1
  end
  return total
end

func bump_param(x: int) -> int do
  x is x + 2
  return x
end

func captured_function_alias_call_ast() do
  handler is bump_param
  wrapper is func(value) do
    return handler(value)
  end
  return wrapper(40)
end

func captured_inline_function_alias_chain_ast() do
  inner is func(value) do
    return value + 1
  end
  alias is inner
  outer is func(value) do
    return alias(value)
  end
  return outer(5)
end

func captured_runtime_function_ternary_ast(flag) do
  handler is flag ? square : bump_param
  wrapper is func(value) do
    return handler(value)
  end
  return wrapper(5)
end

func returned_param_function_capture_source_ast(handler) do
  return func(value) do
    return handler(value)
  end
end

func zero_a_ast() -> int do
  return 11
end

func zero_b_ast() -> int do
  return 17
end

func call_dynamic_zero_function_ast(flag) do
  handler is flag ? zero_a_ast : zero_b_ast
  return handler()
end

func add_pair_ast(a: int, b: int) -> int do
  return a + b
end

func mul_pair_ast(a: int, b: int) -> int do
  return a * b
end

func sum_triple_ast(a: int, b: int, c: int) -> int do
  return a + b + c
end

func mul_add_triple_ast(a: int, b: int, c: int) -> int do
  return a * b + c
end

func sum_quad_ast(a: int, b: int, c: int, d: int) -> int do
  return a + b + c + d
end

func mul_add_quad_ast(a: int, b: int, c: int, d: int) -> int do
  return a * b + c + d
end

func sum_five_ast(a: int, b: int, c: int, d: int, e: int) -> int do
  return a + b + c + d + e
end

func mul_add_five_ast(a: int, b: int, c: int, d: int, e: int) -> int do
  return a * b + c + d + e
end

func sum_eight_ast(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int do
  return a + b + c + d + e + f + g + h
end

func mul_add_eight_ast(a: int, b: int, c: int, d: int, e: int, f: int, g: int, h: int) -> int do
  return a * b + c + d + e + f + g + h
end

func prefix_a_ast(value) do
  return "A" + value
end

func prefix_b_ast(value) do
  return "B" + value
end

func positive_ast(value) do
  return value > 0
end

func over_ten_ast(value) do
  return value > 10
end

func pair_array_a_ast(value) do
  return [value, "a"]
end

func pair_array_b_ast(value) do
  return [value + 1, "b"]
end

func nil_a_ast(value) do
  return nil
end

func nil_b_ast(value) do
  return nil
end

func profile_a_ast(value) do
  return {score: value, name: "a"}
end

func profile_b_ast(value) do
  return {score: value + 1, name: "b"}
end

func return_add_pair_ast(value) do
  return add_pair_ast
end

func return_mul_pair_ast(value) do
  return mul_pair_ast
end

func call_dynamic_binary_function_ast(flag, left, right) do
  handler is flag ? add_pair_ast : mul_pair_ast
  return handler(left, right)
end

func call_dynamic_triple_function_ast(flag, left, middle, right) do
  handler is flag ? sum_triple_ast : mul_add_triple_ast
  return handler(left, middle, right)
end

func call_dynamic_quad_function_ast(flag, a, b, c, d) do
  handler is flag ? sum_quad_ast : mul_add_quad_ast
  return handler(a, b, c, d)
end

func call_dynamic_five_function_ast(flag, a, b, c, d, e) do
  handler is flag ? sum_five_ast : mul_add_five_ast
  return handler(a, b, c, d, e)
end

func call_dynamic_eight_function_ast(flag, a, b, c, d, e, f, g, h) do
  handler is flag ? sum_eight_ast : mul_add_eight_ast
  return handler(a, b, c, d, e, f, g, h)
end

func call_dynamic_string_function_ast(flag, value) do
  handler is flag ? prefix_a_ast : prefix_b_ast
  return handler(value)
end

func call_dynamic_bool_function_ast(flag, value) do
  handler is flag ? positive_ast : over_ten_ast
  return handler(value)
end

func call_dynamic_array_function_ast(flag, value) do
  handler is flag ? pair_array_a_ast : pair_array_b_ast
  return handler(value)
end

func call_dynamic_nil_function_ast(flag, value) do
  handler is flag ? nil_a_ast : nil_b_ast
  return handler(value)
end

func call_dynamic_dict_return_function_ast(flag, value) do
  handler is flag ? profile_a_ast : profile_b_ast
  return handler(value)
end

func call_dynamic_function_return_function_ast(flag, value) do
  handler is flag ? return_add_pair_ast : return_mul_pair_ast
  return handler(value)
end

func call_dynamic_dict_lookup_dict_return_function_ast(flag, value) do
  handlers is {first: profile_a_ast, second: profile_b_ast}
  key is flag ? "first" : "second"
  handler is handlers[key]
  return handler(value)
end

func call_dynamic_array_lookup_function_return_function_ast(flag, value) do
  handlers is [return_add_pair_ast, return_mul_pair_ast]
  index is flag ? 0 : 1
  handler is handlers[index]
  return handler(value)
end

func call_dynamic_binary_dict_function_ast(flag, left, right) do
  handlers is {add: add_pair_ast, mul: mul_pair_ast}
  key is flag ? "add" : "mul"
  handler is handlers[key]
  return handler(left, right)
end

func call_dynamic_binary_array_function_ast(flag, left, right) do
  handlers is [add_pair_ast, mul_pair_ast]
  index is flag ? 0 : 1
  handler is handlers[index]
  return handler(left, right)
end

func call_dynamic_binary_param_function_ast(handler, left, right) do
  return handler(left, right)
end

func fib(n: int) -> int do
  if n <= 1 then return n
  return fib(n - 1) + fib(n - 2)
end

func sum3(values) -> int do
  return values[0] + values[1] + values[2]
end

func make_values() do
  return [2, 4, 6]
end

func make_mixed_values() do
  return [32, "ok", true, nil]
end

func make_mixed_profile() do
  return {score: 32, name: "ok", active: true, missing: nil}
end

func return_direct_string() do
  return "returned"
end

func return_direct_bool() do
  return true
end

func return_direct_nil() do
  return nil
end

func return_direct_array() do
  return [1, "x", true, nil]
end

func return_direct_dict() do
  return {name: "returned", ok: true, missing: nil}
end

func return_direct_function() do
  return fib
end

func pass_wasm_values(items) do
  return items
end

func pass_wasm_profile(info) do
  return info
end

func bare_return_zero() -> int do
  return
end

func throw_value_source(x: int) -> int do
  return x + 1
end

func wasm_pick_label(flag) do
  return flag ? "on" : "off"
end

func wasm_pick_bool(flag) do
  return flag ? true : false
end

func wasm_pick_nil(flag) do
  return flag ? nil : nil
end

func wasm_first_label_from_foreach() do
  labels is ["red", "blue"]
  for label in labels do
    return label
  end
end

func wasm_label_from_match(flag) do
  match flag
  when true then return "yes"
  when _ then return "no"
  end
end

func wasm_label_from_if(flag) do
  if flag then
    return "yes"
  else
    return "no"
  end
end

func wasm_mixed_from_if(flag) do
  if flag then
    return "yes"
  else
    return 7
  end
end

enum WasmMode do
  READY is 7
  SCORE is 11
end

enum WasmLabel do
  READY
  CUSTOM is "custom"
end

class WasmLookupFunctionHolder do
  func dict_handler_profile(flag, value) do
    handlers is {first: profile_a_ast, second: profile_b_ast}
    key is flag ? "first" : "second"
    handler is handlers[key]
    return handler(value)
  end
  func array_handler_function(flag, value) do
    handlers is [return_add_pair_ast, return_mul_pair_ast]
    index is flag ? 0 : 1
    handler is handlers[index]
    return handler(value)
  end
end

result: int is sum_to(5) + square(3)
choose_square_handler is false
dynamic_unary_handler is choose_square_handler ? square : bump_param
assert_eq(dynamic_unary_handler(10), 12)
